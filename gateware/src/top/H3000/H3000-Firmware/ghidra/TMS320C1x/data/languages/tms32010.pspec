<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>
  <data_space space="data"/>
  <context_data>
    <context_set space="prog">
      <set name="arpc" val="0"/>
      <set name="dpc" val="0"/>
    </context_set>
  </context_data>
  <volatile outputop="write_io" inputop="read_io">
    <range space="io" first="0x0" last="0xf"/>  <!-- byte offsets: PA0-PA7 -->
  </volatile>
  <default_symbols>
    <symbol name="RESET" address="prog:0000" entry="true"/>
    <symbol name="INT"   address="prog:0002" entry="true"/>
    <symbol name="PA0" address="io:0000"/>
    <symbol name="PA1" address="io:0001"/>
    <symbol name="PA2" address="io:0002"/>
    <symbol name="PA3" address="io:0003"/>
    <symbol name="PA4" address="io:0004"/>
    <symbol name="PA5" address="io:0005"/>
    <symbol name="PA6" address="io:0006"/>
    <symbol name="PA7" address="io:0007"/>
  </default_symbols>
  <default_memory_blocks>
    <memory_block name="DRAM" start_address="data:0000" length="0x120" initialized="false" mode="rw"/>
    <memory_block name="PORTS" start_address="io:0000" length="0x10" initialized="false" mode="rw"/>
  </default_memory_blocks>
</processor_spec>

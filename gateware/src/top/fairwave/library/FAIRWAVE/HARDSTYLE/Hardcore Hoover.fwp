FAIRWAVE PATCH 1
NAME  = HARDCORE HOOVER
ABOUT = A FASTER, HARDER HOOVER. GATE 1

# The hoover samples with a quicker swoop and a lot of brightness, for gabber and hardcore. 0 V is C3.
[OSC 1]
TABLE = SAMPLES/HOOVBRI.WAV
TUNE = -30
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = SAMPLES/HOOVBRI.WAV
TUNE = -18
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
ATTACK = 40 MS
DECAY = 100 MS
SUSTAIN = 100%
RELEASE = 90 MS
A CURVE = 30
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > PITCH 1 = 20%
ENV 1 > PITCH 2 = 20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30%

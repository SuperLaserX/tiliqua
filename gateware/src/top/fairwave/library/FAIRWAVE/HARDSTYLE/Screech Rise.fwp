FAIRWAVE PATCH 1
NAME  = SCREECH RISE
ABOUT = SWOOPS UP INTO IT. GATE 1, CV 1

# The same lead, but a slide up an octave on each note: a raw melody over the kick.
[OSC 1]
TABLE = TABLES/SYNC.WAV
TUNE = 7
POS = 55%

[OSC 2]
TABLE = TABLES/HARD.WAV
TUNE = 0
POS = 55%
LEVEL = 65%

[ENV 1]
ATTACK = 5 MS
DECAY = 200 MS
SUSTAIN = 90%
RELEASE = 90 MS
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 70 MS
DECAY = 60 MS
SUSTAIN = 100%
RELEASE = 100 MS
A CURVE = 15

[LFO 1]
RATE = 23 HZ
SHAPE = RANDOM

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 10%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 20%
ENV 2 > PITCH 2 = 20%
LFO 1 > X DEPTH = 7%
CV 2 > POS 1 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

FAIRWAVE PATCH 1
NAME  = ACID ROLL
ABOUT = RESONANT SNAP. ABOUT 145 BPM

# A saw under a resonant filter, the peak swept down every sixteenth. CV 2 is the cutoff.
[OSC 1]
TABLE = TABLES/ACIDLP.WAV
TUNE = -24
POS = 20%

[OSC 2]
TABLE = TABLES/SUBDRV.WAV
TUNE = -24
POS = 0%

[ENV 1]
ATTACK = 1 MS
DECAY = 64 MS
SUSTAIN = 0%
RELEASE = 38 MS
D CURVE = 60
R CURVE = 0
LOOP = FREE
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > POS 1 = 44%
CV 2 > POS 1 = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40%

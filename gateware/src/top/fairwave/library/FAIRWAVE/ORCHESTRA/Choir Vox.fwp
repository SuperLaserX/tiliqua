FAIRWAVE PATCH 1
NAME  = CHOIR VOX
ABOUT = THE AKAI'S VOICES. GATE 1, CV 1

# Akai AX73 Vox, played by READ = SAMPLE, restarting on each gate. 0 V is C4.
# CV 2 moves where it starts.
[OSC 1]
TABLE = SAMPLES/VOX.WAV
READ = SAMPLE
TUNE = -19
FINE = -26
POS = 0%
EDGE = WRAP
LOOP = 33.5%
GRAIN = SYNC 1

[OSC 2]
TABLE = SAMPLES/VOX.WAV
READ = SAMPLE
TUNE = -19
FINE = -20
POS = 0%
EDGE = WRAP
LOOP = 33.5%
GRAIN = SYNC 1

[ENV 1]
ATTACK = 150 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 700 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

FAIRWAVE PATCH 1
NAME  = CELLO
ABOUT = ONE CELLO. GATE 1, CV 1

# D110-Cello 1, played by READ = SAMPLE, restarting on each gate. 0 V is C3.
# CV 2 moves where it starts.
[OSC 1]
TABLE = SAMPLES/CELLO.WAV
READ = SAMPLE
TUNE = -18
FINE = 32
POS = 0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 1

[OSC 2]
TABLE = SAMPLES/CELLO.WAV
READ = SAMPLE
TUNE = -18
FINE = 35
POS = 0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 1

[ENV 1]
ATTACK = 70 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 300 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 5.1 HZ
SHAPE = SINE
LEVEL = 30%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

FAIRWAVE PATCH 1
NAME  = ORCHESTRA HIT
ABOUT = THE D-110'S. GATE 1, CV 1

# D110-Orche Hit, played by READ = SAMPLE, restarting on each gate. 0 V is C4.
# CV 2 moves where it starts.
[OSC 1]
TABLE = SAMPLES/ORCHHIT.WAV
READ = SAMPLE
TUNE = -6
FINE = 13
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[OSC 2]
TABLE = SAMPLES/ORCHHIT.WAV
READ = SAMPLE
TUNE = -6
FINE = 17
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[ENV 1]
ATTACK = 0
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 200 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

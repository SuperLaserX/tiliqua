FAIRWAVE PATCH 1
NAME  = FM E PIANO
ABOUT = THE TINE AT 14 TIMES. GATE 1, CV 1

# Two sines at 1:14, the classic electric piano's tine: the modulator's depth falls off quickly leaving the body.
# Only the carrier is heard. CV 2 hits it harder.
[OSC 1]
TABLE = MORPH 2048
TUNE = 46
FINE = -31
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = -12
POS = 0%

[ENV 1]
ATTACK = 1 MS
DECAY = 1.6 S
SUSTAIN = 0%
RELEASE = 260 MS
D CURVE = 55
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 520 MS
SUSTAIN = 0%
RELEASE = 200 MS
D CURVE = 70

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 5%
CV 2 > X DEPTH = 3%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

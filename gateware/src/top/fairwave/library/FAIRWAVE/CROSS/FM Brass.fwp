FAIRWAVE PATCH 1
NAME  = FM BRASS
ABOUT = 1:1, THE DEPTH RISES. GATE 1, CV 1

# Depth rising just after the level does and falling back a little: more harmonics at the front, the way brass speaks.
[OSC 1]
TABLE = MORPH 2048
TUNE = -12
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = -12
POS = 0%

[ENV 1]
ATTACK = 45 MS
DECAY = 300 MS
SUSTAIN = 80%
RELEASE = 160 MS
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 70 MS
DECAY = 240 MS
SUSTAIN = 70%
RELEASE = 160 MS

[LFO 1]
RATE = 5.3 HZ
SHAPE = SINE
LEVEL = 20%

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 20%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > X DEPTH = 15%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

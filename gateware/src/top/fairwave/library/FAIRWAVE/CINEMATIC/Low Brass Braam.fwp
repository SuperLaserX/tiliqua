FAIRWAVE PATCH 1
NAME  = BRAAM
ABOUT = THE TRAILER HORN. GATE 1, CV 1

# D110-Brass 1, played by READ = SAMPLE, restarting on each gate. 0 V is C2.
# CV 2 moves where it starts.
[OSC 1]
TABLE = SAMPLES/BRASS.WAV
READ = SAMPLE
TUNE = -42
FINE = 24
POS = 0%
EDGE = WRAP
LOOP = 68.5%
GRAIN = SYNC 1

[OSC 2]
TABLE = SAMPLES/BRASS.WAV
READ = SAMPLE
TUNE = -42
FINE = 38
POS = 0%
EDGE = WRAP
LOOP = 68.5%
GRAIN = SYNC 1

[ENV 1]
ATTACK = 70 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 1.2 S
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

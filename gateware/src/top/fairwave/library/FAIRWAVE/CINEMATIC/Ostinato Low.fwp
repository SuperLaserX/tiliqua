FAIRWAVE PATCH 1
NAME  = OSTINATO LOW
ABOUT = TIGHT DOWNBOWS FOR RUNNING 8THS

# Short saw notes, low: the driving low strings under every action scene. A synth's version.
[OSC 1]
TABLE = TABLES/SAWLP.WAV
TUNE = -12
FINE = -6
POS = 40%

[OSC 2]
TABLE = TABLES/SAWLP.WAV
TUNE = -24
FINE = 6
POS = 36%

[ENV 1]
ATTACK = 6 MS
DECAY = 170 MS
SUSTAIN = 0%
RELEASE = 90 MS
D CURVE = 30
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > POS 1 = 26%
ENV 1 > POS 2 = 20%
CV 2 > POS 1 = 30%
CV 2 > POS 2 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 64%

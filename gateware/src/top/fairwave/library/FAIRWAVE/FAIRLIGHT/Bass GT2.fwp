FAIRWAVE PATCH 1
NAME  = CMI BASS GT2
ABOUT = BASS, WITH A SUB UNDER IT

# Fairlight CMI: Fairlight Bass GT2. 236.5 Hz, tuned so 0 V is C2.
# Plays once from the start on each gate: GRAIN = SYNC 1, with LFO 1 as slow as it goes.
# CV 2 moves where it starts.
[OSC 1]
TABLE = WAVES/BASSGT2.WAV
READ = SAMPLE
TUNE = -36
FINE = -4
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[OSC 2]
TABLE = TABLES/SUBDRV.WAV
TUNE = -24
POS = 0%

[ENV 1]
ATTACK = 2 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 90 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 26%

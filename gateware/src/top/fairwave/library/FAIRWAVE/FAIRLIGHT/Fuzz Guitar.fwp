FAIRWAVE PATCH 1
NAME  = CMI FUZZ GUITAR
ABOUT = PLUCKED, THEN LET RING

# Fairlight CMI: Fairlight Fuzz Guitar. 473.2 Hz, tuned so 0 V is C4.
# Plays its attack, then its loop, restarting on each gate: GRAIN = SYNC 1.
# CV 2 moves where it starts.
[OSC 1]
TABLE = WAVES/FUZZGUIT.WAV
READ = SAMPLE
TUNE = -24
FINE = 23
POS = 0%
EDGE = WRAP
LOOP = 70.5%
GRAIN = SYNC 1

[OSC 2]
TABLE = WAVES/FUZZGUIT.WAV
READ = SAMPLE
TUNE = -24
FINE = 29
POS = 0%
EDGE = WRAP
LOOP = 70.5%
GRAIN = SYNC 1

[ENV 1]
ATTACK = 1 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 220 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

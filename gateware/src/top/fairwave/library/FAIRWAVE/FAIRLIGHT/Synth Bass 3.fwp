FAIRWAVE PATCH 1
NAME  = CMI SYNTH BASS 3
ABOUT = BASS, WITH A SUB UNDER IT

# Fairlight CMI: Fairlight Synth Bass 3. 237.0 Hz, tuned so 0 V is C2.
# Plays its attack, then its loop, restarting on each gate: GRAIN = SYNC 1.
# CV 2 moves where it starts.
[OSC 1]
TABLE = WAVES/SYNTHBA2.WAV
READ = SAMPLE
TUNE = -36
POS = 0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 1

[OSC 2]
TABLE = TABLES/SUBDRV.WAV
TUNE = -24
POS = 0%

[ENV 1]
ATTACK = 1 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 90 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 26%

FAIRWAVE PATCH 1
NAME  = CMI BELLS
ABOUT = BELLS. CV 2 PICKS WHICH

# Fairlight CMI: Fairlight Bells. 4 recordings.
# Plays once from the start on each gate: GRAIN = SYNC 1, with LFO 1 as slow as it goes.
# POS or CV 2 picks the hit, 5 V reaching the last. They're at: 0% BELLTREE, 25.1% BLLTR, 50.2% EERR1, 75.3% JINGBELL
[OSC 1]
TABLE = WAVES/BELLS.WAV
READ = SAMPLE
TUNE = -14
FINE = 21
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[OSC 2]
TABLE = WAVES/BELLS.WAV
READ = SAMPLE
TUNE = -14
FINE = 28
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[ENV 1]
ATTACK = 0
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 600 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
CV 2 > POS 2 = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

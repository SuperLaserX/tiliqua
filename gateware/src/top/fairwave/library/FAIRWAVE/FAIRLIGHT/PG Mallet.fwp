FAIRWAVE PATCH 1
NAME  = CMI PG MALLET
ABOUT = STRUCK AND DECAYING

# Fairlight CMI: Farilight PG Mallet. 219.8 Hz, tuned so 0 V is C3.
# Plays once from the start on each gate: GRAIN = SYNC 1, with LFO 1 as slow as it goes.
# CV 2 moves where it starts.
[OSC 1]
TABLE = WAVES/PGMALLET.WAV
READ = SAMPLE
TUNE = -36
FINE = 2
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[OSC 2]
TABLE = WAVES/PGMALLET.WAV
READ = SAMPLE
TUNE = -36
FINE = 9
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[ENV 1]
ATTACK = 0
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 200 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

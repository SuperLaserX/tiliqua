FAIRWAVE PATCH 1
NAME  = CMI POLYMOOGV2
ABOUT = THE POLYMOOG ON THE CMI

# Fairlight CMI: Farilight Polymoog. 235.9 Hz, tuned so 0 V is C4.
# Plays its attack, then its loop, restarting on each gate: GRAIN = SYNC 1.
# CV 2 moves where it starts.
[OSC 1]
TABLE = WAVES/POLYMOOG.WAV
READ = SAMPLE
TUNE = -12
FINE = 14
POS = 0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 1

[OSC 2]
TABLE = WAVES/POLYMOOG.WAV
READ = SAMPLE
TUNE = -12
FINE = 23
POS = 0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 1

[ENV 1]
ATTACK = 40 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 500 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

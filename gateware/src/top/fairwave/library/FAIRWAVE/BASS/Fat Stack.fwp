FAIRWAVE PATCH 1
NAME  = FAT STACK
ABOUT = SAW AND SQUARE, SUB OCTAVE. GATE 1

# A big analogue-style mono bass: a saw, and a square an octave under it, both filtered together.
[OSC 1]
TABLE = TABLES/SAWLP.WAV
TUNE = -24
FINE = 4
POS = 35%

[OSC 2]
TABLE = TABLES/SQRLP.WAV
TUNE = -36
FINE = -4
POS = 35%

[ENV 1]
ATTACK = 1 MS
DECAY = 260 MS
SUSTAIN = 55%
RELEASE = 80 MS
D CURVE = 50
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 170 MS
SUSTAIN = 0%
RELEASE = 170 MS
D CURVE = 50

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 30%
ENV 2 > POS 2 = 30%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45%

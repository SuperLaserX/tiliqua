FAIRWAVE PATCH 1
NAME  = CZ RESO
ABOUT = PHASE DISTORTION SWEEP. GATE 1

# A built-in table: a Casio CZ's resonant phase distortion. A filter sweep with no filter in it.
[OSC 1]
TABLE = CZ RESO
TUNE = -24
POS = 15%

[OSC 2]
TABLE = TABLES/SUBDRV.WAV
TUNE = -24
POS = 8%

[ENV 1]
ATTACK = 1 MS
DECAY = 200 MS
SUSTAIN = 30%
RELEASE = 60 MS
D CURVE = 50
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 130 MS
SUSTAIN = 0%
RELEASE = 130 MS
D CURVE = 55

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
CV 2 > POS 1 = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30%

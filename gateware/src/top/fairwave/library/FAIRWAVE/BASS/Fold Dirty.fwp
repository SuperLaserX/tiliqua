FAIRWAVE PATCH 1
NAME  = FOLD DIRTY
ABOUT = WAVEFOLDED GRIT. GATE 1, CV 1

# A sine folded over on itself as the envelope opens: west coast dirt, buzzy without being a saw.
[OSC 1]
TABLE = TABLES/FOLD.WAV
TUNE = -24
POS = 18%

[OSC 2]
TABLE = TABLES/FOLD.WAV
TUNE = -24
FINE = -5
POS = 10%

[ENV 1]
ATTACK = 1 MS
DECAY = 260 MS
SUSTAIN = 40%
RELEASE = 60 MS
D CURVE = 50
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 170 MS
SUSTAIN = 0%
RELEASE = 170 MS
D CURVE = 45

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50%
ENV 2 > POS 2 = 40%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX

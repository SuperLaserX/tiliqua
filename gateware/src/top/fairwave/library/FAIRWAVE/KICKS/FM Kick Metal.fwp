FAIRWAVE PATCH 1
NAME  = FM KICK METAL
ABOUT = WITH A CLANG ON THE FRONT. GATE 1

# The modulator a tritone and a bit up: a clang at the front of the kick that can't be mistaken for a click.
[OSC 1]
TABLE = MORPH 2048
TUNE = -23
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = -29
POS = 0%

[ENV 1]
ATTACK = 0
DECAY = 280 MS
SUSTAIN = 0%
RELEASE = 280 MS
D CURVE = 55
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 38 MS
SUSTAIN = 0%
RELEASE = 38 MS
D CURVE = 75

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 45%
ENV 2 > PITCH 2 = 45%
ENV 2 > X DEPTH = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

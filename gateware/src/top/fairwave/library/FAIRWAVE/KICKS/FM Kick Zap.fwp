FAIRWAVE PATCH 1
NAME  = FM KICK ZAP
ABOUT = A LASER ON THE FRONT. GATE 1

# Five octaves of pitch drop, slowly enough to hear as a zap: the electro kick.
[OSC 1]
TABLE = MORPH 2048
TUNE = -29
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = -29
POS = 0%

[ENV 1]
ATTACK = 0
DECAY = 300 MS
SUSTAIN = 0%
RELEASE = 300 MS
D CURVE = 55
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 90 MS
SUSTAIN = 0%
RELEASE = 90 MS
D CURVE = 80

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 95%
ENV 2 > PITCH 2 = 95%
ENV 2 > X DEPTH = 14%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

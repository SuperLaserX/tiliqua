FAIRWAVE PATCH 1
NAME  = DNB KICK
ABOUT = HIGHER, AND SNAPPY. GATE 1

# Tuned higher than the rest, and short, so it cuts over a sub.
[OSC 1]
TABLE = MORPH 2048
TUNE = -22
POS = 0%

[OSC 2]
TABLE = TABLES/SUBDRV.WAV
TUNE = -22
POS = 16%

[ENV 1]
ATTACK = 0
DECAY = 170 MS
SUSTAIN = 0%
RELEASE = 170 MS
D CURVE = 55
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 22 MS
SUSTAIN = 0%
RELEASE = 22 MS
D CURVE = 75

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 50%
ENV 2 > PITCH 2 = 50%
ENV 2 > X DEPTH = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

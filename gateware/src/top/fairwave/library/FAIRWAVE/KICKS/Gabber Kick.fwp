FAIRWAVE PATCH 1
NAME  = GABBER KICK
ABOUT = HIGH, LONG AND FLAT OUT. GATE 1

# Higher, longer, and at all the drive the table has.
[OSC 1]
TABLE = MORPH 2048
TUNE = -22
POS = 0%

[OSC 2]
TABLE = TABLES/HARD.WAV
TUNE = -22
POS = 84%

[ENV 1]
ATTACK = 0
DECAY = 520 MS
SUSTAIN = 0%
RELEASE = 520 MS
D CURVE = 10
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 24 MS
SUSTAIN = 0%
RELEASE = 24 MS
D CURVE = 75

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 44%
ENV 2 > PITCH 2 = 44%
ENV 1 > POS 2 = 16%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 88%

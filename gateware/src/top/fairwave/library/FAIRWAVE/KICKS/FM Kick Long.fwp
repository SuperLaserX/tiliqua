FAIRWAVE PATCH 1
NAME  = FM KICK LONG
ABOUT = A DEEP ONE, 780 MS LONG. GATE 1

# The same with a slower drop and a long, low tail.
[OSC 1]
TABLE = MORPH 2048
TUNE = -33
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = -33
POS = 0%

[ENV 1]
ATTACK = 0
DECAY = 780 MS
SUSTAIN = 0%
RELEASE = 780 MS
D CURVE = 40
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 70 MS
SUSTAIN = 0%
RELEASE = 70 MS
D CURVE = 75

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 45%
ENV 2 > PITCH 2 = 45%
ENV 2 > X DEPTH = 18%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

FAIRWAVE PATCH 1
NAME  = RAVE STAB
ABOUT = THE 90S CHORD STAB. GATE 1

# A minor chord with its root and third doubled: the 90s rave stab, hard and bright with a very quick filter.
[OSC 1]
TABLE = TABLES/RAVECHRD.WAV
TUNE = -40
FINE = 14
POS = 55%

[OSC 2]
TABLE = TABLES/RAVECHRD.WAV
TUNE = -40
FINE = 26
POS = 55%

[ENV 1]
ATTACK = 1 MS
DECAY = 230 MS
SUSTAIN = 0%
RELEASE = 120 MS
D CURVE = 45
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 90 MS
SUSTAIN = 0%
RELEASE = 60 MS
D CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 40%
ENV 2 > POS 2 = 40%
CV 2 > POS 1 = 30%
CV 2 > POS 2 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX

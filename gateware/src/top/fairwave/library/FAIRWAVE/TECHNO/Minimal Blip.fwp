FAIRWAVE PATCH 1
NAME  = MINIMAL BLIP
ABOUT = A CLICK WITH A NOTE IN IT. GATE 1

# A sine with a very quick FM on it and almost no length. It leaves everything else room: minimal techno's percussion.
[OSC 1]
TABLE = MORPH 2048
TUNE = 12
POS = 0%

[OSC 2]
TABLE = MORPH 2048
TUNE = 0
POS = 0%

[ENV 1]
ATTACK = 0
DECAY = 60 MS
SUSTAIN = 0%
RELEASE = 60 MS
D CURVE = 70
VCA = OSC 2

[ENV 2]
GATE = GATE 1
ATTACK = 0
DECAY = 18 MS
SUSTAIN = 0%
RELEASE = 18 MS
D CURVE = 70

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 30%
ENV 2 > PITCH 2 = 10%
CV 2 > X DEPTH = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100%

FAIRWAVE PATCH 1
NAME  = SLOW BLOOM
ABOUT = A STRING PAD OPENING. GATE 1

# Slow grains of Karma's string pad, on a clock slower than its own loop: it swells and turns without ever
# quite settling. Hold it for a long time.
[OSC 1]
TABLE = SAMPLES/OBER.WAV
READ = SAMPLE
TUNE = -30
FINE = 24
POS = 35%
EDGE = WRAP
GRAIN = LFO 1
LOOP = 6.8%

[OSC 2]
TABLE = SAMPLES/OBER.WAV
READ = SAMPLE
TUNE = -30
FINE = 24
POS = 35%
EDGE = WRAP
GRAIN = LFO 1 B
LOOP = 6.8%

[LFO 1]
RATE = 1.9 HZ
SHAPE = SAW UP

[ENV 1]
ATTACK = 4 S
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 6 S
VCA = BOTH

[LFO 2]
RATE = 0.018 HZ
SHAPE = SINE

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
LFO 2 > POS 1 = 30%
LFO 2 > POS 2 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
LEVEL 1 = 100%
LEVEL 2 = 100%

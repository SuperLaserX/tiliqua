FAIRWAVE PATCH 1
NAME  = STEAM FIFTHS
ABOUT = A PAD IN FIFTHS, MOVING. GATE 1

# The D-110's Steam Pad in grains, with the second stream a fifth up: a chord out of one note, drifting.
[OSC 1]
TABLE = SAMPLES/STEAM.WAV
READ = SAMPLE
TUNE = -6
FINE = 21
POS = 40%
EDGE = WRAP
GRAIN = LFO 1

[OSC 2]
TABLE = SAMPLES/STEAM.WAV
READ = SAMPLE
TUNE = 1
FINE = 21
POS = 40%
EDGE = WRAP
GRAIN = LFO 1 B

[LFO 1]
RATE = 3.3 HZ
SHAPE = SAW UP

[ENV 1]
ATTACK = 1.5 S
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 4 S
VCA = BOTH

[LFO 2]
RATE = 0.05 HZ
SHAPE = TRI

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
LFO 2 > POS 1 = 30%
LFO 2 > POS 2 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
LEVEL 1 = 100%
LEVEL 2 = 100%

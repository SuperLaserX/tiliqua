FAIRWAVE PATCH 1
NAME  = WINDING STRINGS
ABOUT = STRINGS THAT NEVER REPEAT. GATE 1

# A string section's sound, read a little at a time, the place drifting on a slow sine: a bow that never
# changes direction. Move CV 2 for another part of the recording.
[OSC 1]
TABLE = SAMPLES/BOWS.WAV
READ = SAMPLE
TUNE = -30
FINE = 19
POS = 45%
EDGE = WRAP
GRAIN = LFO 1
LOOP = 7.5%

[OSC 2]
TABLE = SAMPLES/BOWS.WAV
READ = SAMPLE
TUNE = -30
FINE = 19
POS = 45%
EDGE = WRAP
GRAIN = LFO 1 B
LOOP = 7.5%

[LFO 1]
RATE = 6.8 HZ
SHAPE = SAW UP

[ENV 1]
ATTACK = 1.8 S
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 3 S
VCA = BOTH

[LFO 2]
RATE = 0.06 HZ
SHAPE = SINE

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
LFO 2 > POS 1 = 28%
LFO 2 > POS 2 = 28%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
LEVEL 1 = 100%
LEVEL 2 = 100%

FAIRWAVE PATCH 1
NAME  = FREEZE
ABOUT = HOLDS ONE MOMENT. CV 2 PICKS IT

# No drift: the grains read one place over and over, so a moment of the recording goes on as long as the gate
# does. CV 2 at 0 to 5 V says which moment. Fast clocks, for a smooth sound.
[OSC 1]
TABLE = SAMPLES/VOX.WAV
READ = SAMPLE
TUNE = -19
FINE = -26
POS = 20%
EDGE = WRAP
GRAIN = LFO 1
LOOP = 33.5%

[OSC 2]
TABLE = SAMPLES/VOX.WAV
READ = SAMPLE
TUNE = -19
FINE = -26
POS = 20%
EDGE = WRAP
GRAIN = LFO 1 B
LOOP = 33.5%

[LFO 1]
RATE = 11.3 HZ
SHAPE = SAW UP

[ENV 1]
ATTACK = 300 MS
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 1.5 S
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 80%
CV 2 > POS 2 = 80%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
LEVEL 1 = 100%
LEVEL 2 = 100%

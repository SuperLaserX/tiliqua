FAIRWAVE PATCH 1
NAME  = WARM OCTAVES
ABOUT = PAD WITH AN OCTAVE OVER IT. GATE 1

# A warm pad's recording in slow grains, with the second stream an octave up: the upper one reads twice
# as fast, so it moves through the recording quicker. Long and slow.
[OSC 1]
TABLE = SAMPLES/WARMPAD.WAV
READ = SAMPLE
TUNE = -6
FINE = 27
POS = 50%
EDGE = WRAP
GRAIN = LFO 1

[OSC 2]
TABLE = SAMPLES/WARMPAD.WAV
READ = SAMPLE
TUNE = 6
FINE = 27
POS = 50%
EDGE = WRAP
GRAIN = LFO 1 B

[LFO 1]
RATE = 2.7 HZ
SHAPE = SAW UP

[ENV 1]
ATTACK = 3 S
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 5 S
VCA = BOTH

[LFO 2]
RATE = 0.03 HZ
SHAPE = SINE

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
LFO 2 > POS 1 = 30%
LFO 2 > POS 2 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
LEVEL 1 = 100%
LEVEL 2 = 100%

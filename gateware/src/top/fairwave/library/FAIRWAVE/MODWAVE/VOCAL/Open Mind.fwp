FAIRWAVE PATCH 1
NAME  = OPEN MIND
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Open Mind by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is A's 2, the sample Syn_WS: VoiceSyn.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D9/D9566792.WAV
READ = SAMPLE
TUNE = -7
FINE = 45
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AD/1679CCA7.WAV
READ = SAMPLE
TUNE = -25
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 43.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 90.000 S
SUSTAIN = 52%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.2%

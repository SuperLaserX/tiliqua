FAIRWAVE PATCH 1
NAME  = RHYTHMS VOCAL
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Rhythms Vocal by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Ahh.
# Oscillator 2 is A's 2, the sample Str_Guru: Dream Ensemble.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Tine EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/92/7664A532.WAV
READ = SAMPLE
TUNE = -30
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 32.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B3/69E2FB4A.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.903 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.475 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 666.667 MS
SUSTAIN = 10%
RELEASE = 1.256 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 60%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

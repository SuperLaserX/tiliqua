FAIRWAVE PATCH 1
NAME  = FLUTTER VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Flutter Vox by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, the sample Vox_WS:Airvox.
# Not carried over: layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/75/5937400D.WAV
READ = SAMPLE
TUNE = -12
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A6/DBA64BD9.WAV
READ = SAMPLE
TUNE = -26
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 70.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 156.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.6%

FAIRWAVE PATCH 1
NAME  = VANGELIS CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Vangelis Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is B's 2, the sample Vox: Choir Ahh.
# Not carried over: layer A oscillator 1, layer A oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/33/6BA7675E.WAV
READ = SAMPLE
TUNE = -12
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 9.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CE/20BA1710.WAV
READ = SAMPLE
TUNE = -30
FINE = 44
POS = 0.0%
EDGE = WRAP
LOOP = 28.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 173.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

FAIRWAVE PATCH 1
NAME  = DUAL TRON CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dual Tron Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Tape Boys Choir.
# Oscillator 2 is A's 2, the sample Vox: Tape Choir.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/F6/B61BEA14.WAV
READ = SAMPLE
TUNE = -25
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/49/A4A14E04.WAV
READ = SAMPLE
TUNE = -18
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 1.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.6%

FAIRWAVE PATCH 1
NAME  = ARTIC VOICES
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Artic Voices by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Cricket Spectrum.
# Oscillator 2 is A's 2, the sample Vox: Choir.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/21/425DEE83.WAV
READ = SAMPLE
TUNE = -46
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 4.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4C/C959525F.WAV
READ = SAMPLE
TUNE = -15
FINE = -35
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 504.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 797.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.7%

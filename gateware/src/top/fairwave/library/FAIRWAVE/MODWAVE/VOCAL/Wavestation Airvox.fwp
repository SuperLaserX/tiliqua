FAIRWAVE PATCH 1
NAME  = WAVESTATION AIRV
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wavestation Airvox by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Airvox.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/45/DFBB0507.WAV
READ = SAMPLE
TUNE = -26
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/45/DFBB0507.WAV
TUNE = -26
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

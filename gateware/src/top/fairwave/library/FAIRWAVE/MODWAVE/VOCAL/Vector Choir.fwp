FAIRWAVE PATCH 1
NAME  = VECTOR CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Vector Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_WS: VS127.
# Oscillator 2 is B's 2, the sample Wave_WS: VS92.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 1, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/BD/E1352FF4.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/71/58696252.WAV
READ = SAMPLE
TUNE = 0
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.2%

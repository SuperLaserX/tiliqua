FAIRWAVE PATCH 1
NAME  = SOUNDSCAPE CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Soundscape Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Gospel Ah.
# Oscillator 2 is A's 2, the sample Vox: Gospel Umm.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/8F/D4732DA2.WAV
READ = SAMPLE
TUNE = -14
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 16.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/13/F11B9D49.WAV
READ = SAMPLE
TUNE = -7
FINE = 43
POS = 0.0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.125 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = -100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

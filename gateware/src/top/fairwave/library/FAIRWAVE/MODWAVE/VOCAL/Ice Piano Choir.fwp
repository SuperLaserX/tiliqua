FAIRWAVE PATCH 1
NAME  = ICE PIANO CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ice Piano Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: Acoustic ff.
# Oscillator 2 is B's 1, the sample Vox: Choir Ahh.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C3/F429606D.WAV
READ = SAMPLE
TUNE = -20
FINE = -8
POS = 0.0%
EDGE = WRAP
LOOP = 83%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/31/820A32F1.WAV
READ = SAMPLE
TUNE = -30
FINE = 39
POS = 0.0%
EDGE = WRAP
LOOP = 28.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 46.000 S
SUSTAIN = 0%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

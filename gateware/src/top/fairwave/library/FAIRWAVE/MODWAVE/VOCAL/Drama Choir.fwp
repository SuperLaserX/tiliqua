FAIRWAVE PATCH 1
NAME  = DRAMA CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Drama Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Ahh Falsetto.
# Oscillator 2 is A's 2, the sample Vox: Choir Ahh.
# Not carried over: layer B oscillator 2, modulation processors, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/92/B38EEF2E.WAV
READ = SAMPLE
TUNE = -39
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 36%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/92/7664A532.WAV
READ = SAMPLE
TUNE = -30
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 32.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.2%

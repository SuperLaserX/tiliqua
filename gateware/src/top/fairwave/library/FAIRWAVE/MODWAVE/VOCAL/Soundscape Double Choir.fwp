FAIRWAVE PATCH 1
NAME  = SOUNDSCAPE DOUBL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Soundscape Double Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Vox: Pop Ooh.
# Oscillator 2 is B's 2, the sample Vox: Choir Ooh.
# Not carried over: layer A oscillator 1, layer B oscillator 1, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/77/8828ABD8.WAV
READ = SAMPLE
TUNE = -11
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E6/221CBF41.WAV
READ = SAMPLE
TUNE = -30
FINE = 42
POS = 0.0%
EDGE = WRAP
LOOP = 34.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.125 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = -100%
LFO 1 > LEVEL 2 = -100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.2%

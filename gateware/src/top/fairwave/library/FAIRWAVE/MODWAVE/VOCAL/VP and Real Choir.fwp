FAIRWAVE PATCH 1
NAME  = VP AND REAL CHOI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VP and Real Choir by Ian Dixon: ID-Vocal.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, the sample Vox: Choir Ahh Falsetto.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/EC/3FE485A4.WAV
READ = SAMPLE
TUNE = -12
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/92/B38EEF2E.WAV
READ = SAMPLE
TUNE = -39
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 36%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.219 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 90.000 S
SUSTAIN = 52%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

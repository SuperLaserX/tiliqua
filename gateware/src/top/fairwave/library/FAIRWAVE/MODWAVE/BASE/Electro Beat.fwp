FAIRWAVE PATCH 1
NAME  = ELECTRO BEAT
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Electro Beat by Richard Devine: Electro Beat.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: Sine.
# Oscillator 2 is B's 2, a table made along morph.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 1, modulation processors, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: Drum Squasher, Electro Beatz, Electro HH & Bass, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/AA/56B6FDC7.WAV
READ = SAMPLE
TUNE = -5
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9F/EADA8229.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 38.139 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 1.000 HZ
SHAPE = SAW DN
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 2 = 50%
LFO 2 > LEVEL 2 = 39%
LFO 1 > PITCH 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 63.7%

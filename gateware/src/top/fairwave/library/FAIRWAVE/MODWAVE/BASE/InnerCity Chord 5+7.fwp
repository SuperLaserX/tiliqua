FAIRWAVE PATCH 1
NAME  = INNERCITY CHORD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's InnerCity Chord 5+7 by Airwave: InnerCity Chord 5+7.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, modulation processors, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, InnerCity Chord 5+7, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0B/299B5B57.WAV
READ = CLEAN
TUNE = -17
FINE = -2
POS = 22.0%

[OSC 2]
TABLE = MODWAVE/T/26/A5D01212.WAV
READ = CLEAN
TUNE = -2
FINE = -2
POS = 22.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56%
ENV 2 > POS 2 = 56%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.1%

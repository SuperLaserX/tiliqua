FAIRWAVE PATCH 1
NAME  = LONELY ECHOS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Lonely Echos by Richard Devine: Lonely Echos.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Wave: DWGS Sine 1.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Alligatorz, Junk Jam Low.
[OSC 1]
TABLE = MODWAVE/T/DE/ABE30420.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/58/BEF377FD.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 96.000 MS
DECAY = 729.333 MS
SUSTAIN = 10%
RELEASE = 2.991 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.000 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -49%
LFO 1 > POS 1 = 20.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.4%

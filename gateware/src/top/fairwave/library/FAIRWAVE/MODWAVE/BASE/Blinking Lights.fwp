FAIRWAVE PATCH 1
NAME  = BLINKING LIGHTS
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Blinking Lights by Richard Devine: Blinking Lights.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Wave: DWGS Sine 1.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Blinking Sparkle, bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/7C/A3A2D1CD.WAV
READ = SAMPLE
TUNE = 12
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F7/7D00DFA2.WAV
READ = CLEAN
TUNE = 12
FINE = 2
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 353.333 MS
DECAY = 64.013 S
SUSTAIN = 72%
RELEASE = 128.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 726.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 16.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 33%
LFO 2 > POS 2 = 33%
CV 1 > POS 2 = -28%
ENV 2 > POS 2 = 27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 83.4%

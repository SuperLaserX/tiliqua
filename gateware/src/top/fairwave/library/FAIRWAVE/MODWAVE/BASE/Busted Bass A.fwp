FAIRWAVE PATCH 1
NAME  = BUSTED BASS A
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Busted Bass A by Rodier: Busted Bass A.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Easy Comp, Easy Go, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/2E/45FDBA67.WAV
READ = CLEAN
TUNE = -36
POS = 22.8%

[OSC 2]
TABLE = MODWAVE/T/CE/102F9D8D.WAV
READ = CLEAN
TUNE = -23
POS = 22.8%

[ENV 1]
GATE = GATE 1
ATTACK = 12.000 MS
DECAY = 845.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 368.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -96%
CV 1 > POS 2 = -96%
CV 2 > POS 1 = 54.5%
CV 2 > POS 2 = 54.5%
ENV 2 > POS 1 = 23.5%
ENV 2 > POS 2 = 23.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.2%

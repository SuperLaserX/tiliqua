FAIRWAVE PATCH 1
NAME  = ZAP FX
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Zap FX by Richard Devine: Zap FX.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Slow Phaser.
[OSC 1]
TABLE = MODWAVE/T/4E/85CB5CB4.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/BA/FEB19C30.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 648.000 MS
DECAY = 1.927 S
SUSTAIN = 54%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 4.185 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -42.5%
CV 1 > POS 2 = -42.5%
LFO 2 > POS 1 = 24.5%
LFO 2 > POS 2 = 24.5%
LFO 1 > PITCH 1 = 15%
LFO 1 > PITCH 2 = 15%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.6%

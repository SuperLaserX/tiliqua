FAIRWAVE PATCH 1
NAME  = BUSTED ALIEN
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Busted Alien by Rodier: Busted Alien.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 3 unison voices, layer A oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Easy Comp, Easy Go, Inharmonic Twang, Modern Compressor, Tight Bass A.
[OSC 1]
TABLE = MODWAVE/T/64/EE47A6C0.WAV
READ = CLEAN
TUNE = -24
POS = 16.8%

[OSC 2]
TABLE = MODWAVE/T/66/C3DF1C34.WAV
READ = CLEAN
TUNE = -36
POS = 22.8%

[ENV 1]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 845.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 368.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -96%
CV 2 > POS 1 = 66.5%
CV 2 > POS 2 = 54.5%
CV 1 > POS 1 = -28%
ENV 2 > POS 2 = 23.5%
ENV 2 > POS 1 = 23%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.4%

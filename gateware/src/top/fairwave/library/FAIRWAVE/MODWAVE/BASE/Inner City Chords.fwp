FAIRWAVE PATCH 1
NAME  = INNER CITY CHORD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Inner City Chords by Airwave: Inner City Chords.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 2 unison voices, layer B oscillator 2, modulation processors, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, InnerCity Chord 1+3, InnerCity Chord 5+7, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AC/AD6D8CB4.WAV
READ = CLEAN
TUNE = -9
FINE = 11
POS = 18.4%

[OSC 2]
TABLE = MODWAVE/T/29/CABA4C75.WAV
READ = CLEAN
TUNE = -17
FINE = -2
POS = 22.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63.5%
ENV 2 > POS 2 = 56%
CV 1 > POS 2 = -36.5%
CV 1 > POS 1 = -30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.0%

FAIRWAVE PATCH 1
NAME  = MOUNTAIN SKY
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mountain Sky by Richard Devine: Mountain Sky.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Steel Guitar mf.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bass Squasher, Clavi Chorus, Drum Squasher, Mono 1/4 note dly, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/1F/1C4FF01B.WAV
READ = SAMPLE
TUNE = -11
FINE = -3
POS = 0.0%
EDGE = WRAP
LOOP = 94.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CF/B3F7E8A6.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.812 S
SUSTAIN = 66%
RELEASE = 680.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 26.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 50%
LFO 2 > LEVEL 2 = 44.5%
CV 1 > POS 2 = 35%
LFO 1 > POS 2 = 29%
LFO 2 > POS 2 = -6.5%
ENV 2 > POS 2 = -5.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.2%

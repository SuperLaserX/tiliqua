FAIRWAVE PATCH 1
NAME  = ELECTRO BEATZ
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Electro Beatz by Richard Devine: Electro Beatz.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: Sine.
# Oscillator 2 is A's 2, the sample Syn: Noise AL-1 1.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Drum Squasher, Electro Beatz.
[OSC 1]
TABLE = MODWAVE/T/AA/56B6FDC7.WAV
READ = SAMPLE
TUNE = -5
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2A/3E4BD8A0.WAV
READ = SAMPLE
TUNE = -18
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 61.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 38.139 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 27.0%

[LFO 1]
RATE = 1.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 100%
LFO 1 > LEVEL 2 = 45%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 24.3%

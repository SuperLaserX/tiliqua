FAIRWAVE PATCH 1
NAME  = SYNTH FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Synth Flute by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow Mo Shock Low, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D2/74B8A19A.WAV
READ = CLEAN
TUNE = 0
POS = 21.1%

[OSC 2]
TABLE = MODWAVE/T/18/E4F1CE9A.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 21.1%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 12.000 MS
DECAY = 220.000 MS
SUSTAIN = 27%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57.5%
ENV 2 > POS 2 = 57.5%
CV 1 > POS 1 = -35%
CV 1 > POS 2 = -35%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.6%

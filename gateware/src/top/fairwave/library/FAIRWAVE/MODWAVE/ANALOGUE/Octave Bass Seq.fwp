FAIRWAVE PATCH 1
NAME  = OCTAVE BASS SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Octave Bass Seq by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FC/36584AFE.WAV
READ = CLEAN
TUNE = -36
POS = 15.9%

[OSC 2]
TABLE = MODWAVE/T/FC/36584AFE.WAV
TUNE = -36
POS = 15.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 520.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 68%
CV 1 > POS 1 = -26.5%
LFO 1 > POS 1 = 11.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

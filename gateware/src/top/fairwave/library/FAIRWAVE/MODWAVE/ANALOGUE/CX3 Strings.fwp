FAIRWAVE PATCH 1
NAME  = CX3 STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CX3 Strings by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CF/219CAA2C.WAV
READ = CLEAN
TUNE = -12
POS = 46.2%

[OSC 2]
TABLE = MODWAVE/T/E1/FA8D10B2.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 46.2%

[ENV 1]
GATE = GATE 1
ATTACK = 1.067 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 900.000 MS
SUSTAIN = 50%
RELEASE = 4.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -77%
CV 1 > POS 2 = -77%
ENV 2 > POS 1 = 7.5%
ENV 2 > POS 2 = 7.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

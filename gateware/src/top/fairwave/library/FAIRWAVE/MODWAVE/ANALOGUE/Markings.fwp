FAIRWAVE PATCH 1
NAME  = MARKINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Markings by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B7/92832593.WAV
READ = CLEAN
TUNE = -24
POS = 15.5%

[OSC 2]
TABLE = MODWAVE/T/7D/EFE31D32.WAV
READ = CLEAN
TUNE = -12
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 95%
RELEASE = 1.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 885.333 MS
SUSTAIN = 0%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.221 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
LFO 1 > POS 1 = 15.5%
LFO 1 > POS 2 = 15.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.6%

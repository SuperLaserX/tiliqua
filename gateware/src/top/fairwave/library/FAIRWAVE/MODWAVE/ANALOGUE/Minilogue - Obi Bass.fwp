FAIRWAVE PATCH 1
NAME  = MINILOGUE - OBI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue - Obi Bass by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/16 - 1/8 HPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/C8/0F309792.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 25.1%

[OSC 2]
TABLE = MODWAVE/T/64/4120399F.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 25.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.489 S
SUSTAIN = 3%
RELEASE = 549.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.432 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50%
ENV 2 > POS 2 = 50%
CV 1 > POS 1 = -42%
CV 1 > POS 2 = -42%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 58.4%

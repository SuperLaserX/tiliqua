FAIRWAVE PATCH 1
NAME  = ENSEMBE STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ensembe Strings by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FC/ABCDA578.WAV
READ = CLEAN
TUNE = -12
FINE = 14
POS = 50.8%

[OSC 2]
TABLE = MODWAVE/T/1A/32640C24.WAV
READ = CLEAN
TUNE = -12
FINE = -12
POS = 50.8%

[ENV 1]
GATE = GATE 1
ATTACK = 360.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 13.5%
LFO 1 > POS 2 = 7%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

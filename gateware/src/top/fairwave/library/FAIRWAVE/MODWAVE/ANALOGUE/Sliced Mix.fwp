FAIRWAVE PATCH 1
NAME  = SLICED MIX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sliced Mix by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, 16ths - 3,5,6, JC Amp Chorus, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B1/FA18FBBD.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 19.1%

[OSC 2]
TABLE = MODWAVE/T/B9/72805784.WAV
READ = CLEAN
TUNE = 0
FINE = 8
POS = 19.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 96.4%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.467 S
SUSTAIN = 9%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SQUARE
PHASE = 2
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
ENV 2 > POS 1 = 62%
ENV 2 > POS 2 = 62%
CV 1 > POS 1 = -32%
CV 1 > POS 2 = -32%
LFO 1 > POS 1 = 2.5%
LFO 1 > POS 2 = 2.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

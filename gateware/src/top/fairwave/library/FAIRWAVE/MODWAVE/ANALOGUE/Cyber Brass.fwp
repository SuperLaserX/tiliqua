FAIRWAVE PATCH 1
NAME  = CYBER BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cyber Brass by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/9E/4AED6771.WAV
READ = CLEAN
TUNE = -12
POS = 15.6%

[OSC 2]
TABLE = MODWAVE/T/B0/AC0C46BC.WAV
READ = CLEAN
TUNE = -5
POS = 15.6%

[ENV 1]
GATE = GATE 1
ATTACK = 24.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.427 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 33.333 MS
DECAY = 513.333 MS
SUSTAIN = 55%
RELEASE = 4.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
ENV 2 > PITCH 1 = 4%
LFO 1 > POS 1 = 3.5%
LFO 1 > POS 2 = 3.5%
ENV 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.4%

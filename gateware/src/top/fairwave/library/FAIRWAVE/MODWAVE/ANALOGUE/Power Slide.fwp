FAIRWAVE PATCH 1
NAME  = POWER SLIDE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Power Slide by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/19/97B2C3DE.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 20.3%

[OSC 2]
TABLE = MODWAVE/T/52/CE0866A6.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 20.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.880 S
SUSTAIN = 0%
RELEASE = 90.000 S
A CURVE = 0
D CURVE = 40
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59.5%
ENV 2 > POS 2 = 59.5%
ENV 2 > PITCH 1 = -35%
ENV 2 > PITCH 2 = 35%
CV 1 > POS 1 = -34%
CV 1 > POS 2 = -34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

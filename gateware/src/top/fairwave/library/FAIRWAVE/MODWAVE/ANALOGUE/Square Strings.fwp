FAIRWAVE PATCH 1
NAME  = SQUARE STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Square Strings by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A7/75DFDB15.WAV
READ = CLEAN
TUNE = 0
FINE = 8
POS = 22.5%

[OSC 2]
TABLE = MODWAVE/T/90/E97F3FDA.WAV
READ = CLEAN
TUNE = 0
FINE = -8
POS = 22.5%

[ENV 1]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 3.600 S
SUSTAIN = 27%
RELEASE = 2.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.800 S
SUSTAIN = 65%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > POS 1 = 55%
ENV 2 > POS 2 = 55%
CV 1 > POS 1 = -37.5%
CV 1 > POS 2 = -37.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

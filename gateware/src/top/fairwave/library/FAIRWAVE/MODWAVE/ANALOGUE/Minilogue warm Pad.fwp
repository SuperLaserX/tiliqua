FAIRWAVE PATCH 1
NAME  = MINILOGUE WARM P
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue warm Pad by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/18/A3E2F4DC.WAV
READ = CLEAN
TUNE = -12
POS = 46.2%

[OSC 2]
TABLE = MODWAVE/T/84/2A28EEF4.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 900.000 MS
SUSTAIN = 50%
RELEASE = 4.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -77%
LFO 1 > POS 2 = 50%
ENV 2 > POS 1 = 7.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.9%

FAIRWAVE PATCH 1
NAME  = MINILOGUE DUKEY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue Dukey by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F0/B1A7A4DE.WAV
READ = CLEAN
TUNE = 0
POS = 25.8%

[OSC 2]
TABLE = MODWAVE/T/E1/2458DFCF.WAV
READ = CLEAN
TUNE = 0
FINE = 7
POS = 25.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.544 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 48.5%
ENV 2 > POS 2 = 48.5%
CV 1 > POS 1 = -43%
CV 1 > POS 2 = -43%
LFO 1 > POS 1 = 13.5%
LFO 1 > POS 2 = 13.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.2%

FAIRWAVE PATCH 1
NAME  = SLICED PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sliced Pad by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AE/054EFA60.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/B9/CA89ECAA.WAV
READ = CLEAN
TUNE = -12
FINE = 8
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = SQUARE
PHASE = 2
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 32.5%
LFO 1 > POS 2 = 32.5%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

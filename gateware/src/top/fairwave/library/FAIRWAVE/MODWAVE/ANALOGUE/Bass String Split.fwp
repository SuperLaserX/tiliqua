FAIRWAVE PATCH 1
NAME  = BASS STRING SPLI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bass String Split by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, layer B oscillator 1, layer B oscillator 2, the sub oscillator.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F2/474482DE.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 20.0%

[OSC 2]
TABLE = MODWAVE/T/C8/0D2854C3.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 20.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 940.000 MS
SUSTAIN = 38%
RELEASE = 306.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 553.333 MS
DECAY = 626.667 MS
SUSTAIN = 100%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
CV 2 > POS 1 = 22%
CV 2 > POS 2 = 22%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

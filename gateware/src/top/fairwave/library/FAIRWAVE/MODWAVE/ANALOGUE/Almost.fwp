FAIRWAVE PATCH 1
NAME  = ALMOST
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Almost by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B6/83160874.WAV
READ = CLEAN
TUNE = -12
POS = 30.4%

[OSC 2]
TABLE = MODWAVE/T/7C/3B33BE79.WAV
READ = CLEAN
TUNE = 0
POS = 30.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 6.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.333 S
SUSTAIN = 50%
RELEASE = 46.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -50.5%
CV 1 > POS 2 = -50.5%
ENV 2 > POS 1 = 39%
ENV 2 > POS 2 = 39%
LFO 1 > POS 1 = 5.5%
LFO 1 > POS 2 = 5.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.3%

FAIRWAVE PATCH 1
NAME  = HP CELESTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's HP Celeste by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/42/8F7CC468.WAV
READ = CLEAN
TUNE = -12
POS = 22.9%

[OSC 2]
TABLE = MODWAVE/T/42/8F7CC468.WAV
TUNE = -12
POS = 22.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 2.667 MS
SUSTAIN = 0%
RELEASE = 112.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 54.5%
CV 1 > POS 1 = -38%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = MINILOGUE CLASSI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue Classic Lead by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/53/793F1437.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 15.0%

[OSC 2]
TABLE = MODWAVE/T/07/7ABE083F.WAV
READ = CLEAN
TUNE = 0
FINE = -6
POS = 15.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.693 S
DECAY = 586.667 MS
SUSTAIN = 75%
RELEASE = 17.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70%
ENV 2 > POS 2 = 70%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 64.0%

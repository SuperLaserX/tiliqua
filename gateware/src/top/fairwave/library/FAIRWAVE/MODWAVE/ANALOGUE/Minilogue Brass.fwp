FAIRWAVE PATCH 1
NAME  = MINILOGUE BRASS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue Brass by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/B2/C2417251.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 18.0%

[OSC 2]
TABLE = MODWAVE/T/F5/D6BCB06F.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 18.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 42.259 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 64.160 S
SUSTAIN = 16%
RELEASE = 6.184 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 64%
ENV 2 > POS 2 = 64%
CV 1 > POS 1 = -30%
CV 1 > POS 2 = -30%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

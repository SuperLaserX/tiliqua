FAIRWAVE PATCH 1
NAME  = OCT BASS AND DRU
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Oct Bass and drums by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, the sample Drm_Guru: Kick Trance.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/0B/A9E3D998.WAV
READ = CLEAN
TUNE = -24
POS = 15.9%

[OSC 2]
TABLE = MODWAVE/T/29/72AD01FA.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 520.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
CV 1 > POS 1 = -26.5%
LFO 1 > POS 1 = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.3%

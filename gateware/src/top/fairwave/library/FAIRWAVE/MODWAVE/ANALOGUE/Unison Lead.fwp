FAIRWAVE PATCH 1
NAME  = UNISON LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Unison Lead by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 8 unison voices, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Belleville Hit, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/81/E81DF937.WAV
READ = CLEAN
TUNE = -24
POS = 49.2%

[OSC 2]
TABLE = MODWAVE/T/93/653FA781.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 47.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 33.5%
LFO 1 > POS 2 = 24%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

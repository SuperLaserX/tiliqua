FAIRWAVE PATCH 1
NAME  = SEARCHING FOR HU
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Searching for humans by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BB/5A57176F.WAV
READ = CLEAN
TUNE = -12
FINE = -10
POS = 17.0%

[OSC 2]
TABLE = MODWAVE/T/B8/E4525E7A.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 17.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 17.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.400 S
DECAY = 14.000 S
SUSTAIN = 50%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66%
ENV 2 > POS 2 = 66%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

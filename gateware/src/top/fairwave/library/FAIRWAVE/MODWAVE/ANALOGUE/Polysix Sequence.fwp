FAIRWAVE PATCH 1
NAME  = POLYSIX SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Polysix Sequence by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/6D/75EA5009.WAV
READ = CLEAN
TUNE = -24
POS = 17.2%

[OSC 2]
TABLE = MODWAVE/T/27/DE71C386.WAV
READ = CLEAN
TUNE = 12
POS = 17.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 140.000 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 97.333 MS
SUSTAIN = 22%
RELEASE = 2.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65.5%
ENV 2 > POS 2 = 65.5%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.0%

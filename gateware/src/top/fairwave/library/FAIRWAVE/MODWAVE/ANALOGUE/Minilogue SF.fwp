FAIRWAVE PATCH 1
NAME  = MINILOGUE SF
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue SF by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2F/32DE5FB5.WAV
READ = CLEAN
TUNE = 0
POS = 20.6%

[OSC 2]
TABLE = MODWAVE/T/AA/86A255D1.WAV
READ = CLEAN
TUNE = 0
FINE = -16
POS = 20.6%

[ENV 1]
GATE = GATE 1
ATTACK = 49.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 353.333 MS
DECAY = 940.000 MS
SUSTAIN = 12%
RELEASE = 800.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59%
ENV 2 > POS 2 = 59%
CV 1 > POS 1 = -34.5%
CV 1 > POS 2 = -34.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.9%

FAIRWAVE PATCH 1
NAME  = SEARCHING AND SC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Searching and scanning by Ian Dixon: ID-Analogue.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/17/7FFAB13B.WAV
READ = CLEAN
TUNE = -12
FINE = -10
POS = 17.1%

[OSC 2]
TABLE = MODWAVE/T/10/8E020F41.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 17.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 17.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.400 S
DECAY = 14.000 S
SUSTAIN = 50%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65.5%
ENV 2 > POS 2 = 65.5%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

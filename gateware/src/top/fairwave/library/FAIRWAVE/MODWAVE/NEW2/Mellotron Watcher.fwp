FAIRWAVE PATCH 1
NAME  = MELLOTRON WATCHE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mellotron Watcher by Ian Dixon: Mellotron Watcher.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Tape 3 Violins-Chmb.
# Oscillator 2 is A's 2, the sample Brs: Tape Brass.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/EB/213D44AC.WAV
READ = SAMPLE
TUNE = -27
FINE = -23
POS = 0.0%
EDGE = WRAP
LOOP = 35.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/11/55D15AB3.WAV
READ = SAMPLE
TUNE = -26
FINE = -33
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

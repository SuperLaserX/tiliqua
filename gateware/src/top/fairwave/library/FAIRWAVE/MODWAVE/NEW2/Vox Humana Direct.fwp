FAIRWAVE PATCH 1
NAME  = VOX HUMANA DIREC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Vox Humana Direct by Ian Dixon: Vox Humana Direct.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, its wavetable.
# Oscillator 2 is B's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BE/9D097ED3.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/83/E2BC21DB.WAV
READ = CLEAN
TUNE = -12
POS = 31.4%

[ENV 1]
GATE = GATE 1
ATTACK = 98.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.609 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 1.960 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 4.181 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 6.454 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 22.5%
LFO 2 > PITCH 1 = 0.5%
LFO 3 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.2%

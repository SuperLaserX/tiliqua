FAIRWAVE PATCH 1
NAME  = THEVON - DUB BAS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Thevon - Dub Bass by Korg: Thevon - Dub Bass.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is the other half of its 3 unison voices.
# Not carried over: performance modulators, the mod wheel's scaling of a modulation.
[OSC 1]
TABLE = MODWAVE/T/2F/C0602EE9.WAV
READ = CLEAN
TUNE = -24
FINE = -15
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/2F/C0602EE9.WAV
READ = CLEAN
TUNE = -24
FINE = 15
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 386.667 MS
SUSTAIN = 79%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.733 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

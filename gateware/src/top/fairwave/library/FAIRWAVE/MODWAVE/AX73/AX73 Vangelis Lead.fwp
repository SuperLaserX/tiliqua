FAIRWAVE PATCH 1
NAME  = AX73 VANGELIS LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Vangelis Lead by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Piano.
# Oscillator 2 is A's 2, the sample Akai AX73 Piano.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/6C/CF5B8925.WAV
READ = SAMPLE
TUNE = -19
FINE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 78.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4A/023E352C.WAV
READ = SAMPLE
TUNE = -31
FINE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 78.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 52.133 S
SUSTAIN = 0%
RELEASE = 666.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.6%

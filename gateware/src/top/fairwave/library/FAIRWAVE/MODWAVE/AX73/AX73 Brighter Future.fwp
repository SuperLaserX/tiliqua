FAIRWAVE PATCH 1
NAME  = AX73 BRIGHTER FU
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Brighter Future by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Phaser.
# Oscillator 2 is A's 2, the sample Akai AX73 Passive.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/75/A95F9023.WAV
READ = SAMPLE
TUNE = -19
FINE = -10
POS = 0.0%
EDGE = WRAP
LOOP = 78.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7C/1F7B30ED.WAV
READ = SAMPLE
TUNE = -19
FINE = -23
POS = 0.0%
EDGE = WRAP
LOOP = 29.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 39.2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 63.5%

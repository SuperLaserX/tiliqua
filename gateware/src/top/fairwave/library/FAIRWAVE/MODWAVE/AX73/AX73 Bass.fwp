FAIRWAVE PATCH 1
NAME  = AX73 BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Bass by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C2 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Bass.
# Oscillator 2 is A's 2, the sample Akai AX73 Bass.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/77/F5465185.WAV
READ = SAMPLE
TUNE = -19
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 33.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A0/506DF218.WAV
READ = SAMPLE
TUNE = -31
FINE = -26
POS = 0.0%
EDGE = WRAP
LOOP = 33.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 920.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 49.3%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 6%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = AX73 PIANO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Piano by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Piano.
# Oscillator 2 is A's 2, the sample Akai AX73 Piano.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/8A/0AD83ED0.WAV
READ = SAMPLE
TUNE = -19
FINE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 78.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D8/5777778F.WAV
READ = SAMPLE
TUNE = -19
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 78.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 52.133 S
SUSTAIN = 0%
RELEASE = 666.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 39.2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = AX73 LOW ORCH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Low Orch by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Orch 3.
# Oscillator 2 is A's 2, the sample Akai AX73 Orch 2.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E8/0E9A9B53.WAV
READ = SAMPLE
TUNE = -31
FINE = -8
POS = 0.0%
EDGE = WRAP
LOOP = 13.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AE/254DDA9F.WAV
READ = SAMPLE
TUNE = -43
FINE = -29
POS = 0.0%
EDGE = WRAP
LOOP = 13.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 200.000 MS
DECAY = 3.533 S
SUSTAIN = 83%
RELEASE = 273.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

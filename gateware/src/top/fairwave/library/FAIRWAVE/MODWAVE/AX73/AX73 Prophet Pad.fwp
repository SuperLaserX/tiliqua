FAIRWAVE PATCH 1
NAME  = AX73 PROPHET PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Prophet Pad by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Prophet.
# Oscillator 2 is A's 2, the sample AX73 Syn Flute.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/F2/40CECFED.WAV
READ = SAMPLE
TUNE = -7
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 74.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/81/E5865BC8.WAV
READ = SAMPLE
TUNE = -7
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 32.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 920.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.5%

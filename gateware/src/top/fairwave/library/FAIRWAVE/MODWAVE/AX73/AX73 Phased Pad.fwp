FAIRWAVE PATCH 1
NAME  = AX73 PHASED PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Phased Pad by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Lazer.
# Oscillator 2 is A's 2, the sample Akai AX73 Lazer.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/1F/E22A5C84.WAV
READ = SAMPLE
TUNE = 5
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 46.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AC/EC4D4DB3.WAV
READ = SAMPLE
TUNE = 5
FINE = -21
POS = 0.0%
EDGE = WRAP
LOOP = 46.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 126.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 39.2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.1%

FAIRWAVE PATCH 1
NAME  = AK73 ELEC WAVETA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AK73 Elec Wavetable by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is the other half of its 3 unison voices.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/21/A9670212.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/21/A9670212.WAV
READ = CLEAN
TUNE = -12
FINE = 6
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 613.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.273 S
DECAY = 25.873 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 39.5%
ENV 2 > POS 2 = 39.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = AX73 BRIGHT PLUC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Bright Pluck by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akia AX73 2nd Synth.
# Oscillator 2 is A's 2, the sample Akia AX73 2nd Synth.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/B0/1689FF63.WAV
READ = SAMPLE
TUNE = -7
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 83.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/38/9B29A9A0.WAV
READ = SAMPLE
TUNE = -7
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 83.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.133 S
SUSTAIN = 0%
RELEASE = 2.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

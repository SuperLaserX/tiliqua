FAIRWAVE PATCH 1
NAME  = AX73 GUITAR LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Guitar Lead by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Prophet.
# Oscillator 2 is A's 2, the sample Akai AX73 Prophet.
# Its effects, which FairWave hasn't got: Stereo Chorus, UK 80's T75, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/A0/D1C2FABB.WAV
READ = SAMPLE
TUNE = -7
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 74.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C0/B1C8D5B3.WAV
READ = SAMPLE
TUNE = -7
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 74.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 51.333 S
SUSTAIN = 0%
RELEASE = 68.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 39.2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

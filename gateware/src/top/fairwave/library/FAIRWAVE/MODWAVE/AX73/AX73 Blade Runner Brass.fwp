FAIRWAVE PATCH 1
NAME  = AX73 BLADE RUNNE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Blade Runner Brass by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Akai AX73 Horns.
# Oscillator 2 is A's 2, the sample Akai AX73 Horns.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/94/50FC1AAD.WAV
READ = SAMPLE
TUNE = -19
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 34.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/85/7BF1014E.WAV
READ = SAMPLE
TUNE = -7
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 34.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.267 S
DECAY = 3.533 S
SUSTAIN = 100%
RELEASE = 926.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

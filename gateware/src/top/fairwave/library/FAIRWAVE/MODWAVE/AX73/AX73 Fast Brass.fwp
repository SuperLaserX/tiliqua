FAIRWAVE PATCH 1
NAME  = AX73 FAST BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AX73 Fast Brass by Ian Dixon: ID-AX73.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Akai AX73 Horns.
# Oscillator 2 is B's 2, the sample Akai AX73 Horns.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Stereo Delay, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/31/09DFD350.WAV
READ = SAMPLE
TUNE = -19
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 34.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/69/90DE3FEA.WAV
READ = SAMPLE
TUNE = -7
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 34.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.533 S
SUSTAIN = 100%
RELEASE = 61.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.7%

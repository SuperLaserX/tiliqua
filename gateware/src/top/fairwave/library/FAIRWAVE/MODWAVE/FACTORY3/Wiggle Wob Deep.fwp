FAIRWAVE PATCH 1
NAME  = WIGGLE WOB DEEP
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wiggle Wob Deep by Richard Devine: backup1.mwbackup.
# 0 V plays what its C2 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Alligatorz, Drum Squasher.
[OSC 1]
TABLE = MODWAVE/T/B7/0A6306B2.WAV
READ = CLEAN
TUNE = -24
FINE = -18
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/B7/0A6306B2.WAV
READ = CLEAN
TUNE = -24
FINE = -2
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 60.967 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 73.333 MS
SUSTAIN = 0%
RELEASE = 10.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 75%
ENV 2 > POS 2 = 75%
LFO 2 > LEVEL 1 = 45%
LFO 1 > POS 1 = 31.5%
LFO 1 > POS 2 = 31.5%
CV 1 > POS 1 = -31%
CV 1 > POS 2 = -31%
CV 2 > POS 1 = 29%
CV 2 > POS 2 = 29%
LFO 3 > LEVEL 1 = 1%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

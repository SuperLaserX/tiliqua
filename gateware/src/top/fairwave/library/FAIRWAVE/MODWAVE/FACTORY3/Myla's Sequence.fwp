FAIRWAVE PATCH 1
NAME  = MYLA'S SEQUENCE
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Myla's Sequence by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Not carried over: 2 unison voices, the noise generator.
# Its effects, which FairWave hasn't got: Myla's Sequence, Soft Orchestral, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B6/1361183E.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/3E/1ABC9476.WAV
READ = SAMPLE
TUNE = -12
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.737 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 997.333 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 74.5%
CV 1 > POS 1 = -21%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.9%

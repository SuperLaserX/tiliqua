FAIRWAVE PATCH 1
NAME  = OORT CLOUD
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Oort Cloud by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6D/6175DC61.WAV
READ = CLEAN
TUNE = 0
POS = 21.1%

[OSC 2]
TABLE = MODWAVE/T/D2/255330FA.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 21.1%

[ENV 1]
GATE = GATE 1
ATTACK = 693.333 MS
DECAY = 18.747 S
SUSTAIN = 0%
RELEASE = 200.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 16.504 S
SUSTAIN = 0%
RELEASE = 896.000 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[LFO 3]
RATE = 3.541 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58%
ENV 2 > POS 2 = 58%
CV 1 > POS 1 = -35%
CV 1 > POS 2 = -35%
ENV 2 > PITCH 2 = -0.5%
LFO 3 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.5%

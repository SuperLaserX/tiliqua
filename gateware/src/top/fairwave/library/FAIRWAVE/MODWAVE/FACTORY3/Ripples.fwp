FAIRWAVE PATCH 1
NAME  = RIPPLES
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ripples by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Ripples.
[OSC 1]
TABLE = MODWAVE/T/15/F0711064.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/F8/1D1D9534.WAV
READ = CLEAN
TUNE = -7
FINE = 2
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.460 S
DECAY = 10.652 S
SUSTAIN = 41%
RELEASE = 3.825 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 92.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.125 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 0.784 HZ
SHAPE = SQUARE
PHASE = 358
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 198.5%
CV 2 > POS 2 = -174%
CV 1 > POS 2 = -82.5%
LFO 1 > POS 1 = 40%
CV 2 > POS 1 = -35%
ENV 2 > POS 2 = 22%
CV 1 > POS 1 = -16.5%
ENV 2 > POS 1 = 4.5%
LFO 2 > POS 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.5%

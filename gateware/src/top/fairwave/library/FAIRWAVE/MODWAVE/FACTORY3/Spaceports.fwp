FAIRWAVE PATCH 1
NAME  = SPACEPORTS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Spaceports by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Ooh.
# Oscillator 2 is A's 2, the sample Vox: Choir.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Sine2Pad I, Spaceports.
[OSC 1]
TABLE = MODWAVE/T/C3/0BBD2C0E.WAV
READ = SAMPLE
TUNE = -30
FINE = 23
POS = 0.0%
EDGE = WRAP
LOOP = 32%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F9/3D7C0A5E.WAV
READ = SAMPLE
TUNE = -15
FINE = -35
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 76.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 382.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.5%

FAIRWAVE PATCH 1
NAME  = STRINGMACH CELLO
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stringmach Cellos by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Desert Walking, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/39/F28EC77B.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 40.7%

[OSC 2]
TABLE = MODWAVE/T/12/3C0D788A.WAV
READ = CLEAN
TUNE = -12
FINE = -10
POS = 40.7%

[ENV 1]
GATE = GATE 1
ATTACK = 196.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 328.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -68%
CV 1 > POS 2 = -68%
ENV 2 > POS 1 = 18.5%
ENV 2 > POS 2 = 18.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

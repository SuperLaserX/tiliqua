FAIRWAVE PATCH 1
NAME  = DAMAGED GLASS
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Damaged Glass by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample FX: Verre Casse.
# Not carried over: controllers, random and Kaoss Physics, the noise generator.
# Its effects, which FairWave hasn't got: Damaged Glass, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/29/98CA02E3.WAV
READ = CLEAN
TUNE = 24
POS = 27.6%

[OSC 2]
TABLE = MODWAVE/T/6E/E87C1593.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.471 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 40.561 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = -176%
CV 2 > X DEPTH = 100%
CV 1 > POS 1 = -46%
ENV 2 > POS 1 = 45%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

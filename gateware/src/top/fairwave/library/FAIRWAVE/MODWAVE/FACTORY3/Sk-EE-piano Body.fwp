FAIRWAVE PATCH 1
NAME  = SK-EE-PIANO BODY
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Sk-EE-piano Body by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Fast Chorus.
[OSC 1]
TABLE = MODWAVE/T/87/093FD8BB.WAV
READ = CLEAN
TUNE = -12
POS = 29.0%

[OSC 2]
TABLE = MODWAVE/T/87/093FD8BB.WAV
TUNE = -12
POS = 29.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.193 S
SUSTAIN = 59%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.184 S
SUSTAIN = 26%
RELEASE = 124.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 4.550 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -48.5%
ENV 2 > POS 1 = 42%
LFO 1 > POS 1 = 17%
CV 2 > POS 1 = 12%
LFO 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = ROBO MUTTERING
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Robo Muttering by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Vox: Choir Whisper M.
# Not carried over: 5 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Easy Comp, Easy Go.
[OSC 1]
TABLE = MODWAVE/T/51/6F8F8856.WAV
READ = CLEAN
TUNE = -12
POS = 23.4%

[OSC 2]
TABLE = MODWAVE/T/6F/2BFF74EE.WAV
READ = SAMPLE
TUNE = -30
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 25%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 297.333 MS
DECAY = 874.667 MS
SUSTAIN = 71%
RELEASE = 2.861 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 79.1%

[LFO 1]
RATE = 0.010 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.046 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
CV 2 > LEVEL 2 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 53.5%
CV 1 > POS 1 = -39%
LFO 2 > LEVEL 2 = -32%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

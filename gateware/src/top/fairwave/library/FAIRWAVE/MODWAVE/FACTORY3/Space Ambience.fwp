FAIRWAVE PATCH 1
NAME  = SPACE AMBIENCE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Space Ambience by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 7 unison voices, the noise generator.
# Its effects, which FairWave hasn't got: Mix Pop.
[OSC 1]
TABLE = MODWAVE/T/31/1026C93C.WAV
READ = CLEAN
TUNE = -12
POS = 91.1%

[OSC 2]
TABLE = MODWAVE/T/AD/498F5F3C.WAV
READ = CLEAN
TUNE = -7
POS = 20.6%

[ENV 1]
GATE = GATE 1
ATTACK = 900.000 MS
DECAY = 1.073 S
SUSTAIN = 100%
RELEASE = 2.776 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.063 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.072 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = -100%
ENV 2 > POS 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 2 > LEVEL 2 = -84%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.3%

FAIRWAVE PATCH 1
NAME  = SPECKLES PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Speckles Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, the mod wheel's scaling of a modulation.
[OSC 1]
TABLE = MODWAVE/T/EF/813CA6F6.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/09/A4088BB8.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 644.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.539 S
A CURVE = 30
D CURVE = 60
R CURVE = 80
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 21.400 S
SUSTAIN = 0%
RELEASE = 734.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.072 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.230 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
LFO 2 > POS 1 = 49%
CV 1 > POS 2 = -45.5%
LFO 1 > POS 2 = 22.5%
ENV 2 > POS 2 = 13.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.4%

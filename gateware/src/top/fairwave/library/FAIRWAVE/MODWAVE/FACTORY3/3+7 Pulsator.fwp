FAIRWAVE PATCH 1
NAME  = 3+7 PULSATOR
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's 3+7 Pulsator by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, an LFO past the three here, performance modulators.
# Its effects, which FairWave hasn't got: 3+7 Pulsator, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/D6/ED885577.WAV
READ = CLEAN
TUNE = 3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/F1/2D1EF277.WAV
READ = CLEAN
TUNE = 10
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
PHASE = 270
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SAW DN
PHASE = 90
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.4%

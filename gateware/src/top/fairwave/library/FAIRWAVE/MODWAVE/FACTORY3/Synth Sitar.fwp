FAIRWAVE PATCH 1
NAME  = SYNTH SITAR
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Synth Sitar by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, modulation processors, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse.
[OSC 1]
TABLE = MODWAVE/T/B4/64B6B14E.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1E/5A587B36.WAV
READ = CLEAN
TUNE = -36
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 969.333 MS
SUSTAIN = 0%
RELEASE = 2.507 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 152.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.3%

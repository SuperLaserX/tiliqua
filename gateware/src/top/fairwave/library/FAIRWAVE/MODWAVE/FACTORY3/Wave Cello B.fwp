FAIRWAVE PATCH 1
NAME  = WAVE CELLO B
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wave Cello B by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Whisper F.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/81/E209F79D.WAV
READ = SAMPLE
TUNE = -39
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 19.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BF/39404EAA.WAV
READ = CLEAN
TUNE = -12
POS = 35.2%

[ENV 1]
GATE = GATE 1
ATTACK = 1.183 S
DECAY = 34.028 S
SUSTAIN = 16%
RELEASE = 4.377 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.886 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.326 HZ
SHAPE = TRI
PHASE = 92
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 2 = -1.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 73.6%

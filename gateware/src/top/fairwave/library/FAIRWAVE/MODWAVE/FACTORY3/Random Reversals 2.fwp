FAIRWAVE PATCH 1
NAME  = RANDOM REVERSALS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Random Reversals by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/8F/F105767B.WAV
READ = CLEAN
TUNE = 12
POS = 36.4%

[OSC 2]
TABLE = MODWAVE/T/8F/F105767B.WAV
TUNE = 12
POS = 36.4%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 54.667 MS
DECAY = 10.173 S
SUSTAIN = 64%
RELEASE = 1.747 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 773.333 MS
DECAY = 29.333 MS
SUSTAIN = 0%
RELEASE = 9.956 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > LEVEL 1 = 69%
CV 1 > POS 1 = -60.5%
ENV 2 > POS 1 = 27.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

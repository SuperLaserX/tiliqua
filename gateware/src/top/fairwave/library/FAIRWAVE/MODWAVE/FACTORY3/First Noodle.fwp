FAIRWAVE PATCH 1
NAME  = FIRST NOODLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's First Noodle by Korg: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Wnd_WS: Wood Flute.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: Ambient Reverse, Smooth Tremolo, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0E/F0DBE289.WAV
READ = CLEAN
TUNE = -12
POS = 35.2%

[OSC 2]
TABLE = MODWAVE/T/B0/F5816D6C.WAV
READ = SAMPLE
TUNE = -35
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 46.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 55.3%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.1%

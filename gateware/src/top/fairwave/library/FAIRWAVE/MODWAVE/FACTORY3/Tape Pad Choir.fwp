FAIRWAVE PATCH 1
NAME  = TAPE PAD CHOIR
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tape Pad Choir by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, the sample Vox: Choir Ahh.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Soft Orchestral, Stereo Chorus, Tape Pad Choir.
[OSC 1]
TABLE = MODWAVE/T/F8/0C5480C0.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/E7/E089D9FA.WAV
READ = SAMPLE
TUNE = -30
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 32.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 340.000 MS
DECAY = 496.000 MS
SUSTAIN = 100%
RELEASE = 924.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 49.4%

[LFO 1]
RATE = 0.046 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > X DEPTH = -13%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 70.3%

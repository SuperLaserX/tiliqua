FAIRWAVE PATCH 1
NAME  = SUBSTRATA PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Substrata Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Pianotable.
[OSC 1]
TABLE = MODWAVE/T/53/C702B520.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/EA/C40A2BC5.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.055 S
DECAY = 3.812 S
SUSTAIN = 66%
RELEASE = 168.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
CV 1 > POS 2 = -44.5%
LFO 1 > POS 2 = 23.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 85.9%

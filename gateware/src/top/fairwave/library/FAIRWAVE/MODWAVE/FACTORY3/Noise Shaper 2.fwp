FAIRWAVE PATCH 1
NAME  = NOISE SHAPER
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Noise Shaper by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Noise Shaper, Polysix Ensemble, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/A3/40BB9B89.WAV
READ = CLEAN
TUNE = -12
POS = 33.5%

[OSC 2]
TABLE = MODWAVE/T/B2/6524ED0F.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 64.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.799 S
DECAY = 2.416 S
SUSTAIN = 0%
RELEASE = 534.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -56%
CV 2 > POS 1 = 33%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.2%

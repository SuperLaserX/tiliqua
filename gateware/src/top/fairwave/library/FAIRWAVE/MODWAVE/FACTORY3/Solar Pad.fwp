FAIRWAVE PATCH 1
NAME  = SOLAR PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Solar Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, the sample Syn_WS: PsychoWave.
# Not carried over: 3 unison voices, an LFO past the three here, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF.
[OSC 1]
TABLE = MODWAVE/T/13/518A7278.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/66/A8982994.WAV
READ = SAMPLE
TUNE = -16
FINE = 31
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 789.333 MS
DECAY = 10.037 S
SUSTAIN = 58%
RELEASE = 4.084 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 49.9%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 918.667 MS
SUSTAIN = 0%
RELEASE = 569.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 1.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
LFO 2 > X DEPTH = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 9.0%

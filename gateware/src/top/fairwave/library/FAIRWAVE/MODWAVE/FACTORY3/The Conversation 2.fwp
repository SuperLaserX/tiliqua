FAIRWAVE PATCH 1
NAME  = THE CONVERSATION
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's The Conversation by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Slow Phaser.
[OSC 1]
TABLE = MODWAVE/T/25/7D17F45B.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/41/2FA687D2.WAV
READ = CLEAN
TUNE = 10
FINE = 32
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 809.333 MS
DECAY = 31.273 S
SUSTAIN = 15%
RELEASE = 966.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 23.703 S
DECAY = 0.000 MS
SUSTAIN = 100%
RELEASE = 2.107 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.267 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 5.609 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 1 > POS 2 = -64.5%
LFO 1 > POS 1 = 50%
ENV 2 > PITCH 2 = 11.5%
LFO 2 > POS 2 = 11.5%
LFO 1 > PITCH 2 = -1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

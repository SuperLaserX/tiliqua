FAIRWAVE PATCH 1
NAME  = CLOCK BEEP
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Clock Beep by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Cym_Guru: Hat 8008 Hybrd.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: 16 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/94/8467943F.WAV
READ = CLEAN
TUNE = -12
POS = 58.8%

[OSC 2]
TABLE = MODWAVE/T/A3/9BD868C5.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.9%

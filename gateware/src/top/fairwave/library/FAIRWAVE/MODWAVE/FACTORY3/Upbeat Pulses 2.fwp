FAIRWAVE PATCH 1
NAME  = UPBEAT PULSES
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Upbeat Pulses by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, PEQ Mid, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/8D/6463538A.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/6C/76A9ECF9.WAV
READ = CLEAN
TUNE = 19
POS = 25.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 13.180 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 0%
RELEASE = 2.484 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
PHASE = 22
SYNC = GATE 1

[LFO 2]
RATE = 1.000 HZ
SHAPE = SQUARE
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
ENV 2 > POS 2 = 48.5%
CV 1 > POS 2 = -43%
LFO 1 > POS 2 = 40.5%
LFO 2 > LEVEL 2 = 33%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

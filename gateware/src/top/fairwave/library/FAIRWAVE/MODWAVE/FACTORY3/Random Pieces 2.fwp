FAIRWAVE PATCH 1
NAME  = RANDOM PIECES
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Random Pieces by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Detuned Super 2.
# Not carried over: 2 unison voices, an LFO past the three here, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A7/1BD51442.WAV
READ = CLEAN
TUNE = 0
POS = 33.3%

[OSC 2]
TABLE = MODWAVE/T/C0/6D6100B7.WAV
READ = SAMPLE
TUNE = -3
FINE = -21
POS = 0.0%
EDGE = WRAP
LOOP = 0.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 54.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 448.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 773.333 MS
DECAY = 29.333 MS
SUSTAIN = 0%
RELEASE = 16.051 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 1.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 98%
ENV 2 > LEVEL 1 = 69%
CV 1 > POS 1 = 55.5%
CV 2 > POS 1 = 33.5%
LFO 1 > PITCH 1 = 10%
LFO 1 > PITCH 2 = 10%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

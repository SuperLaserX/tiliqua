FAIRWAVE PATCH 1
NAME  = STAR DUST
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Star Dust by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/DC/E769861F.WAV
READ = CLEAN
TUNE = 0
POS = 37.2%

[OSC 2]
TABLE = MODWAVE/T/2D/188CA402.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 617.333 MS
DECAY = 5.791 S
SUSTAIN = 63%
RELEASE = 1.305 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 150.667 MS
DECAY = 4.248 S
SUSTAIN = 49%
RELEASE = 972.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 0.750 HZ
SHAPE = RANDOM
PHASE = 359
SYNC = GATE 1

[LFO 3]
RATE = 16.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -62%
LFO 2 > POS 2 = 50%
LFO 3 > LEVEL 1 = 34%
LFO 3 > LEVEL 2 = 34%
ENV 2 > POS 1 = 25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.8%

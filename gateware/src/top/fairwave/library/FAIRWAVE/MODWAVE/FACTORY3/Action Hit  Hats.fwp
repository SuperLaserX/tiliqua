FAIRWAVE PATCH 1
NAME  = ACTION HIT & HAT
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Action Hit & Hats by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Hit: Parking Trailer.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the noise generator.
# Its effects, which FairWave hasn't got: Action Hit & Hats, Lost Satellite.
[OSC 1]
TABLE = MODWAVE/T/99/0DE54C61.WAV
READ = SAMPLE
TUNE = -48
FINE = 2
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CA/E73197A0.WAV
READ = CLEAN
TUNE = 24
POS = 29.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 184.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 169.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -48.5%
ENV 2 > POS 2 = 41.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

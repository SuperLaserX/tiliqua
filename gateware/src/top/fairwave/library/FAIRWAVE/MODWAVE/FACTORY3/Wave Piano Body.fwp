FAIRWAVE PATCH 1
NAME  = WAVE PIANO BODY
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Wave Piano Body by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/FA/A9059D64.WAV
READ = CLEAN
TUNE = -12
POS = 28.3%

[OSC 2]
TABLE = MODWAVE/T/8B/B9AC91D7.WAV
READ = CLEAN
TUNE = -12
POS = 28.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 6.000 S
SUSTAIN = 0%
RELEASE = 777.333 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 21.521 S
SUSTAIN = 0%
RELEASE = 3.371 S
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -47%
CV 1 > POS 2 = -47%
ENV 2 > POS 1 = 43.5%
ENV 2 > POS 2 = 43.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.5%

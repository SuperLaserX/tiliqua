FAIRWAVE PATCH 1
NAME  = SINGING AIR
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Singing Air by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Mercurial.
# Oscillator 2 is A's 2, the sample Syn: Airchime.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Electrik Kooltest, bpm Clear View.
[OSC 1]
TABLE = MODWAVE/T/A5/5DC83003.WAV
READ = SAMPLE
TUNE = -48
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BE/16C03BB6.WAV
READ = SAMPLE
TUNE = -48
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 10.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 8.289 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.363 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.5%

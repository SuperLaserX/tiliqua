FAIRWAVE PATCH 1
NAME  = CHEEZE WALL 5TH
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Cheeze Wall 5th by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Cheeze Wallace, Tape Chug Even.
[OSC 1]
TABLE = MODWAVE/T/E4/CB10575E.WAV
READ = CLEAN
TUNE = 19
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/41/934779E1.WAV
READ = CLEAN
TUNE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 713.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 672.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 69.5%

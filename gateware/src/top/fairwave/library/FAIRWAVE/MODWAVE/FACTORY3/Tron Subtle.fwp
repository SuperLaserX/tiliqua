FAIRWAVE PATCH 1
NAME  = TRON SUBTLE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tron Subtle by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
[OSC 1]
TABLE = MODWAVE/T/DD/F6CC9467.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/1A/39EB2954.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 50.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 100%
LFO 1 > POS 2 = 93%
LFO 2 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.9%

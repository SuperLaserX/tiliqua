FAIRWAVE PATCH 1
NAME  = TOK LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tok Lead by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Clean E.Guitar, Digi Motion S&H.
[OSC 1]
TABLE = MODWAVE/T/66/A7F4426A.WAV
READ = CLEAN
TUNE = 0
FINE = -4
POS = 34.5%

[OSC 2]
TABLE = MODWAVE/T/89/8F1E0825.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

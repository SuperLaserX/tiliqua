FAIRWAVE PATCH 1
NAME  = NATURE AMBIENCE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Nature Ambience by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, the sample Wave_WS: Min1-12a.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/2B/55756565.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/88/FE7D197D.WAV
READ = SAMPLE
TUNE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 890.667 MS
DECAY = 464.000 MS
SUSTAIN = 45%
RELEASE = 4.485 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 37.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.492 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.5%

FAIRWAVE PATCH 1
NAME  = SOURIS NOISE PUL
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Souris Noise Pulse by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the noise generator.
[OSC 1]
TABLE = MODWAVE/T/76/E2C6340D.WAV
READ = CLEAN
TUNE = -24
POS = 14.6%

[OSC 2]
TABLE = MODWAVE/T/76/E2C6340D.WAV
TUNE = -24
POS = 14.6%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 946.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 71%
CV 2 > POS 1 = 48.5%
CV 2 > LEVEL 1 = 27%
CV 1 > POS 1 = -24.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

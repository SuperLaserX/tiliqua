FAIRWAVE PATCH 1
NAME  = WAVE CELLO A
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wave Cello A by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/74/52E2BC57.WAV
READ = CLEAN
TUNE = -12
POS = 27.2%

[OSC 2]
TABLE = MODWAVE/T/ED/4A960BB8.WAV
READ = CLEAN
TUNE = 0
POS = 27.2%

[ENV 1]
GATE = GATE 1
ATTACK = 196.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.167 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.667 S
DECAY = 22.453 S
SUSTAIN = 0%
RELEASE = 2.080 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 3]
RATE = 5.084 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 45.5%
ENV 2 > POS 2 = 45.5%
CV 1 > POS 1 = -45.5%
CV 1 > POS 2 = -45.5%
CV 2 > POS 1 = 27%
CV 2 > POS 2 = 27%
LFO 3 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 21.8%

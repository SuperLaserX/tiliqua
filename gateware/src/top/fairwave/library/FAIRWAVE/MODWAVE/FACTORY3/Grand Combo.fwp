FAIRWAVE PATCH 1
NAME  = GRAND COMBO
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Grand Combo by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: Acoustic f.
# Oscillator 2 is A's 2, the sample Key: Electric Grand.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, Organic Pad, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F8/856F2530.WAV
READ = SAMPLE
TUNE = -32
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 77.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/21/28DACA06.WAV
READ = SAMPLE
TUNE = -15
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 60.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.449 S
SUSTAIN = 0%
RELEASE = 513.333 MS
A CURVE = 30
D CURVE = 80
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

FAIRWAVE PATCH 1
NAME  = LOW PRESSURE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Low Pressure by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Growth.
[OSC 1]
TABLE = MODWAVE/T/C9/DE2C1162.WAV
READ = CLEAN
TUNE = -23
FINE = -3
POS = 48.2%

[OSC 2]
TABLE = MODWAVE/T/25/02257886.WAV
READ = CLEAN
TUNE = -26
FINE = 5
POS = 60.8%

[ENV 1]
GATE = GATE 1
ATTACK = 2.295 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 73.4%

[LFO 1]
RATE = 0.369 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 0.312 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 52%
LFO 2 > LEVEL 1 = 35%
CV 2 > PITCH 1 = 8.5%
CV 2 > PITCH 2 = -8.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.3%

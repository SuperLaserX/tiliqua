FAIRWAVE PATCH 1
NAME  = N'IMPORTE NOISE
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's N'importe Noise by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Processed Dirt.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, N'importe Noise, Slow LFO Drone.
[OSC 1]
TABLE = MODWAVE/T/4F/0DA11A8A.WAV
READ = SAMPLE
TUNE = -25
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 38.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BA/A13DA3BA.WAV
READ = CLEAN
TUNE = 22
FINE = 3
POS = 78.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 74%
LFO 1 > LEVEL 2 = 74%
LFO 2 > PITCH 1 = 1%
LFO 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

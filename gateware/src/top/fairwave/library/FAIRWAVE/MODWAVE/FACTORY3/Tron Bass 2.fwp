FAIRWAVE PATCH 1
NAME  = TRON BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tron Bass by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 8 unison voices.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stream Sizzle, Tron Bass, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/90/4730189D.WAV
READ = CLEAN
TUNE = -24
FINE = -17
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/90/4730189D.WAV
READ = CLEAN
TUNE = -24
FINE = 17
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 3.976 S
SUSTAIN = 65%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 800.000 MS
SUSTAIN = 0%
RELEASE = 306.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 1 > POS 1 = 39%
LFO 1 > POS 2 = 39%
ENV 2 > PITCH 1 = 20%
CV 1 > POS 1 = -18%
CV 1 > POS 2 = -18%
LFO 3 > POS 1 = -6%
LFO 3 > POS 2 = -6%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

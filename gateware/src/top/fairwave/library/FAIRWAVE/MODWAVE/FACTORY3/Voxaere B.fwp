FAIRWAVE PATCH 1
NAME  = VOXAERE B
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Voxaere B by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Cricket Spectrum.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/50/75C6C9B2.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 38.7%

[OSC 2]
TABLE = MODWAVE/T/BC/DCF0FF9C.WAV
READ = SAMPLE
TUNE = -48
FINE = 39
POS = 0.0%
EDGE = WRAP
LOOP = 3.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.260 S
DECAY = 20.000 S
SUSTAIN = 0%
RELEASE = 3.999 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 50.8%

[ENV 2]
GATE = GATE 1
ATTACK = 3.832 S
DECAY = 7.675 S
SUSTAIN = 0%
RELEASE = 7.675 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.175 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -64.5%
ENV 2 > POS 1 = 22.5%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.4%

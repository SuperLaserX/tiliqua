FAIRWAVE PATCH 1
NAME  = REVWIRE PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's RevWire Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Str_Guru: Denali Cello.
# Not carried over: performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E1/571BB87B.WAV
READ = SAMPLE
TUNE = -30
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 44.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E1/571BB87B.WAV
TUNE = -30
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 169.333 MS
DECAY = 31.641 S
SUSTAIN = 35%
RELEASE = 1.676 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.254 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > LEVEL 1 = 67%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

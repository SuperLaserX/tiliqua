FAIRWAVE PATCH 1
NAME  = RAVE CHORDAL
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rave Chordal by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample FX: Rainstick.
# Oscillator 2 is A's 2, the sample Hit: Synth Loop 2.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: Bass Preserver, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/41/84E28124.WAV
READ = SAMPLE
TUNE = -45
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 40.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/80/3B00051B.WAV
READ = SAMPLE
TUNE = -19
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 58.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 256.000 MS
SUSTAIN = 57%
RELEASE = 821.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 50%
LFO 1 > LEVEL 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.2%

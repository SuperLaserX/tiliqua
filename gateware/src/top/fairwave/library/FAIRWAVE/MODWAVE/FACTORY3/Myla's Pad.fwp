FAIRWAVE PATCH 1
NAME  = MYLA'S PAD
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Myla's Pad by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str_Guru: Flutterscape.
# Oscillator 2 is A's 2, the sample Str: Glass Harp Buzzy.
# Not carried over: 2 unison voices, the sub oscillator.
# Its effects, which FairWave hasn't got: 138 Baby Bass, Myla's Pad.
[OSC 1]
TABLE = MODWAVE/T/E3/13BB0992.WAV
READ = SAMPLE
TUNE = -18
FINE = 26
POS = 0.0%
EDGE = WRAP
LOOP = 47.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FE/F0C49FD2.WAV
READ = SAMPLE
TUNE = -13
FINE = 42
POS = 0.0%
EDGE = WRAP
LOOP = 30.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.332 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.135 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 49.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 4.5%

FAIRWAVE PATCH 1
NAME  = STEP CHILL BASS
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Step Chill Bass by Airwave: backup1.mwbackup.
# 0 V plays what its F2 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: Step Chill Bass.
[OSC 1]
TABLE = MODWAVE/T/44/B4631AF0.WAV
READ = CLEAN
TUNE = -43
POS = 40.1%

[OSC 2]
TABLE = MODWAVE/T/E4/F9FB3313.WAV
READ = CLEAN
TUNE = -24
POS = 40.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 102.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 1 > POS 1 = -67%
CV 1 > POS 2 = -67%
ENV 2 > POS 1 = 20%
ENV 2 > POS 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

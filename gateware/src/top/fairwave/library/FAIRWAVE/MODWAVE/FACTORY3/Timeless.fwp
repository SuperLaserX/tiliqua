FAIRWAVE PATCH 1
NAME  = TIMELESS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Timeless by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Small Speaker, Timeless.
[OSC 1]
TABLE = MODWAVE/T/C5/70C41A20.WAV
READ = CLEAN
TUNE = 0
POS = 34.4%

[OSC 2]
TABLE = MODWAVE/T/FD/88E7674F.WAV
READ = CLEAN
TUNE = 24
POS = 34.4%

[ENV 1]
GATE = GATE 1
ATTACK = 530.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 50.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -57.5%
CV 1 > POS 2 = -57.5%
ENV 2 > POS 1 = 31%
ENV 2 > POS 2 = 31%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.9%

FAIRWAVE PATCH 1
NAME  = STEP CHILL PERC
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Step Chill Perc by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Pole.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Step Chill Perc.
[OSC 1]
TABLE = MODWAVE/T/42/8FA4FDD0.WAV
READ = CLEAN
TUNE = -15
POS = 24.5%

[OSC 2]
TABLE = MODWAVE/T/DD/F860A69F.WAV
READ = SAMPLE
TUNE = -48
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 37.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 95.8%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 100
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 51%
CV 1 > POS 1 = 41%
ENV 2 > PITCH 1 = 35%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = RAVE PAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rave Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 6 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Cabinets Machine, Rave Pad, Stream Sizzle.
[OSC 1]
TABLE = MODWAVE/T/EC/7CC61123.WAV
READ = CLEAN
TUNE = -36
FINE = -9
POS = 18.2%

[OSC 2]
TABLE = MODWAVE/T/03/1563FA12.WAV
READ = CLEAN
TUNE = -12
FINE = -9
POS = 18.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.156 S
SUSTAIN = 51%
RELEASE = 734.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 16.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 63.5%
CV 2 > POS 2 = 63.5%
CV 1 > POS 1 = 30.5%
CV 1 > POS 2 = 30.5%
LFO 3 > POS 1 = 8%
LFO 3 > POS 2 = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.0%

FAIRWAVE PATCH 1
NAME  = SUPER PHAT B
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Super Phat B by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AA/69D927B2.WAV
READ = CLEAN
TUNE = -12
FINE = -7
POS = 24.2%

[OSC 2]
TABLE = MODWAVE/T/AA/69D927B2.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 24.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.704 S
A CURVE = 10
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 6.667 MS
DECAY = 13.739 S
SUSTAIN = 0%
RELEASE = 1.957 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51.5%
ENV 2 > POS 2 = 51.5%
CV 1 > POS 1 = -40.5%
CV 1 > POS 2 = -40.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

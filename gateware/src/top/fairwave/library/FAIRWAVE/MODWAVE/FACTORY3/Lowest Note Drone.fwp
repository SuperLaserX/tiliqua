FAIRWAVE PATCH 1
NAME  = LOWEST NOTE DRON
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Lowest Note Drone by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation, the noise generator.
[OSC 1]
TABLE = MODWAVE/T/D7/78AE5A30.WAV
READ = CLEAN
TUNE = -24
POS = 21.9%

[OSC 2]
TABLE = MODWAVE/T/D7/78AE5A30.WAV
TUNE = -24
POS = 21.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.896 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.375 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.852 S
DECAY = 918.667 MS
SUSTAIN = 100%
RELEASE = 1.421 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 56%
CV 1 > POS 1 = -36.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = CLOCK TICK
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Clock Tick by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 16 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Reverse.
[OSC 1]
TABLE = MODWAVE/T/4D/FCD0C292.WAV
READ = CLEAN
TUNE = -5
POS = 44.6%

[OSC 2]
TABLE = MODWAVE/T/25/390590E7.WAV
READ = CLEAN
TUNE = 7
POS = 51.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.1%

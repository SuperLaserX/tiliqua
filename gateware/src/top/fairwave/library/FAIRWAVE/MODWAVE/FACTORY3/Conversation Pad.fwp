FAIRWAVE PATCH 1
NAME  = CONVERSATION PAD
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Conversation Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_Guru: BrassyVerby.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9A/879911AF.WAV
READ = SAMPLE
TUNE = -48
FINE = 1
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A4/F1F0B885.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.720 S
DECAY = 812.000 MS
SUSTAIN = 73%
RELEASE = 1.595 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 4.033 S
DECAY = 13.503 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 7.664 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 0.398 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -38%
LFO 1 > POS 2 = 27.5%
LFO 2 > POS 2 = 18%
ENV 2 > POS 2 = 14.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 14.6%

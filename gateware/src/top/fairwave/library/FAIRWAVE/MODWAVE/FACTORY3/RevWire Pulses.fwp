FAIRWAVE PATCH 1
NAME  = REVWIRE PULSES
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's RevWire Pulses by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/C4/03860681.WAV
READ = CLEAN
TUNE = 0
POS = 16.8%

[OSC 2]
TABLE = MODWAVE/T/6A/ABD4234D.WAV
READ = CLEAN
TUNE = 0
POS = 16.8%

[ENV 1]
GATE = GATE 1
ATTACK = 61.333 MS
DECAY = 25.000 S
SUSTAIN = 9%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 0
R CURVE = 100
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 36.517 S
SUSTAIN = 9%
RELEASE = 421.333 MS
A CURVE = 30
D CURVE = 10
R CURVE = 100

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 73%
LFO 1 > LEVEL 2 = 73%
ENV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 66.5%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
LFO 2 > POS 1 = 12%
LFO 2 > POS 2 = 12%
ENV 2 > PITCH 1 = -10%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.9%

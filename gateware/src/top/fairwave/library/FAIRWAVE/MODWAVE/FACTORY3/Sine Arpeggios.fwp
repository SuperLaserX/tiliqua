FAIRWAVE PATCH 1
NAME  = SINE ARPEGGIOS
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Sine Arpeggios by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Plk_WS: Harp 1a.
# Oscillator 2 is A's 2, the sample Plk_WS: Harp 1a.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Drum Squasher, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/5E/BAA33B2A.WAV
READ = SAMPLE
TUNE = -18
FINE = -37
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B3/887AB10A.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 773.333 MS
SUSTAIN = 2%
RELEASE = 4.943 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = -1%
LFO 1 > LEVEL 2 = -1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

FAIRWAVE PATCH 1
NAME  = SK-EE-PIANO TINE
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Sk-EE-piano Tines by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Atk: Granular Bell.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/74/BFEAE801.WAV
READ = SAMPLE
TUNE = -4
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/40/DF7AE866.WAV
READ = CLEAN
TUNE = 0
FINE = -5
POS = 38.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 7.075 S
SUSTAIN = 31%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.289 S
DECAY = 1.000 S
SUSTAIN = 100%
RELEASE = 26.669 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 63.5%
ENV 2 > POS 2 = 24%
ENV 2 > LEVEL 2 = 13%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

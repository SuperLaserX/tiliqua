FAIRWAVE PATCH 1
NAME  = POCKET LAYER
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Pocket Layer by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn_WS: MagicOrgan.
# Not carried over: controllers, random and Kaoss Physics, the sub oscillator.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, 16ths - 3,4,6, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/35/DF88DB11.WAV
READ = CLEAN
TUNE = -12
POS = 21.2%

[OSC 2]
TABLE = MODWAVE/T/87/8432AA90.WAV
READ = SAMPLE
TUNE = -22
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 26.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.468 S
SUSTAIN = 50%
RELEASE = 3.395 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.2%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.043 S
SUSTAIN = 0%
RELEASE = 2.876 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 100%
ENV 2 > POS 1 = 57.5%
CV 2 > POS 1 = 43%
CV 1 > POS 1 = -35.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

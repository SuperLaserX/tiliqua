FAIRWAVE PATCH 1
NAME  = POLY60 BUZZ
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Poly60 Buzz by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Poly60 Buzz, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/7F/2DF19DD6.WAV
READ = CLEAN
TUNE = -24
POS = 14.3%

[OSC 2]
TABLE = MODWAVE/T/6A/B1B6345A.WAV
READ = CLEAN
TUNE = -12
POS = 14.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 44.000 MS
SUSTAIN = 100%
RELEASE = 37.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 100.000 MS
SUSTAIN = 42%
RELEASE = 20.207 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 71.5%
CV 2 > POS 2 = 71.5%
ENV 2 > POS 1 = 28.5%
ENV 2 > POS 2 = 28.5%
CV 1 > POS 1 = -24%
CV 1 > POS 2 = -24%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.4%

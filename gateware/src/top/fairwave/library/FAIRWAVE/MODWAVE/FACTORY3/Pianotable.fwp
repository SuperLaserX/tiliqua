FAIRWAVE PATCH 1
NAME  = PIANOTABLE
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Pianotable by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, Organic Pad, Pianotable.
[OSC 1]
TABLE = MODWAVE/T/FF/F7C3C393.WAV
READ = CLEAN
TUNE = -24
POS = 25.0%

[OSC 2]
TABLE = MODWAVE/T/63/88C9AF82.WAV
READ = CLEAN
TUNE = -24
FINE = 19
POS = 25.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.972 S
SUSTAIN = 0%
RELEASE = 513.333 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.395 S
SUSTAIN = 50%
RELEASE = 1.580 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50%
ENV 2 > POS 2 = 50%
CV 1 > POS 1 = -41.5%
CV 1 > POS 2 = -41.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.4%

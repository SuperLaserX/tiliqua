FAIRWAVE PATCH 1
NAME  = WEIRD BELLS
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Weird Bells by AGeldert: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Biegerish Bass.
[OSC 1]
TABLE = MODWAVE/T/FD/DAA11ACF.WAV
READ = CLEAN
TUNE = 13
FINE = -29
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/C9/069B18CB.WAV
READ = CLEAN
TUNE = 2
FINE = 26
POS = 58.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 440.000 MS
SUSTAIN = 0%
RELEASE = 1.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 75.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 89.333 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 5.153 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 8.221 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
LFO 1 > X DEPTH = 35%
ENV 2 > PITCH 1 = -1.5%
ENV 2 > PITCH 2 = -1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.1%

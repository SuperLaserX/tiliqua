FAIRWAVE PATCH 1
NAME  = TRIPLE LEAD
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Triple Lead by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Drum Phase 2 A.
[OSC 1]
TABLE = MODWAVE/T/9A/C66DF60F.WAV
READ = CLEAN
TUNE = -36
FINE = 2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/D0/99C25F97.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 60.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.499 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 1.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 2 > LEVEL 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 50%
LFO 2 > POS 1 = 23%
LFO 2 > POS 2 = 23%
ENV 2 > POS 1 = 0.5%
ENV 2 > POS 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.2%

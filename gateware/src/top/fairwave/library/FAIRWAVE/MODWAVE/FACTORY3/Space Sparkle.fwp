FAIRWAVE PATCH 1
NAME  = SPACE SPARKLE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Space Sparkle by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn_WS: EtherBell.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Back & Forth.
[OSC 1]
TABLE = MODWAVE/T/E5/73F4995C.WAV
READ = CLEAN
TUNE = 0
POS = 36.2%

[OSC 2]
TABLE = MODWAVE/T/59/67CCEBE7.WAV
READ = SAMPLE
TUNE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 35.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.307 S
SUSTAIN = 9%
RELEASE = 4.560 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 653.333 MS
DECAY = 2.753 S
SUSTAIN = 13%
RELEASE = 4.177 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 1 > POS 1 = 60.5%
ENV 2 > POS 1 = 27.5%
LFO 2 > POS 1 = -11%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.9%

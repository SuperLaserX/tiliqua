FAIRWAVE PATCH 1
NAME  = NEVEREND BASS KN
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Neverend Bass Knb1 by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/B2/E068D923.WAV
READ = CLEAN
TUNE = -12
POS = 24.9%

[OSC 2]
TABLE = MODWAVE/T/B2/E068D923.WAV
TUNE = -12
POS = 24.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 70.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 317.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 50%
CV 1 > POS 1 = -41.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

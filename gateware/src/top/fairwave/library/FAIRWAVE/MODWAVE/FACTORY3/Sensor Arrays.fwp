FAIRWAVE PATCH 1
NAME  = SENSOR ARRAYS
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sensor Arrays by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 4 unison voices, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Pulsariffic, Sensor Arrays.
[OSC 1]
TABLE = MODWAVE/T/BC/273D6160.WAV
READ = CLEAN
TUNE = -36
FINE = -11
POS = 50.5%

[OSC 2]
TABLE = MODWAVE/T/D6/1CDBE0E5.WAV
READ = CLEAN
TUNE = -36
FINE = 12
POS = 50.2%

[ENV 1]
GATE = GATE 1
ATTACK = 394.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 344.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.068 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 50%
LFO 1 > POS 1 = 49%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = WINGDINGS SEQ
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wingdings Seq by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: VoiSyn1a.
# Oscillator 2 is A's 2, the sample Syn_WS: VoiSyn1a.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: Stereo Chorus, Wingdings Seq.
[OSC 1]
TABLE = MODWAVE/T/2E/1398265F.WAV
READ = SAMPLE
TUNE = -13
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/76/52F1849A.WAV
READ = SAMPLE
TUNE = -18
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 989.333 MS
DECAY = 322.667 MS
SUSTAIN = 57%
RELEASE = 2.409 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.6%

FAIRWAVE PATCH 1
NAME  = 808
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 808 by Korg: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: Easy Comp, Easy Go.
[OSC 1]
TABLE = MODWAVE/T/BB/A4139084.WAV
READ = CLEAN
TUNE = -12
POS = 21.9%

[OSC 2]
TABLE = MODWAVE/T/BB/A4139084.WAV
TUNE = -12
POS = 21.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 20.000 MS
DECAY = 620.000 MS
SUSTAIN = 0%
RELEASE = 1.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 56%
CV 1 > POS 1 = -36.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

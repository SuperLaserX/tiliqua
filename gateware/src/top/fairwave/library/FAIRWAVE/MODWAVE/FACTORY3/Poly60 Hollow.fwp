FAIRWAVE PATCH 1
NAME  = POLY60 HOLLOW
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Poly60 Hollow by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, OberKase.
[OSC 1]
TABLE = MODWAVE/T/3E/21CBC9DD.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/5D/5ED0EAC4.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 27.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 184.000 MS
SUSTAIN = 100%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 82.667 MS
SUSTAIN = 50%
RELEASE = 981.333 MS
A CURVE = 0
D CURVE = 50
R CURVE = 60

[LFO 1]
RATE = 0.693 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 1 > POS 2 = -45.5%
CV 2 > POS 2 = 45%
ENV 2 > POS 2 = 10%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 65.0%

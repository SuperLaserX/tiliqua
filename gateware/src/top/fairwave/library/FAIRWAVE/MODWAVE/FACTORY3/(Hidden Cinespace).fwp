FAIRWAVE PATCH 1
NAME  = (HIDDEN CINESPAC
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's (Hidden Cinespace) by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: CineSpace Smooth, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F3/2594FED5.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/12/7A92A9CA.WAV
READ = CLEAN
TUNE = -5
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 977.333 MS
DECAY = 16.353 S
SUSTAIN = 41%
RELEASE = 2.815 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 49.1%

[ENV 2]
GATE = GATE 1
ATTACK = 2.931 S
DECAY = 13.724 S
SUSTAIN = 0%
RELEASE = 3.565 S
A CURVE = 0
D CURVE = 0
R CURVE = 60

[LFO 1]
RATE = 0.053 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 0.168 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
LFO 1 > POS 1 = 50%
LFO 3 > X DEPTH = 6.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.5%

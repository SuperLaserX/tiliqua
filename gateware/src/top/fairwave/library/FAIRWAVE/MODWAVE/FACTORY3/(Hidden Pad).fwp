FAIRWAVE PATCH 1
NAME  = (HIDDEN PAD)
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's (Hidden Pad) by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Whisper F.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/41/6CDF7C3F.WAV
READ = SAMPLE
TUNE = -39
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 19.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5A/99122FB6.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.175 S
DECAY = 9.896 S
SUSTAIN = 50%
RELEASE = 4.377 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.9%

FAIRWAVE PATCH 1
NAME  = TAPE PAD STRINGS
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tape Pad Strings by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Tape 3 Violins-Chmb.
# Oscillator 2 is A's 2, the sample Str: Tape 3 Violins-Chmb.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 16ths - 3,5,6, Stereo Chorus, Tape Pad Strings.
[OSC 1]
TABLE = MODWAVE/T/92/1CF569C9.WAV
READ = SAMPLE
TUNE = -19
FINE = -22
POS = 0.0%
EDGE = WRAP
LOOP = 22.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/65/C9F38C82.WAV
READ = SAMPLE
TUNE = -19
FINE = -23
POS = 0.0%
EDGE = WRAP
LOOP = 20.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 1.440 S
SUSTAIN = 100%
RELEASE = 928.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.0%

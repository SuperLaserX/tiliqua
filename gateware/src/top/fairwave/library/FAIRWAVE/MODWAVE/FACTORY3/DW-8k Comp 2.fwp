FAIRWAVE PATCH 1
NAME  = DW-8K COMP
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW-8k Comp by Dan Phillips: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF.
[OSC 1]
TABLE = MODWAVE/T/C9/B5ADBC25.WAV
READ = CLEAN
TUNE = -12
FINE = 8
POS = 27.5%

[OSC 2]
TABLE = MODWAVE/T/78/1CA9CF7D.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 27.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 74.667 MS
SUSTAIN = 100%
RELEASE = 113.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.067 S
SUSTAIN = 50%
RELEASE = 961.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46%
CV 1 > POS 2 = -46%
ENV 2 > POS 1 = 45%
ENV 2 > POS 2 = 45%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.7%

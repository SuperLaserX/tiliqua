FAIRWAVE PATCH 1
NAME  = RINGMOD MACA A
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's RingMod Maca A by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Modern Compressor, RingMod Maca A.
[OSC 1]
TABLE = MODWAVE/T/4A/57DEC9F8.WAV
READ = CLEAN
TUNE = -12
POS = 27.5%

[OSC 2]
TABLE = MODWAVE/T/D4/B621C411.WAV
READ = CLEAN
TUNE = -12
FINE = -36
POS = 27.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 472.000 MS
SUSTAIN = 0%
RELEASE = 66.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 0
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 164.000 MS
SUSTAIN = 0%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 60%
CV 1 > POS 1 = -46%
CV 1 > POS 2 = -46%
ENV 2 > POS 1 = 45%
ENV 2 > POS 2 = 45%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

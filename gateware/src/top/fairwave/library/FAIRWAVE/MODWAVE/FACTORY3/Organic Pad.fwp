FAIRWAVE PATCH 1
NAME  = ORGANIC PAD
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Organic Pad by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 250_500_750ms DDL, Organic Pad, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A5/422509B7.WAV
READ = CLEAN
TUNE = -12
FINE = -5
POS = 24.3%

[OSC 2]
TABLE = MODWAVE/T/84/124EDD48.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 24.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 76.000 MS
SUSTAIN = 51%
RELEASE = 142.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 27.565 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51.5%
ENV 2 > POS 2 = 51.5%
CV 1 > POS 1 = -40.5%
CV 1 > POS 2 = -40.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.7%

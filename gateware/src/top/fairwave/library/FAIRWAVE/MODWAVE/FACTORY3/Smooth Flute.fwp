FAIRWAVE PATCH 1
NAME  = SMOOTH FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Smooth Flute by Korg: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Wnd_Guru: Pan Flute 3.
# Not carried over: the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Slow & Warm, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/0E/3AA132E2.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/61/A0C2F06A.WAV
READ = SAMPLE
TUNE = -48
FINE = 15
POS = 0.0%
EDGE = WRAP
LOOP = 51.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.7%

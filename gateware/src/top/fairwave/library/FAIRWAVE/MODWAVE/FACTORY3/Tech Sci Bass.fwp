FAIRWAVE PATCH 1
NAME  = TECH SCI BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tech Sci Bass by Richard Devine: backup1.mwbackup.
# 0 V plays what its C5 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Bass Squasher, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/77/3E833659.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BE/12469D19.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 494.667 MS
SUSTAIN = 0%
RELEASE = 40.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 5.827 S
SUSTAIN = 61%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.3%

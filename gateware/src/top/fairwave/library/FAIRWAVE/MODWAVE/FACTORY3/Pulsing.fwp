FAIRWAVE PATCH 1
NAME  = PULSING
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pulsing by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Alligatorz, bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/6A/495332FF.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/DA/E5B0FF30.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 79.675 S
SUSTAIN = 96%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 824.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
LFO 2 > LEVEL 1 = 50%
LFO 2 > LEVEL 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.5%

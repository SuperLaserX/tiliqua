FAIRWAVE PATCH 1
NAME  = WARP ALARM BEEPS
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Warp Alarm Beeps by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Warp Alarm Beeps.
[OSC 1]
TABLE = MODWAVE/T/AE/1C8AE479.WAV
READ = CLEAN
TUNE = 36
FINE = -40
POS = 44.0%

[OSC 2]
TABLE = MODWAVE/T/67/A23D172B.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

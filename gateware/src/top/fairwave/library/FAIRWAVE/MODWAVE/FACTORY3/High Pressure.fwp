FAIRWAVE PATCH 1
NAME  = HIGH PRESSURE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's High Pressure by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 6 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Tape Chug 1.
[OSC 1]
TABLE = MODWAVE/T/A7/3550D66C.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/CA/D05885D6.WAV
READ = CLEAN
TUNE = -13
FINE = -23
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.032 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.1%

FAIRWAVE PATCH 1
NAME  = SINUSOIDAL DEPTH
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sinusoidal Depth by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 11 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Pulsariffic.
[OSC 1]
TABLE = MODWAVE/T/8F/06A6339D.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/B3/96ABAAE7.WAV
READ = CLEAN
TUNE = -12
FINE = 8
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 396.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.044 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

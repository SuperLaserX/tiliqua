FAIRWAVE PATCH 1
NAME  = SKI STEPPER KNB3
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ski Stepper Knb3 by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample EP_Guru: CastleWalls Wet.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Ski Stepper, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A8/52D9E139.WAV
READ = CLEAN
TUNE = 0
POS = 19.8%

[OSC 2]
TABLE = MODWAVE/T/60/5EC41106.WAV
READ = SAMPLE
TUNE = -43
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 14.757 S
SUSTAIN = 27%
RELEASE = 914.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 42.803 S
SUSTAIN = 0%
RELEASE = 1.100 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60.5%
CV 1 > POS 1 = -33%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.5%

FAIRWAVE PATCH 1
NAME  = TECH SCI BEAT
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Tech Sci Beat by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Atk: Mad Analog Noise 1.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Clavi Chorus, Drum Squasher, Mono 1/4 note dly.
[OSC 1]
TABLE = MODWAVE/T/0B/E1793C8E.WAV
READ = SAMPLE
TUNE = -7
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/0B/E1793C8E.WAV
TUNE = -7
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 79.931 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > LEVEL 1 = 50%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

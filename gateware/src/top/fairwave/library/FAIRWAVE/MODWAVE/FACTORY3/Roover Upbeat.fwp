FAIRWAVE PATCH 1
NAME  = ROOVER UPBEAT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Roover Upbeat by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Roover Upbeat.
[OSC 1]
TABLE = MODWAVE/T/B2/902C3343.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/44/35E132E7.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
LFO 3 > POS 2 = 50%
LFO 1 > PITCH 1 = 20%
LFO 1 > PITCH 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.1%

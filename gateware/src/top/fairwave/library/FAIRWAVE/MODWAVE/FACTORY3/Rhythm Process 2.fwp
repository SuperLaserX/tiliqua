FAIRWAVE PATCH 1
NAME  = RHYTHM PROCESS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rhythm Process by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, Rhythm Process.
[OSC 1]
TABLE = MODWAVE/T/E6/3CB54459.WAV
READ = CLEAN
TUNE = 0
POS = 17.1%

[OSC 2]
TABLE = MODWAVE/T/8C/CDA53CB0.WAV
READ = CLEAN
TUNE = 12
POS = 17.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 772.000 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 59.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 377.333 MS
SUSTAIN = 39%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65.5%
ENV 2 > POS 2 = 65.5%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

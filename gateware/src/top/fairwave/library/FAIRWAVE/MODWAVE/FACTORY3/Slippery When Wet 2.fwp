FAIRWAVE PATCH 1
NAME  = SLIPPERY WHEN WE
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Slippery When Wet by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Drm: Kick Dance 11.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Electro Beatz, Slippery When Wet.
[OSC 1]
TABLE = MODWAVE/T/B6/DCD1F8B0.WAV
READ = SAMPLE
TUNE = -13
FINE = 34
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FF/9C2B84C5.WAV
READ = CLEAN
TUNE = -24
FINE = 13
POS = 43.0%

[ENV 1]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 298.667 MS
SUSTAIN = 0%
RELEASE = 628.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = 5%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 23.4%

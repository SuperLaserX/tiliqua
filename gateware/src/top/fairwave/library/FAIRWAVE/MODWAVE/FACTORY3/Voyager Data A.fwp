FAIRWAVE PATCH 1
NAME  = VOYAGER DATA A
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Voyager Data A by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F1/11C0C616.WAV
READ = CLEAN
TUNE = 12
POS = 24.8%

[OSC 2]
TABLE = MODWAVE/T/95/E2ACC58A.WAV
READ = CLEAN
TUNE = 12
POS = 24.8%

[ENV 1]
GATE = GATE 1
ATTACK = 820.000 MS
DECAY = 3.724 S
SUSTAIN = 84%
RELEASE = 3.959 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 9.136 S
SUSTAIN = 16%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 0
R CURVE = 60

[LFO 1]
RATE = 1.426 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 1.609 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
ENV 2 > POS 1 = 50.5%
ENV 2 > POS 2 = 50.5%
CV 1 > POS 1 = -41.5%
CV 1 > POS 2 = -41.5%
LFO 2 > POS 1 = 28.5%
LFO 2 > POS 2 = 28.5%
ENV 2 > LEVEL 2 = 17%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

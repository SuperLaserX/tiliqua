FAIRWAVE PATCH 1
NAME  = SPLENDOR BOX BLI
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Splendor Box Blips by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bass Squasher, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/8B/30B53D91.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/D7/0E507018.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 32.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 613.333 MS
SUSTAIN = 22%
RELEASE = 638.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 4.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
LFO 2 > POS 1 = 73.5%
CV 1 > POS 2 = -42%
LFO 3 > LEVEL 1 = 39%
LFO 3 > LEVEL 2 = 39%
LFO 1 > POS 2 = 24.5%
ENV 2 > POS 2 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.6%

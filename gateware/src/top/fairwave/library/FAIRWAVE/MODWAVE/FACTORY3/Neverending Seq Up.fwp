FAIRWAVE PATCH 1
NAME  = NEVERENDING SEQ
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Neverending Seq Up by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Organ: 8'.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5, Neverending Seq Up.
[OSC 1]
TABLE = MODWAVE/T/29/A57643B9.WAV
READ = SAMPLE
TUNE = -6
FINE = 31
POS = 0.0%
EDGE = WRAP
LOOP = 33.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BF/60290F39.WAV
READ = CLEAN
TUNE = -12
POS = 16.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 190.667 MS
SUSTAIN = 100%
RELEASE = 714.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 808.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 68%
LFO 1 > LEVEL 1 = 34%
LFO 1 > LEVEL 2 = 34%
CV 1 > POS 2 = -26.5%
ENV 2 > POS 2 = 23%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 93.5%

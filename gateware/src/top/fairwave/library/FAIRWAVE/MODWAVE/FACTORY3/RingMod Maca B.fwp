FAIRWAVE PATCH 1
NAME  = RINGMOD MACA B
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's RingMod Maca B by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Wave: DWGS Sine 1.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: RingMod Maca B.
[OSC 1]
TABLE = MODWAVE/T/F8/89EBC60D.WAV
READ = CLEAN
TUNE = 9
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/AC/54A5E437.WAV
READ = SAMPLE
TUNE = 9
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
LFO 1 > POS 1 = 18%
LFO 2 > POS 1 = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

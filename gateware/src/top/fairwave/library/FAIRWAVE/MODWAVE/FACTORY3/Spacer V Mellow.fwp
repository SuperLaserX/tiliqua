FAIRWAVE PATCH 1
NAME  = SPACER V MELLOW
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Spacer V Mellow by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Male Mnnn.
# Oscillator 2 is A's 2, the sample Wnd: 3 Flutes.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Spacer V Mellow, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/1A/2DEB0CD7.WAV
READ = SAMPLE
TUNE = -6
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 20.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1C/28BB1ABA.WAV
READ = SAMPLE
TUNE = -24
FINE = -47
POS = 0.0%
EDGE = WRAP
LOOP = 21.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.557 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.743 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 81.3%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

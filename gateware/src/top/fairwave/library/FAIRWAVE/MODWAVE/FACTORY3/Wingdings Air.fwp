FAIRWAVE PATCH 1
NAME  = WINGDINGS AIR
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wingdings Air by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, Stereo Chorus, Wingdings Air.
[OSC 1]
TABLE = MODWAVE/T/CE/D3552F98.WAV
READ = CLEAN
TUNE = 15
POS = 27.3%

[OSC 2]
TABLE = MODWAVE/T/2B/E36E93CD.WAV
READ = CLEAN
TUNE = 36
POS = 27.3%

[ENV 1]
GATE = GATE 1
ATTACK = 989.333 MS
DECAY = 322.667 MS
SUSTAIN = 57%
RELEASE = 2.409 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 728.000 MS
DECAY = 2.240 S
SUSTAIN = 0%
RELEASE = 3.717 S
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -45.5%
CV 1 > POS 2 = -45.5%
CV 2 > POS 1 = 45.5%
CV 2 > POS 2 = 45.5%
ENV 2 > POS 1 = 41%
ENV 2 > POS 2 = 41%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.0%

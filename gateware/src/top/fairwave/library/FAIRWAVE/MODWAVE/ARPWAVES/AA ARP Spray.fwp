FAIRWAVE PATCH 1
NAME  = AA ARP SPRAY
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Spray by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, ModW DoubleTalk, Odd Piano, Slowchug Lead.
[OSC 1]
TABLE = MODWAVE/T/31/422E7BC0.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 35.8%

[OSC 2]
TABLE = MODWAVE/T/C1/CC7131A2.WAV
READ = CLEAN
TUNE = 7
FINE = 2
POS = 35.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 172.000 MS
SUSTAIN = 86%
RELEASE = 485.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 436.000 MS
SUSTAIN = 0%
RELEASE = 729.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 1]
RATE = 0.667 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 0.667 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -59.5%
CV 1 > POS 2 = -59.5%
LFO 1 > LEVEL 1 = -31%
LFO 1 > LEVEL 2 = -31%
ENV 2 > POS 1 = 28.5%
ENV 2 > POS 2 = 28.5%
CV 2 > POS 1 = 21%
CV 2 > POS 2 = 21%
LFO 3 > POS 1 = 9.5%
LFO 3 > POS 2 = 9.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.3%

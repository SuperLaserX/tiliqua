FAIRWAVE PATCH 1
NAME  = AA ARP COLLAPSE
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Collapse by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bell Air High, Paddish Organ, Phaser, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/FB/9963C2AF.WAV
READ = CLEAN
TUNE = -24
POS = 32.1%

[OSC 2]
TABLE = MODWAVE/T/FC/CB0F6560.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 32.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 142.667 MS
SUSTAIN = 72%
RELEASE = 628.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 221.333 MS
SUSTAIN = 0%
RELEASE = 704.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 1]
RATE = 1.333 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
CV 2 > POS 1 = 18.5%
CV 2 > POS 2 = 18.5%
LFO 1 > POS 1 = -14.5%
LFO 1 > POS 2 = -14.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.7%

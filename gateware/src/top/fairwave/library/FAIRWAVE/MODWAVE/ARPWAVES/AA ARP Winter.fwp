FAIRWAVE PATCH 1
NAME  = AA ARP WINTER
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Winter by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Junk Jam Low, Noise Shaper, Slowchug Lead, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/7D/31517EDA.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 34.5%

[OSC 2]
TABLE = MODWAVE/T/35/5541E3AA.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 34.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 313.333 MS
SUSTAIN = 61%
RELEASE = 84.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 96.000 MS
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -57.5%
CV 1 > POS 2 = -57.5%
ENV 2 > POS 1 = 31%
ENV 2 > POS 2 = 31%
CV 2 > POS 1 = 10.5%
CV 2 > POS 2 = 10.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.4%

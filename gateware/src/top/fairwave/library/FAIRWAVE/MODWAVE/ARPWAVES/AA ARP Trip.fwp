FAIRWAVE PATCH 1
NAME  = AA ARP TRIP
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Trip by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted HPF, Junk Jam Low, Phaser.
[OSC 1]
TABLE = MODWAVE/T/90/C3710DAC.WAV
READ = CLEAN
TUNE = -36
FINE = -5
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/55/6F524A8F.WAV
READ = CLEAN
TUNE = -24
FINE = 6
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 MS
DECAY = 313.333 MS
SUSTAIN = 17%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 88.000 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.095 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 36%
LFO 1 > POS 2 = 36%
CV 1 > POS 1 = -23%
CV 1 > POS 2 = -23%
ENV 2 > POS 1 = -5.5%
ENV 2 > POS 2 = -5.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.6%

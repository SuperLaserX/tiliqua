FAIRWAVE PATCH 1
NAME  = AA ARP ROUTE
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Route by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Changing Patterns, Sidewinder, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/D1/AE0BCE1F.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 28.1%

[OSC 2]
TABLE = MODWAVE/T/B8/0CFAAA8C.WAV
READ = CLEAN
TUNE = 7
FINE = 5
POS = 28.1%

[ENV 1]
GATE = GATE 1
ATTACK = 2.667 MS
DECAY = 97.333 MS
SUSTAIN = 78%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 300.000 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.169 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -47%
CV 1 > POS 2 = -47%
ENV 2 > POS 1 = 44%
ENV 2 > POS 2 = 44%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%
LFO 1 > POS 1 = 11.5%
LFO 1 > POS 2 = 11.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.3%

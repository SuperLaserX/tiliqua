FAIRWAVE PATCH 1
NAME  = AA ARP DREAM WOR
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Dream Worlds by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Noise Shaper, Rose Garden Pad, Vintage Flanger, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E5/77D29051.WAV
READ = CLEAN
TUNE = -24
FINE = -1
POS = 36.9%

[OSC 2]
TABLE = MODWAVE/T/8A/4E547BAA.WAV
READ = CLEAN
TUNE = -24
FINE = 4
POS = 33.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 313.333 MS
SUSTAIN = 61%
RELEASE = 84.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 430.667 MS
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 1]
RATE = 0.312 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -61.5%
CV 1 > POS 2 = -55.5%
ENV 2 > POS 1 = 36.5%
ENV 2 > POS 2 = 33%
CV 2 > POS 1 = 26.5%
CV 2 > POS 2 = 24%
CV 2 > X DEPTH = 21.5%
LFO 1 > POS 1 = 5%
LFO 1 > POS 2 = 4.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

FAIRWAVE PATCH 1
NAME  = AA ARP PATTERN
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Pattern by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Bell Air High, Medium Chorus, Odd Piano.
[OSC 1]
TABLE = MODWAVE/T/AB/867C1266.WAV
READ = CLEAN
TUNE = -24
FINE = -4
POS = 34.0%

[OSC 2]
TABLE = MODWAVE/T/62/61A273B9.WAV
READ = CLEAN
TUNE = -5
FINE = 6
POS = 34.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 142.667 MS
SUSTAIN = 48%
RELEASE = 365.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 213.333 MS
SUSTAIN = 0%
RELEASE = 428.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 3]
RATE = 2.667 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -56.5%
CV 1 > POS 2 = -56.5%
ENV 2 > POS 1 = 32%
ENV 2 > POS 2 = 32%
CV 2 > POS 1 = 26%
CV 2 > POS 2 = 26%
LFO 3 > POS 1 = 6%
LFO 3 > POS 2 = 6%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.6%

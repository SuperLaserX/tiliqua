FAIRWAVE PATCH 1
NAME  = AA ARP ANONYMOUS
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Anonymous by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse, Li'l Pirate Hollow, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/93/0D17BCD3.WAV
READ = CLEAN
TUNE = -24
FINE = -5
POS = 30.3%

[OSC 2]
TABLE = MODWAVE/T/BA/CCB22DD9.WAV
READ = CLEAN
TUNE = -5
FINE = 9
POS = 30.3%

[ENV 1]
GATE = GATE 1
ATTACK = 120.000 MS
DECAY = 313.333 MS
SUSTAIN = 57%
RELEASE = 85.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 362.667 MS
DECAY = 86.667 MS
SUSTAIN = 0%
RELEASE = 89.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.070 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 50.5%
CV 1 > POS 2 = 50.5%
CV 2 > POS 1 = 39.5%
CV 2 > POS 2 = 39.5%
ENV 2 > POS 1 = -37%
ENV 2 > POS 2 = -37%
LFO 1 > POS 1 = -6.5%
LFO 1 > POS 2 = -6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.4%

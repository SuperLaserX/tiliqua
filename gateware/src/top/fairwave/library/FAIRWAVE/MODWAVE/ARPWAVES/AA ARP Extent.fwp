FAIRWAVE PATCH 1
NAME  = AA ARP EXTENT
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Extent by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Cross DDL 2, Paddish Organ, Phaser.
[OSC 1]
TABLE = MODWAVE/T/76/D66274AA.WAV
READ = CLEAN
TUNE = -24
POS = 31.1%

[OSC 2]
TABLE = MODWAVE/T/06/CC9C62BF.WAV
READ = CLEAN
TUNE = 7
POS = 31.1%

[ENV 1]
GATE = GATE 1
ATTACK = 56.000 MS
DECAY = 313.333 MS
SUSTAIN = 61%
RELEASE = 161.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 93.333 MS
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52%
CV 1 > POS 2 = -52%
ENV 2 > POS 1 = 38%
ENV 2 > POS 2 = 38%
CV 2 > POS 1 = 24.5%
CV 2 > POS 2 = 24.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.2%

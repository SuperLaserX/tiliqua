FAIRWAVE PATCH 1
NAME  = AA ARP RELIANCE
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Reliance by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Junk Jam Low, Orange Mk I Phaser, Stream Sizzle, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/65/EE2F56B9.WAV
READ = CLEAN
TUNE = -36
FINE = -5
POS = 31.3%

[OSC 2]
TABLE = MODWAVE/T/C4/2D379E9E.WAV
READ = CLEAN
TUNE = -12
FINE = 9
POS = 31.3%

[ENV 1]
GATE = GATE 1
ATTACK = 81.333 MS
DECAY = 313.333 MS
SUSTAIN = 57%
RELEASE = 85.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 78.667 MS
DECAY = 86.667 MS
SUSTAIN = 0%
RELEASE = 89.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.070 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52%
CV 1 > POS 2 = -52%
ENV 2 > POS 1 = 37.5%
ENV 2 > POS 2 = 37.5%
CV 2 > POS 1 = 23%
CV 2 > POS 2 = 23%
LFO 1 > POS 1 = 7%
LFO 1 > POS 2 = 7%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 24.8%

FAIRWAVE PATCH 1
NAME  = AA ARP REFLECTIO
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Reflections by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Black Phase, Noise Shaper, Odd Piano, Sadness in D Minor.
[OSC 1]
TABLE = MODWAVE/T/E7/A2B58FFE.WAV
READ = CLEAN
TUNE = -24
POS = 33.9%

[OSC 2]
TABLE = MODWAVE/T/04/BA1D1A7D.WAV
READ = CLEAN
TUNE = 0
POS = 34.8%

[ENV 1]
GATE = GATE 1
ATTACK = 2.667 MS
DECAY = 313.333 MS
SUSTAIN = 61%
RELEASE = 277.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 93.333 MS
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -58%
CV 1 > POS 1 = -56.5%
ENV 2 > POS 2 = 33%
ENV 2 > POS 1 = 32%
CV 2 > POS 2 = 30.5%
CV 2 > POS 1 = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.4%

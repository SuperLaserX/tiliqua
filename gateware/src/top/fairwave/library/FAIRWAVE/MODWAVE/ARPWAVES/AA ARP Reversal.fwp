FAIRWAVE PATCH 1
NAME  = AA ARP REVERSAL
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Reversal by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Changing Patterns, Noise Shaper, Sidewinder, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/F2/A6421DC7.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 36.2%

[OSC 2]
TABLE = MODWAVE/T/30/1A38C7BB.WAV
READ = CLEAN
TUNE = 0
FINE = 5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 97.333 MS
SUSTAIN = 70%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 518.667 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.658 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.134 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -60.5%
LFO 2 > POS 2 = 50%
CV 2 > POS 1 = 27.5%
ENV 2 > POS 2 = 22%
ENV 2 > POS 1 = 15.5%
LFO 1 > POS 1 = 15%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.9%

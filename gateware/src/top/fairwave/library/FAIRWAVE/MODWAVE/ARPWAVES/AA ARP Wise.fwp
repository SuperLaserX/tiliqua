FAIRWAVE PATCH 1
NAME  = AA ARP WISE
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Wise by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Airy Plucks, Cross DDL 2, Use Your Words, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6A/AEB1D704.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/9F/13B86BE5.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 29.6%

[ENV 1]
GATE = GATE 1
ATTACK = 70.667 MS
DECAY = 364.000 MS
SUSTAIN = 70%
RELEASE = 100.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 34.667 MS
DECAY = 321.333 MS
SUSTAIN = 0%
RELEASE = 285.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -49.5%
CV 2 > POS 2 = 41%
ENV 2 > POS 2 = -27%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.3%

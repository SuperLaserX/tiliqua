FAIRWAVE PATCH 1
NAME  = AA ARP DECOR
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Decor by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse, DTMF Organ, Sidewinder.
[OSC 1]
TABLE = MODWAVE/T/14/1FB2B5CA.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 33.0%

[OSC 2]
TABLE = MODWAVE/T/2C/00F64453.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 33.0%

[ENV 1]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 97.333 MS
SUSTAIN = 70%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 40.000 MS
DECAY = 322.667 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.072 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55%
CV 1 > POS 2 = -55%
CV 2 > POS 1 = 34%
CV 2 > POS 2 = 34%
ENV 2 > POS 1 = 18.5%
ENV 2 > POS 2 = 18.5%
LFO 1 > POS 1 = 13.5%
LFO 1 > POS 2 = 13.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.0%

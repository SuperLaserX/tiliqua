FAIRWAVE PATCH 1
NAME  = AA ARP GASH
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Gash by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF 2, Changing Patterns, Sidewinder, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/D9/F57F19CE.WAV
READ = CLEAN
TUNE = -24
FINE = -8
POS = 30.3%

[OSC 2]
TABLE = MODWAVE/T/C3/923A597A.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 30.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 97.333 MS
SUSTAIN = 78%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 322.667 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.072 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -50.5%
CV 1 > POS 2 = -50.5%
CV 2 > POS 1 = 39.5%
CV 2 > POS 2 = 39.5%
ENV 2 > POS 1 = 27%
ENV 2 > POS 2 = 27%
LFO 1 > POS 1 = 12.5%
LFO 1 > POS 2 = 12.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.2%

FAIRWAVE PATCH 1
NAME  = AA ARP BLINK
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Blink by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Phaser, Slowchug Lead, Transformation.
[OSC 1]
TABLE = MODWAVE/T/B7/AD64FFAC.WAV
READ = CLEAN
TUNE = -12
POS = 35.0%

[OSC 2]
TABLE = MODWAVE/T/86/8AD1B3A7.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 35.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 142.667 MS
SUSTAIN = 72%
RELEASE = 484.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 221.333 MS
SUSTAIN = 0%
RELEASE = 704.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 1]
RATE = 0.333 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58.5%
CV 1 > POS 2 = -58.5%
ENV 2 > POS 1 = 30%
ENV 2 > POS 2 = 30%
LFO 1 > POS 1 = 24.5%
LFO 1 > POS 2 = 24.5%
CV 2 > POS 1 = 20%
CV 2 > POS 2 = 20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.1%

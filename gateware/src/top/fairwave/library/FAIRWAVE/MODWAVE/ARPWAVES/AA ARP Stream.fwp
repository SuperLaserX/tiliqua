FAIRWAVE PATCH 1
NAME  = AA ARP STREAM
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Stream by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Electro Beatz, Noise Shaper, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/3A/02E861A9.WAV
READ = CLEAN
TUNE = -24
POS = 32.1%

[OSC 2]
TABLE = MODWAVE/T/50/5C5B927C.WAV
READ = CLEAN
TUNE = 12
POS = 32.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 313.333 MS
SUSTAIN = 57%
RELEASE = 85.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 470.667 MS
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 2 = -56%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
ENV 2 > POS 1 = 36%
ENV 2 > POS 2 = 36%
CV 2 > POS 1 = 28%
CV 2 > POS 2 = 28%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.6%

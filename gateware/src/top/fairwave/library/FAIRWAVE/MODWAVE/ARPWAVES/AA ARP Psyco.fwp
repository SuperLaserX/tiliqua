FAIRWAVE PATCH 1
NAME  = AA ARP PSYCO
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Psyco by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Medium Chorus, Odd Piano, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/FE/7081B57F.WAV
READ = CLEAN
TUNE = -24
FINE = -4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/0E/FB079543.WAV
READ = CLEAN
TUNE = -36
FINE = 6
POS = 33.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 142.667 MS
SUSTAIN = 48%
RELEASE = 365.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 258.667 MS
SUSTAIN = 0%
RELEASE = 428.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -55%
ENV 2 > POS 2 = 33.5%
CV 2 > POS 2 = 27.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.5%

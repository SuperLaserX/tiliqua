FAIRWAVE PATCH 1
NAME  = AA ARP EPOCH
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Epoch by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, ModW DoubleTalk, Paddish Organ, Phaser.
[OSC 1]
TABLE = MODWAVE/T/15/5A8676B9.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 34.3%

[OSC 2]
TABLE = MODWAVE/T/9D/D02B8F7E.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 34.3%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 172.000 MS
SUSTAIN = 81%
RELEASE = 353.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 216.000 MS
SUSTAIN = 0%
RELEASE = 729.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[LFO 2]
RATE = 0.667 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -57%
CV 1 > POS 2 = -57%
ENV 2 > POS 1 = 31.5%
ENV 2 > POS 2 = 31.5%
CV 2 > POS 1 = 20.5%
CV 2 > POS 2 = 20.5%
LFO 2 > POS 1 = 6.5%
LFO 2 > POS 2 = 6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

FAIRWAVE PATCH 1
NAME  = AA ARP TRAIL
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AA ARP Trail by Anton Anru: Korg Modwave - Arp Waves Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Dark Triumph Bass, Sadness in D Minor, Sidewinder.
[OSC 1]
TABLE = MODWAVE/T/60/F2AB5333.WAV
READ = CLEAN
TUNE = -24
FINE = -11
POS = 27.8%

[OSC 2]
TABLE = MODWAVE/T/26/131C2924.WAV
READ = CLEAN
TUNE = 0
FINE = 11
POS = 27.8%

[ENV 1]
GATE = GATE 1
ATTACK = 2.667 MS
DECAY = 97.333 MS
SUSTAIN = 78%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 97.333 MS
SUSTAIN = 0%
RELEASE = 60.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.055 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
ENV 2 > POS 1 = 44.5%
ENV 2 > POS 2 = 44.5%
CV 2 > POS 1 = 24.5%
CV 2 > POS 2 = 24.5%
LFO 1 > POS 1 = 7%
LFO 1 > POS 2 = 7%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.6%

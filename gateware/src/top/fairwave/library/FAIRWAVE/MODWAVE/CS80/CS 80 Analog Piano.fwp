FAIRWAVE PATCH 1
NAME  = CS 80 ANALOG PIA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS 80 Analog Piano by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/71/C963BE82.WAV
READ = CLEAN
TUNE = 0
POS = 21.2%

[OSC 2]
TABLE = MODWAVE/T/C2/6C9DEE12.WAV
READ = CLEAN
TUNE = 0
POS = 21.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.333 S
SUSTAIN = 16%
RELEASE = 2.013 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.733 S
SUSTAIN = 50%
RELEASE = 10.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57.5%
ENV 2 > POS 2 = 57.5%
CV 1 > POS 1 = -35.5%
CV 1 > POS 2 = -35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

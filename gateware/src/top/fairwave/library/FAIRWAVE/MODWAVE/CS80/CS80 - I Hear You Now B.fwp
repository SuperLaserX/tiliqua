FAIRWAVE PATCH 1
NAME  = CS80 - I HEAR YO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 - I Hear You Now B by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/B2/BC921788.WAV
READ = CLEAN
TUNE = -24
POS = 14.0%

[OSC 2]
TABLE = MODWAVE/T/B2/BC921788.WAV
READ = CLEAN
TUNE = -24
POS = 14.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 673.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 40.000 MS
DECAY = 113.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 72%
ENV 2 > POS 2 = 72%
CV 1 > POS 1 = -23.5%
CV 1 > POS 2 = -23.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = BIG CHORDS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Big Chords by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/46/D56FEC23.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 22.6%

[OSC 2]
TABLE = MODWAVE/T/25/01DC085B.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 22.6%

[ENV 1]
GATE = GATE 1
ATTACK = 33.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 84.000 S
SUSTAIN = 89%
RELEASE = 133.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 54.5%
ENV 2 > POS 2 = 54.5%
CV 1 > POS 1 = -37.5%
CV 1 > POS 2 = -37.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.0%

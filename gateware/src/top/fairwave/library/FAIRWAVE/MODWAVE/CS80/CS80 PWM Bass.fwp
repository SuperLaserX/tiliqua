FAIRWAVE PATCH 1
NAME  = CS80 PWM BASS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 PWM Bass by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 3 unison voices.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Biegerish Bass, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/22244D2E.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 13.1%

[OSC 2]
TABLE = MODWAVE/T/05/22244D2E.WAV
READ = CLEAN
TUNE = -12
FINE = 6
POS = 13.1%

[ENV 1]
GATE = GATE 1
ATTACK = 486.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 506.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.867 S
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 3.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.557 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74%
ENV 2 > POS 2 = 74%
LFO 1 > POS 1 = 33%
LFO 1 > POS 2 = 33%
CV 1 > POS 1 = -22%
CV 1 > POS 2 = -22%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

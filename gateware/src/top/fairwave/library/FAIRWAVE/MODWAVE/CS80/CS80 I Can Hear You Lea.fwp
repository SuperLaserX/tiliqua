FAIRWAVE PATCH 1
NAME  = CS80 I CAN HEAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 I Can Hear You Lead by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/BC/7FD4AE7A.WAV
READ = CLEAN
TUNE = 0
POS = 16.8%

[OSC 2]
TABLE = MODWAVE/T/2E/F3B4FB23.WAV
READ = CLEAN
TUNE = 0
POS = 16.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.333 S
SUSTAIN = 16%
RELEASE = 2.013 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.200 S
SUSTAIN = 50%
RELEASE = 10.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 66.5%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.6%

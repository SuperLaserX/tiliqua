FAIRWAVE PATCH 1
NAME  = CS80 FIND MY WAY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Find my way home  by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/DC/8239C5E2.WAV
READ = CLEAN
TUNE = 0
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/03/7624F124.WAV
READ = CLEAN
TUNE = 19
POS = 28.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.669 S
SUSTAIN = 26%
RELEASE = 658.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 12%
LFO 1 > LEVEL 2 = 12%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = CS80 PITCH BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Pitch Brass by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/CC/8BD0A3A0.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 44.6%

[OSC 2]
TABLE = MODWAVE/T/D1/EDDFBE60.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 44.6%

[ENV 1]
GATE = GATE 1
ATTACK = 29.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 24.000 MS
DECAY = 674.667 MS
SUSTAIN = 73%
RELEASE = 4.147 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -74.5%
CV 1 > POS 2 = -74.5%
ENV 2 > POS 1 = 10.5%
ENV 2 > POS 2 = 10.5%
ENV 2 > PITCH 1 = -1.5%
ENV 2 > PITCH 2 = -1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

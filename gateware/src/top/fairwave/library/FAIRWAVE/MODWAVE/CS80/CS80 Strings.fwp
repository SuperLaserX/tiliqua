FAIRWAVE PATCH 1
NAME  = CS80 STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Strings by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/3E/C601E1C1.WAV
READ = CLEAN
TUNE = 0
POS = 24.2%

[OSC 2]
TABLE = MODWAVE/T/27/DB8E43CA.WAV
READ = CLEAN
TUNE = 0
FINE = 13
POS = 24.2%

[ENV 1]
GATE = GATE 1
ATTACK = 8.000 S
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 953.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 42.4%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 32.667 S
SUSTAIN = 35%
RELEASE = 820.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.864 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51.5%
ENV 2 > POS 2 = 51.5%
CV 1 > POS 1 = -40.5%
CV 1 > POS 2 = -40.5%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

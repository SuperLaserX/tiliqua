FAIRWAVE PATCH 1
NAME  = CS80 HI-PASS STR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Hi-Pass Strings by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/69/92337D8B.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 12.0%

[OSC 2]
TABLE = MODWAVE/T/72/3ADF3AEF.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 12.0%

[ENV 1]
GATE = GATE 1
ATTACK = 260.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 962.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 0.000 MS
SUSTAIN = 63%
RELEASE = 8.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 76%
ENV 2 > POS 2 = 76%
CV 1 > POS 1 = -20%
CV 1 > POS 2 = -20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.4%

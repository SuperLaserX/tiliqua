FAIRWAVE PATCH 1
NAME  = BLADERUNNER (CS8
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bladerunner (CS80) by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BF/694F561C.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 23.9%

[OSC 2]
TABLE = MODWAVE/T/CB/F41647ED.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 23.9%

[ENV 1]
GATE = GATE 1
ATTACK = 573.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 706.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.147 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 52%
ENV 2 > POS 2 = 52%
CV 1 > POS 1 = -40%
CV 1 > POS 2 = -40%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

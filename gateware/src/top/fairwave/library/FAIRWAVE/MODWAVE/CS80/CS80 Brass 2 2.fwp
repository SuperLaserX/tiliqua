FAIRWAVE PATCH 1
NAME  = CS80 BRASS 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Brass 2 by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9B/EE4BFC1B.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 23.4%

[OSC 2]
TABLE = MODWAVE/T/91/815985E6.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 23.4%

[ENV 1]
GATE = GATE 1
ATTACK = 173.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 666.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.147 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 53%
ENV 2 > POS 2 = 53%
CV 1 > POS 1 = -39%
CV 1 > POS 2 = -39%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

FAIRWAVE PATCH 1
NAME  = CS80 SPIT LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Spit Lead by Ian Dixon: cs80.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/0C/2EF5EFEB.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/7C/015CE9A5.WAV
READ = CLEAN
TUNE = 0
FINE = 7
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.200 S
SUSTAIN = 41%
RELEASE = 1.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 16.000 MS
DECAY = 53.333 MS
SUSTAIN = 65%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.816 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.5%

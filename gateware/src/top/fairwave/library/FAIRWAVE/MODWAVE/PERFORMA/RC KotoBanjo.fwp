FAIRWAVE PATCH 1
NAME  = RC KOTO/BANJO
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's RC Koto/Banjo by Deborah Pickett: RC KotoBanjo.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Plk: Koto.
# Oscillator 2 is A's 2, the sample Plk: Banjo.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Delay, Stuck in a Jar.
[OSC 1]
TABLE = MODWAVE/T/CD/07F24307.WAV
READ = SAMPLE
TUNE = -12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 77.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/98/3F8B75A2.WAV
READ = SAMPLE
TUNE = -5
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 74.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 3.867 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 4.2%

FAIRWAVE PATCH 1
NAME  = RC GUITAR CLEAN
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's RC Guitar Clean 2 by Deborah Pickett: RC Guitar Clean 2.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Clean 2 mf.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus, Stereo Delay, US Modern V30.
[OSC 1]
TABLE = MODWAVE/T/5F/1A2C15C9.WAV
READ = SAMPLE
TUNE = -5
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 96.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5F/1A2C15C9.WAV
TUNE = -5
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 18.667 MS
DECAY = 13.600 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

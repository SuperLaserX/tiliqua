FAIRWAVE PATCH 1
NAME  = RC POP OOH/AH
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's RC Pop Ooh/Ah by Deborah Pickett: RC Pop OohAh.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Pop Ooh.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/C6/FC4DE6BD.WAV
READ = SAMPLE
TUNE = -7
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 13.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C6/FC4DE6BD.WAV
TUNE = -7
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 1.800 S
SUSTAIN = 71%
RELEASE = 786.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

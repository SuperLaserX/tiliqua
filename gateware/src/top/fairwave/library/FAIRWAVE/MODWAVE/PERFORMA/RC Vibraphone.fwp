FAIRWAVE PATCH 1
NAME  = RC VIBRAPHONE
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's RC Vibraphone by Deborah Pickett: RC Vibraphone.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell: Vibraphone 1.
# Oscillator 2 is A's 2, the sample Bell: Vibraphone 2.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/9F/F6B64489.WAV
READ = SAMPLE
TUNE = -6
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 61.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/0D/6E792C29.WAV
READ = SAMPLE
TUNE = 2
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 89.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 4.000 S
SUSTAIN = 0%
RELEASE = 2.067 S
A CURVE = 0
D CURVE = 100
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 7.0%

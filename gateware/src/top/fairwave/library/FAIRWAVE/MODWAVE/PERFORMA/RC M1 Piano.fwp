FAIRWAVE PATCH 1
NAME  = RC M1 PIANO
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's RC M1 Piano by Deborah Pickett: RC M1 Piano.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: M1 Piano.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Mix Bright & Clean, Stereo Chorus, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/16/304FCD3D.WAV
READ = SAMPLE
TUNE = -12
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 95.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/16/304FCD3D.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 17.333 MS
DECAY = 13.333 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

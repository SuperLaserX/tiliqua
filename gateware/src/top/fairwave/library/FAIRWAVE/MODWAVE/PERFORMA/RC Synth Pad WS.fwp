FAIRWAVE PATCH 1
NAME  = RC SYNTH PAD WS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC Synth Pad WS by Deborah Pickett: RC Synth Pad WS.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynthPad.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Rezzo, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/35/AC18ED55.WAV
READ = SAMPLE
TUNE = -37
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 10.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/35/AC18ED55.WAV
TUNE = -37
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 1.200 S
SUSTAIN = 78%
RELEASE = 897.333 MS
A CURVE = 0
D CURVE = 100
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

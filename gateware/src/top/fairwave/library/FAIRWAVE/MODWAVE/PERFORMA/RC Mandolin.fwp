FAIRWAVE PATCH 1
NAME  = RC MANDOLIN
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's RC Mandolin by Deborah Pickett: RC Mandolin.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Plk: Mandolin 1.
# Oscillator 2 is A's 2, the sample Plk: Mandolin 2.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Mix Bright & Clean, Stereo Delay, Talking Modulator.
[OSC 1]
TABLE = MODWAVE/T/49/C6D0E845.WAV
READ = SAMPLE
TUNE = -13
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 89.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4B/6B7EE40A.WAV
READ = SAMPLE
TUNE = -8
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 80.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 4.667 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.9%

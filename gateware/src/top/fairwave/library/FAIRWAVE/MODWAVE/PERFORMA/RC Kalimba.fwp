FAIRWAVE PATCH 1
NAME  = RC KALIMBA
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's RC Kalimba by Deborah Pickett: RC Kalimba.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell: Kalimba.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Rezzo, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/A2/9DA4B6AB.WAV
READ = SAMPLE
TUNE = -4
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 78.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A2/9DA4B6AB.WAV
TUNE = -4
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 505.333 MS
SUSTAIN = 0%
RELEASE = 1.772 S
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

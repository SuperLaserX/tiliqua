FAIRWAVE PATCH 1
NAME  = RC STRING ENSEMB
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC String Ensemble 1/2 by Deborah Pickett: RC String Ensemble 12.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: String Ensemble 1.
# Oscillator 2 is A's 2, the sample Str: String Ensemble 2.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/A8/D6FE038E.WAV
READ = SAMPLE
TUNE = -11
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 20.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BE/BD838651.WAV
READ = SAMPLE
TUNE = -19
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 53.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 1.000 S
SUSTAIN = 85%
RELEASE = 786.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 9.6%

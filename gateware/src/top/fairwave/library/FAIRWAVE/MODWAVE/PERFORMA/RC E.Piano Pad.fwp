FAIRWAVE PATCH 1
NAME  = RC E.PIANO PAD
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's RC E.Piano Pad by Deborah Pickett: RC EPiano Pad.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Pad 1.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Mix Bright & Clean, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/EA/6BA66616.WAV
READ = SAMPLE
TUNE = -31
FINE = -18
POS = 0.0%
EDGE = WRAP
LOOP = 72.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EA/6BA66616.WAV
TUNE = -31
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 20.000 MS
DECAY = 14.351 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

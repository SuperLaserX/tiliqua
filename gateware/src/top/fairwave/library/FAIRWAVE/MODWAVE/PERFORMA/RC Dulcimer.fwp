FAIRWAVE PATCH 1
NAME  = RC DULCIMER
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's RC Dulcimer by Deborah Pickett: RC Dulcimer.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Plk: Dulcimer Hard.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Mix Bright & Clean, Stereo Chorus, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/88/B3194411.WAV
READ = SAMPLE
TUNE = -18
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/88/B3194411.WAV
TUNE = -18
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 89.333 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

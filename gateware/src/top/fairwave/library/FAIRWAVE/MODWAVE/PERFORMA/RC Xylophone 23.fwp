FAIRWAVE PATCH 1
NAME  = RC XYLOPHONE 2/3
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's RC Xylophone 2/3 by Deborah Pickett: RC Xylophone 23.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell: Xylophone 2.
# Oscillator 2 is A's 2, the sample Bell: Xylophone 3.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Rezzo, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/A1/FB2A887E.WAV
READ = SAMPLE
TUNE = -16
FINE = 26
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D8/2A357C94.WAV
READ = SAMPLE
TUNE = -37
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 82.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 4.000 S
SUSTAIN = 0%
RELEASE = 2.067 S
A CURVE = 0
D CURVE = 100
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 10.6%

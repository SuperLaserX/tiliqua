FAIRWAVE PATCH 1
NAME  = RC GLASS HARP
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC Glass Harp by Deborah Pickett: RC Glass Harp.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Glass Harp Smooth.
# Oscillator 2 is A's 2, the sample Str: Glass Harp Buzzy.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/37/A3212A6E.WAV
READ = SAMPLE
TUNE = -22
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 52.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/73/29432FA9.WAV
READ = SAMPLE
TUNE = -32
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 67.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 1.000 S
SUSTAIN = 85%
RELEASE = 66.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 6.0%

FAIRWAVE PATCH 1
NAME  = RC COWBELL
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's RC Cowbell by Deborah Pickett: RC Cowbell.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc: Cowbell 1.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Phaser, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/07/9BBDA87A.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/07/9BBDA87A.WAV
TUNE = -13
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 333.333 MS
SUSTAIN = 0%
RELEASE = 20.667 S
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = RC VOICE OOHH/YA
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's RC Voice Oohh/Yah by Deborah Pickett: RC Voice OohhYah.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Hit: Voice 42 "Oohh".
# Oscillator 2 is A's 2, the sample Hit: Voice 41 "Yah".
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/26/31A8668B.WAV
READ = SAMPLE
TUNE = -30
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/DC/08265822.WAV
READ = SAMPLE
TUNE = -29
FINE = 7
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 3.867 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 3.9%

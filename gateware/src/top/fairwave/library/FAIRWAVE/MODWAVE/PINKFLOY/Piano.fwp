FAIRWAVE PATCH 1
NAME  = PIANO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Piano by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: Acoustic f.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/CC/677972D1.WAV
READ = SAMPLE
TUNE = -32
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 77.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CC/677972D1.WAV
TUNE = -32
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 13.333 S
SUSTAIN = 0%
RELEASE = 726.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

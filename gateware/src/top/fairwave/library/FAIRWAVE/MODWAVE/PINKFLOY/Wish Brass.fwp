FAIRWAVE PATCH 1
NAME  = WISH BRASS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wish Brass by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/F4/75D3D7ED.WAV
READ = CLEAN
TUNE = -12
POS = 23.3%

[OSC 2]
TABLE = MODWAVE/T/F4/75D3D7ED.WAV
TUNE = -12
POS = 23.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 120.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 90.000 S
SUSTAIN = 93%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 53.5%
CV 1 > POS 1 = -39%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

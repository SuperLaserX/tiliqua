FAIRWAVE PATCH 1
NAME  = WURLEY EP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wurley EP by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Wurly 2 ff.
# Oscillator 2 is A's 2, the sample E.Piano: Wurly 2  mp.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7C/080E7E0F.WAV
READ = SAMPLE
TUNE = -4
FINE = 42
POS = 0.0%
EDGE = WRAP
LOOP = 90.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F4/FBB35296.WAV
READ = SAMPLE
TUNE = -7
FINE = -46
POS = 0.0%
EDGE = WRAP
LOOP = 89.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 13.333 S
SUSTAIN = 0%
RELEASE = 77.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

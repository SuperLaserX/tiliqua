FAIRWAVE PATCH 1
NAME  = WELCOME TO THE M
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Welcome to the Machine by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FD/0274C121.WAV
READ = CLEAN
TUNE = -24
POS = 38.5%

[OSC 2]
TABLE = MODWAVE/T/A2/3FE31EC4.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 38.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.200 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.200 S
SUSTAIN = 14%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.050 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.172 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 99%
CV 1 > POS 1 = -64%
CV 1 > POS 2 = -64%
ENV 2 > POS 1 = 23%
ENV 2 > POS 2 = 23%
LFO 2 > POS 1 = -21.5%
LFO 2 > POS 2 = -21.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.7%

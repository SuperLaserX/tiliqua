FAIRWAVE PATCH 1
NAME  = SIGNS OF LIFE WH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Signs of Life Whistle by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/03/04C63566.WAV
READ = CLEAN
TUNE = 12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/03/04C63566.WAV
TUNE = 12
POS = 100.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 61.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 4.536 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = COMING BACK TO L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Coming Back to Life by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: String Ensemble 1.
# Oscillator 2 is A's 2, the sample Str: String Ensemble 2.
# Not carried over: modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/AE/87FA7773.WAV
READ = SAMPLE
TUNE = -4
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 13.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1E/B602C378.WAV
READ = SAMPLE
TUNE = -19
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 53.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 29.333 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.9%

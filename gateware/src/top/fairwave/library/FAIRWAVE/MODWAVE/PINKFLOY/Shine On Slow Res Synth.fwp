FAIRWAVE PATCH 1
NAME  = SHINE ON SLOW RE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Shine On Slow Res Synth by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/16 - 1/8 HPF, JC Amp Chorus, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/1B/44C590F4.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 15.8%

[OSC 2]
TABLE = MODWAVE/T/1B/44C590F4.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 15.8%

[ENV 1]
GATE = GATE 1
ATTACK = 4.467 S
DECAY = 606.667 MS
SUSTAIN = 100%
RELEASE = 3.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.133 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 72.667 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.172 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
LFO 1 > POS 1 = 9%
LFO 1 > POS 2 = 9%
ENV 2 > PITCH 1 = 3%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

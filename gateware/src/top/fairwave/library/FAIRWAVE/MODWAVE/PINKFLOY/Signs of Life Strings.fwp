FAIRWAVE PATCH 1
NAME  = SIGNS OF LIFE ST
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Signs of Life Strings by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Syn: String Ensemble Sln.
# Oscillator 2 is B's 2, the sample Syn: String Ensemble Sln.
# Not carried over: modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A0/69F54D05.WAV
READ = SAMPLE
TUNE = -13
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 1.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9F/49523122.WAV
READ = SAMPLE
TUNE = -13
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 1.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 40.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

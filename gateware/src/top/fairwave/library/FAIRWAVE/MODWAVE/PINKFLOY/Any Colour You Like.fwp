FAIRWAVE PATCH 1
NAME  = ANY COLOUR YOU L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Any Colour You Like  by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Stereo DDL 2.
[OSC 1]
TABLE = MODWAVE/T/A6/87B2AA54.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 47.6%

[OSC 2]
TABLE = MODWAVE/T/4A/9320DEDD.WAV
READ = CLEAN
TUNE = 0
POS = 47.6%

[ENV 1]
GATE = GATE 1
ATTACK = 6.667 MS
DECAY = 90.000 S
SUSTAIN = 46%
RELEASE = 2.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -79.5%
CV 1 > POS 2 = -79.5%
ENV 2 > POS 1 = 4.5%
ENV 2 > POS 2 = 4.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.8%

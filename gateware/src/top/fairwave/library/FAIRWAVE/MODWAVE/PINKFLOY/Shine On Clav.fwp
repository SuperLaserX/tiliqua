FAIRWAVE PATCH 1
NAME  = SHINE ON CLAV
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Shine On Clav by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Key: Clav 1.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/C5/33F16293.WAV
READ = SAMPLE
TUNE = -5
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 92.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C5/33F16293.WAV
TUNE = -5
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 13.333 S
SUSTAIN = 0%
RELEASE = 77.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = ROTORY ORGAN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rotory Organ by Ian Dixon: pinkfloyd.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Organ: Rotary Slow.
# Its effects, which FairWave hasn't got: Fast Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B6/41B4C2CB.WAV
READ = SAMPLE
TUNE = -19
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 0.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B6/41B4C2CB.WAV
TUNE = -19
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

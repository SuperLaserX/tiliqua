FAIRWAVE PATCH 1
NAME  = AA SY CRAYON
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Crayon by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Hawkins Massacre, Slow Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/06CA7508.WAV
READ = CLEAN
TUNE = 0
POS = 32.7%

[OSC 2]
TABLE = MODWAVE/T/C3/89D1B445.WAV
READ = CLEAN
TUNE = 19
POS = 31.0%

[ENV 1]
GATE = GATE 1
ATTACK = 100.000 MS
DECAY = 1.617 S
SUSTAIN = 5%
RELEASE = 280.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 4.2%

[ENV 2]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 886.667 MS
SUSTAIN = 6%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[LFO 1]
RATE = 0.094 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -54.5%
ENV 2 > X DEPTH = 53%
CV 1 > POS 2 = -51.5%
CV 2 > POS 1 = 40%
CV 2 > POS 2 = 38%
ENV 2 > POS 1 = 34.5%
ENV 2 > POS 2 = 32.5%
CV 2 > X DEPTH = 7.5%
LFO 1 > X DEPTH = 5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

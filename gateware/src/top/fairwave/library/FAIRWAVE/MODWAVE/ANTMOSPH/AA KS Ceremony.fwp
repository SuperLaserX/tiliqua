FAIRWAVE PATCH 1
NAME  = AA KS CEREMONY
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Ceremony by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Metallurgy Bass 9.
[OSC 1]
TABLE = MODWAVE/T/23/0E736529.WAV
READ = CLEAN
TUNE = -24
POS = 27.4%

[OSC 2]
TABLE = MODWAVE/T/D9/7A108BD1.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 27.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.036 S
SUSTAIN = 8%
RELEASE = 485.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 53.5%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.728 S
SUSTAIN = 5%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[LFO 1]
RATE = 0.330 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -45.5%
CV 1 > POS 2 = -45.5%
ENV 2 > POS 1 = 45%
ENV 2 > POS 2 = 45%
LFO 1 > X DEPTH = 19.5%
CV 2 > POS 1 = 17%
CV 2 > POS 2 = 17%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.8%

FAIRWAVE PATCH 1
NAME  = AA SY STRANGER
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Stranger by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BlkChor St. Flanger, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/34/7A225532.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 30.1%

[OSC 2]
TABLE = MODWAVE/T/69/8AD4C139.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 30.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.553 S
SUSTAIN = 15%
RELEASE = 862.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 24.9%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.253 S
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[LFO 2]
RATE = 0.317 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -50%
CV 1 > POS 2 = -50%
ENV 2 > POS 1 = 40%
ENV 2 > POS 2 = 40%
CV 2 > POS 1 = 6.5%
CV 2 > POS 2 = 6.5%
CV 2 > X DEPTH = -6%
ENV 2 > X DEPTH = 5.5%
LFO 2 > X DEPTH = 5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 28.9%

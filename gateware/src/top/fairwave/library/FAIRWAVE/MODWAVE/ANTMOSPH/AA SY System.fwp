FAIRWAVE PATCH 1
NAME  = AA SY SYSTEM
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY System by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Phaser, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/CC/DEDFFD00.WAV
READ = CLEAN
TUNE = -12
POS = 33.4%

[OSC 2]
TABLE = MODWAVE/T/41/3D9448D1.WAV
READ = CLEAN
TUNE = 5
FINE = 4
POS = 37.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.767 S
SUSTAIN = 32%
RELEASE = 438.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.663 S
SUSTAIN = 5%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -62%
CV 1 > POS 1 = -55.5%
ENV 2 > POS 2 = 37%
ENV 2 > POS 1 = 33%
CV 2 > POS 2 = 26%
CV 2 > POS 1 = 23%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.6%

FAIRWAVE PATCH 1
NAME  = AA SY PAST
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Past by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/4A/4DB6C1A3.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 28.8%

[OSC 2]
TABLE = MODWAVE/T/9B/01E9C24C.WAV
READ = CLEAN
TUNE = -12
FINE = 13
POS = 28.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.773 S
SUSTAIN = 22%
RELEASE = 1.539 S
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 322.667 MS
DECAY = 994.667 MS
SUSTAIN = 19%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48%
CV 1 > POS 2 = -48%
ENV 2 > POS 1 = 42.5%
ENV 2 > POS 2 = 42.5%
CV 2 > POS 1 = 10.5%
CV 2 > POS 2 = 10.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.4%

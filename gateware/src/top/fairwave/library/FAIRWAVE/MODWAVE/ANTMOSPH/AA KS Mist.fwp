FAIRWAVE PATCH 1
NAME  = AA KS MIST
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Mist by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Phaser, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/CB/0797FEF1.WAV
READ = CLEAN
TUNE = 0
POS = 29.2%

[OSC 2]
TABLE = MODWAVE/T/41/890EEC1F.WAV
READ = CLEAN
TUNE = 12
FINE = 2
POS = 29.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.441 S
SUSTAIN = 41%
RELEASE = 1.539 S
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.299 S
SUSTAIN = 37%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48.5%
CV 1 > POS 2 = -48.5%
ENV 2 > POS 1 = 41.5%
ENV 2 > POS 2 = 41.5%
CV 2 > POS 1 = 19.5%
CV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.5%

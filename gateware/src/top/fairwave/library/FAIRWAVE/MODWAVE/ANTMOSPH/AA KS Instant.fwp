FAIRWAVE PATCH 1
NAME  = AA KS INSTANT
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Instant by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse, Phaser, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/E2/E574BBCF.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 36.3%

[OSC 2]
TABLE = MODWAVE/T/0A/25157AE1.WAV
READ = CLEAN
TUNE = 24
FINE = 10
POS = 36.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.700 S
SUSTAIN = 10%
RELEASE = 1.497 S
A CURVE = 30
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 770.667 MS
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -60.5%
CV 1 > POS 2 = -60.5%
ENV 2 > POS 1 = 27.5%
ENV 2 > POS 2 = 27.5%
CV 2 > POS 1 = 22.5%
CV 2 > POS 2 = 22.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 6.6%

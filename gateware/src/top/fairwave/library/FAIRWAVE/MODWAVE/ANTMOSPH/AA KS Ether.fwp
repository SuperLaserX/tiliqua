FAIRWAVE PATCH 1
NAME  = AA KS ETHER
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Ether by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BPass Feedback BPM, Sidewinder, Use Your Words, bpm Growth.
[OSC 1]
TABLE = MODWAVE/T/BB/8B72DEC7.WAV
READ = CLEAN
TUNE = 0
POS = 35.0%

[OSC 2]
TABLE = MODWAVE/T/B7/880B24E6.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 35.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.828 S
SUSTAIN = 15%
RELEASE = 693.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 10.969 S
SUSTAIN = 1%
RELEASE = 2.019 S
A CURVE = 30
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58.5%
CV 1 > POS 2 = -58.5%
ENV 2 > POS 1 = 30%
ENV 2 > POS 2 = 30%
CV 2 > POS 1 = 22%
CV 2 > POS 2 = 22%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.7%

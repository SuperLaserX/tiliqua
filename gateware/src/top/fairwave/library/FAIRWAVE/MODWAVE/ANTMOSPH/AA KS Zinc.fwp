FAIRWAVE PATCH 1
NAME  = AA KS ZINC
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Zinc by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/5E/3132CC33.WAV
READ = CLEAN
TUNE = -12
POS = 24.6%

[OSC 2]
TABLE = MODWAVE/T/56/2644492C.WAV
READ = CLEAN
TUNE = -12
FINE = 9
POS = 24.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.036 S
SUSTAIN = 30%
RELEASE = 485.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 385.333 MS
SUSTAIN = 5%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51%
ENV 2 > POS 2 = 51%
CV 1 > POS 1 = -41%
CV 1 > POS 2 = -41%
CV 2 > POS 1 = 18%
CV 2 > POS 2 = 18%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

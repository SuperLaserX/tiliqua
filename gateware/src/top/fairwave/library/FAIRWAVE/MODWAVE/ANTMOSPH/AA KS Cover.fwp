FAIRWAVE PATCH 1
NAME  = AA KS COVER
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Cover by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/6D/A30041FA.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 32.3%

[OSC 2]
TABLE = MODWAVE/T/F7/8705F241.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 32.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.477 S
SUSTAIN = 19%
RELEASE = 913.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.315 S
SUSTAIN = 0%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 40
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -54%
CV 1 > POS 2 = -54%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
CV 2 > POS 1 = 24.5%
CV 2 > POS 2 = 24.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.3%

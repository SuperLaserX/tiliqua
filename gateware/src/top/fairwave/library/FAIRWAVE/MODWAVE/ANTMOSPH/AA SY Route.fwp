FAIRWAVE PATCH 1
NAME  = AA SY ROUTE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Route by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted HPF, Bandpass Triplets, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/1D/0C06E16F.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/49/93DDB5FB.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.981 S
SUSTAIN = 10%
RELEASE = 892.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 324.000 MS
DECAY = 4.713 S
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
ENV 1 > POS 2 = 17.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.9%

FAIRWAVE PATCH 1
NAME  = AA SY BACKGROUND
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Background by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 & Dotted 1/8, 500ms, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/FF/248C4C62.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 39.2%

[OSC 2]
TABLE = MODWAVE/T/56/9812EE9D.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 39.2%

[ENV 1]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 4.769 S
SUSTAIN = 9%
RELEASE = 1.411 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 4.713 S
SUSTAIN = 1%
RELEASE = 1.544 S
A CURVE = 30
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -65.5%
CV 1 > POS 2 = -65.5%
ENV 2 > POS 1 = 21.5%
ENV 2 > POS 2 = 21.5%
CV 2 > POS 1 = 15%
CV 2 > POS 2 = 15%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.4%

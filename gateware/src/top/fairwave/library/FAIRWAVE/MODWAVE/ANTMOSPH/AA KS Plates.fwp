FAIRWAVE PATCH 1
NAME  = AA KS PLATES
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Plates by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, 1/8 dotted LPF, 12-bit Decimator, Suspenstrings, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BF/C8BE67BA.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/FE/2F0009F2.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 36.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.769 S
SUSTAIN = 9%
RELEASE = 872.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.1%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.713 S
SUSTAIN = 1%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 20
R CURVE = 60

[LFO 1]
RATE = 0.813 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > POS 1 = 100%
CV 1 > POS 2 = -60.5%
ENV 2 > POS 2 = 27%
CV 2 > POS 2 = 16.5%
ENV 2 > X DEPTH = 5.5%
LFO 1 > X DEPTH = -1.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 77.5%

FAIRWAVE PATCH 1
NAME  = AA KS HEARTH
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Hearth by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Glass Pad, Li'l Pirate Hollow, Slow Vintage Flanger, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/33/0EF06D89.WAV
READ = CLEAN
TUNE = -12
POS = 33.0%

[OSC 2]
TABLE = MODWAVE/T/6C/1D406DDB.WAV
READ = CLEAN
TUNE = -12
FINE = 16
POS = 33.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.828 S
SUSTAIN = 12%
RELEASE = 693.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 29.4%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.972 S
SUSTAIN = 1%
RELEASE = 2.019 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.813 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55%
CV 1 > POS 2 = -55%
CV 2 > POS 1 = 34%
CV 2 > POS 2 = 34%
ENV 2 > POS 1 = 28%
ENV 2 > POS 2 = 28%
ENV 2 > X DEPTH = 5.5%
LFO 1 > X DEPTH = -1.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.2%

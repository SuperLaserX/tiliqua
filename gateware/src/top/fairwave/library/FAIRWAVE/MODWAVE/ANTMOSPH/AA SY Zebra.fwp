FAIRWAVE PATCH 1
NAME  = AA SY ZEBRA
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Zebra by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E9/D8112C80.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 32.9%

[OSC 2]
TABLE = MODWAVE/T/26/87861897.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 32.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.477 S
SUSTAIN = 24%
RELEASE = 489.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.315 S
SUSTAIN = 0%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55%
CV 1 > POS 2 = -55%
ENV 2 > POS 1 = 34%
ENV 2 > POS 2 = 34%
CV 2 > POS 1 = 15%
CV 2 > POS 2 = 15%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.9%

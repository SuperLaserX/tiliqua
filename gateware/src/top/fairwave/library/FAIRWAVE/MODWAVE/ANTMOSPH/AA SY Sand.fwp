FAIRWAVE PATCH 1
NAME  = AA SY SAND
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Sand by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Vintage Flanger, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/7C/6E976AFD.WAV
READ = CLEAN
TUNE = -12
POS = 28.0%

[OSC 2]
TABLE = MODWAVE/T/B4/79683066.WAV
READ = CLEAN
TUNE = 0
FINE = 18
POS = 28.0%

[ENV 1]
GATE = GATE 1
ATTACK = 61.333 MS
DECAY = 3.441 S
SUSTAIN = 30%
RELEASE = 98.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 68.000 MS
DECAY = 593.333 MS
SUSTAIN = 13%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
ENV 2 > POS 1 = 44%
ENV 2 > POS 2 = 44%
CV 2 > POS 1 = 5%
CV 2 > POS 2 = 5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

FAIRWAVE PATCH 1
NAME  = AA SY SPIDER
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Spider by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Mband Up.
[OSC 1]
TABLE = MODWAVE/T/9F/65904D27.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 31.5%

[OSC 2]
TABLE = MODWAVE/T/97/8F3983A1.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 31.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.477 S
SUSTAIN = 19%
RELEASE = 538.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 965.333 MS
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 40
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52.5%
CV 1 > POS 2 = -52.5%
ENV 2 > POS 1 = 37%
ENV 2 > POS 2 = 37%
CV 2 > POS 1 = 4%
CV 2 > POS 2 = 4%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.1%

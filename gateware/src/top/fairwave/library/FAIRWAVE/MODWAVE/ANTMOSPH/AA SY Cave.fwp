FAIRWAVE PATCH 1
NAME  = AA SY CAVE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Cave by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/58/D8A7C048.WAV
READ = CLEAN
TUNE = -12
FINE = -5
POS = 31.0%

[OSC 2]
TABLE = MODWAVE/T/C3/17D58FB6.WAV
READ = CLEAN
TUNE = -24
FINE = 10
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.981 S
SUSTAIN = 14%
RELEASE = 832.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 33.333 MS
DECAY = 836.000 MS
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -51.5%
ENV 2 > POS 1 = 38%
CV 2 > POS 1 = 22%
ENV 1 > POS 2 = 17.5%
CV 2 > X DEPTH = -6%
ENV 2 > X DEPTH = 5.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.5%

FAIRWAVE PATCH 1
NAME  = AA KS CROSSING
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Crossing by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: EP Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/B8/851CBA26.WAV
READ = CLEAN
TUNE = -12
POS = 28.8%

[OSC 2]
TABLE = MODWAVE/T/A3/18D5DE4E.WAV
READ = CLEAN
TUNE = -24
FINE = 17
POS = 28.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.828 S
SUSTAIN = 5%
RELEASE = 1.160 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.972 S
SUSTAIN = 1%
RELEASE = 2.019 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48%
CV 1 > POS 2 = -48%
CV 2 > POS 1 = 42.5%
CV 2 > POS 2 = 42.5%
ENV 2 > POS 1 = 17%
ENV 2 > POS 2 = 17%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 27.8%

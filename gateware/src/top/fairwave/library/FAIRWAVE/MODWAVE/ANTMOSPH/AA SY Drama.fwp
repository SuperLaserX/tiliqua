FAIRWAVE PATCH 1
NAME  = AA SY DRAMA
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Drama by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BlkChor St. Flanger, Vintage Stereo Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/DC/4F4387A3.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1F/7D65B387.WAV
READ = CLEAN
TUNE = 0
FINE = 15
POS = 34.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.553 S
SUSTAIN = 15%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.253 S
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -56.5%
ENV 2 > POS 2 = 32%
CV 2 > POS 2 = 14%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 25.8%

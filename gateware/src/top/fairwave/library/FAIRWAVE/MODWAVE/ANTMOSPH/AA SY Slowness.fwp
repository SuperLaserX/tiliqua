FAIRWAVE PATCH 1
NAME  = AA SY SLOWNESS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Slowness by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Bandpass Triplets, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/C9/2E954EA4.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/5E/C4698D60.WAV
READ = CLEAN
TUNE = 0
FINE = 9
POS = 33.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.769 S
SUSTAIN = 11%
RELEASE = 1.623 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 613.333 MS
DECAY = 4.713 S
SUSTAIN = 10%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -55.5%
ENV 2 > POS 2 = 33.5%
CV 2 > POS 2 = 18%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

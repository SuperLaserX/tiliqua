FAIRWAVE PATCH 1
NAME  = AA KS REACTION
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Reaction by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Glass Pad, Wave Piano Bite, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/40/8CB5D632.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 23.4%

[OSC 2]
TABLE = MODWAVE/T/6A/E26AB58A.WAV
READ = CLEAN
TUNE = 0
FINE = 14
POS = 23.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.195 S
SUSTAIN = 9%
RELEASE = 240.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 976.000 MS
SUSTAIN = 13%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 53%
CV 2 > POS 2 = 53%
CV 1 > POS 1 = -39%
CV 1 > POS 2 = -39%
ENV 2 > POS 1 = 25%
ENV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

FAIRWAVE PATCH 1
NAME  = AA SY BREATH
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Breath by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Vintage Stereo Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/2B/A719D65C.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 29.2%

[OSC 2]
TABLE = MODWAVE/T/D3/1D5F7E07.WAV
READ = CLEAN
TUNE = -12
FINE = 19
POS = 29.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.195 S
SUSTAIN = 8%
RELEASE = 240.000 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 492.000 MS
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48.5%
CV 1 > POS 2 = -48.5%
ENV 2 > POS 1 = 41.5%
ENV 2 > POS 2 = 41.5%
CV 2 > POS 1 = 27%
CV 2 > POS 2 = 27%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.0%

FAIRWAVE PATCH 1
NAME  = AA KS SKYWARD
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Skyward by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 350_700ms LR DDL, BlkChor mono, LCR Long Delay 1, Modern Compressor, Phaser.
[OSC 1]
TABLE = MODWAVE/T/21/017CDDA1.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 31.7%

[OSC 2]
TABLE = MODWAVE/T/20/955601A0.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 31.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.875 S
SUSTAIN = 10%
RELEASE = 978.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.300 S
SUSTAIN = 0%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 20
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53%
CV 1 > POS 2 = -53%
CV 2 > POS 1 = 36.5%
CV 2 > POS 2 = 36.5%
ENV 2 > POS 1 = 21.5%
ENV 2 > POS 2 = 21.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.3%

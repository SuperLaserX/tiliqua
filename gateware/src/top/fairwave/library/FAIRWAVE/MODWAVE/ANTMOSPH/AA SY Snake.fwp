FAIRWAVE PATCH 1
NAME  = AA SY SNAKE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA SY Snake by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/0A/D64D09D1.WAV
READ = CLEAN
TUNE = -12
POS = 29.4%

[OSC 2]
TABLE = MODWAVE/T/BE/BE97F157.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 29.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.036 S
SUSTAIN = 31%
RELEASE = 485.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.728 S
SUSTAIN = 5%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -49%
CV 1 > POS 2 = -49%
ENV 2 > POS 1 = 41%
ENV 2 > POS 2 = 41%
CV 2 > POS 1 = 19.5%
CV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.6%

FAIRWAVE PATCH 1
NAME  = AA KS INK
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Ink by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Glass Pad, Phaser.
[OSC 1]
TABLE = MODWAVE/T/46/E1190BC8.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 31.3%

[OSC 2]
TABLE = MODWAVE/T/63/9AB72807.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 31.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.801 S
SUSTAIN = 15%
RELEASE = 538.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 965.333 MS
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 40
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52%
CV 1 > POS 2 = -52%
ENV 2 > POS 1 = 37.5%
ENV 2 > POS 2 = 37.5%
CV 2 > POS 1 = 6.5%
CV 2 > POS 2 = 6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

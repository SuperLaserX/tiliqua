FAIRWAVE PATCH 1
NAME  = AA KS MOON
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AA KS Moon by Anton Anru: Korg Modwave - Antmospheric Keys Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Vintage Flanger, Wave Piano Bite, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F3/EEC24289.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/F2/B6A524A7.WAV
READ = CLEAN
TUNE = 12
FINE = 6
POS = 30.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.553 S
SUSTAIN = 15%
RELEASE = 862.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.253 S
SUSTAIN = 12%
RELEASE = 1.544 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -50%
ENV 2 > POS 2 = 40%
CV 2 > POS 2 = 12.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.5%

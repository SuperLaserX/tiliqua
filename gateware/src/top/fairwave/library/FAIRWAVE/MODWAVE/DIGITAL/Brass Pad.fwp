FAIRWAVE PATCH 1
NAME  = BRASS PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Brass Pad by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Brite Pad.
# Oscillator 2 is B's 2, the sample Syn: Brass Pad.
# Not carried over: layer A oscillator 1, layer B oscillator 1.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/4C/02AED176.WAV
READ = SAMPLE
TUNE = -6
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 66%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D9/ED74F274.WAV
READ = SAMPLE
TUNE = -48
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 17.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 16.667 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 88.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.4%

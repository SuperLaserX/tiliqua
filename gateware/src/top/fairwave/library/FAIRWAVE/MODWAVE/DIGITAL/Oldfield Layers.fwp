FAIRWAVE PATCH 1
NAME  = OLDFIELD LAYERS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Oldfield Layers by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Flute Pad.
# Oscillator 2 is B's 2, the sample Syn: Texture Elly 2.
# Not carried over: layer A oscillator 2, layer B oscillator 1.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor, Smooth Tremolo, Vintage Tine EP Chorus, bpm Mband Bounce, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/69/7A49B397.WAV
READ = SAMPLE
TUNE = -19
FINE = -27
POS = 0.0%
EDGE = WRAP
LOOP = 20.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/18/8356FC0E.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 25.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.533 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

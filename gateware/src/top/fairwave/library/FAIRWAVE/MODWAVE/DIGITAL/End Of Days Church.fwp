FAIRWAVE PATCH 1
NAME  = END OF DAYS CHUR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's End Of Days Church by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Organ_WS: PipeOrg1.
# Oscillator 2 is A's 2, the sample FX: ChurchBell.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/72/FD2FC5E3.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 10.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1C/4041F522.WAV
READ = SAMPLE
TUNE = -24
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 93.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 366.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 81.0%

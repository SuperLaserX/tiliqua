FAIRWAVE PATCH 1
NAME  = DIGITAL LINE PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digital Line Pad by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Ooh.
# Oscillator 2 is A's 2, the sample Syn_WS: SynString.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C7/40D8C849.WAV
READ = SAMPLE
TUNE = -30
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 32%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/49/2F687C66.WAV
READ = SAMPLE
TUNE = -25
FINE = 23
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 800.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 2.024 S
SUSTAIN = 29%
RELEASE = 2.024 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = BRASS STABS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Brass Stabs by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynBrass.
# Oscillator 2 is A's 2, the sample Syn: Brite Pad.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/56/89089B60.WAV
READ = SAMPLE
TUNE = -6
FINE = -41
POS = 0.0%
EDGE = WRAP
LOOP = 83%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/37/50F221C9.WAV
READ = SAMPLE
TUNE = -6
FINE = 46
POS = 0.0%
EDGE = WRAP
LOOP = 22.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 88.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 1%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 64.6%

FAIRWAVE PATCH 1
NAME  = FM CLAV SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's FM Clav Seq by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_WS: ClavTS-5.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/E0/A2C9CBDF.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/47/8E6F2D09.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 60.000 MS
SUSTAIN = 0%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 40.4%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = SAGA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Saga by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: MagicOrgan.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D9/1A5A0BF8.WAV
READ = SAMPLE
TUNE = -34
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 26.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/04/FB62DD8B.WAV
READ = SAMPLE
TUNE = -24
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.008 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = -76%
ENV 2 > LEVEL 2 = 63%
ENV 2 > PITCH 1 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

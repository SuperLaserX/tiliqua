FAIRWAVE PATCH 1
NAME  = D50 LEAD GUITAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D50 Lead Guitar by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Dist Muted mp.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Lead Rock Guitar, Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2A/1A84D62F.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 34.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 80.2%

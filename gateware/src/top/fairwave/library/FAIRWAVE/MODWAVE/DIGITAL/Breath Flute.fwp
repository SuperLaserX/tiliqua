FAIRWAVE PATCH 1
NAME  = BREATH FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Breath Flute by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is B's 1, the sample Syn: Choral Multi Flutes.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E7/4018EF47.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/8E/BEB28F70.WAV
READ = SAMPLE
TUNE = -37
FINE = 22
POS = 0.0%
EDGE = WRAP
LOOP = 7.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 62.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 79.2%

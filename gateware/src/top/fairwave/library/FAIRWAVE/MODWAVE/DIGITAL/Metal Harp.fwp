FAIRWAVE PATCH 1
NAME  = METAL HARP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Metal Harp by Ian dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Plk_WS: Harp WS.
# Oscillator 2 is A's 2, the sample Syn: Air Vox.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/49/61B0D3A7.WAV
READ = SAMPLE
TUNE = -6
FINE = -42
POS = 0.0%
EDGE = WRAP
LOOP = 79.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/86/5E608B7E.WAV
READ = SAMPLE
TUNE = -14
FINE = 34
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.267 S
SUSTAIN = 17%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 65.333 MS
SUSTAIN = 20%
RELEASE = 2.152 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 61%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = WARM PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Warm Pad by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: White Pad.
# Oscillator 2 is A's 2, the sample Syn: White Pad.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus 2, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/80/6B8BF088.WAV
READ = SAMPLE
TUNE = -37
FINE = 5
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/77/5DF1CAE8.WAV
READ = SAMPLE
TUNE = -37
FINE = 13
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 84.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 760.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

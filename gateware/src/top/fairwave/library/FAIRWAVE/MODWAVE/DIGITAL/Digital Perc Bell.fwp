FAIRWAVE PATCH 1
NAME  = DIGITAL PERC BEL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digital Perc Bell by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell: Granular Perc 11.
# Oscillator 2 is A's 2, the sample Bell: Glass Bell.
# Its effects, which FairWave hasn't got: Smooth Tremolo, Super Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/F5/95677BED.WAV
READ = SAMPLE
TUNE = -46
FINE = -35
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CD/477961C6.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 38.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.533 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

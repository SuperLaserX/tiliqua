FAIRWAVE PATCH 1
NAME  = M1 PIANOSTACK
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 PianoStack by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: M1 Piano.
# Oscillator 2 is A's 2, the sample Wave: DWGS E.P.2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus 2.
[OSC 1]
TABLE = MODWAVE/T/65/424F687C.WAV
READ = SAMPLE
TUNE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 95.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CD/5BB2703D.WAV
READ = SAMPLE
TUNE = 0
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.133 S
SUSTAIN = 0%
RELEASE = 586.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

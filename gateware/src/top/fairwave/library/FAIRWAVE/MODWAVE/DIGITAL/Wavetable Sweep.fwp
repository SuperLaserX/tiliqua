FAIRWAVE PATCH 1
NAME  = WAVETABLE SWEEP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wavetable Sweep by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/63/9DDB2544.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/96/7A61E1E5.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 90.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 760.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 90.000 S
SUSTAIN = 90%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.6%

FAIRWAVE PATCH 1
NAME  = DIGITAL TRON VOC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digital Tron Vocal by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Not carried over: modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Tine EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BC/E36089DC.WAV
READ = SAMPLE
TUNE = -15
FINE = -35
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3A/AABBC627.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.7%

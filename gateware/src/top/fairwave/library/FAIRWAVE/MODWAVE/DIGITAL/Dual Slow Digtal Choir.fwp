FAIRWAVE PATCH 1
NAME  = DUAL SLOW DIGTAL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dual Slow Digtal Choir by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, the sample Vox: Vocoder VP.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, Stereo Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/13/A813FCF2.WAV
READ = SAMPLE
TUNE = -12
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5F/6FD60710.WAV
READ = SAMPLE
TUNE = -12
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.267 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

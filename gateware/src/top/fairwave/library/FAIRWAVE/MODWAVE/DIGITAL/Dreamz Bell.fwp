FAIRWAVE PATCH 1
NAME  = DREAMZ BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dreamz Bell by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_Guru: Chorus Dreamz.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B2/3A9136EC.WAV
READ = SAMPLE
TUNE = -40
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 55%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/03/04C63566.WAV
READ = CLEAN
TUNE = 12
POS = 37.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 620.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 41%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

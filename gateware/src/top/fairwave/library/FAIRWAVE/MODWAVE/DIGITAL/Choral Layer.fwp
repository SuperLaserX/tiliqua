FAIRWAVE PATCH 1
NAME  = CHORAL LAYER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Choral Layer by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Choral Multi Flutes.
# Oscillator 2 is A's 2, the sample Wave_WS: Xenon.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/70/21A27521.WAV
READ = SAMPLE
TUNE = -25
FINE = 22
POS = 0.0%
EDGE = WRAP
LOOP = 7.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3C/213B3902.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 346.667 MS
SUSTAIN = 17%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.3%

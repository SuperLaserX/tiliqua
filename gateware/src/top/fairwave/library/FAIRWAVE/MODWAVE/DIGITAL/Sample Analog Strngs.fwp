FAIRWAVE PATCH 1
NAME  = SAMPLE ANALOG ST
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sample Analog Strngs by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Analog Strings 2.
# Oscillator 2 is A's 2, the sample Syn: Analog Strings 1.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/FD/DCCC8374.WAV
READ = SAMPLE
TUNE = -41
FINE = -33
POS = 0.0%
EDGE = WRAP
LOOP = 0.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2F/0D5D8ECE.WAV
READ = SAMPLE
TUNE = -13
FINE = -33
POS = 0.0%
EDGE = WRAP
LOOP = 8.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 140.000 MS
DECAY = 86.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

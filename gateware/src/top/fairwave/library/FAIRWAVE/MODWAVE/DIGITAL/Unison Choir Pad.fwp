FAIRWAVE PATCH 1
NAME  = UNISON CHOIR PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Unison Choir Pad by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Vox_WS:Choir.
# Oscillator 2 is B's 2, the sample Str: String Ensemble 3.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7D/B7B6B0CA.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A5/B3D70EE2.WAV
READ = SAMPLE
TUNE = -7
POS = 0.0%
EDGE = WRAP
LOOP = 17.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 2.856 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

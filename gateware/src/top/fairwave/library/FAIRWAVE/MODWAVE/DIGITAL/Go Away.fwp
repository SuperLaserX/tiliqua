FAIRWAVE PATCH 1
NAME  = GO AWAY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Go Away by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: MagicOrgan.
# Oscillator 2 is A's 2, the sample Wave: Triangle EXB.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/47/69FED9DC.WAV
READ = SAMPLE
TUNE = -22
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 26.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/34/5C06DEEC.WAV
READ = SAMPLE
TUNE = 2
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 52.000 MS
DECAY = 26.667 MS
SUSTAIN = 95%
RELEASE = 1.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.5%

FAIRWAVE PATCH 1
NAME  = REVERSE TUBULAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Reverse Tubular by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell: Tubular Bell.
# Oscillator 2 is A's 2, the sample Bell: Tubular Bell.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/E2/AD73C6F2.WAV
READ = SAMPLE
TUNE = -27
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 70.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C8/4A64517E.WAV
READ = SAMPLE
TUNE = -27
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 70.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.133 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.728 S
DECAY = 3.880 S
SUSTAIN = 98%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 82%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

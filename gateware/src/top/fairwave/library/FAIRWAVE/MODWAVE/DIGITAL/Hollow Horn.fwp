FAIRWAVE PATCH 1
NAME  = HOLLOW HORN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Hollow Horn by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Brs: French Horns f.
# Oscillator 2 is A's 2, the sample Syn: Lead Pro5.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Wave Piano Bite, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/2D/69C108DC.WAV
READ = SAMPLE
TUNE = -29
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 40.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A9/F14FF9FF.WAV
READ = SAMPLE
TUNE = -8
FINE = 36
POS = 0.0%
EDGE = WRAP
LOOP = 38.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 240.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 926.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 90.000 S
SUSTAIN = 93%
RELEASE = 1.512 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > PITCH 2 = -1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

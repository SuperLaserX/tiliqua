FAIRWAVE PATCH 1
NAME  = PWM PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PWM Pad by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Detuned PWM.
[OSC 1]
TABLE = MODWAVE/T/E9/270C2990.WAV
READ = SAMPLE
TUNE = -22
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 1.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E9/270C2990.WAV
TUNE = -22
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 121.333 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

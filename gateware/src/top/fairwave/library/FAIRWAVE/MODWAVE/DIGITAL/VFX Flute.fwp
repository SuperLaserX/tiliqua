FAIRWAVE PATCH 1
NAME  = VFX FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VFX Flute by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd_WS: Hard Flute.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/21/757E5A25.WAV
READ = SAMPLE
TUNE = -32
FINE = 46
POS = 0.0%
EDGE = WRAP
LOOP = 36.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CF/CD63C837.WAV
READ = CLEAN
TUNE = 0
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 873.333 MS
SUSTAIN = 50%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.672 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 2 = -21%
LFO 1 > PITCH 2 = -0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

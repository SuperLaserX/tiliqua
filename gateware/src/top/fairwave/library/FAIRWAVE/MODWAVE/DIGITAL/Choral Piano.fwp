FAIRWAVE PATCH 1
NAME  = CHORAL PIANO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Choral Piano by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Choral Multi Flutes.
# Oscillator 2 is A's 2, the sample Hit: VoxWave Chord.
# Not carried over: layer B oscillator 2, modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/93/981939B6.WAV
READ = SAMPLE
TUNE = -25
FINE = 20
POS = 0.0%
EDGE = WRAP
LOOP = 7.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F0/520476AD.WAV
READ = SAMPLE
TUNE = 11
FINE = 34
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.067 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 893.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 121.333 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 0.5%
ENV 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.4%

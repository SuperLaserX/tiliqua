FAIRWAVE PATCH 1
NAME  = 80S POP BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 80s Pop Brass by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Brs_WS: BrassEns.
# Oscillator 2 is A's 2, the sample Syn: Power Saw.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/3E/392FAD23.WAV
READ = SAMPLE
TUNE = -22
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 24.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7B/EC5DC9FC.WAV
READ = SAMPLE
TUNE = -7
FINE = -6
POS = 0.0%
EDGE = WRAP
LOOP = 18.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.6%

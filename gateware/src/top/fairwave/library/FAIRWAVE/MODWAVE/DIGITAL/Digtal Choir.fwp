FAIRWAVE PATCH 1
NAME  = DIGTAL CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digtal Choir by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Ooh.
# Oscillator 2 is A's 2, the sample Wave_Guru: Triangle DSP.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/94/4BDB0096.WAV
READ = SAMPLE
TUNE = -30
FINE = 23
POS = 0.0%
EDGE = WRAP
LOOP = 32%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/39/EFC0737C.WAV
READ = SAMPLE
TUNE = -5
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 193.333 MS
DECAY = 26.667 MS
SUSTAIN = 97%
RELEASE = 1.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 202.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

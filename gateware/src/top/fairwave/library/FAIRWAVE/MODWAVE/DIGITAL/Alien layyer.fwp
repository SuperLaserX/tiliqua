FAIRWAVE PATCH 1
NAME  = ALIEN LAYYER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Alien layyer by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynPad2a.
# Oscillator 2 is A's 2, the sample Syn_WS: Spectrm2.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7E/1A135CB7.WAV
READ = SAMPLE
TUNE = -18
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/74/4C510821.WAV
READ = SAMPLE
TUNE = -46
FINE = -21
POS = 0.0%
EDGE = WRAP
LOOP = 3.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 280.000 MS
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 860.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.305 S
DECAY = 1.959 S
SUSTAIN = 79%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

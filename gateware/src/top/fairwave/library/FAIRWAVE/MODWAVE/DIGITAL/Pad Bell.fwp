FAIRWAVE PATCH 1
NAME  = PAD BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pad Bell by Ian Dixon: Digital.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Flute Pad.
# Oscillator 2 is A's 2, the sample Bell: Metal VPM Bell.
# Its effects, which FairWave hasn't got: Smooth Tremolo, Vintage Tine EP Chorus, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/69/7A49B397.WAV
READ = SAMPLE
TUNE = -19
FINE = -27
POS = 0.0%
EDGE = WRAP
LOOP = 20.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E6/2874929D.WAV
READ = SAMPLE
TUNE = -7
FINE = -2
POS = 0.0%
EDGE = WRAP
LOOP = 40.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.533 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 19.9%

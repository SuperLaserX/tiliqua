FAIRWAVE PATCH 1
NAME  = AR PPG DECIDRONA
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG Decidronal by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: 12-bit Decimator, Made4 Slow Pads, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/FD/FFC8D0DE.WAV
READ = CLEAN
TUNE = -24
POS = 33.2%

[OSC 2]
TABLE = MODWAVE/T/64/59656C83.WAV
READ = CLEAN
TUNE = -12
POS = 33.2%

[ENV 1]
GATE = GATE 1
ATTACK = 413.333 MS
DECAY = 10.667 S
SUSTAIN = 47%
RELEASE = 2.000 S
A CURVE = 10
D CURVE = 0
R CURVE = 20
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 3.653 S
DECAY = 23.333 S
SUSTAIN = 0%
RELEASE = 2.667 S
A CURVE = 0
D CURVE = 10
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55.5%
CV 1 > POS 2 = -55.5%
ENV 2 > POS 1 = 33.5%
ENV 2 > POS 2 = 33.5%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.1%

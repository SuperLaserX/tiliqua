FAIRWAVE PATCH 1
NAME  = AR MS2K NEW DIGI
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AR MS2k New Digi Keys by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, its wavetable.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: layer A oscillator 1, layer A oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BATesque Bassline, EP Chorus, Emotive Pad, Nice Stereo DDL.
[OSC 1]
TABLE = MODWAVE/T/5D/5B4E2E1C.WAV
READ = CLEAN
TUNE = -12
POS = 80.5%

[OSC 2]
TABLE = MODWAVE/T/5D/5B4E2E1C.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.200 S
SUSTAIN = 0%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 8.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

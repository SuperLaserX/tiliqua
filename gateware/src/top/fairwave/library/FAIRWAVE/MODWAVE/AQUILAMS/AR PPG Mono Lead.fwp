FAIRWAVE PATCH 1
NAME  = AR PPG MONO LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Mono Lead by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: BlkChor St. Chorus, bpm Tape Rhythm.
[OSC 1]
TABLE = MODWAVE/T/2C/125F8674.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/2C/125F8674.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 4.093 S
SUSTAIN = 95%
RELEASE = 460.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.600 S
DECAY = 4.800 S
SUSTAIN = 0%
RELEASE = 4.200 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = AR PPG MULTI PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Multi Pad by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 350_700ms LR DDL, BATesque Bassline.
[OSC 1]
TABLE = MODWAVE/T/A7/E0B76403.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 43.8%

[OSC 2]
TABLE = MODWAVE/T/6F/09C3C4F4.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 58.667 MS
DECAY = 2.347 S
SUSTAIN = 67%
RELEASE = 820.000 MS
A CURVE = 0
D CURVE = 20
R CURVE = 30
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 2.773 S
SUSTAIN = 0%
RELEASE = 3.213 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -73%
ENV 2 > POS 1 = 12.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 16.5%

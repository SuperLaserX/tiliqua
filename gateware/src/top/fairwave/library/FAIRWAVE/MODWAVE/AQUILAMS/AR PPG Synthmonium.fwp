FAIRWAVE PATCH 1
NAME  = AR PPG SYNTHMONI
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Synthmonium by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Made4 Slow Pads, Shimmer Flange, Smooth Tremolo, Synth Brass.
[OSC 1]
TABLE = MODWAVE/T/AA/3E01D444.WAV
READ = CLEAN
TUNE = -24
FINE = 8
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/05/3E61B5B4.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 92.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.245 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 13.0%

FAIRWAVE PATCH 1
NAME  = AR PADDED WARMTH
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR Padded Warmth by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/E5/C736E355.WAV
READ = CLEAN
TUNE = -24
FINE = 6
POS = 41.8%

[OSC 2]
TABLE = MODWAVE/T/30/4EA3D240.WAV
READ = CLEAN
TUNE = 0
FINE = -6
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.053 S
DECAY = 6.000 S
SUSTAIN = 29%
RELEASE = 3.107 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 100%
CV 1 > POS 1 = 69.5%
CV 2 > POS 1 = 16.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.3%

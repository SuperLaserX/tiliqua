FAIRWAVE PATCH 1
NAME  = AR PPG IT'S SWEL
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG It's Swell by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Detuned PWM.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Glass Pad, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/4E/B0EFF806.WAV
READ = SAMPLE
TUNE = -10
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 1.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F7/2E10CDEA.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 52.000 MS
DECAY = 13.333 S
SUSTAIN = 0%
RELEASE = 2.067 S
A CURVE = 30
D CURVE = 20
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.267 S
DECAY = 1.533 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 20
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 61.8%

FAIRWAVE PATCH 1
NAME  = AR PPG DARK ENER
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG Dark Energy by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Its effects, which FairWave hasn't got: Made4 Slow Pads, Phaser, Warp Alarm Claxon.
[OSC 1]
TABLE = MODWAVE/T/76/8C7B9ABF.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/7A/BC4A8F5F.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.227 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 8.000 S
DECAY = 1.000 S
SUSTAIN = 100%
RELEASE = 5.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.6%

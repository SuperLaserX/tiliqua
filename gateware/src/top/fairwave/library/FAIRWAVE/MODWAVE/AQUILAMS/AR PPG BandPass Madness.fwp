FAIRWAVE PATCH 1
NAME  = AR PPG BANDPASS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG BandPass Madness by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: BATesque Bassline, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/FA/DED7E0A0.WAV
READ = CLEAN
TUNE = -24
POS = 31.6%

[OSC 2]
TABLE = MODWAVE/T/F5/EBFBAEEB.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 30
VCA = BOTH

[LFO 1]
RATE = 0.071 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 40%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.1%

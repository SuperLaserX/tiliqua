FAIRWAVE PATCH 1
NAME  = AR PPG PSYCHONAU
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AR PPG Psychonauts by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Alligatorz, Nice Stereo DDL, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/CB/EB116FD0.WAV
READ = CLEAN
TUNE = 0
POS = 35.4%

[OSC 2]
TABLE = MODWAVE/T/E5/C736E355.WAV
READ = CLEAN
TUNE = -24
FINE = 6
POS = 41.8%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 560.000 MS
SUSTAIN = 28%
RELEASE = 346.667 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 513.333 MS
SUSTAIN = 0%
RELEASE = 433.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 0.066 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 69.5%
CV 1 > POS 1 = -59%
ENV 2 > POS 1 = 29%
CV 2 > POS 2 = 16.5%
LFO 2 > POS 1 = 15%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.1%

FAIRWAVE PATCH 1
NAME  = AR MS2K POLAR IC
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR MS2k Polar Ice by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BATesque Bassline, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/4E/C20CEF46.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3F/AF13683A.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 14.667 S
DECAY = 6.000 S
SUSTAIN = 81%
RELEASE = 2.933 S
A CURVE = 70
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.010 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = -50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.6%

FAIRWAVE PATCH 1
NAME  = AR MS2K TIME DUA
ABOUT = RHYTHM HARD FROM MODWAVE. GATE 1, 

# From the modwave's AR MS2k Time Duality by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF 2, BATesque Bassline.
[OSC 1]
TABLE = MODWAVE/T/90/CAD1FB98.WAV
READ = CLEAN
TUNE = 0
FINE = 5
POS = 19.9%

[OSC 2]
TABLE = MODWAVE/T/AD/81677B45.WAV
READ = CLEAN
TUNE = 0
FINE = -5
POS = 19.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 600.000 MS
SUSTAIN = 0%
RELEASE = 380.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 940.000 MS
SUSTAIN = 0%
RELEASE = 1.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.742 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33%
CV 1 > POS 2 = -33%
CV 2 > POS 1 = 8.5%
CV 2 > POS 2 = 8.5%
LFO 1 > POS 1 = 6.5%
LFO 1 > POS 2 = 6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.3%

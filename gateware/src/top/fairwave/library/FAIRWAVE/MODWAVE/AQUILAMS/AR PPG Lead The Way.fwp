FAIRWAVE PATCH 1
NAME  = AR PPG LEAD THE
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Lead The Way by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: BlkChor St. Chorus, bpm Tape Rhythm.
[OSC 1]
TABLE = MODWAVE/T/02/6FD79DF7.WAV
READ = CLEAN
TUNE = -24
FINE = 4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/AA/09975357.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 4.093 S
SUSTAIN = 95%
RELEASE = 460.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.600 S
DECAY = 4.800 S
SUSTAIN = 0%
RELEASE = 4.200 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.060 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = 50.5%
LFO 1 > POS 2 = 19.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.0%

FAIRWAVE PATCH 1
NAME  = AR BASIC SAW
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR Basic Saw by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: BATesque Bassline, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/53/46546DC4.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/6C/C90CFFC0.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 S
SUSTAIN = 38%
RELEASE = 1.800 S
A CURVE = 30
D CURVE = 30
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = AR STYLE PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR Style Pad by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: BATesque Bassline, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/A5/1F4DB6E9.WAV
READ = CLEAN
TUNE = -12
FINE = 8
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/FF/68965B50.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.147 S
DECAY = 2.933 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 41%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.5%

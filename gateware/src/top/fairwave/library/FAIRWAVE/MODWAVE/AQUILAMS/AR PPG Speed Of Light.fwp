FAIRWAVE PATCH 1
NAME  = AR PPG SPEED OF
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG Speed Of Light by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Atmos 3.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Alligatorz, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/FF/1902916E.WAV
READ = SAMPLE
TUNE = -42
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B5/187A7FA0.WAV
READ = CLEAN
TUNE = -12
FINE = -7
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.000 S
DECAY = 6.000 S
SUSTAIN = 74%
RELEASE = 4.867 S
A CURVE = 10
D CURVE = 0
R CURVE = 0
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.093 S
DECAY = 6.667 S
SUSTAIN = 90%
RELEASE = 4.560 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 1.500 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 45.5%
LFO 1 > POS 2 = 22.5%
ENV 2 > POS 2 = -16.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 65.0%

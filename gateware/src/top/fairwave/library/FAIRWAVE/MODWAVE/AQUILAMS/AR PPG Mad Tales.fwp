FAIRWAVE PATCH 1
NAME  = AR PPG MAD TALES
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG Mad Tales by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is B's 1, its wavetable.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: BATesque Bassline, Made4 Slow Pads, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/CD/A4D0013C.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/F1/A1540546.WAV
READ = CLEAN
TUNE = -12
FINE = 9
POS = 79.6%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 30
VCA = BOTH

[LFO 1]
RATE = 0.071 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.9%

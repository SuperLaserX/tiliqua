FAIRWAVE PATCH 1
NAME  = AR PPG POP WOBBL
ABOUT = FAST SYNTH FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG PoP Wobble by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, Blinking Sparkle.
[OSC 1]
TABLE = MODWAVE/T/97/787DF5B7.WAV
READ = CLEAN
TUNE = -12
POS = 27.7%

[OSC 2]
TABLE = MODWAVE/T/8C/510E73F7.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 27.7%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 1.669 S
SUSTAIN = 0%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.400 S
SUSTAIN = 0%
RELEASE = 4.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 6.150 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46%
CV 1 > POS 2 = -46%
ENV 2 > POS 1 = 44.5%
ENV 2 > POS 2 = 44.5%
LFO 1 > PITCH 1 = 1.5%
LFO 1 > PITCH 2 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.1%

FAIRWAVE PATCH 1
NAME  = AR MS2K MICROCOS
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AR MS2k Microcosmica by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: BATesque Bassline, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/B6/7979546E.WAV
READ = CLEAN
TUNE = -12
POS = 30.4%

[OSC 2]
TABLE = MODWAVE/T/D5/A86F020F.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.600 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.667 S
DECAY = 4.267 S
SUSTAIN = 50%
RELEASE = 4.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.064 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.265 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -50.5%
LFO 1 > POS 2 = 50%
ENV 2 > POS 1 = 39%
CV 2 > PITCH 2 = 11.5%
LFO 2 > POS 2 = 4.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.2%

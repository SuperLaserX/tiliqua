FAIRWAVE PATCH 1
NAME  = AR PPG GO WONK
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Go Wonk by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: modulation processors.
# Its effects, which FairWave hasn't got: LCR Long Delay 3, Subtle Presence, Synth Brass.
[OSC 1]
TABLE = MODWAVE/T/23/F4891620.WAV
READ = CLEAN
TUNE = -12
POS = 53.4%

[OSC 2]
TABLE = MODWAVE/T/C3/ECC9B2E4.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 5.000 S
SUSTAIN = 0%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.200 S
DECAY = 2.733 S
SUSTAIN = 0%
RELEASE = 4.800 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.850 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 100%
CV 2 > LEVEL 2 = 20%
LFO 1 > POS 2 = 13.5%
ENV 2 > POS 1 = 8.5%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 72.1%

FAIRWAVE PATCH 1
NAME  = AR MS2K DIGITAL
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's AR MS2k Digital Keys by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: EP Chorus, Emotive Pad.
[OSC 1]
TABLE = MODWAVE/T/8E/E3879DA6.WAV
READ = CLEAN
TUNE = -12
POS = 44.6%

[OSC 2]
TABLE = MODWAVE/T/30/15878E56.WAV
READ = CLEAN
TUNE = -12
POS = 44.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 7.333 S
SUSTAIN = 0%
RELEASE = 726.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 74.5%
CV 1 > POS 2 = 74.5%
CV 2 > POS 1 = 10.5%
CV 2 > POS 2 = 10.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.3%

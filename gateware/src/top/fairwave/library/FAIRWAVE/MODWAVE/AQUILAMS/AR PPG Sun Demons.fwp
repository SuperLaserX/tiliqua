FAIRWAVE PATCH 1
NAME  = AR PPG SUN DEMON
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Sun Demons by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer B oscillator 1, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, EP Chorus, Slow Deep 90.
[OSC 1]
TABLE = MODWAVE/T/C6/5DDEB628.WAV
READ = CLEAN
TUNE = -12
POS = 21.2%

[OSC 2]
TABLE = MODWAVE/T/4A/6613F65B.WAV
READ = CLEAN
TUNE = -24
POS = 23.0%

[ENV 1]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 3.867 S
SUSTAIN = 41%
RELEASE = 2.787 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 18.667 MS
DECAY = 2.067 S
SUSTAIN = 47%
RELEASE = 2.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57.5%
ENV 2 > POS 2 = 54%
CV 1 > POS 2 = -38.5%
CV 1 > POS 1 = -35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.7%

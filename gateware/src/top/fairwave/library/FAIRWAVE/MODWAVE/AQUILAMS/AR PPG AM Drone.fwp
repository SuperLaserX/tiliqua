FAIRWAVE PATCH 1
NAME  = AR PPG AM DRONE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG AM Drone by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Synth Brass, Transformation.
[OSC 1]
TABLE = MODWAVE/T/0D/FBF27CFA.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/E3/97E1B58D.WAV
READ = CLEAN
TUNE = -24
POS = 63.3%

[ENV 1]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 10
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 19.5%

[LFO 1]
RATE = 0.062 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 0.188 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > X DEPTH = 30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

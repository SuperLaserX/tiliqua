FAIRWAVE PATCH 1
NAME  = AR PPG SLIP & SL
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Slip & Slide by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: bpm Old Tape.
[OSC 1]
TABLE = MODWAVE/T/86/E3398021.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/86/E3398021.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 33.333 MS
DECAY = 7.333 S
SUSTAIN = 48%
RELEASE = 906.667 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.427 S
DECAY = 3.867 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

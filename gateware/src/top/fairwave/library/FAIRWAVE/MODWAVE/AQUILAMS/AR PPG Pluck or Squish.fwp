FAIRWAVE PATCH 1
NAME  = AR PPG PLUCK OR
ABOUT = FAST SYNTH FROM MODWAVE. GATE 1, C

# From the modwave's AR PPG Pluck or Squish by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF 2, EP Chorus, Glass Orch Hit.
[OSC 1]
TABLE = MODWAVE/T/28/B7152B67.WAV
READ = CLEAN
TUNE = -12
FINE = 9
POS = 44.0%

[OSC 2]
TABLE = MODWAVE/T/DE/8A181A6A.WAV
READ = CLEAN
TUNE = -12
FINE = -9
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 613.333 MS
SUSTAIN = 0%
RELEASE = 640.000 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -73.5%
LFO 1 > POS 2 = 50%
ENV 1 > POS 1 = 12%
LFO 2 > POS 1 = 8.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.8%

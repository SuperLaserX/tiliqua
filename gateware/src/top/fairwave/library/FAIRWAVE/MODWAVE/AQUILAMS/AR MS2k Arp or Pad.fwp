FAIRWAVE PATCH 1
NAME  = AR MS2K ARP OR P
ABOUT = ARPEGGIO FROM MODWAVE. GATE 1, CV 

# From the modwave's AR MS2k Arp or Pad by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: BATesque Bassline, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/10/7BAEE6FD.WAV
READ = CLEAN
TUNE = 12
POS = 65.0%

[OSC 2]
TABLE = MODWAVE/T/04/BA526540.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.240 S
SUSTAIN = 16%
RELEASE = 580.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 506.667 MS
DECAY = 673.333 MS
SUSTAIN = 8%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > LEVEL 2 = 60%
ENV 2 > POS 1 = 3.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = AR PPG FLOOR MOD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Floor Model by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Clavi Chorus, Nice Stereo DDL, Soft-knee Limiter.
[OSC 1]
TABLE = MODWAVE/T/84/134B3B38.WAV
READ = CLEAN
TUNE = -24
FINE = -10
POS = 34.8%

[OSC 2]
TABLE = MODWAVE/T/1A/74C6D186.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 34.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 27.000 S
SUSTAIN = 0%
RELEASE = 420.000 MS
A CURVE = 0
D CURVE = 70
R CURVE = 20
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.640 S
SUSTAIN = 54%
RELEASE = 706.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58%
CV 1 > POS 2 = -58%
ENV 2 > POS 1 = 30.5%
ENV 2 > POS 2 = 30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.7%

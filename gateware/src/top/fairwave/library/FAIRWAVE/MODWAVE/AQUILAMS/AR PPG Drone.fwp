FAIRWAVE PATCH 1
NAME  = AR PPG DRONE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Drone by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Flotsam, Subtle Chorus.
[OSC 1]
TABLE = MODWAVE/T/C2/7D644A6C.WAV
READ = CLEAN
TUNE = -24
POS = 30.0%

[OSC 2]
TABLE = MODWAVE/T/C4/231F3B0C.WAV
READ = CLEAN
TUNE = -12
POS = 70.6%

[ENV 1]
GATE = GATE 1
ATTACK = 746.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.800 S
DECAY = 3.760 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 1.160 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.540 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = -70%
ENV 2 > POS 1 = 23.5%
LFO 1 > POS 2 = -8%
LFO 1 > POS 1 = 5%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.5%

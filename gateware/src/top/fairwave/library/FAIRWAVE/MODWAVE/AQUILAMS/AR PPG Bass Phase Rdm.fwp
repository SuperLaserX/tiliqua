FAIRWAVE PATCH 1
NAME  = AR PPG BASS PHAS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR PPG Bass Phase Rdm by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bass Preserver, bpm Mband Down.
[OSC 1]
TABLE = MODWAVE/T/8E/6A09343E.WAV
READ = CLEAN
TUNE = -24
POS = 34.4%

[OSC 2]
TABLE = MODWAVE/T/30/621A4C3E.WAV
READ = CLEAN
TUNE = -24
POS = 34.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 11.333 S
SUSTAIN = 0%
RELEASE = 460.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.587 S
SUSTAIN = 0%
RELEASE = 3.080 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -57.5%
CV 1 > POS 2 = -57.5%
ENV 2 > POS 1 = 31%
ENV 2 > POS 2 = 31%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.1%

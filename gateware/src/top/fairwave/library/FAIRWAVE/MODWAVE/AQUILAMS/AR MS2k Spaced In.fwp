FAIRWAVE PATCH 1
NAME  = AR MS2K SPACED I
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AR MS2k Spaced In by Aquila Rift: AquilaMSPPG.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: BATesque Arp, BATesque Bassline, LowRes Bitz, Made4 Slow Pads.
[OSC 1]
TABLE = MODWAVE/T/88/7F98E07E.WAV
READ = CLEAN
TUNE = -12
POS = 4.3%

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 15.9%

[ENV 2]
GATE = GATE 1
ATTACK = 46.000 S
DECAY = 46.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 1.210 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 0.100 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 72%
ENV 2 > X DEPTH = 18.5%
LFO 2 > POS 1 = 4%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

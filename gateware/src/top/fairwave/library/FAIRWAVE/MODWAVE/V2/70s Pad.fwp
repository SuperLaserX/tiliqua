FAIRWAVE PATCH 1
NAME  = 70S PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 70s Pad by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Small Phaser Color.
[OSC 1]
TABLE = MODWAVE/T/6D/B265E4A6.WAV
READ = CLEAN
TUNE = -12
POS = 31.5%

[OSC 2]
TABLE = MODWAVE/T/18/A114756D.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 31.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 806.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 97.333 MS
DECAY = 90.000 S
SUSTAIN = 50%
RELEASE = 53.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52.5%
CV 1 > POS 2 = -52.5%
ENV 2 > POS 1 = 37%
ENV 2 > POS 2 = 37%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.7%

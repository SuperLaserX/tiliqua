FAIRWAVE PATCH 1
NAME  = FREE RUNNING SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Free Running Saw Width by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/94/4D1EBC8F.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/BA/0EC503F6.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 82.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.170 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.157 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
LFO 1 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 63.4%

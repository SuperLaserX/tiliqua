FAIRWAVE PATCH 1
NAME  = JUNO BRASS (V2)
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Brass (v2) by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/D0/0FF3C715.WAV
READ = CLEAN
TUNE = -12
POS = 23.3%

[OSC 2]
TABLE = MODWAVE/T/D0/0FF3C715.WAV
TUNE = -12
POS = 23.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 120.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 90.000 S
SUSTAIN = 93%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 53.5%
CV 1 > POS 1 = -39%
LFO 1 > LEVEL 1 = 8%
LFO 2 > POS 1 = 3.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

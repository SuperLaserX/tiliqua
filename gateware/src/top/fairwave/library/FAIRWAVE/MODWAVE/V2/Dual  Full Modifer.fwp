FAIRWAVE PATCH 1
NAME  = DUAL  FULL MODIF
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dual  Full Modifer by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A5/D70C995D.WAV
READ = CLEAN
TUNE = -24
FINE = -1
POS = 18.3%

[OSC 2]
TABLE = MODWAVE/T/07/8D5329DA.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 18.3%

[ENV 1]
GATE = GATE 1
ATTACK = 1.707 S
DECAY = 90.000 S
SUSTAIN = 89%
RELEASE = 1.261 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 600.000 MS
DECAY = 89.333 S
SUSTAIN = 86%
RELEASE = 16.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 3]
RATE = 0.544 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63.5%
ENV 2 > POS 2 = 63.5%
CV 1 > POS 1 = -30.5%
CV 1 > POS 2 = -30.5%
LFO 3 > POS 1 = 2.5%
LFO 3 > POS 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.3%

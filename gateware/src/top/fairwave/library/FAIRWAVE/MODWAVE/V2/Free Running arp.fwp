FAIRWAVE PATCH 1
NAME  = FREE RUNNING ARP
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Free Running arp by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/25/B9CFAA94.WAV
READ = CLEAN
TUNE = -12
POS = 17.0%

[OSC 2]
TABLE = MODWAVE/T/1E/D3094888.WAV
READ = CLEAN
TUNE = -12
POS = 17.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.400 S
SUSTAIN = 14%
RELEASE = 1.067 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.400 S
SUSTAIN = 34%
RELEASE = 53.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.170 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66%
ENV 2 > POS 2 = 66%
LFO 1 > POS 1 = 30%
LFO 1 > POS 2 = 30%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

FAIRWAVE PATCH 1
NAME  = FREE RUNNINGBERL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Free RunningBerlin Split by Ian dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 2, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/90/E8F9EFF7.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[OSC 2]
TABLE = MODWAVE/T/90/E8F9EFF7.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 90.000 S
SUSTAIN = 34%
RELEASE = 453.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 89.333 MS
DECAY = 22.667 S
SUSTAIN = 0%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.093 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70.5%
ENV 2 > POS 2 = 70.5%
LFO 1 > POS 1 = 27%
LFO 1 > POS 2 = 27%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.6%

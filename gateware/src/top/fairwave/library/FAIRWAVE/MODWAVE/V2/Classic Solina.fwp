FAIRWAVE PATCH 1
NAME  = CLASSIC SOLINA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Classic Solina by Ian Dixon: V2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: String Ensemble Sln.
# Oscillator 2 is A's 2, the sample Syn: String Ensemble Sln.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/12/F6D70868.WAV
READ = SAMPLE
TUNE = -13
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C4/E5025F7C.WAV
READ = SAMPLE
TUNE = -13
FINE = 18
POS = 0.0%
EDGE = WRAP
LOOP = 1.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 96.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.4%

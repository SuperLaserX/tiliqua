FAIRWAVE PATCH 1
NAME  = CS80 DUAL PWM-OP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's CS80 Dual PWM-Open by Ian Dixon: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Biegerish Bass, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F4/95653B05.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 16.3%

[OSC 2]
TABLE = MODWAVE/T/06/F2F2C5AF.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 10.1%

[ENV 1]
GATE = GATE 1
ATTACK = 486.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.867 S
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 53.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.557 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 80%
ENV 2 > POS 1 = 67.5%
CV 2 > POS 1 = 57%
LFO 1 > POS 2 = 45%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -17%
LFO 1 > POS 1 = 10%
ENV 2 > PITCH 2 = -0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

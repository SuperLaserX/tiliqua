FAIRWAVE PATCH 1
NAME  = WALKINGWUB3
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WalkingWub3 by Korg: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: Rezzo.
[OSC 1]
TABLE = MODWAVE/T/5D/6282D929.WAV
READ = CLEAN
TUNE = -24
POS = 25.1%

[OSC 2]
TABLE = MODWAVE/T/FA/3F409B21.WAV
READ = CLEAN
TUNE = -24
POS = 25.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 50.8%

[LFO 1]
RATE = 6.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
CV 1 > POS 1 = 42%
CV 1 > POS 2 = 42%
LFO 1 > X DEPTH = 20%
LFO 1 > POS 1 = -14.5%
LFO 1 > POS 2 = -14.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

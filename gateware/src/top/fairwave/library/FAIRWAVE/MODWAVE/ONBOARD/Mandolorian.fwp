FAIRWAVE PATCH 1
NAME  = MANDOLORIAN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mandolorian by Korg: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd: Recorder.
# Oscillator 2 is A's 2, the sample Wnd: Flute 2 GermanTone.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: 1/4 LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/86/19CB3121.WAV
READ = SAMPLE
TUNE = -18
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 43.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3D/FA5CFC83.WAV
READ = SAMPLE
TUNE = -6
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 31.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.560 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

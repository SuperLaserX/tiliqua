FAIRWAVE PATCH 1
NAME  = X BS 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's X BS 2 by X: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/BE/A74C14F5.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/BE/A74C14F5.WAV
TUNE = -12
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 90.000 S
SUSTAIN = 34%
RELEASE = 2.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 1.920 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 4.250 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

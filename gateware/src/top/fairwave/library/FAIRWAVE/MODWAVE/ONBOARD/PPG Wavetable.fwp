FAIRWAVE PATCH 1
NAME  = PPG WAVETABLE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Wavetable by Ian Dixon: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the sub oscillator.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B5/E0270CBD.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 12.7%

[OSC 2]
TABLE = MODWAVE/T/DC/F815E8C9.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 12.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.067 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 746.667 MS
SUSTAIN = 29%
RELEASE = 44.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.014 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
LFO 1 > X DEPTH = 22.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 20.5%
CV 2 > POS 2 = 20.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.8%

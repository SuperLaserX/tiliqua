FAIRWAVE PATCH 1
NAME  = MANDOLORIAN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mandolorian by Korg: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: Acoustic ff.
# Oscillator 2 is A's 2, the sample Str: String Ensemble 1.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the noise generator.
# Its effects, which FairWave hasn't got: 1/4 LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/2B/D64C256E.WAV
READ = SAMPLE
TUNE = -31
FINE = 5
POS = 0.0%
EDGE = WRAP
LOOP = 76.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2B/24224337.WAV
READ = SAMPLE
TUNE = -11
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 20.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = AA BS UPPERDECKE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS UpperDecker by Anton Anru: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black 2x12, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E8/2522EC26.WAV
READ = CLEAN
TUNE = -36
POS = 29.6%

[OSC 2]
TABLE = MODWAVE/T/29/E4E510B7.WAV
READ = CLEAN
TUNE = -24
FINE = 20
POS = 29.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 100%
RELEASE = 77.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 1.111 S
SUSTAIN = 20%
RELEASE = 429.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.435 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -49.5%
CV 1 > POS 2 = -49.5%
CV 2 > POS 1 = 41%
CV 2 > POS 2 = 41%
ENV 2 > POS 1 = 24.5%
ENV 2 > POS 2 = 24.5%
LFO 1 > POS 1 = 8%
LFO 1 > POS 2 = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.5%

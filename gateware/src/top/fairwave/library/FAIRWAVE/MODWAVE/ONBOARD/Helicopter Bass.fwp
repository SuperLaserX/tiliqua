FAIRWAVE PATCH 1
NAME  = HELICOPTER BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Helicopter Bass by Korg: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_Guru: Saw Modular.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 8 unison voices, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ground Sub Bass.
[OSC 1]
TABLE = MODWAVE/T/BE/CE52DCCD.WAV
READ = SAMPLE
TUNE = -5
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/6F/C9E3435D.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.643 S
SUSTAIN = 82%
RELEASE = 1.853 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.105 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = RANDOM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Random by X: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1+5 Pulsator, Organ As-Is, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/75/6EF5367C.WAV
READ = CLEAN
TUNE = 16
POS = 32.8%

[OSC 2]
TABLE = MODWAVE/T/DB/3D78BF34.WAV
READ = CLEAN
TUNE = -12
POS = 32.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 970.667 MS
SUSTAIN = 35%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -54.5%
CV 1 > POS 2 = -54.5%
ENV 2 > POS 1 = 34.5%
ENV 2 > POS 2 = 34.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.6%

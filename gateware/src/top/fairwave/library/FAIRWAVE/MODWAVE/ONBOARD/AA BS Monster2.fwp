FAIRWAVE PATCH 1
NAME  = AA BS MONSTER2
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Monster2 by Anton Anru: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black 2x12, Stereo Chorus, Tron Bass, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2D/8651DDA7.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 34.7%

[OSC 2]
TABLE = MODWAVE/T/7D/A38E45B5.WAV
READ = CLEAN
TUNE = -12
FINE = -11
POS = 34.7%

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 MS
DECAY = 654.667 MS
SUSTAIN = 76%
RELEASE = 386.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.884 S
SUSTAIN = 0%
RELEASE = 70.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58%
CV 1 > POS 2 = -58%
ENV 2 > POS 1 = 30.5%
ENV 2 > POS 2 = 30.5%
CV 2 > POS 1 = 19.5%
CV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.9%

FAIRWAVE PATCH 1
NAME  = FADING LIGHTS SP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fading Lights split by Ian Dixon: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: AnaStrings.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: 2 unison voices, layer A oscillator 2, layer B oscillator 1, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0F/9346A7F1.WAV
READ = SAMPLE
TUNE = -25
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 41.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/33/FEB347DF.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.600 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.6%

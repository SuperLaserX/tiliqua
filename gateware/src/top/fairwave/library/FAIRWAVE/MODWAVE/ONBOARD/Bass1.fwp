FAIRWAVE PATCH 1
NAME  = BASS1
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bass1 by X: the instrument's own library.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: PlayChord (Arp), Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/89/8DB9EB99.WAV
READ = CLEAN
TUNE = -36
POS = 25.4%

[OSC 2]
TABLE = MODWAVE/T/09/CF5A637B.WAV
READ = CLEAN
TUNE = -12
POS = 25.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 429.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 49%
CV 2 > POS 2 = 49%
CV 1 > POS 1 = -42.5%
CV 1 > POS 2 = -42.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.3%

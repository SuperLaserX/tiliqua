FAIRWAVE PATCH 1
NAME  = D-110 GLASS HARM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Glass Harmo by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Glasses.
# Oscillator 2 is A's 2, the sample D110-Harmo Pan.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/51/29DA3195.WAV
READ = SAMPLE
TUNE = -6
FINE = 26
POS = 0.0%
EDGE = WRAP
LOOP = 18.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/56/7A3D0A78.WAV
READ = SAMPLE
TUNE = -18
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 7.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 2%
RELEASE = 500.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.880 S
DECAY = 856.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

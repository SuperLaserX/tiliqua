FAIRWAVE PATCH 1
NAME  = D-110 DUAL POLY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Dual Poly Synth by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Poly Synth.
# Oscillator 2 is B's 1, the sample D110-Poly Synth.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AB/6E1C8655.WAV
READ = SAMPLE
TUNE = -18
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 73%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4C/E3538B85.WAV
READ = SAMPLE
TUNE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 96.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 54.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.0%

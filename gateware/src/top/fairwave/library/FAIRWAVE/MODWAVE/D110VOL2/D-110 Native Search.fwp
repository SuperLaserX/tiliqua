FAIRWAVE PATCH 1
NAME  = D-110 NATIVE SEA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Native Search by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-NativeePerc.
# Oscillator 2 is A's 2, the sample D110-NativeePerc.
# Not carried over: layer B oscillator 1.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/83/72C59634.WAV
READ = SAMPLE
TUNE = -6
FINE = 22
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AF/37F49CB0.WAV
READ = SAMPLE
TUNE = -6
FINE = 24
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 38.000 S
SUSTAIN = 45%
RELEASE = 486.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 24.0%

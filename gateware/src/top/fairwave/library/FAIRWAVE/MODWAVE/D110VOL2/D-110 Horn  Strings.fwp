FAIRWAVE PATCH 1
NAME  = D-110 HORN & STR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Horn & Strings by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Horn.
# Oscillator 2 is A's 2, the sample D110-Poly Synth.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/EE/1D8C25C7.WAV
READ = SAMPLE
TUNE = -18
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 15.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1A/13288254.WAV
READ = SAMPLE
TUNE = -17
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 96.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 38.000 S
SUSTAIN = 45%
RELEASE = 486.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 51%
RELEASE = 28.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

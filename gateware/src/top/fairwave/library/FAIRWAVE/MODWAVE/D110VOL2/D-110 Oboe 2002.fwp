FAIRWAVE PATCH 1
NAME  = D-110 OBOE 2002
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Oboe 2002 by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Oboe 2002.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/70/B481A115.WAV
READ = SAMPLE
TUNE = -18
FINE = 36
POS = 0.0%
EDGE = WRAP
LOOP = 51.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/70/B481A115.WAV
TUNE = -18
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 22.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 54.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = D-110 POWER SYNT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Power Synth by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-PowerSynth.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/D6/E643C66F.WAV
READ = SAMPLE
TUNE = -6
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 18.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D6/E643C66F.WAV
TUNE = -6
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 54.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

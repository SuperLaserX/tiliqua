FAIRWAVE PATCH 1
NAME  = D-110 HARPSI STR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Harpsi Strings by Ian Dixon: ID-D110Vol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: layer A oscillator 1.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Slow & Warm, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B7/595DBB6C.WAV
READ = CLEAN
TUNE = -12
POS = 32.2%

[OSC 2]
TABLE = MODWAVE/T/C3/DC240E8F.WAV
READ = CLEAN
TUNE = -12
FINE = 13
POS = 32.2%

[ENV 1]
GATE = GATE 1
ATTACK = 8.000 S
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 953.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 42.4%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 32.667 S
SUSTAIN = 35%
RELEASE = 820.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = MS-20 PWM LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 PWM Lead by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F8/5FDDD782.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 13.6%

[OSC 2]
TABLE = MODWAVE/T/59/C4534785.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 61.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 92.8%

[ENV 2]
GATE = GATE 1
ATTACK = 25.333 MS
DECAY = 4.328 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.259 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 60%
LFO 1 > POS 1 = 40%
LFO 1 > POS 2 = -8%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.7%

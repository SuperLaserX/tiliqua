FAIRWAVE PATCH 1
NAME  = MS-20 - VINTAGE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 - Vintage Lead by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/18/17B32843.WAV
READ = CLEAN
TUNE = -12
POS = 42.5%

[OSC 2]
TABLE = MODWAVE/T/91/B5EC4694.WAV
READ = CLEAN
TUNE = 12
POS = 42.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 6.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -71%
CV 1 > POS 2 = -71%
ENV 2 > POS 1 = 15%
ENV 2 > POS 2 = 15%
LFO 1 > PITCH 1 = 1%
LFO 1 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.9%

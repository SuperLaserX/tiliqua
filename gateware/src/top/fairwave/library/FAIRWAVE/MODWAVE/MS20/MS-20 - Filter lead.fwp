FAIRWAVE PATCH 1
NAME  = MS-20 - FILTER L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 - Filter lead by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/4 LPF, Modern Compressor, Slow & Warm.
[OSC 1]
TABLE = MODWAVE/T/80/A93FB983.WAV
READ = CLEAN
TUNE = -12
FINE = -9
POS = 18.3%

[OSC 2]
TABLE = MODWAVE/T/E0/6B77DC7A.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 18.3%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 49.333 MS
SUSTAIN = 100%
RELEASE = 2.016 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.533 S
SUSTAIN = 0%
RELEASE = 20.963 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63.5%
ENV 2 > POS 2 = 63.5%
CV 1 > POS 1 = -30.5%
CV 1 > POS 2 = -30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.6%

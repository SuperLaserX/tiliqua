FAIRWAVE PATCH 1
NAME  = MS-20 ANALOG PIA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Analog Piano by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/06/6A379154.WAV
READ = CLEAN
TUNE = -12
POS = 27.3%

[OSC 2]
TABLE = MODWAVE/T/70/43C51373.WAV
READ = CLEAN
TUNE = -12
POS = 27.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 22.667 S
SUSTAIN = 26%
RELEASE = 853.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.733 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 45.5%
CV 1 > POS 1 = -45.5%
ENV 2 > POS 2 = 45.5%
CV 1 > POS 2 = -45.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.1%

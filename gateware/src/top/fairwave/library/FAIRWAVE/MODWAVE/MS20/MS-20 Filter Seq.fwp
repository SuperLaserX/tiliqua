FAIRWAVE PATCH 1
NAME  = MS-20 FILTER SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Filter Seq by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/C1/8362B2C2.WAV
READ = CLEAN
TUNE = -24
FINE = -5
POS = 18.6%

[OSC 2]
TABLE = MODWAVE/T/93/8B638D67.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 18.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 486.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 280.000 MS
SUSTAIN = 34%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63%
ENV 2 > POS 2 = 63%
CV 1 > POS 1 = -31%
CV 1 > POS 2 = -31%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.4%

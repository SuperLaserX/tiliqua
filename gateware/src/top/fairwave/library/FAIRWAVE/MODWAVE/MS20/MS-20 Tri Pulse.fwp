FAIRWAVE PATCH 1
NAME  = MS-20 TRI PULSE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Tri Pulse by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/3C/1667C028.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/0C/A4128E84.WAV
READ = CLEAN
TUNE = 0
FINE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 25.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 626.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 4.152 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

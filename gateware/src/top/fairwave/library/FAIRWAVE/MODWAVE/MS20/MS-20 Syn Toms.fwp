FAIRWAVE PATCH 1
NAME  = MS-20 SYN TOMS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Syn Toms by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, its wavetable.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Ambient Reverse, Chorus-Flange Morph, JC Amp Chorus, Modern Compressor, Yeah/Yah.
[OSC 1]
TABLE = MODWAVE/T/3A/0505D656.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/3A/0505D656.WAV
TUNE = 0
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 800.000 MS
SUSTAIN = 0%
RELEASE = 753.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 553.333 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > PITCH 1 = 17%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = MS-20 STAB
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Stab by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus 2, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/27/FEF45E2C.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/91/57FCC1A0.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.133 S
DECAY = 700.000 MS
SUSTAIN = 57%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = 21%
CV 1 > POS 2 = 21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

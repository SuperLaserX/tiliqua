FAIRWAVE PATCH 1
NAME  = MS-20 OVERTONE B
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Overtone Bass by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Small Phaser Color.
[OSC 1]
TABLE = MODWAVE/T/DA/BD47F40C.WAV
READ = CLEAN
TUNE = -36
POS = 22.0%

[OSC 2]
TABLE = MODWAVE/T/66/997B610E.WAV
READ = CLEAN
TUNE = -24
POS = 22.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 69.333 S
SUSTAIN = 14%
RELEASE = 4.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56%
ENV 2 > POS 2 = 56%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.6%

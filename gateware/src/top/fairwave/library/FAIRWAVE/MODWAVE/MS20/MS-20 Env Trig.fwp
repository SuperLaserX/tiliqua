FAIRWAVE PATCH 1
NAME  = MS-20 ENV TRIG
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Env Trig by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/40/E3980D08.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 13.8%

[OSC 2]
TABLE = MODWAVE/T/73/A3956832.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 13.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 72.000 MS
DECAY = 2.333 S
SUSTAIN = 40%
RELEASE = 973.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 90%
ENV 2 > POS 1 = 72.5%
ENV 2 > POS 2 = 72.5%
CV 1 > POS 1 = -23%
CV 1 > POS 2 = -23%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = MS-20 TRI FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Tri Flute by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/3C/1667C028.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3C/1667C028.WAV
TUNE = -12
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 25.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 626.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 4.152 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

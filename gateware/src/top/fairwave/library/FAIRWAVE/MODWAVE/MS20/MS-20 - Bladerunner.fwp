FAIRWAVE PATCH 1
NAME  = MS-20 - BLADERUN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 - Bladerunner by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
[OSC 1]
TABLE = MODWAVE/T/0E/B00E7C82.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/D0/6FDA7653.WAV
READ = CLEAN
TUNE = -12
FINE = 6
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 124.000 MS
SUSTAIN = 67%
RELEASE = 641.333 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 1 > LEVEL 1 = 13%
LFO 1 > LEVEL 2 = 13%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.2%

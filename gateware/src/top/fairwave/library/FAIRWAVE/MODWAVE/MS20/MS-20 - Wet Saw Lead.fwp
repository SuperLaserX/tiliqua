FAIRWAVE PATCH 1
NAME  = MS-20 - WET SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 - Wet Saw Lead by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/EF/CD71458E.WAV
READ = CLEAN
TUNE = 0
POS = 16.3%

[OSC 2]
TABLE = MODWAVE/T/7D/8C636F0C.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 16.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 353.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 506.667 MS
SUSTAIN = 50%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 6.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.1%

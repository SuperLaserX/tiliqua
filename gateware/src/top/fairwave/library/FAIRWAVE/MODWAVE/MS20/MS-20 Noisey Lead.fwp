FAIRWAVE PATCH 1
NAME  = MS-20 NOISEY LEA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS-20 Noisey Lead by Ian Dixon: MS20.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/5C/64ADC361.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 27.1%

[OSC 2]
TABLE = MODWAVE/T/5C/64ADC361.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 27.1%

[ENV 1]
GATE = GATE 1
ATTACK = 32.000 MS
DECAY = 1.800 S
SUSTAIN = 0%
RELEASE = 686.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.200 S
SUSTAIN = 29%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 9.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 46%
ENV 2 > POS 2 = 46%
CV 1 > POS 1 = -45%
CV 1 > POS 2 = -45%
LFO 1 > POS 1 = 11.5%
LFO 1 > POS 2 = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

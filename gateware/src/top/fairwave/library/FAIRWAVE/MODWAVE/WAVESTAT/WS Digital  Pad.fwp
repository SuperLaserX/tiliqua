FAIRWAVE PATCH 1
NAME  = WS DIGITAL  PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Digital  Pad by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: VoiSyn1a.
# Oscillator 2 is A's 2, the sample Syn_WS: EtherBell.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E1/A93DEDA2.WAV
READ = SAMPLE
TUNE = -25
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7C/3A4F7733.WAV
READ = SAMPLE
TUNE = -24
POS = 0.0%
EDGE = WRAP
LOOP = 35.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.933 S
SUSTAIN = 52%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.8%

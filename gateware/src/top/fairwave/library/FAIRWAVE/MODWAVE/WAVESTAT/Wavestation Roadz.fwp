FAIRWAVE PATCH 1
NAME  = WAVESTATION ROAD
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Wavestation Roadz by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano_WS: Soft EP.
# Oscillator 2 is A's 2, the sample E.Piano_WS: Hard EP.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A0/BDCBAB25.WAV
READ = SAMPLE
TUNE = -8
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/61/9CA1E467.WAV
READ = SAMPLE
TUNE = -8
FINE = 36
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 13.333 S
SUSTAIN = 11%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 13.0%

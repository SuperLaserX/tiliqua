FAIRWAVE PATCH 1
NAME  = WS TRISQARE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS TriSqare by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Wave_WS: 13-39.
# Oscillator 2 is the other half of its 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/13/49FAB4D2.WAV
READ = SAMPLE
TUNE = 12
FINE = -2
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/13/49FAB4D2.WAV
READ = SAMPLE
TUNE = 12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 393.333 MS
DECAY = 25.333 MS
SUSTAIN = 82%
RELEASE = 886.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 26.5%
LFO 1 > LEVEL 1 = 6%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

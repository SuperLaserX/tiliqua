FAIRWAVE PATCH 1
NAME  = WS TWILIGHT PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Twilight Pad by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Glass Vox.
# Oscillator 2 is B's 1, the sample Syn_WS: MV Wave.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E1/C1F72EFE.WAV
READ = SAMPLE
TUNE = -43
FINE = 46
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/64/F3A33D51.WAV
READ = SAMPLE
TUNE = -23
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 326.667 MS
DECAY = 8.667 S
SUSTAIN = 93%
RELEASE = 640.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

FAIRWAVE PATCH 1
NAME  = WS HEAVEN
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Heaven by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn_WS: SynthPad.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AD/0AD569DB.WAV
READ = SAMPLE
TUNE = -25
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 10.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AD/0AD569DB.WAV
TUNE = -25
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 43.333 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.088 S
DECAY = 90.000 S
SUSTAIN = 80%
RELEASE = 4.200 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

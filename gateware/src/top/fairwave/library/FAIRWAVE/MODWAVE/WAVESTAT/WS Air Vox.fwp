FAIRWAVE PATCH 1
NAME  = WS AIR VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Air Vox by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Airvox.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: JC Amp Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/98/173A8DD4.WAV
READ = SAMPLE
TUNE = -26
FINE = 33
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/29/14896651.WAV
READ = SAMPLE
TUNE = -31
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 8.000 MS
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.152 S
DECAY = 81.840 S
SUSTAIN = 46%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

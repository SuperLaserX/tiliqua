FAIRWAVE PATCH 1
NAME  = GLASS BOTTLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Glass Bottle by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_WS: Glass Hit.
# Oscillator 2 is A's 2, the sample Wnd_WS: Bottle WS.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/62/53BC20CD.WAV
READ = SAMPLE
TUNE = -14
FINE = 18
POS = 0.0%
EDGE = WRAP
LOOP = 46.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FA/A67AC2AE.WAV
READ = SAMPLE
TUNE = -27
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 42.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 18.667 MS
DECAY = 89.333 S
SUSTAIN = 52%
RELEASE = 1.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 26.5%
CV 2 > LEVEL 2 = 26.5%
LFO 1 > LEVEL 1 = 6%
LFO 1 > LEVEL 2 = 6%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.1%

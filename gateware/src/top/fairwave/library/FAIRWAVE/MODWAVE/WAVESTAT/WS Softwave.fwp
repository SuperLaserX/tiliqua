FAIRWAVE PATCH 1
NAME  = WS SOFTWAVE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Softwave by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr_WS: Harmonic.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/9E/7DD07E13.WAV
READ = SAMPLE
TUNE = -44
FINE = -47
POS = 0.0%
EDGE = WRAP
LOOP = 53%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9E/7DD07E13.WAV
READ = SAMPLE
TUNE = -44
FINE = -44
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = WS MGRAND AND ST
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS MGrand and Strings by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: PWM String.
# Oscillator 2 is B's 2, the sample Piano_WS: GrandPiano.
# Not carried over: layer A oscillator 2, layer B oscillator 1.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/32/95B0DDEC.WAV
READ = SAMPLE
TUNE = -41
FINE = -33
POS = 0.0%
EDGE = WRAP
LOOP = 0.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/07/3748BE90.WAV
READ = SAMPLE
TUNE = -21
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 67.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 866.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

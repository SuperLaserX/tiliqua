FAIRWAVE PATCH 1
NAME  = WS DIGITAL VECTO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Digital Vector2 by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn_WS: Res Wave.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D7/E9B88DB4.WAV
READ = SAMPLE
TUNE = -48
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 32%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D7/E9B88DB4.WAV
TUNE = -48
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 246.667 MS
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

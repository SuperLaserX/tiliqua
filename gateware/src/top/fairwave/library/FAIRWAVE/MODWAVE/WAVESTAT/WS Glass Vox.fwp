FAIRWAVE PATCH 1
NAME  = WS GLASS VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Glass Vox by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Glass Vox.
# Oscillator 2 is A's 2, the sample Syn_WS: Spectrm2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E1/C1F72EFE.WAV
READ = SAMPLE
TUNE = -43
FINE = 46
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/ED/D32E4B18.WAV
READ = SAMPLE
TUNE = -34
FINE = -21
POS = 0.0%
EDGE = WRAP
LOOP = 3.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 326.667 MS
DECAY = 8.667 S
SUSTAIN = 93%
RELEASE = 640.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.880 S
DECAY = 19.280 S
SUSTAIN = 14%
RELEASE = 2.792 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

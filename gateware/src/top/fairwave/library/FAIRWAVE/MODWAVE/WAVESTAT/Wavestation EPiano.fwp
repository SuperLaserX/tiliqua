FAIRWAVE PATCH 1
NAME  = WAVESTATION EPIA
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Wavestation EPiano by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano_WS: EP Body1.
# Oscillator 2 is A's 2, the sample E.Piano_WS: EP Tine.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/10/169AC690.WAV
READ = SAMPLE
TUNE = -14
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 33.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D9/B04D8B52.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 13.333 S
SUSTAIN = 11%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.000 S
SUSTAIN = 6%
RELEASE = 2.344 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

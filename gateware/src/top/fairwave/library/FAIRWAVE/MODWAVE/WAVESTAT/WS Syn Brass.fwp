FAIRWAVE PATCH 1
NAME  = WS SYN BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Syn Brass by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_WS: OBSAW3.
# Oscillator 2 is A's 2, the sample Wave_WS: OBSAW3.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/5B/E7053275.WAV
READ = SAMPLE
TUNE = 0
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5B/E7053275.WAV
READ = SAMPLE
TUNE = 0
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 93%
RELEASE = 473.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 76.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 1%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

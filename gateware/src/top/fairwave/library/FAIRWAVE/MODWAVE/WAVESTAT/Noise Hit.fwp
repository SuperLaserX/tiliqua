FAIRWAVE PATCH 1
NAME  = NOISE HIT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Noise Hit by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample FX_WS: Noise Hit.
# Oscillator 2 is A's 2, the sample BassFX: Slap Ghost 04.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/73/3153BFEE.WAV
READ = SAMPLE
TUNE = -25
FINE = -19
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/29/AEC82B6A.WAV
READ = SAMPLE
TUNE = -36
FINE = -24
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.6%

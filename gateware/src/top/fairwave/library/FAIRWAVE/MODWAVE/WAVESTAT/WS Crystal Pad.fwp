FAIRWAVE PATCH 1
NAME  = WS CRYSTAL PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Crystal Pad by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynthPad.
# Oscillator 2 is A's 2, the sample Bell_WS: Crystal.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/8C/0D06C65B.WAV
READ = SAMPLE
TUNE = -37
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 10.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/8E/4C3F4477.WAV
READ = SAMPLE
TUNE = -13
FINE = -39
POS = 0.0%
EDGE = WRAP
LOOP = 38.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 316.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 893.333 MS
DECAY = 1.000 S
SUSTAIN = 99%
RELEASE = 4.469 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

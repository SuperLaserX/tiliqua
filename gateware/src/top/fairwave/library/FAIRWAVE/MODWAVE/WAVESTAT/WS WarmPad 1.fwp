FAIRWAVE PATCH 1
NAME  = WS WARMPAD 1
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS WarmPad 1 by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynString.
# Oscillator 2 is A's 2, the sample Syn_WS: Synorch.
[OSC 1]
TABLE = MODWAVE/T/DA/F58700E0.WAV
READ = SAMPLE
TUNE = -25
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D4/DE0D2756.WAV
READ = SAMPLE
TUNE = -37
FINE = -2
POS = 0.0%
EDGE = WRAP
LOOP = 1.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.600 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

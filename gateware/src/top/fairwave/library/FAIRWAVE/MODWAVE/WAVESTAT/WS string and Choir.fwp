FAIRWAVE PATCH 1
NAME  = WS STRING AND CH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS string and Choir by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: PWM String.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/32/95B0DDEC.WAV
READ = SAMPLE
TUNE = -41
FINE = -33
POS = 0.0%
EDGE = WRAP
LOOP = 0.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E5/CC6851DA.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 866.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.688 S
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

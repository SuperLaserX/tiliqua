FAIRWAVE PATCH 1
NAME  = WS THICK PICK
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Thick Pick by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, the sample Gtr_WS: MuteGtr1.
# Oscillator 2 is A's 2, the sample Atk_WS:A.BassTR.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/81/015F6D8A.WAV
READ = SAMPLE
TUNE = -47
FINE = -3
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/08/B6C0D329.WAV
READ = SAMPLE
TUNE = -32
FINE = -18
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 98%
RELEASE = 47.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.8%

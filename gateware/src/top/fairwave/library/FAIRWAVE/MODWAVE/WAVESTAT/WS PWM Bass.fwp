FAIRWAVE PATCH 1
NAME  = WS PWM BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS PWM Bass by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: PWM.
# Oscillator 2 is A's 2, the sample Syn_WS: Synbass1.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/27/AFA4EE17.WAV
READ = SAMPLE
TUNE = -37
FINE = 10
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7F/CEBBEB0F.WAV
READ = SAMPLE
TUNE = -12
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 67.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 98%
RELEASE = 47.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.0%

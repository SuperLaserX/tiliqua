FAIRWAVE PATCH 1
NAME  = WS BELL PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Bell Pad by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: AirSynth.
# Oscillator 2 is A's 2, the sample Syn_WS: BellWind.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/55/22874988.WAV
READ = SAMPLE
TUNE = -25
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/46/948F9A8D.WAV
READ = SAMPLE
TUNE = -42
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 65.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.933 S
SUSTAIN = 52%
RELEASE = 389.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.6%

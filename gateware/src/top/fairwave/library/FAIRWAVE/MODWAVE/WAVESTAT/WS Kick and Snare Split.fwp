FAIRWAVE PATCH 1
NAME  = WS KICK AND SNAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Kick and Snare Split by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Drm_WS: Gated Kick.
# Oscillator 2 is B's 1, the sample Drm_WS: Crack Snar.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/B5/FF701798.WAV
READ = SAMPLE
TUNE = -13
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/8F/907381FF.WAV
READ = SAMPLE
TUNE = -25
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 63%
RELEASE = 700.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.5%

FAIRWAVE PATCH 1
NAME  = WS NITE TIME BEL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Nite Time Bells by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_WS: Xenon.
# Oscillator 2 is A's 2, the sample Bell_WS: Hi Bell.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/EC/1E7CEBCC.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9B/3502DE37.WAV
READ = SAMPLE
TUNE = -26
FINE = -26
POS = 0.0%
EDGE = WRAP
LOOP = 54.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.800 S
SUSTAIN = 9%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.7%

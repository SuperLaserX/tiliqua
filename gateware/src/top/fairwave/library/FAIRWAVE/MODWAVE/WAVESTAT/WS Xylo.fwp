FAIRWAVE PATCH 1
NAME  = WS XYLO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Xylo by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Xylo-Spectrum.
# Oscillator 2 is A's 2, the sample Bell: Xylophone 1  p.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/F9/47921967.WAV
READ = SAMPLE
TUNE = -22
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 1.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B9/F1AACB68.WAV
READ = SAMPLE
TUNE = -29
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 83%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 989.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 19.2%

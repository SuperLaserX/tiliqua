FAIRWAVE PATCH 1
NAME  = WS MAXIBASSSYNTH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS MaxiBassSynth by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: DeepBass.
# Oscillator 2 is A's 2, the sample Syn_WS: MiniBass.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/C1/179217B7.WAV
READ = SAMPLE
TUNE = -24
FINE = 5
POS = 0.0%
EDGE = WRAP
LOOP = 80.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EE/644121A8.WAV
READ = SAMPLE
TUNE = -12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 78.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 98%
RELEASE = 47.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.8%

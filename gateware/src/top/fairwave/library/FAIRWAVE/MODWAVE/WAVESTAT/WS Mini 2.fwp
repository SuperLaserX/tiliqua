FAIRWAVE PATCH 1
NAME  = WS MINI 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's WS Mini 2 by Ian Dixon: idwavestation.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave_WS: Min1-05a.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Distortion 1, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/5C/59722CB9.WAV
READ = SAMPLE
TUNE = 0
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5C/59722CB9.WAV
READ = SAMPLE
TUNE = 0
FINE = 8
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.624 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = M1 SLAP BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Slap Bass by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bass: Slap M1.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A6/F443F36C.WAV
READ = SAMPLE
TUNE = -10
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 85.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A6/F443F36C.WAV
TUNE = -10
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.800 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = T1 AEROGLIDE
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's T1 Aeroglide by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Voices.
# Oscillator 2 is A's 2, the sample Syn_WS: MagicOrgan.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/99/4C5893D8.WAV
READ = SAMPLE
TUNE = -19
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/0C/6FAE4940.WAV
READ = SAMPLE
TUNE = -22
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 26.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 809.333 MS
DECAY = 90.000 S
SUSTAIN = 51%
RELEASE = 1.215 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.120 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = -1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.3%

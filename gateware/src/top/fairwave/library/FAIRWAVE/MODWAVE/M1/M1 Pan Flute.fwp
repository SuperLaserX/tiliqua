FAIRWAVE PATCH 1
NAME  = M1 PAN FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Pan Flute by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Wnd_WS: PanFlute.
# Oscillator 2 is B's 2, the sample Wnd_WS: PanFlute.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, JC Amp Chorus, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E8/7B3A844B.WAV
READ = SAMPLE
TUNE = -38
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E8/7B3A844B.WAV
READ = SAMPLE
TUNE = -38
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 95%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = M1 DREAM PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Dream Pad by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Wave_WS: saw.
# Oscillator 2 is B's 2, the sample Syn_WS: Digital2.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/AC/AD9AE1B6.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C0/94CA0A28.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 81.104 S
DECAY = 83.333 S
SUSTAIN = 90%
RELEASE = 4.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.5%

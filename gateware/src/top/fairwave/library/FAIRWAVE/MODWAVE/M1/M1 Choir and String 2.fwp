FAIRWAVE PATCH 1
NAME  = M1 CHOIR AND STR
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Choir and String by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_WS: Tubular.
# Oscillator 2 is A's 2, the sample Str: String Ensemble 1.
[OSC 1]
TABLE = MODWAVE/T/A7/1C00F00B.WAV
READ = SAMPLE
TUNE = -26
FINE = -18
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2B/24224337.WAV
READ = SAMPLE
TUNE = -11
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 20.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

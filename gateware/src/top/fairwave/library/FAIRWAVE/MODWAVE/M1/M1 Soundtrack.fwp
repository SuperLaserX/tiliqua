FAIRWAVE PATCH 1
NAME  = M1 SOUNDTRACK
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Soundtrack by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_WS: SynString.
# Oscillator 2 is A's 2, the sample Wnd_WS: PanFlute.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/87/08BCDCDD.WAV
READ = SAMPLE
TUNE = -25
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/31/464F82A1.WAV
READ = SAMPLE
TUNE = -14
FINE = -17
POS = 0.0%
EDGE = WRAP
LOOP = 21.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.667 S
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 26.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 568.000 MS
DECAY = 3.304 S
SUSTAIN = 100%
RELEASE = 90.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.8%

FAIRWAVE PATCH 1
NAME  = M1 CHOIR SWEEP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's M1 Choir Sweep by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_WS: Glass Hit.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/14/15C6B2DF.WAV
READ = SAMPLE
TUNE = -14
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 46.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F6/9541B6AF.WAV
READ = SAMPLE
TUNE = -31
FINE = -13
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 58.667 MS
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 2.897 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 496.000 MS
SUSTAIN = 30%
RELEASE = 2.175 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 55%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.1%

FAIRWAVE PATCH 1
NAME  = T1 12-STRING
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's T1 12-String by Ian Dixon: M1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr_WS: Guitar 1.
# Oscillator 2 is A's 2, the sample Gtr_WS: Guitar 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B1/A5F27F58.WAV
READ = SAMPLE
TUNE = -14
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 57.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/8C/FB216BCF.WAV
READ = SAMPLE
TUNE = -14
FINE = 20
POS = 0.0%
EDGE = WRAP
LOOP = 63.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 19%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.5%

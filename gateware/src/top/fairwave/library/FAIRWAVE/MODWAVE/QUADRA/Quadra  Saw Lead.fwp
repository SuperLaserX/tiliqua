FAIRWAVE PATCH 1
NAME  = QUADRA  SAW LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra  Saw Lead by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/7C/12B89390.WAV
READ = CLEAN
TUNE = -12
POS = 17.0%

[OSC 2]
TABLE = MODWAVE/T/1E/F5DC7DF4.WAV
READ = CLEAN
TUNE = 12
FINE = -8
POS = 17.0%

[ENV 1]
GATE = GATE 1
ATTACK = 613.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 733.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 2.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66%
ENV 2 > POS 2 = 66%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

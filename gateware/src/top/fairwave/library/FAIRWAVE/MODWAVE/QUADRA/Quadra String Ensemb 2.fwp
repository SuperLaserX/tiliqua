FAIRWAVE PATCH 1
NAME  = QUADRA STRING EN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra String Ensemble by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is A's 2, the sample Syn: Ensemble A2600.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/ED/65AFD90A.WAV
READ = SAMPLE
TUNE = -7
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AB/B4735156.WAV
READ = SAMPLE
TUNE = -7
FINE = 45
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 306.667 MS
DECAY = 1.867 S
SUSTAIN = 100%
RELEASE = 2.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.3%

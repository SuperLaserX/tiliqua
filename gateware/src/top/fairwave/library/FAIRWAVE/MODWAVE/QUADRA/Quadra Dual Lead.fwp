FAIRWAVE PATCH 1
NAME  = QUADRA DUAL LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Dual Lead by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 2, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E3/CF9B5F1D.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 19.1%

[OSC 2]
TABLE = MODWAVE/T/80/2E114C7C.WAV
READ = CLEAN
TUNE = 12
FINE = 2
POS = 19.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 100%
RELEASE = 4.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 29.333 MS
DECAY = 2.333 S
SUSTAIN = 99%
RELEASE = 1.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62%
ENV 2 > POS 2 = 62%
CV 1 > POS 1 = -32%
CV 1 > POS 2 = -32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.3%

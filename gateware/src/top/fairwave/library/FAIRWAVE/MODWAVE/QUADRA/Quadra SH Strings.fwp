FAIRWAVE PATCH 1
NAME  = QUADRA S/H STRIN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra S/H Strings by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: BlkChor St. Chorus, BlkChor St. Flanger, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F9/140C30F6.WAV
READ = SAMPLE
TUNE = -19
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BB/F0B00841.WAV
READ = CLEAN
TUNE = 0
POS = 17.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.547 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 722.667 MS
SUSTAIN = 32%
RELEASE = 544.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW DN
PHASE = 58
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 65.5%
LFO 1 > POS 2 = 36.5%
CV 1 > POS 2 = -28.5%
ENV 2 > LEVEL 1 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 98.9%

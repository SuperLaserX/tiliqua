FAIRWAVE PATCH 1
NAME  = QUADRA MEDITATIO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Meditation by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B7/D0574AF1.WAV
READ = SAMPLE
TUNE = -19
FINE = 41
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AF/75684981.WAV
READ = CLEAN
TUNE = 0
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 506.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 833.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 86.667 MS
DECAY = 90.000 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.5%

FAIRWAVE PATCH 1
NAME  = QUADRA BASS / OR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Bass / Organ by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Fast Vintage Chorus, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A8/B09C9EE9.WAV
READ = CLEAN
TUNE = -24
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/C1/8137A0B7.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.103 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.0%

FAIRWAVE PATCH 1
NAME  = QUADRA LUSH POLY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Lush Poly Strings by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/7D/CBB6870B.WAV
READ = CLEAN
TUNE = 0
POS = 66.4%

[OSC 2]
TABLE = MODWAVE/T/60/B099F7C9.WAV
READ = CLEAN
TUNE = 12
POS = 57.2%

[ENV 1]
GATE = GATE 1
ATTACK = 360.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 5.280 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 10%
LFO 1 > POS 2 = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.7%

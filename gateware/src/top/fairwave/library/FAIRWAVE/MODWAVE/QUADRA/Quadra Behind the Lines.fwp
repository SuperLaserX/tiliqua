FAIRWAVE PATCH 1
NAME  = QUADRA BEHIND TH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Behind the Lines by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7D/CBB6870B.WAV
READ = CLEAN
TUNE = 0
POS = 66.4%

[OSC 2]
TABLE = MODWAVE/T/A1/19905F24.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 36.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 5.280 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -73%
LFO 1 > POS 1 = 10%
LFO 2 > POS 2 = 6%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.8%

FAIRWAVE PATCH 1
NAME  = QUADRA FOLLOW LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Follow Lead by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E3/D2B5E8F0.WAV
READ = CLEAN
TUNE = -12
POS = 13.9%

[OSC 2]
TABLE = MODWAVE/T/E3/D2B5E8F0.WAV
TUNE = -12
POS = 13.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 433.333 MS
DECAY = 21.333 MS
SUSTAIN = 100%
RELEASE = 23.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 653.333 MS
DECAY = 8.000 S
SUSTAIN = 64%
RELEASE = 1.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 72.5%
CV 1 > POS 1 = -23%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

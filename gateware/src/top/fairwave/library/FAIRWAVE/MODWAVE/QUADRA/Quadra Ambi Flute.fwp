FAIRWAVE PATCH 1
NAME  = QUADRA AMBI FLUT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Ambi Flute by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/03/04C63566.WAV
READ = CLEAN
TUNE = 12
POS = 36.5%

[OSC 2]
TABLE = MODWAVE/T/A0/5DF1CECC.WAV
READ = CLEAN
TUNE = 0
POS = 38.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.467 S
SUSTAIN = 0%
RELEASE = 1.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 712.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

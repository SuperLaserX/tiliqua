FAIRWAVE PATCH 1
NAME  = TRI PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tri Pad by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/98/135586F8.WAV
READ = CLEAN
TUNE = 0
POS = 64.5%

[OSC 2]
TABLE = MODWAVE/T/5B/AD14959F.WAV
READ = CLEAN
TUNE = 12
POS = 67.5%

[ENV 1]
GATE = GATE 1
ATTACK = 2.267 S
DECAY = 60.000 S
SUSTAIN = 97%
RELEASE = 1.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.9%

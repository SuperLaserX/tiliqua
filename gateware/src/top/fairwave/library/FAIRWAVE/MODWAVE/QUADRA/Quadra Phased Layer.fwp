FAIRWAVE PATCH 1
NAME  = QUADRA PHASED LA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Phased Layer by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100.
[OSC 1]
TABLE = MODWAVE/T/B7/D0574AF1.WAV
READ = SAMPLE
TUNE = -19
FINE = 41
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1C/1D8CAAE2.WAV
READ = CLEAN
TUNE = -12
POS = 33.0%

[ENV 1]
GATE = GATE 1
ATTACK = 506.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 833.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.1%

FAIRWAVE PATCH 1
NAME  = QUADRA ALONE ORG
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Alone Organ choru by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/66/597821D4.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/61/9D6EE855.WAV
READ = CLEAN
TUNE = 0
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = DESC ARP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Desc Arp by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/12/033DE954.WAV
READ = CLEAN
TUNE = 0
POS = 12.7%

[OSC 2]
TABLE = MODWAVE/T/25/88CB85A5.WAV
READ = CLEAN
TUNE = 12
FINE = 4
POS = 12.7%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 90.000 S
SUSTAIN = 68%
RELEASE = 2.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.533 S
DECAY = 90.000 S
SUSTAIN = 97%
RELEASE = 85.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 6.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 1 > LEVEL 2 = 14%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

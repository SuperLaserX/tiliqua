FAIRWAVE PATCH 1
NAME  = QUADRA LESILE OR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Lesile Organ by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Fast Vintage Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/02/B6B9A3A2.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 40.4%

[OSC 2]
TABLE = MODWAVE/T/2D/815053F2.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 37.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

FAIRWAVE PATCH 1
NAME  = QUADRA PULSE STA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Pulse Stab by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/26/25F51B2C.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/26/25F51B2C.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 29.333 MS
DECAY = 44.000 MS
SUSTAIN = 100%
RELEASE = 793.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.472 S
SUSTAIN = 15%
RELEASE = 90.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 5.280 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 100%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

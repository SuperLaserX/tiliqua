FAIRWAVE PATCH 1
NAME  = QUADRA PHASED EN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Phased Ensemble by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Bass/Lead M/poly.
# Oscillator 2 is B's 2, the sample Syn: Ensemble A2600.
# Not carried over: layer A oscillator 1, layer B oscillator 1.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/29/C5DA2FA8.WAV
READ = SAMPLE
TUNE = -12
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 57.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/91/DCEC5905.WAV
READ = SAMPLE
TUNE = -6
FINE = -40
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 306.667 MS
DECAY = 1.867 S
SUSTAIN = 100%
RELEASE = 2.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.5%

FAIRWAVE PATCH 1
NAME  = QUADRA BASS PULS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Bass Pulse Split by Ian Dixon: IDquadra.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/26/25F51B2C.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/C5/C79E8176.WAV
READ = CLEAN
TUNE = -24
POS = 23.4%

[ENV 1]
GATE = GATE 1
ATTACK = 29.333 MS
DECAY = 44.000 MS
SUSTAIN = 100%
RELEASE = 793.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 620.000 MS
SUSTAIN = 50%
RELEASE = 3.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 5.280 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 53%
CV 1 > POS 2 = -39%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = D-110 ELEC GTR 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Elec Gtr 2 by Ian Dixon: ID-D110.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Elec Gtr 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/BB/65470607.WAV
READ = SAMPLE
TUNE = -15
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 98.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BB/65470607.WAV
TUNE = -15
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

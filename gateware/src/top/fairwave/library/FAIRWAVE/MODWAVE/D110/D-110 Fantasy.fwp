FAIRWAVE PATCH 1
NAME  = D-110 FANTASY
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Fantasy by Ian Dixon: ID-D110.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D-110 Fantasy.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A9/2581E908.WAV
READ = SAMPLE
TUNE = -6
FINE = 36
POS = 0.0%
EDGE = WRAP
LOOP = 94.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A9/2581E908.WAV
TUNE = -6
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

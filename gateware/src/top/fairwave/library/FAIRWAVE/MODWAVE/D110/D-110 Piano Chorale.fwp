FAIRWAVE PATCH 1
NAME  = D-110 PIANO CHOR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Piano Chorale by Ian Dixon: ID-D110.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Chorale.
# Oscillator 2 is A's 2, the sample D-110-AcouPiano1.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/EC/2C201658.WAV
READ = SAMPLE
TUNE = -18
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 34%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B9/C08A0190.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 61.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 433.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.5%

FAIRWAVE PATCH 1
NAME  = D-110 ECHO ARP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Echo ARP by Ian Dixon: ID-D110.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Echo Pan.
# Oscillator 2 is A's 2, the sample D-110-Ice Rains Long.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/51/C1F6E3E7.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1D/32D40E7E.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 14.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.9%

FAIRWAVE PATCH 1
NAME  = D-110 ELECPIANO2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 ElecPiano2 by Ian Dixon: ID-D110.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-ElecPiano2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/09/D083DE92.WAV
READ = SAMPLE
TUNE = -17
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 93.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/09/D083DE92.WAV
TUNE = -17
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

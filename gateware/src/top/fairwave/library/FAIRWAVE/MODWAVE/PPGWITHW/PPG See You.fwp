FAIRWAVE PATCH 1
NAME  = PPG SEE YOU
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG See You by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/02/A369D924.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 61.7%

[OSC 2]
TABLE = MODWAVE/T/B2/E384EC04.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 61.7%

[ENV 1]
GATE = GATE 1
ATTACK = 96.000 MS
DECAY = 580.000 MS
SUSTAIN = 100%
RELEASE = 304.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = PPG 8BIT BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG 8bit Bass by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Changing Patterns, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6F/0DD03663.WAV
READ = CLEAN
TUNE = -12
POS = 17.4%

[OSC 2]
TABLE = MODWAVE/T/40/A7A27DF2.WAV
READ = CLEAN
TUNE = -12
POS = 17.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 77.333 S
SUSTAIN = 60%
RELEASE = 186.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.6%

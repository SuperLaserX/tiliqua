FAIRWAVE PATCH 1
NAME  = PPG  BELL WAVE V
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG  Bell Wave Vocal by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: layer A oscillator 1, layer A oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/3D/60D44259.WAV
READ = CLEAN
TUNE = 0
POS = 16.4%

[OSC 2]
TABLE = MODWAVE/T/57/30906B97.WAV
READ = CLEAN
TUNE = -12
POS = 16.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.133 S
SUSTAIN = 34%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67%
ENV 2 > POS 2 = 67%
CV 1 > POS 1 = -27.5%
CV 1 > POS 2 = -27.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = PPG MONO LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Mono Lead by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B3/1CEDB83F.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 32.1%

[OSC 2]
TABLE = MODWAVE/T/D8/473C044A.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 32.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.541 S
SUSTAIN = 47%
RELEASE = 1.704 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.5%

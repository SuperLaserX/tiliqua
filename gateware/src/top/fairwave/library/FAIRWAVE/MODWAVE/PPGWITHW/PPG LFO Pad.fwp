FAIRWAVE PATCH 1
NAME  = PPG LFO PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG LFO Pad by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A3/373261BC.WAV
READ = CLEAN
TUNE = -24
POS = 21.7%

[OSC 2]
TABLE = MODWAVE/T/6A/13374578.WAV
READ = CLEAN
TUNE = -12
POS = 21.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 77.333 S
SUSTAIN = 60%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36%
CV 1 > POS 2 = -36%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.8%

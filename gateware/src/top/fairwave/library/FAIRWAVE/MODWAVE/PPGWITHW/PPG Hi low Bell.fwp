FAIRWAVE PATCH 1
NAME  = PPG HI LOW BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Hi low Bell by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/F1/B918A55E.WAV
READ = CLEAN
TUNE = -12
POS = 20.0%

[OSC 2]
TABLE = MODWAVE/T/F3/FADA2038.WAV
READ = CLEAN
TUNE = 24
POS = 20.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.432 S
SUSTAIN = 8%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.344 S
SUSTAIN = 100%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.5%

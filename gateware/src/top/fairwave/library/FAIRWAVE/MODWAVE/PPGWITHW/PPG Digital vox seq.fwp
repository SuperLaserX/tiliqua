FAIRWAVE PATCH 1
NAME  = PPG DIGITAL VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Digital vox seq by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/76/14002531.WAV
READ = CLEAN
TUNE = -12
POS = 16.6%

[OSC 2]
TABLE = MODWAVE/T/76/14002531.WAV
READ = CLEAN
TUNE = -12
POS = 16.6%

[ENV 1]
GATE = GATE 1
ATTACK = 38.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 66.5%
CV 1 > POS 1 = -27.5%
CV 1 > POS 2 = -27.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = PPG BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Bass by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/C8/FB7A1352.WAV
READ = CLEAN
TUNE = -12
POS = 13.7%

[OSC 2]
TABLE = MODWAVE/T/F1/397C759D.WAV
READ = CLEAN
TUNE = -12
POS = 13.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 466.667 MS
SUSTAIN = 19%
RELEASE = 15.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 72.5%
ENV 2 > POS 2 = 72.5%
CV 1 > POS 1 = -23%
CV 1 > POS 2 = -23%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.5%

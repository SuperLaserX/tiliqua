FAIRWAVE PATCH 1
NAME  = PPG VP SOFT WAVE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG VP Soft wave by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Vox: Vocoder VP.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9E/8FC6A7F6.WAV
READ = CLEAN
TUNE = -12
POS = 16.4%

[OSC 2]
TABLE = MODWAVE/T/26/FFE121F7.WAV
READ = SAMPLE
TUNE = -12
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 9.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 78.667 S
SUSTAIN = 94%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67%
CV 1 > POS 1 = -27.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.7%

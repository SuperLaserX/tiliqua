FAIRWAVE PATCH 1
NAME  = PPG BELLS AND SA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Bells and Saw Gated by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 4, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/5A/F14BAA33.WAV
READ = CLEAN
TUNE = 0
POS = 20.8%

[OSC 2]
TABLE = MODWAVE/T/4F/043CFCD8.WAV
READ = CLEAN
TUNE = 24
POS = 20.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.816 S
SUSTAIN = 34%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58.5%
ENV 2 > POS 2 = 58.5%
CV 1 > POS 1 = -34.5%
CV 1 > POS 2 = -34.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

FAIRWAVE PATCH 1
NAME  = PPG VOCAL (OLD W
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Vocal (old WT) by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AE/5367E57C.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 34.6%

[OSC 2]
TABLE = MODWAVE/T/DC/568CE8E5.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 34.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

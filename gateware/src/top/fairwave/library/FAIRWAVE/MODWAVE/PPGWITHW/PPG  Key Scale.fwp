FAIRWAVE PATCH 1
NAME  = PPG  KEY SCALE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG  Key Scale by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/4A/B103BFD3.WAV
READ = CLEAN
TUNE = 24
FINE = 1
POS = 14.0%

[OSC 2]
TABLE = MODWAVE/T/8D/DD883DB7.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 14.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.067 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 50.616 S
SUSTAIN = 69%
RELEASE = 57.601 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.014 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > X DEPTH = 100%
ENV 2 > POS 1 = 72%
ENV 2 > POS 2 = 72%
CV 1 > POS 1 = -23.5%
CV 1 > POS 2 = -23.5%
LFO 1 > X DEPTH = 22.5%
CV 2 > POS 1 = 22.5%
CV 2 > POS 2 = 22.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.4%

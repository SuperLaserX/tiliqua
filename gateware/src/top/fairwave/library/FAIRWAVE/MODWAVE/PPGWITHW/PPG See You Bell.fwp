FAIRWAVE PATCH 1
NAME  = PPG SEE YOU BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG See You Bell by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/9D/40AE3925.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 90.3%

[OSC 2]
TABLE = MODWAVE/T/FE/6DC1DE08.WAV
READ = STEPS
TUNE = -12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 640.000 MS
SUSTAIN = 0%
RELEASE = 112.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 61.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

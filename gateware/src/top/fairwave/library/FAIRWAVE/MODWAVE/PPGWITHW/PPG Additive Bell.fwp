FAIRWAVE PATCH 1
NAME  = PPG ADDITIVE BEL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Additive Bell by Ian Dixon: idppgwithwaves.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BC/285F37DE.WAV
READ = CLEAN
TUNE = -12
POS = 16.1%

[OSC 2]
TABLE = MODWAVE/T/A6/2AE432C3.WAV
READ = CLEAN
TUNE = -12
POS = 16.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 8.000 S
SUSTAIN = 40%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 47.333 S
SUSTAIN = 100%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
ENV 2 > POS 2 = 68%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.2%

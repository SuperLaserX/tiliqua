FAIRWAVE PATCH 1
NAME  = AA PD SEASIDE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Seaside by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the noise generator.
# Its effects, which FairWave hasn't got: Reverse Delay, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/96/FC523773.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BB/F7518D1F.WAV
READ = CLEAN
TUNE = 0
FINE = 7
POS = 31.0%

[ENV 1]
GATE = GATE 1
ATTACK = 3.112 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.819 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.693 S
DECAY = 4.440 S
SUSTAIN = 0%
RELEASE = 4.608 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -51.5%
CV 2 > POS 2 = 38%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.7%

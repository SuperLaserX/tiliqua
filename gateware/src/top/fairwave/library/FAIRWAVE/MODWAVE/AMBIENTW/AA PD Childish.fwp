FAIRWAVE PATCH 1
NAME  = AA PD CHILDISH
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Childish by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Mband Bounce, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/AE/B7FDCE37.WAV
READ = CLEAN
TUNE = 12
FINE = 3
POS = 28.8%

[OSC 2]
TABLE = MODWAVE/T/22/3888E0A0.WAV
READ = CLEAN
TUNE = 19
FINE = -5
POS = 28.8%

[ENV 1]
GATE = GATE 1
ATTACK = 1.140 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.885 S
A CURVE = 20
D CURVE = 60
R CURVE = 20
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 5.2%

[LFO 1]
RATE = 0.780 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48%
CV 1 > POS 2 = -48%
CV 2 > POS 1 = 42.5%
CV 2 > POS 2 = 42.5%
LFO 1 > X DEPTH = 6.5%
CV 2 > X DEPTH = 5.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.5%

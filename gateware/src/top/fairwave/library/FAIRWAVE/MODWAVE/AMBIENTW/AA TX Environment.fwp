FAIRWAVE PATCH 1
NAME  = AA TX ENVIRONMEN
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA TX Environment by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Pattern 4, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/92/4BB40F06.WAV
READ = CLEAN
TUNE = -24
POS = 27.8%

[OSC 2]
TABLE = MODWAVE/T/BE/FD066649.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 27.8%

[ENV 1]
GATE = GATE 1
ATTACK = 2.787 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.627 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
CV 2 > POS 1 = 44.5%
CV 2 > POS 2 = 44.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.5%

FAIRWAVE PATCH 1
NAME  = AA DR ENNUI
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Ennui by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/30/2DE21701.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 41.4%

[OSC 2]
TABLE = MODWAVE/T/11/8EF244E7.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.371 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.227 S
A CURVE = 30
D CURVE = 60
R CURVE = 40
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 100%
CV 1 > POS 1 = -69%
CV 2 > POS 1 = 17%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.4%

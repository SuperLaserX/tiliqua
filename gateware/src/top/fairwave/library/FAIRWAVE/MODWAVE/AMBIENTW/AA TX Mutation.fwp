FAIRWAVE PATCH 1
NAME  = AA TX MUTATION
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA TX Mutation by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Rave Pad, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/B1/07AFE0C8.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1D/66058359.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 654.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.148 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 29.7%

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.994 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
ENV 2 > POS 2 = 65.5%
CV 2 > LEVEL 1 = 31%
CV 2 > X DEPTH = 13.5%
LFO 1 > X DEPTH = 2%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

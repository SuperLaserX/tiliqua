FAIRWAVE PATCH 1
NAME  = AA DR SUBTERRA
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Subterra by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Emotive Pad, Stereo Chorus, bpm Mband Down Chor.
[OSC 1]
TABLE = MODWAVE/T/35/650F70FA.WAV
READ = CLEAN
TUNE = -18
FINE = -3
POS = 34.5%

[OSC 2]
TABLE = MODWAVE/T/62/F411E8C0.WAV
READ = CLEAN
TUNE = -12
FINE = 8
POS = 34.5%

[ENV 1]
GATE = GATE 1
ATTACK = 1.071 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.029 S
A CURVE = 30
D CURVE = 60
R CURVE = 30
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 35.7%

[ENV 2]
GATE = GATE 1
ATTACK = 3.301 S
DECAY = 3.984 S
SUSTAIN = 0%
RELEASE = 534.667 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -57.5%
CV 1 > POS 2 = -57.5%
CV 2 > POS 1 = 31%
CV 2 > POS 2 = 31%
CV 2 > LEVEL 1 = 27%
ENV 2 > POS 1 = 15.5%
ENV 2 > POS 2 = 15.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.8%

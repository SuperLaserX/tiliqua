FAIRWAVE PATCH 1
NAME  = AA DR OBSCURITY
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Obscurity by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Endless Plucks, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/87/81E3562E.WAV
READ = CLEAN
TUNE = -24
FINE = -2
POS = 37.6%

[OSC 2]
TABLE = MODWAVE/T/D7/FF0919FC.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 37.6%

[ENV 1]
GATE = GATE 1
ATTACK = 3.312 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.683 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 93.4%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -62.5%
CV 1 > POS 2 = -62.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%
LFO 1 > X DEPTH = 6%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = AA PD FLOATING
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Floating by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Ambient Reverse, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/20/7E80DA97.WAV
READ = CLEAN
TUNE = -24
POS = 37.6%

[OSC 2]
TABLE = MODWAVE/T/BC/84EE2D2F.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.411 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.235 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 100%
CV 1 > POS 1 = -62.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.9%

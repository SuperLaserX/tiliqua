FAIRWAVE PATCH 1
NAME  = AA TX WINTERTIME
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA TX Wintertime by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Mini MW Noise, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/3A/3ABDDD08.WAV
READ = CLEAN
TUNE = -5
FINE = -3
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/C4/89EAF950.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.516 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.419 S
A CURVE = 30
D CURVE = 60
R CURVE = 20
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 29.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

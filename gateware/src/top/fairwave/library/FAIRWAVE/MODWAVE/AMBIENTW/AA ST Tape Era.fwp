FAIRWAVE PATCH 1
NAME  = AA ST TAPE ERA
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Tape Era by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Phaser.
[OSC 1]
TABLE = MODWAVE/T/D6/728C5B35.WAV
READ = CLEAN
TUNE = -24
FINE = -1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BC/C151FBBC.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.332 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.512 S
A CURVE = 0
D CURVE = 60
R CURVE = 20
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
CV 2 > POS 2 = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.2%

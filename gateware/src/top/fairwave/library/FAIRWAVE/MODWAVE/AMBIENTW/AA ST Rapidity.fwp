FAIRWAVE PATCH 1
NAME  = AA ST RAPIDITY
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Rapidity by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/5F/81C6A990.WAV
READ = CLEAN
TUNE = -12
FINE = 13
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/08/A8F89C7B.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.243 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.251 S
A CURVE = 30
D CURVE = 60
R CURVE = 40
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = AA ST MURMUR
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Murmur by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/2B/057508DD.WAV
READ = CLEAN
TUNE = -36
POS = 36.1%

[OSC 2]
TABLE = MODWAVE/T/CF/6A28A1A1.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 3.093 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.687 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.235 S
DECAY = 3.357 S
SUSTAIN = 41%
RELEASE = 4.196 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -60%
CV 2 > POS 2 = 38.5%
CV 2 > POS 1 = 28%
ENV 2 > POS 1 = 8%
LFO 2 > POS 2 = 7%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.0%

FAIRWAVE PATCH 1
NAME  = AA ST DENSITY
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Density by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Ambient Reverse.
[OSC 1]
TABLE = MODWAVE/T/41/34F4F2EF.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/03/EFE09B4E.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 38.5%

[ENV 1]
GATE = GATE 1
ATTACK = 2.333 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.924 S
A CURVE = 0
D CURVE = 60
R CURVE = 20
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.203 S
DECAY = 4.311 S
SUSTAIN = 47%
RELEASE = 2.945 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -64%
CV 2 > POS 1 = 23.5%
CV 2 > POS 2 = 23%
ENV 2 > POS 2 = 17.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.1%

FAIRWAVE PATCH 1
NAME  = AA PD PHASE SHIF
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Phase Shift by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Phaser, Vintage Flanger, bpm Pattern 3, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/AB/9DBB006C.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/B9/1CCD1340.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 42.3%

[ENV 1]
GATE = GATE 1
ATTACK = 2.361 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.323 S
A CURVE = 30
D CURVE = 60
R CURVE = 10
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.261 S
DECAY = 4.465 S
SUSTAIN = 0%
RELEASE = 4.669 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -70.5%
CV 2 > POS 2 = 15.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 63.4%

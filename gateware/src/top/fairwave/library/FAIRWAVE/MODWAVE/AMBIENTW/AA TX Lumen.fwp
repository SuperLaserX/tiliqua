FAIRWAVE PATCH 1
NAME  = AA TX LUMEN
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA TX Lumen by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/A3/E7B2E07F.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 39.6%

[OSC 2]
TABLE = MODWAVE/T/86/7906213C.WAV
READ = CLEAN
TUNE = 10
FINE = 5
POS = 39.6%

[ENV 1]
GATE = GATE 1
ATTACK = 2.076 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.525 S
A CURVE = 30
D CURVE = 60
R CURVE = 30
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.620 S
DECAY = 16.253 S
SUSTAIN = 29%
RELEASE = 2.543 S
A CURVE = 10
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -66%
CV 1 > POS 2 = -66%
ENV 2 > POS 1 = 21%
ENV 2 > POS 2 = 21%
CV 2 > POS 1 = 20%
CV 2 > POS 2 = 20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 27.9%

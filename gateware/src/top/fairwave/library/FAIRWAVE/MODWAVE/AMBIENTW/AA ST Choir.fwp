FAIRWAVE PATCH 1
NAME  = AA ST CHOIR
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Choir by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Nonsense B, Stereo Chorus, bpm Tape Rhythm.
[OSC 1]
TABLE = MODWAVE/T/6E/61E1018D.WAV
READ = CLEAN
TUNE = -12
POS = 37.5%

[OSC 2]
TABLE = MODWAVE/T/08/144F7E6A.WAV
READ = CLEAN
TUNE = 0
FINE = 5
POS = 37.5%

[ENV 1]
GATE = GATE 1
ATTACK = 1.047 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.985 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -62.5%
CV 1 > POS 2 = -62.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.7%

FAIRWAVE PATCH 1
NAME  = AA TX SPLENDOR
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA TX Splendor by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Glass Pad, Stereo Chorus, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/D5/4AF185A8.WAV
READ = CLEAN
TUNE = -24
FINE = -2
POS = 39.0%

[OSC 2]
TABLE = MODWAVE/T/D9/CD29EEC2.WAV
READ = CLEAN
TUNE = 5
FINE = 3
POS = 39.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.373 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.869 S
A CURVE = 30
D CURVE = 60
R CURVE = 40
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -65%
CV 1 > POS 2 = -65%
CV 2 > POS 1 = 22%
CV 2 > POS 2 = 22%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.7%

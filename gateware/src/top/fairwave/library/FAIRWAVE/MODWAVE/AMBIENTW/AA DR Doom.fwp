FAIRWAVE PATCH 1
NAME  = AA DR DOOM
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Doom by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: bpm Growth, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/FF/081F35DF.WAV
READ = CLEAN
TUNE = 12
FINE = -4
POS = 42.6%

[OSC 2]
TABLE = MODWAVE/T/8C/9310A2C8.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 42.6%

[ENV 1]
GATE = GATE 1
ATTACK = 2.532 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.792 S
A CURVE = 0
D CURVE = 60
R CURVE = 40
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 26.9%

[LFO 2]
RATE = 2.246 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -71%
CV 1 > POS 2 = -71%
CV 2 > POS 1 = 15%
CV 2 > POS 2 = 15%
CV 2 > X DEPTH = 11%
LFO 2 > X DEPTH = 1.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = AA PD PARADISE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Paradise by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF.
[OSC 1]
TABLE = MODWAVE/T/1A/9450652A.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 32.1%

[OSC 2]
TABLE = MODWAVE/T/22/D616AFAA.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 32.1%

[ENV 1]
GATE = GATE 1
ATTACK = 2.367 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.365 S
A CURVE = 30
D CURVE = 60
R CURVE = 20
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
CV 2 > POS 1 = 35.5%
CV 2 > POS 2 = 35.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

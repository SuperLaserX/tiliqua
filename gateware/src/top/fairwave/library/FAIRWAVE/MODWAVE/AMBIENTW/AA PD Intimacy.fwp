FAIRWAVE PATCH 1
NAME  = AA PD INTIMACY
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Intimacy by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 8-Bit 12kHz, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/E4/AAAEB1CB.WAV
READ = CLEAN
TUNE = -17
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/CA/D14EF947.WAV
READ = CLEAN
TUNE = -5
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.768 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.699 S
A CURVE = 30
D CURVE = 60
R CURVE = 20
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 9.397 S
DECAY = 5.227 S
SUSTAIN = 0%
RELEASE = 4.223 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.6%

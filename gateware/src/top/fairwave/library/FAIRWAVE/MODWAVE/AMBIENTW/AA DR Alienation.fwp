FAIRWAVE PATCH 1
NAME  = AA DR ALIENATION
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Alienation by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ambient Reverse, Stereo Chorus, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/57/A26603E2.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/CC/1D2FA3AD.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.225 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.617 S
A CURVE = 30
D CURVE = 60
R CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.645 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 1.574 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
CV 2 > POS 2 = 100%
LFO 2 > POS 1 = 13.5%
LFO 1 > POS 2 = -11%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.2%

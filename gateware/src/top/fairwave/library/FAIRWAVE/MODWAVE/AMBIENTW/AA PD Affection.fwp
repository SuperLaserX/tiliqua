FAIRWAVE PATCH 1
NAME  = AA PD AFFECTION
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Affection by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/F5/85BE21FD.WAV
READ = CLEAN
TUNE = -12
FINE = -10
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/46/B3E0C524.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.816 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.984 S
A CURVE = 10
D CURVE = 60
R CURVE = 40
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 8.027 S
DECAY = 7.825 S
SUSTAIN = 0%
RELEASE = 4.571 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 2 = 100%
CV 2 > LEVEL 1 = -39%
CV 2 > LEVEL 2 = -39%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 93.2%

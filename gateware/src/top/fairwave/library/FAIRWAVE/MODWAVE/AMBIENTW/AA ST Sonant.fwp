FAIRWAVE PATCH 1
NAME  = AA ST SONANT
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Sonant by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Mband Bounce, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/BC/FC141631.WAV
READ = CLEAN
TUNE = -12
POS = 31.8%

[OSC 2]
TABLE = MODWAVE/T/A4/4E0EE3D9.WAV
READ = CLEAN
TUNE = 0
FINE = 5
POS = 31.8%

[ENV 1]
GATE = GATE 1
ATTACK = 2.708 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.172 S
A CURVE = 30
D CURVE = 80
R CURVE = 20
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53%
CV 1 > POS 2 = -53%
CV 2 > POS 1 = 36.5%
CV 2 > POS 2 = 36.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 17.8%

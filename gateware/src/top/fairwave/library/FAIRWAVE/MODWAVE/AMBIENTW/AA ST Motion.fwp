FAIRWAVE PATCH 1
NAME  = AA ST MOTION
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA ST Motion by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Stereo Chorus, Worldscape Pad, bpm Old Tape.
[OSC 1]
TABLE = MODWAVE/T/4A/1086D092.WAV
READ = CLEAN
TUNE = -12
FINE = -5
POS = 34.8%

[OSC 2]
TABLE = MODWAVE/T/68/1317825E.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 34.8%

[ENV 1]
GATE = GATE 1
ATTACK = 3.292 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.077 S
A CURVE = 30
D CURVE = 60
R CURVE = 20
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 77.4%

[LFO 1]
RATE = 0.808 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58%
CV 1 > POS 2 = -58%
CV 2 > POS 1 = 30.5%
CV 2 > POS 2 = 30.5%
LFO 1 > X DEPTH = 10%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 83.5%

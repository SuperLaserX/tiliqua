FAIRWAVE PATCH 1
NAME  = AA DR VANE
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA DR Vane by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Rose Garden Pad, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/75/E8D16FD8.WAV
READ = CLEAN
TUNE = -11
FINE = 6
POS = 36.5%

[OSC 2]
TABLE = MODWAVE/T/9A/B950207A.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 36.5%

[ENV 1]
GATE = GATE 1
ATTACK = 2.229 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.744 S
A CURVE = 0
D CURVE = 60
R CURVE = 30
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 22.6%

[LFO 1]
RATE = 9.256 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -61%
CV 1 > POS 2 = -61%
CV 2 > POS 1 = 27%
CV 2 > POS 2 = 27%
LFO 1 > POS 1 = 4%
LFO 1 > POS 2 = 4%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.1%

FAIRWAVE PATCH 1
NAME  = AA PD RETICENT
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Reticent by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/E8/1201D6BB.WAV
READ = CLEAN
TUNE = -12
POS = 25.7%

[OSC 2]
TABLE = MODWAVE/T/63/F0FAFDBA.WAV
READ = CLEAN
TUNE = 24
FINE = 4
POS = 25.7%

[ENV 1]
GATE = GATE 1
ATTACK = 3.660 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.117 S
A CURVE = 30
D CURVE = 60
R CURVE = 40
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = -57%
CV 2 > LEVEL 2 = -57%
CV 2 > POS 1 = 48.5%
CV 2 > POS 2 = 48.5%
CV 1 > POS 1 = -43%
CV 1 > POS 2 = -43%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 20.6%

FAIRWAVE PATCH 1
NAME  = AA PD CRYSTALS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA PD Crystals by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/1F/E8D1D302.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/83/0A48AE6E.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 42.3%

[ENV 1]
GATE = GATE 1
ATTACK = 3.309 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.795 S
A CURVE = 0
D CURVE = 60
R CURVE = 10
VCA = BOTH

[LFO 1]
RATE = 0.831 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
CV 1 > POS 2 = -70.5%
CV 2 > POS 2 = 15.5%
LFO 1 > POS 1 = 2%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.5%

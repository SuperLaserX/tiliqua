FAIRWAVE PATCH 1
NAME  = AA TX GLOOM
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's AA TX Gloom by Anton Anru: Korg Modwave - Ambient Worlds Bundle.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Chorus-Flange Morph, Phaser, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/FC/E7B37F52.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 36.0%

[OSC 2]
TABLE = MODWAVE/T/56/84178E4C.WAV
READ = CLEAN
TUNE = -21
FINE = 3
POS = 36.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.528 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.249 S
A CURVE = 10
D CURVE = 60
R CURVE = 30
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -60%
CV 1 > POS 2 = -60%
CV 2 > POS 1 = 28%
CV 2 > POS 2 = 28%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.3%

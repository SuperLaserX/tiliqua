FAIRWAVE PATCH 1
NAME  = DX SOFT BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DX Soft Brass by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/1F/1DEC6048.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/8D/0BE529F4.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 857.333 MS
SUSTAIN = 71%
RELEASE = 208.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 66.667 MS
DECAY = 2.661 S
SUSTAIN = 18%
RELEASE = 820.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
ENV 2 > X DEPTH = 39.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

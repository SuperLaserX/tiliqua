FAIRWAVE PATCH 1
NAME  = FM VOICES
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's FM Voices by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/51/F11ED939.WAV
READ = CLEAN
TUNE = -24
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/03/04C63566.WAV
READ = CLEAN
TUNE = 12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 364.000 MS
DECAY = 604.000 MS
SUSTAIN = 64%
RELEASE = 976.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 28.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = FM SQU BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's FM Squ Bell by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
[OSC 1]
TABLE = MODWAVE/T/B6/2576BD6E.WAV
READ = CLEAN
TUNE = 12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 545.333 MS
SUSTAIN = 41%
RELEASE = 4.208 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 31.0%

[LFO 1]
RATE = 0.325 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 5.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

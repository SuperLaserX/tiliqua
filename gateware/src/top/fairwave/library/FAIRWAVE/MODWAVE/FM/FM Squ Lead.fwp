FAIRWAVE PATCH 1
NAME  = FM SQU LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's FM Squ Lead by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0C/23D75000.WAV
READ = CLEAN
TUNE = 12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/E5/B63A2634.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 364.000 MS
DECAY = 604.000 MS
SUSTAIN = 64%
RELEASE = 976.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 14.6%

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 13.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = FM EP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's FM EP by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano_WS: E_PIANO3.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, EP Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/2C/97CE2860.WAV
READ = SAMPLE
TUNE = 0
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 24.524 S
SUSTAIN = 24%
RELEASE = 472.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.909 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 10%
LFO 1 > X DEPTH = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

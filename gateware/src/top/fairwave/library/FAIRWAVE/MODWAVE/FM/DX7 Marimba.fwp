FAIRWAVE PATCH 1
NAME  = DX7 MARIMBA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DX7 Marimba by Ian Dixon: FM.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Atk: Bell Mad Analog 37.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/24/EC69D3AC.WAV
READ = SAMPLE
TUNE = -26
FINE = -3
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 63%
RELEASE = 472.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 49.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 23.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

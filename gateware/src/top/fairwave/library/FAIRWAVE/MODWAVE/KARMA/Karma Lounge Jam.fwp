FAIRWAVE PATCH 1
NAME  = KARMA LOUNGE JAM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Karma Lounge Jam by Ian DIxon: ID-Karma.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Korg Karma Lounge Kit.
# Oscillator 2 is B's 1, the sample Korg Karma Lounge Kit.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/3D/34FC854D.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BB/962A016F.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 70.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 13.5%

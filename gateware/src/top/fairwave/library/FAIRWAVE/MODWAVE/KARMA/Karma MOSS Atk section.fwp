FAIRWAVE PATCH 1
NAME  = KARMA MOSS ATK S
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Karma MOSS Atk section by Ian DIxon: ID-Karma.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Korg Karma-AtkStringsMSS.
# Oscillator 2 is A's 2, the sample Korg Karma-GlistenStringsMOSS.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/DC/4937CA43.WAV
READ = SAMPLE
TUNE = -18
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3E/86CE88C9.WAV
READ = SAMPLE
TUNE = -18
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

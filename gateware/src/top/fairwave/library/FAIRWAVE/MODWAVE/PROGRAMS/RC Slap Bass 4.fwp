FAIRWAVE PATCH 1
NAME  = RC SLAP BASS 4
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC Slap Bass 4 by Deborah Pickett: RC Slap Bass 4.mwprog.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, the sample Bass: Slap 4 Thumb JB.
# Oscillator 2 is A's 2, the sample Bass: Slap 4 Pull JB.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Delay, Stuck in a Jar.
[OSC 1]
TABLE = MODWAVE/T/EF/E0F1CCFE.WAV
READ = SAMPLE
TUNE = -8
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 76.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C4/0E8C3CD6.WAV
READ = SAMPLE
TUNE = -5
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 81%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 3.867 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 4.0%

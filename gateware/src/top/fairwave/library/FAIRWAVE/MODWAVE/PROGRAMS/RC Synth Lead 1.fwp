FAIRWAVE PATCH 1
NAME  = RC SYNTH LEAD 1
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC Synth Lead 1 by Deborah Pickett: RC Synth Lead 1.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: MxKg Gnarly Lead.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Rezzo, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/62/A3E5406B.WAV
READ = SAMPLE
TUNE = -17
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 46%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/62/A3E5406B.WAV
TUNE = -17
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 1.200 S
SUSTAIN = 78%
RELEASE = 897.333 MS
A CURVE = 0
D CURVE = 100
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

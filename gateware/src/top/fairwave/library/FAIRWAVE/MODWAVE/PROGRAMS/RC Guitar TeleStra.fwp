FAIRWAVE PATCH 1
NAME  = RC GUITAR TELE/S
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's RC Guitar Tele/Stra by Deborah Pickett: RC Guitar TeleStra.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Clean 3 Tele.
# Oscillator 2 is A's 2, the sample Gtr: Clean 3 Stra.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 Pan Dance, Chorus-Flange Morph, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/F1/89A31BE5.WAV
READ = SAMPLE
TUNE = -2
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 80.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2B/2CC3C501.WAV
READ = SAMPLE
TUNE = -6
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 81.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 14.929 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 4.6%

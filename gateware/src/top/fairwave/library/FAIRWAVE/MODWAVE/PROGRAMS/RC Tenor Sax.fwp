FAIRWAVE PATCH 1
NAME  = RC TENOR SAX
ABOUT = WOODWIND FROM MODWAVE. GATE 1, CV 

# From the modwave's RC Tenor Sax by Deborah Pickett: RC Tenor Sax.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd: Tenor Saxophone f.
# Oscillator 2 is A's 2, the sample Wnd: Tenor Sax Growl.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Delay, Talking Modulator.
[OSC 1]
TABLE = MODWAVE/T/06/2A72A28B.WAV
READ = SAMPLE
TUNE = -6
FINE = -49
POS = 0.0%
EDGE = WRAP
LOOP = 58.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D7/C9060A87.WAV
READ = SAMPLE
TUNE = -5
FINE = -38
POS = 0.0%
EDGE = WRAP
LOOP = 60.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 1.000 S
SUSTAIN = 69%
RELEASE = 66.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 8.8%

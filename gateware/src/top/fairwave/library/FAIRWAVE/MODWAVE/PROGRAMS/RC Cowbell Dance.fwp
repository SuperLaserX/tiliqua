FAIRWAVE PATCH 1
NAME  = RC COWBELL DANCE
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's RC Cowbell Dance by Deborah Pickett: RC Cowbell Dance.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc: Dance Cowbell.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Phaser, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/B5/9493C7E0.WAV
READ = SAMPLE
TUNE = -15
FINE = 19
POS = 0.0%
EDGE = WRAP
LOOP = 42.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B5/9493C7E0.WAV
TUNE = -15
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 333.333 MS
SUSTAIN = 0%
RELEASE = 626.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

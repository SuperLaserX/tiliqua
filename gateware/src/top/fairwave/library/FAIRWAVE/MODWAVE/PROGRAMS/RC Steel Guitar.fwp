FAIRWAVE PATCH 1
NAME  = RC STEEL GUITAR
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's RC Steel Guitar by Deborah Pickett: RC Steel Guitar.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Steel Guitar p.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Mix Bright & Clean, Stereo Chorus, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/D4/3F623099.WAV
READ = SAMPLE
TUNE = -6
FINE = -36
POS = 0.0%
EDGE = WRAP
LOOP = 94.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D4/3F623099.WAV
TUNE = -6
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 7.423 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

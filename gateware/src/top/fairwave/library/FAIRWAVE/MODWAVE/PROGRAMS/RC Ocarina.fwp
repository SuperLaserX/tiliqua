FAIRWAVE PATCH 1
NAME  = RC OCARINA
ABOUT = WOODWIND FROM MODWAVE. GATE 1, CV 

# From the modwave's RC Ocarina by Deborah Pickett: RC Ocarina.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd: Ocarina 1.
# Oscillator 2 is A's 2, the sample Wnd: Ocarina 2.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Delay, Talking Modulator.
[OSC 1]
TABLE = MODWAVE/T/CE/DF882CFD.WAV
READ = SAMPLE
TUNE = -4
FINE = 20
POS = 0.0%
EDGE = WRAP
LOOP = 19.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B9/AF85759E.WAV
READ = SAMPLE
TUNE = -6
FINE = -30
POS = 0.0%
EDGE = WRAP
LOOP = 20.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 1.000 S
SUSTAIN = 69%
RELEASE = 66.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 9.7%

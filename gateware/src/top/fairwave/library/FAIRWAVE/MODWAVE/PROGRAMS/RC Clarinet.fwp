FAIRWAVE PATCH 1
NAME  = RC CLARINET
ABOUT = WOODWIND FROM MODWAVE. GATE 1, CV 

# From the modwave's RC Clarinet by Deborah Pickett: RC Clarinet.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd: Clarinet 2 p.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Polysix Ensemble, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/3E/CFAD0F50.WAV
READ = SAMPLE
TUNE = -30
FINE = -18
POS = 0.0%
EDGE = WRAP
LOOP = 67%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3E/CFAD0F50.WAV
TUNE = -30
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 1.000 S
SUSTAIN = 87%
RELEASE = 66.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

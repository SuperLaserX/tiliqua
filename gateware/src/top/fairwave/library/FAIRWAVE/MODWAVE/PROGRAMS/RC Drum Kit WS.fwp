FAIRWAVE PATCH 1
NAME  = RC DRUM KIT WS
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's RC Drum Kit WS by Deborah Pickett: RC Drum Kit WS.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Drm_WS: Drum Kit.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bass Squasher, Stereo Chorus, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/5C/CB1D497D.WAV
READ = SAMPLE
TUNE = -12
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5C/CB1D497D.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 90.000 S
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

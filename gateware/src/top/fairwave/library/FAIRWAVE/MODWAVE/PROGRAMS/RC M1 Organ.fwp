FAIRWAVE PATCH 1
NAME  = RC M1 ORGAN
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's RC M1 Organ by Deborah Pickett: RC M1 Organ.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Organ: M1.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Smooth Tremolo, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/31/D5DA8F7E.WAV
READ = SAMPLE
TUNE = -11
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 76.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/31/D5DA8F7E.WAV
TUNE = -11
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 17.333 MS
DECAY = 57.333 MS
SUSTAIN = 74%
RELEASE = 580.000 MS
A CURVE = 100
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

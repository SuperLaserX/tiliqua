FAIRWAVE PATCH 1
NAME  = RC PAD SYN GURU
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's RC Pad Syn Guru by Deborah Pickett: RC Pad Syn Guru.mwprog.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn_Guru: InnerStellar.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black Phase, Mix Bright & Clean, Stereo Delay.
[OSC 1]
TABLE = MODWAVE/T/41/EA0C3A07.WAV
READ = SAMPLE
TUNE = -34
FINE = 23
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/41/EA0C3A07.WAV
TUNE = -34
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 20.000 MS
DECAY = 14.351 S
SUSTAIN = 83%
RELEASE = 580.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

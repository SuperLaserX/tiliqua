FAIRWAVE PATCH 1
NAME  = KORG DELTA STRIN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Korg Delta Strings by Ian dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C8/13C8AEAD.WAV
READ = CLEAN
TUNE = 12
FINE = 2
POS = 52.8%

[OSC 2]
TABLE = MODWAVE/T/52/3A53C7B6.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 52.4%

[ENV 1]
GATE = GATE 1
ATTACK = 78.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 8.541 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 9%
LFO 1 > POS 2 = 7%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.5%

FAIRWAVE PATCH 1
NAME  = SOLINA ENSEMBLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Solina Ensemble Split by Ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: String Ensemble Sln.
# Oscillator 2 is A's 2, the sample Syn: String Ensemble Sln.
# Not carried over: layer B oscillator 1, layer B oscillator 2, modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Suspenstrings, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/DF/98F3DF4F.WAV
READ = SAMPLE
TUNE = -13
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 1.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E1/1BEA8636.WAV
READ = SAMPLE
TUNE = -13
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 1.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 793.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.533 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.6%

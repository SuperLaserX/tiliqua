FAIRWAVE PATCH 1
NAME  = VP-330 BASS/STRI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VP-330 Bass/Strings by Ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 2, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E7/DF1482D1.WAV
READ = SAMPLE
TUNE = -7
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9B/BBDB6C34.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 30.8%

[ENV 1]
GATE = GATE 1
ATTACK = 793.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 2 = 38.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.8%

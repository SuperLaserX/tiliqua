FAIRWAVE PATCH 1
NAME  = ELKA CELESTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Elka Celeste by Ian dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/14/51FC8BFC.WAV
READ = CLEAN
TUNE = 12
FINE = -2
POS = 81.8%

[OSC 2]
TABLE = MODWAVE/T/13/4C73D72E.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 86.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.533 S
SUSTAIN = 0%
RELEASE = 693.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

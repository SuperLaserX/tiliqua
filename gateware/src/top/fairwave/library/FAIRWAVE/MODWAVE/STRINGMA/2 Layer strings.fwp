FAIRWAVE PATCH 1
NAME  = 2 LAYER STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 2 Layer strings by ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/87/EAAC7EC0.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/3D/CCFB3059.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 626.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 61.0%

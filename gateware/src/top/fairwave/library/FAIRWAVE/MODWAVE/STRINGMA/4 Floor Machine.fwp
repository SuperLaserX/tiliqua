FAIRWAVE PATCH 1
NAME  = 4 FLOOR MACHINE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 4 Floor Machine by Ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is B's 1, the sample Drm: Kick Dance 04.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2D/E5A61513.WAV
READ = SAMPLE
TUNE = -7
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 0.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C6/8CDB0E6B.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 793.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 4.840 S
DECAY = 83.200 S
SUSTAIN = 46%
RELEASE = 2.472 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 98.1%

FAIRWAVE PATCH 1
NAME  = BASS SECTION
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bass Section by Ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/9B/BBDB6C34.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 30.8%

[OSC 2]
TABLE = MODWAVE/T/4B/AA9EE559.WAV
READ = CLEAN
TUNE = -24
FINE = 3
POS = 30.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.600 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 260.000 MS
SUSTAIN = 10%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51.5%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 1 = 38.5%
ENV 2 > POS 2 = 38.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

FAIRWAVE PATCH 1
NAME  = VP-330 BASS/VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VP-330 Bass/Vox by Ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AB/C0D7AAE4.WAV
READ = SAMPLE
TUNE = -12
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9B/BBDB6C34.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 30.8%

[ENV 1]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 418.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.733 S
DECAY = 1.240 S
SUSTAIN = 67%
RELEASE = 4.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 2 = 38.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.3%

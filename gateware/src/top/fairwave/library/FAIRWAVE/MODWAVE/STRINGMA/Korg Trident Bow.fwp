FAIRWAVE PATCH 1
NAME  = KORG TRIDENT BOW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Korg Trident Bow by Ian dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: BlkChor St. Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/4A87FFD8.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1F/80858EB4.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 52.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.176 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.976 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
ENV 2 > LEVEL 1 = 55%
LFO 1 > POS 1 = 9.5%
LFO 1 > POS 2 = 7%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

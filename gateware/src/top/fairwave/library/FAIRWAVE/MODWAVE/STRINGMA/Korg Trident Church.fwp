FAIRWAVE PATCH 1
NAME  = KORG TRIDENT CHU
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Korg Trident Church by Ian dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C9/673D8D3B.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 33.8%

[OSC 2]
TABLE = MODWAVE/T/49/8B7EAB0B.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 33.8%

[ENV 1]
GATE = GATE 1
ATTACK = 626.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 173.333 MS
DECAY = 90.000 S
SUSTAIN = 95%
RELEASE = 2.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -56.5%
CV 1 > POS 2 = -56.5%
ENV 2 > POS 1 = 32.5%
ENV 2 > POS 2 = 32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.0%

FAIRWAVE PATCH 1
NAME  = KORG TRIDENT COM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Korg Trident Combi by Ian dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: layer A oscillator 2, layer B oscillator 1, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C5/78E73D74.WAV
READ = CLEAN
TUNE = -12
POS = 19.6%

[OSC 2]
TABLE = MODWAVE/T/3D/CCFB3059.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 1.200 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61%
CV 1 > POS 1 = -32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.4%

FAIRWAVE PATCH 1
NAME  = ELKA LOW STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Elka Low Strings by ian Dixon: StringMachines.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/44/1765D615.WAV
READ = CLEAN
TUNE = 12
POS = 50.4%

[OSC 2]
TABLE = MODWAVE/T/16/6E31B0D0.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 50.4%

[ENV 1]
GATE = GATE 1
ATTACK = 500.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.952 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 7%
LFO 1 > POS 2 = 7%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.7%

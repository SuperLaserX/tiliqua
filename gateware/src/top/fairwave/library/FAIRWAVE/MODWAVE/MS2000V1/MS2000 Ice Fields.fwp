FAIRWAVE PATCH 1
NAME  = MS2000 ICE FIELD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Ice Fields by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/19/E3C8A207.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 5.9%

[OSC 2]
TABLE = MODWAVE/T/74/E2279A6B.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 5.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 46.667 S
SUSTAIN = 51%
RELEASE = 4.813 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 33.333 MS
DECAY = 3.600 S
SUSTAIN = 28%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 88%
ENV 2 > POS 2 = 88%
CV 1 > POS 1 = 10%
CV 1 > POS 2 = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

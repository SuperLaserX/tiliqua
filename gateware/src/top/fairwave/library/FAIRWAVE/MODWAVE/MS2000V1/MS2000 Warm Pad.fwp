FAIRWAVE PATCH 1
NAME  = MS2000 WARM PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Warm Pad by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/C5/A1C1BD35.WAV
READ = CLEAN
TUNE = -12
POS = 35.8%

[OSC 2]
TABLE = MODWAVE/T/26/6B303A73.WAV
READ = CLEAN
TUNE = -12
POS = 35.8%

[ENV 1]
GATE = GATE 1
ATTACK = 186.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.467 S
SUSTAIN = 100%
RELEASE = 846.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -59.5%
CV 1 > POS 2 = -59.5%
ENV 2 > POS 1 = 28.5%
ENV 2 > POS 2 = 28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.3%

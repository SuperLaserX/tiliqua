FAIRWAVE PATCH 1
NAME  = MS2000 VOICES
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Voices by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E1/56450333.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/4B/8A10F4DA.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 3.867 S
SUSTAIN = 12%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 3.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.0%

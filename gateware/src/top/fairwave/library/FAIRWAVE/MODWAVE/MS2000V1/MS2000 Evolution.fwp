FAIRWAVE PATCH 1
NAME  = MS2000 EVOLUTION
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Evolution  by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FA/BCF25331.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/C1/BEC981C2.WAV
READ = CLEAN
TUNE = -19
POS = 66.3%

[ENV 1]
GATE = GATE 1
ATTACK = 980.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.544 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.8%

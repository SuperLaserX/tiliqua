FAIRWAVE PATCH 1
NAME  = MS2000 CLASSICAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 ClassicArp by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is the other half of its 4 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Vintage Flanger, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/D7/77819F62.WAV
READ = CLEAN
TUNE = 0
FINE = -12
POS = 24.4%

[OSC 2]
TABLE = MODWAVE/T/D7/77819F62.WAV
READ = CLEAN
TUNE = 0
FINE = 12
POS = 24.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 750.667 MS
SUSTAIN = 28%
RELEASE = 832.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 920.000 MS
SUSTAIN = 4%
RELEASE = 328.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51%
ENV 2 > POS 2 = 51%
CV 1 > POS 1 = -40.5%
CV 1 > POS 2 = -40.5%
CV 2 > POS 1 = -35%
CV 2 > POS 2 = -35%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

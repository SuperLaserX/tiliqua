FAIRWAVE PATCH 1
NAME  = MS2000 DWGS BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 DWGS Bell 2 by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: DWGS Bell 4.
# Oscillator 2 is A's 2, the sample Wave: DWGS Bell 3.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/BB/E3E73735.WAV
READ = SAMPLE
TUNE = 0
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B6/D36ACFD4.WAV
READ = SAMPLE
TUNE = 0
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.000 S
SUSTAIN = 9%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.6%

FAIRWAVE PATCH 1
NAME  = MS2000 PULSE PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Pulse Pad by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/67/22F2EA61.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/28/1EFCC792.WAV
READ = CLEAN
TUNE = -12
POS = 46.8%

[ENV 1]
GATE = GATE 1
ATTACK = 186.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.042 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 78%
LFO 1 > POS 1 = 50%
ENV 2 > POS 1 = 30.5%
ENV 2 > POS 2 = 6.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.4%

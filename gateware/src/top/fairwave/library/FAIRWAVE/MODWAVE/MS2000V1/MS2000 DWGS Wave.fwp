FAIRWAVE PATCH 1
NAME  = MS2000 DWGS WAVE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 DWGS Wave by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/B1/0A058564.WAV
READ = CLEAN
TUNE = -12
POS = 18.9%

[OSC 2]
TABLE = MODWAVE/T/E3/CDA83145.WAV
READ = CLEAN
TUNE = -12
POS = 18.9%

[ENV 1]
GATE = GATE 1
ATTACK = 220.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 826.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 1.333 S
SUSTAIN = 68%
RELEASE = 453.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62%
ENV 2 > POS 2 = 62%
CV 1 > POS 1 = -31.5%
CV 1 > POS 2 = -31.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.4%

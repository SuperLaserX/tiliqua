FAIRWAVE PATCH 1
NAME  = MS2000 DWGS MORP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 DWGS Morph2 by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/8F/D160B7BD.WAV
READ = CLEAN
TUNE = -12
POS = 14.6%

[OSC 2]
TABLE = MODWAVE/T/37/1C796EA3.WAV
READ = CLEAN
TUNE = -12
POS = 14.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.000 S
SUSTAIN = 9%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 50.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 32.000 S
SUSTAIN = 93%
RELEASE = 4.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 71%
ENV 2 > POS 2 = 71%
LFO 1 > X DEPTH = 31%
CV 1 > POS 1 = -24.5%
CV 1 > POS 2 = -24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.5%

FAIRWAVE PATCH 1
NAME  = MS2000 UNI SYNTH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Uni Synth by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/33/F3ED30C7.WAV
READ = CLEAN
TUNE = -12
POS = 15.4%

[OSC 2]
TABLE = MODWAVE/T/4E/EA6051F4.WAV
READ = CLEAN
TUNE = -12
FINE = 6
POS = 15.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.080 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 87.333 S
SUSTAIN = 50%
RELEASE = 4.880 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.052 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
LFO 1 > LEVEL 1 = 65%
LFO 1 > LEVEL 2 = 65%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
LFO 3 > POS 1 = 1.5%
LFO 3 > POS 2 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

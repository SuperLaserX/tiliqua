FAIRWAVE PATCH 1
NAME  = MS2000 POLY LINE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Poly Line by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9C/7FE9DED1.WAV
READ = CLEAN
TUNE = -24
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/53/4B81A01D.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

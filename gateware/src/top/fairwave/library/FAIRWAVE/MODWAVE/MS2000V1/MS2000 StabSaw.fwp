FAIRWAVE PATCH 1
NAME  = MS2000 STABSAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 StabSaw by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: 250_500_750ms DDL.
[OSC 1]
TABLE = MODWAVE/T/9E/4C9C0349.WAV
READ = CLEAN
TUNE = 0
POS = 15.6%

[OSC 2]
TABLE = MODWAVE/T/CB/182349B9.WAV
READ = CLEAN
TUNE = 0
FINE = 6
POS = 15.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 52.000 MS
SUSTAIN = 76%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

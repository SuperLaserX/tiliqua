FAIRWAVE PATCH 1
NAME  = MS2000 PAD AND A
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Pad and Arp by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: layer A oscillator 1, layer A oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Black Phase, Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BC/83DA456B.WAV
READ = CLEAN
TUNE = -12
POS = 20.8%

[OSC 2]
TABLE = MODWAVE/T/C0/3B65E3D7.WAV
READ = CLEAN
TUNE = -12
POS = 20.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 28.667 S
SUSTAIN = 43%
RELEASE = 893.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.600 S
SUSTAIN = 0%
RELEASE = 14.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 1.240 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58.5%
ENV 2 > POS 2 = 58.5%
CV 1 > POS 1 = -34.5%
CV 1 > POS 2 = -34.5%
LFO 1 > POS 1 = 34.5%
LFO 1 > POS 2 = 34.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.2%

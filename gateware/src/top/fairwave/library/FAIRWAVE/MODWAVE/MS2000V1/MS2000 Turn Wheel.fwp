FAIRWAVE PATCH 1
NAME  = MS2000 TURN WHEE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's MS2000 Turn Wheel by Ian Dixon: ID-MS2000_V1.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/02/8775F3CB.WAV
READ = CLEAN
TUNE = -12
POS = 31.0%

[OSC 2]
TABLE = MODWAVE/T/02/8775F3CB.WAV
TUNE = -12
POS = 31.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 346.667 MS
SUSTAIN = 100%
RELEASE = 566.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 1.667 S
SUSTAIN = 46%
RELEASE = 413.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.247 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -51.5%
ENV 2 > POS 1 = 38%
LFO 1 > POS 1 = 11.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = SEA STRING
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sea String by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Analog Strings 1.
# Oscillator 2 is A's 2, a table made along morph.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F8/8FD69B10.WAV
READ = SAMPLE
TUNE = -25
FINE = -34
POS = 0.0%
EDGE = WRAP
LOOP = 8.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9C/8B8944C2.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 629.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 604.000 MS
DECAY = 772.000 MS
SUSTAIN = 0%
RELEASE = 1.801 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
LFO 1 > POS 2 = 50%
LFO 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

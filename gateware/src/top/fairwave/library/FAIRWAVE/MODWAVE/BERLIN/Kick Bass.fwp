FAIRWAVE PATCH 1
NAME  = KICK BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Kick Bass by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, The Beast, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/45/7F168A0E.WAV
READ = CLEAN
TUNE = -24
POS = 13.6%

[OSC 2]
TABLE = MODWAVE/T/D3/5BFD4F09.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 13.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 112.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 73%
ENV 2 > POS 2 = 73%
CV 1 > POS 1 = -22.5%
CV 1 > POS 2 = -22.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.4%

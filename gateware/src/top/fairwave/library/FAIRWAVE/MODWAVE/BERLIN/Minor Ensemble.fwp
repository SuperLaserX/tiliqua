FAIRWAVE PATCH 1
NAME  = MINOR ENSEMBLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minor Ensemble by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Vintage Stereo Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/34/830A4F09.WAV
READ = CLEAN
TUNE = -24
FINE = 3
POS = 18.0%

[OSC 2]
TABLE = MODWAVE/T/DD/5C976BB6.WAV
READ = CLEAN
TUNE = -24
FINE = -3
POS = 18.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 373.333 MS
SUSTAIN = 0%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.000 MS
DECAY = 2.067 S
SUSTAIN = 2%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.271 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 64%
ENV 2 > POS 2 = 64%
CV 1 > POS 1 = -30%
CV 1 > POS 2 = -30%
LFO 1 > POS 1 = 14%
LFO 1 > POS 2 = 14%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.5%

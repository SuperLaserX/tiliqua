FAIRWAVE PATCH 1
NAME  = WARNING KICK
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Warning Kick by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc: Click 1.
# Oscillator 2 is A's 2, the sample Drm: Kick Dance 11.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, JC Amp Chorus, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E4/8CA911C2.WAV
READ = SAMPLE
TUNE = -1
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/71/2FCE5B41.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 88.5%

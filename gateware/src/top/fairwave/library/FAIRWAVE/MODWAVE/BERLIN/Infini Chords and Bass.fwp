FAIRWAVE PATCH 1
NAME  = INFINI CHORDS AN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Infini Chords and Bass by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/39/942939E7.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/D4/BAF13888.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 88.000 MS
SUSTAIN = 0%
RELEASE = 58.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.257 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 31.5%
LFO 1 > POS 2 = 31.5%
CV 1 > POS 1 = -31%
CV 1 > POS 2 = -31%
ENV 2 > POS 1 = 20.5%
ENV 2 > POS 2 = 20.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.3%

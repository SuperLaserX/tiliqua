FAIRWAVE PATCH 1
NAME  = COLD SURFACE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cold Surface by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Distortion 1 f.
# Oscillator 2 is B's 1, a table made along position.
# Not carried over: layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Modern Compressor, Stereo Chorus, Vox AC30TB, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/39/ECBABCB5.WAV
READ = SAMPLE
TUNE = -8
FINE = -4
POS = 0.0%
EDGE = WRAP
LOOP = 49.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/24/47B2199D.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.536 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.563 S
SUSTAIN = 100%
RELEASE = 4.772 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

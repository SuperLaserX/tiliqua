FAIRWAVE PATCH 1
NAME  = PULSE WIDTH LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pulse Width Lead by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2A/D42DDEB6.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 45.5%

[OSC 2]
TABLE = MODWAVE/T/A4/75C3A78F.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 48.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.267 S
SUSTAIN = 0%
RELEASE = 1.747 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.053 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

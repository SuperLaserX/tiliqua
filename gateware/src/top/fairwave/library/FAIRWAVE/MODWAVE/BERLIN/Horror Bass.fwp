FAIRWAVE PATCH 1
NAME  = HORROR BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Horror Bass by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Air Vortex.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7B/E5452C20.WAV
READ = SAMPLE
TUNE = -19
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 38.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7B/E5452C20.WAV
TUNE = -19
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 34.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.353 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

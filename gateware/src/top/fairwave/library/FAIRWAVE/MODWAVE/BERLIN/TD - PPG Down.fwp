FAIRWAVE PATCH 1
NAME  = TD - PPG DOWN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD - PPG Down by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Tine EP Chorus, bpm Tape Rhythm.
[OSC 1]
TABLE = MODWAVE/T/E5/FA0435B2.WAV
READ = STEPS
TUNE = -12
FINE = 4
POS = 70.2%

[OSC 2]
TABLE = MODWAVE/T/96/136A6A82.WAV
READ = STEPS
TUNE = 0
FINE = -4
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.067 S
SUSTAIN = 0%
RELEASE = 466.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 4.373 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = -100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.5%

FAIRWAVE PATCH 1
NAME  = INFINI PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Infini Pad by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CB/669740AC.WAV
READ = CLEAN
TUNE = -12
POS = 6.8%

[OSC 2]
TABLE = MODWAVE/T/CB/669740AC.WAV
READ = CLEAN
TUNE = -12
POS = 6.8%

[ENV 1]
GATE = GATE 1
ATTACK = 293.333 MS
DECAY = 26.667 MS
SUSTAIN = 93%
RELEASE = 640.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 780.000 MS
DECAY = 90.000 S
SUSTAIN = 83%
RELEASE = 2.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 86.5%
ENV 2 > POS 2 = 86.5%
CV 1 > POS 1 = -11.5%
CV 1 > POS 2 = -11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

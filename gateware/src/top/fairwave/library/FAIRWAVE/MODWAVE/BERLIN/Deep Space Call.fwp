FAIRWAVE PATCH 1
NAME  = DEEP SPACE CALL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deep Space Call by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Made4 Slow Pads, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/02/27B31522.WAV
READ = CLEAN
TUNE = -12
POS = 0.9%

[OSC 2]
TABLE = MODWAVE/T/9D/DF203A49.WAV
READ = CLEAN
TUNE = 12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 86.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 533.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.488 S
DECAY = 24.357 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.064 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
LFO 1 > POS 1 = 80.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.9%

FAIRWAVE PATCH 1
NAME  = CHURCH LOOP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Church loop by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Made4 Slow Pads, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/2C/91231255.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.9%

[OSC 2]
TABLE = MODWAVE/T/64/69B202EC.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 93.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 11.333 S
SUSTAIN = 0%
RELEASE = 533.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.064 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = DRUM PULSES
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Drum Pulses by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Drm_WS: SynTom.
# Oscillator 2 is A's 2, the sample Drm: Tabla Tin.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Noise Kick, Polysix Ensemble, The Beast, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/28/E393476C.WAV
READ = SAMPLE
TUNE = -22
FINE = -48
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2D/D803B819.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 9.729 S
SUSTAIN = 1%
RELEASE = 557.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

FAIRWAVE PATCH 1
NAME  = DARK SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dark Sequence by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/52/FE1F2434.WAV
READ = CLEAN
TUNE = -24
POS = 14.6%

[OSC 2]
TABLE = MODWAVE/T/F8/D8042B75.WAV
READ = CLEAN
TUNE = -36
POS = 14.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 44.000 S
SUSTAIN = 60%
RELEASE = 22.060 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.133 S
SUSTAIN = 8%
RELEASE = 3.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.101 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70.5%
ENV 2 > POS 2 = 70.5%
LFO 1 > POS 1 = 48.5%
LFO 1 > POS 2 = 48.5%
CV 1 > POS 1 = -24.5%
CV 1 > POS 2 = -24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.1%

FAIRWAVE PATCH 1
NAME  = AMBI LAYERS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ambi Layers by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/DA/8F90A1BA.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/7A/D46EF8AB.WAV
READ = CLEAN
TUNE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 413.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.699 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 4.683 S
DECAY = 90.000 S
SUSTAIN = 49%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 2]
RATE = 0.067 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > LEVEL 2 = 100%
LFO 2 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

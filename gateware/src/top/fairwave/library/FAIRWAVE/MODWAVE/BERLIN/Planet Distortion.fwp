FAIRWAVE PATCH 1
NAME  = PLANET DISTORTIO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Planet Distortion by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Gtr: Power Chord 1.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Orange Phase V2 100, Vox AC30TB.
[OSC 1]
TABLE = MODWAVE/T/23/CABC58E4.WAV
READ = SAMPLE
TUNE = -13
FINE = 49
POS = 0.0%
EDGE = WRAP
LOOP = 47.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/23/CABC58E4.WAV
TUNE = -13
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.015 S
DECAY = 1.000 S
SUSTAIN = 100%
RELEASE = 2.761 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > LEVEL 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = ANTON PULSE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Anton Pulse by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/11/9D4F5F48.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 18.8%

[OSC 2]
TABLE = MODWAVE/T/11/9D4F5F48.WAV
TUNE = -12
POS = 18.8%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 17.333 MS
DECAY = 486.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 62.5%
CV 1 > POS 1 = -31%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = SOLINA AND VOCOD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Solina and Vocoder by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: String Ensemble Sln.
# Oscillator 2 is A's 2, the sample Vox: Vocoder VP.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2E/7C00BC42.WAV
READ = SAMPLE
TUNE = -13
FINE = 22
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EC/3FE485A4.WAV
READ = SAMPLE
TUNE = -12
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.000 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 866.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.5%

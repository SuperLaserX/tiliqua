FAIRWAVE PATCH 1
NAME  = ARR MOTION
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARR Motion by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Syn_WS: VoiceSyn.
# Oscillator 2 is B's 2, the sample Drm: Kick Dance 10.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer A oscillator 1, layer A oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CE/DC1109A7.WAV
READ = SAMPLE
TUNE = -13
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 43.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/A3/01C54D31.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.2%

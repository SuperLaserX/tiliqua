FAIRWAVE PATCH 1
NAME  = CALL OUT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Call out  by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/FE/0E3E8C74.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/FE/0E3E8C74.WAV
TUNE = -12
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 52.711 S
SUSTAIN = 100%
RELEASE = 712.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.282 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > LEVEL 1 = 100%
CV 1 > POS 1 = -37.5%
LFO 1 > POS 1 = 27.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = HORROR BY THE SE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Horror by the sea by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Analog Strings 1.
# Oscillator 2 is B's 2, the sample Syn: Air Vortex.
# Not carried over: layer A oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/35/4FDC3D8B.WAV
READ = SAMPLE
TUNE = -25
FINE = -34
POS = 0.0%
EDGE = WRAP
LOOP = 8.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/93/488EC60B.WAV
READ = SAMPLE
TUNE = -19
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 38.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 629.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.2%

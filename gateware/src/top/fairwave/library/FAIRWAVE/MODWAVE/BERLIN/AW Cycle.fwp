FAIRWAVE PATCH 1
NAME  = AW CYCLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's AW Cycle by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Tine EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FF/6310C5BC.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/FF/6310C5BC.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 68.000 MS
DECAY = 26.667 MS
SUSTAIN = 96%
RELEASE = 466.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.071 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

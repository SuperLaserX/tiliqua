FAIRWAVE PATCH 1
NAME  = CAVE DROPS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cave Drops by Ian Dixon: ID-Berlin.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/92/FE6C4063.WAV
READ = CLEAN
TUNE = 0
POS = 15.8%

[OSC 2]
TABLE = MODWAVE/T/1A/22B129E6.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 15.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 89.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 31.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 556.000 MS
SUSTAIN = 8%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.8%

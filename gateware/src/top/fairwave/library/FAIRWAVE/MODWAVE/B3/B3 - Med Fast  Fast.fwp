FAIRWAVE PATCH 1
NAME  = B3 - MED FAST /
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's B3 - Med Fast / Fast by Ian Dixon: B3.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample B3 Medium Fast.
# Not carried over: modulation processors.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/FF/FB5B6677.WAV
READ = SAMPLE
TUNE = -31
FINE = -27
POS = 0.0%
EDGE = WRAP
LOOP = 8.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FF/FB5B6677.WAV
TUNE = -31
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

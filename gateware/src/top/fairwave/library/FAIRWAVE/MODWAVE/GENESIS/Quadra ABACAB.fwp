FAIRWAVE PATCH 1
NAME  = QUADRA ABACAB
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra ABACAB by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/EB/109054EB.WAV
READ = CLEAN
TUNE = 0
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/15/DCD9C7EF.WAV
READ = CLEAN
TUNE = 7
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 46.667 S
SUSTAIN = 92%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.067 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.4%

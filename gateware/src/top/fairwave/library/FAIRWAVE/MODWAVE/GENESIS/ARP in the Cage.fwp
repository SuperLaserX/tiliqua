FAIRWAVE PATCH 1
NAME  = ARP IN THE CAGE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP in the Cage by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/FF/35F2A57B.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 17.3%

[OSC 2]
TABLE = MODWAVE/T/4A/0ACEA902.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 17.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 88.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.733 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65.5%
ENV 2 > POS 2 = 65.5%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

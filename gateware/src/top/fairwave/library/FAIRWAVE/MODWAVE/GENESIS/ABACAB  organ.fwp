FAIRWAVE PATCH 1
NAME  = ABACAB  ORGAN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ABACAB  organ by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Stereo EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E4/355AB211.WAV
READ = CLEAN
TUNE = -12
POS = 19.0%

[OSC 2]
TABLE = MODWAVE/T/DA/D98A79CB.WAV
READ = CLEAN
TUNE = -12
POS = 19.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 30.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62%
ENV 2 > POS 2 = 62%
CV 1 > POS 1 = -31.5%
CV 1 > POS 2 = -31.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.7%

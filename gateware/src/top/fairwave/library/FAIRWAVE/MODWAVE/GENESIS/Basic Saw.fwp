FAIRWAVE PATCH 1
NAME  = BASIC SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Basic Saw by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/07/277844CD.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/15/88293DF6.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 38.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 333.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = MAMA PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mama Pad by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: layer A oscillator 1, layer A oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/44/837C4963.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 31.0%

[OSC 2]
TABLE = MODWAVE/T/FA/9B12622B.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 31.0%

[ENV 1]
GATE = GATE 1
ATTACK = 173.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 666.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.147 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51.5%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 1 = 38%
ENV 2 > POS 2 = 38%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

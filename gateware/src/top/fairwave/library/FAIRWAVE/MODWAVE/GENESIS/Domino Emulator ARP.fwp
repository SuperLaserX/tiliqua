FAIRWAVE PATCH 1
NAME  = DOMINO EMULATOR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Domino Emulator ARP by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wnd_WS: Bottle WS.
# Oscillator 2 is A's 2, the sample Wnd: Bottleizer.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7C/98B4B7F7.WAV
READ = SAMPLE
TUNE = -27
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 42.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/78/EAA0A240.WAV
READ = SAMPLE
TUNE = -8
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 24.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.2%

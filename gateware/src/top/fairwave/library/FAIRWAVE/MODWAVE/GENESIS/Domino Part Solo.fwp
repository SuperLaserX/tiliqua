FAIRWAVE PATCH 1
NAME  = DOMINO PART SOLO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Domino Part Solo by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Wave_WS: Min1-02a.
# Not carried over: 2 unison voices, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9B/731E8345.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 6.7%

[OSC 2]
TABLE = MODWAVE/T/95/4E852942.WAV
READ = SAMPLE
TUNE = 0
FINE = -3
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 493.333 MS
DECAY = 90.000 S
SUSTAIN = 99%
RELEASE = 533.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 82%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.8%

FAIRWAVE PATCH 1
NAME  = QUADRA PHASED OR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Phased Organ by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/AC/5C828357.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 40.4%

[OSC 2]
TABLE = MODWAVE/T/52/C7F07440.WAV
READ = CLEAN
TUNE = -12
FINE = -6
POS = 37.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.7%

FAIRWAVE PATCH 1
NAME  = ARP PS TRUMPET
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP PS Trumpet by Ian dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage.
[OSC 1]
TABLE = MODWAVE/T/90/64AEC98D.WAV
READ = CLEAN
TUNE = -12
POS = 17.4%

[OSC 2]
TABLE = MODWAVE/T/90/64AEC98D.WAV
READ = CLEAN
TUNE = -12
POS = 17.4%

[ENV 1]
GATE = GATE 1
ATTACK = 81.333 MS
DECAY = 98.667 MS
SUSTAIN = 73%
RELEASE = 725.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 42.667 MS
DECAY = 15.447 S
SUSTAIN = 61%
RELEASE = 148.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 7.4%

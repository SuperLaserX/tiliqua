FAIRWAVE PATCH 1
NAME  = BASS PEDELS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bass Pedels by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the noise generator.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/209D5C27.WAV
READ = CLEAN
TUNE = -24
POS = 15.5%

[OSC 2]
TABLE = MODWAVE/T/A6/6F91D525.WAV
READ = CLEAN
TUNE = -36
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 42.000 S
SUSTAIN = 73%
RELEASE = 50.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 4.267 S
SUSTAIN = 50%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.4%

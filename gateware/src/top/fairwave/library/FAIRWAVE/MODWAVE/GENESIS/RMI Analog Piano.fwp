FAIRWAVE PATCH 1
NAME  = RMI ANALOG PIANO
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's RMI Analog Piano by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/7E/DA2FD49F.WAV
READ = CLEAN
TUNE = -12
POS = 37.8%

[OSC 2]
TABLE = MODWAVE/T/DD/2E5AA0FD.WAV
READ = CLEAN
TUNE = -12
POS = 37.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.067 S
SUSTAIN = 9%
RELEASE = 860.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 37.333 S
SUSTAIN = 8%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -63%
CV 1 > POS 2 = -63%
ENV 2 > POS 1 = 24.5%
ENV 2 > POS 2 = 24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = DX PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DX Pad by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/89/97228029.WAV
READ = CLEAN
TUNE = -36
FINE = 1
POS = 41.7%

[OSC 2]
TABLE = MODWAVE/T/E5/B63A2634.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 42.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 917.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 21.9%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

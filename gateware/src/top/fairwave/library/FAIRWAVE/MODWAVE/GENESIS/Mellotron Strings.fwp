FAIRWAVE PATCH 1
NAME  = MELLOTRON STRING
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mellotron Strings by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Tape 3 Violins-Chmb.
# Oscillator 2 is A's 2, the sample Str: Tape Mixed Strings.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Swirly, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/79/6E07CA12.WAV
READ = SAMPLE
TUNE = -27
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 35.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/ED/A8BBA381.WAV
READ = SAMPLE
TUNE = -26
FINE = -14
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 962.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

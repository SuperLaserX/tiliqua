FAIRWAVE PATCH 1
NAME  = QUADRA ALONE TON
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Quadra Alone Tonight Org by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Orange Phase V2 100, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/61/6C8056D0.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/14/9D5A7E51.WAV
READ = CLEAN
TUNE = 0
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.1%

FAIRWAVE PATCH 1
NAME  = TB LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TB Lead by Ian Dixon: Genesis.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/F0/D5F39171.WAV
READ = CLEAN
TUNE = -12
POS = 19.3%

[OSC 2]
TABLE = MODWAVE/T/B8/A1F5C1D6.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 19.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 88.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 80.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.733 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61.5%
ENV 2 > POS 2 = 61.5%
CV 1 > POS 1 = -32%
CV 1 > POS 2 = -32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

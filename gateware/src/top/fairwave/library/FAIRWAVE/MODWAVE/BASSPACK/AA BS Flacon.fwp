FAIRWAVE PATCH 1
NAME  = AA BS FLACON
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Flacon by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/31/1701444D.WAV
READ = CLEAN
TUNE = -36
POS = 26.0%

[OSC 2]
TABLE = MODWAVE/T/DE/56278DBF.WAV
READ = CLEAN
TUNE = -5
POS = 26.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 81%
RELEASE = 114.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 80.000 MS
SUSTAIN = 7%
RELEASE = 45.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 48%
ENV 2 > POS 2 = 48%
CV 1 > POS 1 = -43.5%
CV 1 > POS 2 = -43.5%
CV 2 > POS 1 = 9%
CV 2 > POS 2 = 9%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.4%

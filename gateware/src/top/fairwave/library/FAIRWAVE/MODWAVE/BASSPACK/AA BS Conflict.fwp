FAIRWAVE PATCH 1
NAME  = AA BS CONFLICT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Conflict by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/88/EF266794.WAV
READ = CLEAN
TUNE = -24
POS = 30.9%

[OSC 2]
TABLE = MODWAVE/T/3A/C41ADE2D.WAV
READ = CLEAN
TUNE = 12
FINE = 16
POS = 30.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 80%
RELEASE = 38.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 69.333 MS
SUSTAIN = 0%
RELEASE = 44.000 MS
A CURVE = 10
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51.5%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 1 = 38%
ENV 2 > POS 2 = 38%
CV 2 > LEVEL 2 = 8%
CV 2 > POS 1 = 2%
CV 2 > POS 2 = 2%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 9.7%

FAIRWAVE PATCH 1
NAME  = AA BS PIXEL
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Pixel by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/F1/353DC998.WAV
READ = CLEAN
TUNE = -24
POS = 28.9%

[OSC 2]
TABLE = MODWAVE/T/ED/24702119.WAV
READ = CLEAN
TUNE = -12
POS = 28.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 92.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 668.000 MS
SUSTAIN = 2%
RELEASE = 332.000 MS
A CURVE = 20
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48%
CV 1 > POS 2 = -48%
ENV 2 > POS 1 = 42.5%
ENV 2 > POS 2 = 42.5%
CV 2 > POS 1 = 33.5%
CV 2 > POS 2 = 33.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.3%

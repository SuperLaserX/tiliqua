FAIRWAVE PATCH 1
NAME  = AA BS ZOOM
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Zoom by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/B3/D2AE83F0.WAV
READ = CLEAN
TUNE = -36
POS = 23.8%

[OSC 2]
TABLE = MODWAVE/T/C7/16B5E84F.WAV
READ = CLEAN
TUNE = -36
POS = 23.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 220.000 MS
SUSTAIN = 13%
RELEASE = 97.333 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 52.5%
ENV 2 > POS 2 = 52.5%
CV 1 > POS 1 = -39.5%
CV 1 > POS 2 = -39.5%
CV 2 > POS 1 = 23%
CV 2 > POS 2 = 23%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.1%

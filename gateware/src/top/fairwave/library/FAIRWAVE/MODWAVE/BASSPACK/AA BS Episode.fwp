FAIRWAVE PATCH 1
NAME  = AA BS EPISODE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Episode by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black 2x12.
[OSC 1]
TABLE = MODWAVE/T/4F/DA2AB5D7.WAV
READ = CLEAN
TUNE = -24
POS = 32.2%

[OSC 2]
TABLE = MODWAVE/T/B8/6097A352.WAV
READ = CLEAN
TUNE = -24
POS = 32.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 81%
RELEASE = 84.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 260.000 MS
SUSTAIN = 0%
RELEASE = 57.333 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
CV 2 > POS 1 = 28%
CV 2 > POS 2 = 28%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.5%

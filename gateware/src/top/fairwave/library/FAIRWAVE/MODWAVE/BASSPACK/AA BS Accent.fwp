FAIRWAVE PATCH 1
NAME  = AA BS ACCENT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Accent by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/A0/30F9A3A9.WAV
READ = CLEAN
TUNE = -24
POS = 22.3%

[OSC 2]
TABLE = MODWAVE/T/17/3E784D56.WAV
READ = CLEAN
TUNE = -12
POS = 22.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 85%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 229.333 MS
SUSTAIN = 2%
RELEASE = 326.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 55.5%
ENV 2 > POS 2 = 55.5%
CV 1 > POS 1 = -37%
CV 1 > POS 2 = -37%
CV 2 > POS 1 = 19.5%
CV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.1%

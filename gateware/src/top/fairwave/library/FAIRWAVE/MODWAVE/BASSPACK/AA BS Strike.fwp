FAIRWAVE PATCH 1
NAME  = AA BS STRIKE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Strike by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/1B/FA1B539E.WAV
READ = CLEAN
TUNE = -24
POS = 27.1%

[OSC 2]
TABLE = MODWAVE/T/3D/B4CE277B.WAV
READ = CLEAN
TUNE = -12
POS = 27.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 80%
RELEASE = 36.000 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 5%
RELEASE = 57.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 46%
ENV 2 > POS 2 = 46%
CV 1 > POS 1 = -45%
CV 1 > POS 2 = -45%
CV 2 > POS 1 = 15.5%
CV 2 > POS 2 = 15.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 28.8%

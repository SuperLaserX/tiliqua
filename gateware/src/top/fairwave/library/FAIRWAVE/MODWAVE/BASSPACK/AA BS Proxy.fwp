FAIRWAVE PATCH 1
NAME  = AA BS PROXY
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Proxy by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/B6/2521429B.WAV
READ = CLEAN
TUNE = -36
FINE = -2
POS = 33.0%

[OSC 2]
TABLE = MODWAVE/T/46/C5FC973E.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 33.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 217.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 804.000 MS
SUSTAIN = 4%
RELEASE = 896.000 MS
A CURVE = 20
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55%
CV 1 > POS 2 = -55%
CV 2 > POS 1 = 34%
CV 2 > POS 2 = 34%
ENV 2 > POS 1 = 18.5%
ENV 2 > POS 2 = 18.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.8%

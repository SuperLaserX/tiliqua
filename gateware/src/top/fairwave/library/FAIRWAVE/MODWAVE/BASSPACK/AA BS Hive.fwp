FAIRWAVE PATCH 1
NAME  = AA BS HIVE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Hive by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/EE/5922F301.WAV
READ = CLEAN
TUNE = -24
POS = 34.7%

[OSC 2]
TABLE = MODWAVE/T/FC/95209411.WAV
READ = CLEAN
TUNE = -24
FINE = 24
POS = 34.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 654.667 MS
SUSTAIN = 85%
RELEASE = 232.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.325 S
SUSTAIN = 20%
RELEASE = 2.640 S
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58%
CV 1 > POS 2 = -58%
CV 2 > POS 1 = 30.5%
CV 2 > POS 2 = 30.5%
ENV 2 > POS 1 = 29.5%
ENV 2 > POS 2 = 29.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 26.8%

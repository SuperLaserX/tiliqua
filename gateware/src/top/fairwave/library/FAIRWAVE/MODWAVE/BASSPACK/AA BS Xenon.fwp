FAIRWAVE PATCH 1
NAME  = AA BS XENON
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Xenon by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/91/EE50EC36.WAV
READ = CLEAN
TUNE = -24
POS = 28.4%

[OSC 2]
TABLE = MODWAVE/T/51/88BBF9D3.WAV
READ = CLEAN
TUNE = -24
FINE = 11
POS = 25.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 876.000 MS
SUSTAIN = 2%
RELEASE = 317.333 MS
A CURVE = 0
D CURVE = 90
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 53%
CV 2 > POS 2 = 48.5%
CV 1 > POS 1 = -47.5%
ENV 2 > POS 1 = 43.5%
CV 1 > POS 2 = -43%
ENV 2 > POS 2 = 39.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 37.1%

FAIRWAVE PATCH 1
NAME  = AA BS VIRUS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Virus by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/1C/2334A84E.WAV
READ = CLEAN
TUNE = -36
POS = 30.2%

[OSC 2]
TABLE = MODWAVE/T/A1/4697DFC1.WAV
READ = CLEAN
TUNE = -36
FINE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 45.333 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 93.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 81.333 MS
DECAY = 101.333 MS
SUSTAIN = 7%
RELEASE = 314.667 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -50.5%
ENV 2 > POS 1 = 39.5%
CV 2 > POS 1 = 20%
CV 2 > LEVEL 2 = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.7%

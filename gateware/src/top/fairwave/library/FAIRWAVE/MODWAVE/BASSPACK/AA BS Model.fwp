FAIRWAVE PATCH 1
NAME  = AA BS MODEL
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Model by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/3B/FB01004B.WAV
READ = CLEAN
TUNE = -24
FINE = 10
POS = 31.8%

[OSC 2]
TABLE = MODWAVE/T/31/D7F95443.WAV
READ = CLEAN
TUNE = -12
FINE = -13
POS = 31.8%

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 MS
DECAY = 654.667 MS
SUSTAIN = 76%
RELEASE = 76.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 12.000 MS
DECAY = 457.333 MS
SUSTAIN = 25%
RELEASE = 65.333 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53%
CV 1 > POS 2 = -53%
ENV 2 > POS 1 = 36.5%
ENV 2 > POS 2 = 36.5%
CV 2 > POS 1 = 17.5%
CV 2 > POS 2 = 17.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.4%

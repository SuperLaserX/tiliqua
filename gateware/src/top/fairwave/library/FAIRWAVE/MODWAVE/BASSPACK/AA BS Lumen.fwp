FAIRWAVE PATCH 1
NAME  = AA BS LUMEN
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Lumen by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/EA/055053A0.WAV
READ = CLEAN
TUNE = -24
FINE = -15
POS = 31.6%

[OSC 2]
TABLE = MODWAVE/T/88/F2D0F482.WAV
READ = CLEAN
TUNE = 0
POS = 31.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 654.667 MS
SUSTAIN = 85%
RELEASE = 118.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 681.333 MS
SUSTAIN = 13%
RELEASE = 2.493 S
A CURVE = 30
D CURVE = 90
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52.5%
CV 1 > POS 2 = -52.5%
ENV 2 > POS 1 = 37%
ENV 2 > POS 2 = 37%
CV 2 > POS 1 = 35%
CV 2 > POS 2 = 35%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 18.5%

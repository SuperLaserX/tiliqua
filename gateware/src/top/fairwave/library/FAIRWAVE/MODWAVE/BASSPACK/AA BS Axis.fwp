FAIRWAVE PATCH 1
NAME  = AA BS AXIS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Axis by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/50/D3C62450.WAV
READ = CLEAN
TUNE = -24
POS = 26.2%

[OSC 2]
TABLE = MODWAVE/T/0A/7EF0ACD3.WAV
READ = CLEAN
TUNE = -24
POS = 26.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 78%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.667 MS
SUSTAIN = 0%
RELEASE = 52.000 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 47.5%
ENV 2 > POS 2 = 47.5%
CV 1 > POS 1 = -43.5%
CV 1 > POS 2 = -43.5%
CV 2 > POS 1 = 26.5%
CV 2 > POS 2 = 26.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 20.4%

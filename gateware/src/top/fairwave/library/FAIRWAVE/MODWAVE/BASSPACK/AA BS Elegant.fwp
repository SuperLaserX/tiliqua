FAIRWAVE PATCH 1
NAME  = AA BS ELEGANT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Elegant by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/C3/A2446A2C.WAV
READ = CLEAN
TUNE = -24
POS = 35.2%

[OSC 2]
TABLE = MODWAVE/T/78/A7D6B960.WAV
READ = CLEAN
TUNE = -24
POS = 35.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 80%
RELEASE = 76.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 77.333 MS
SUSTAIN = 0%
RELEASE = 76.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58.5%
CV 1 > POS 2 = -58.5%
ENV 2 > POS 1 = 29.5%
ENV 2 > POS 2 = 29.5%
CV 2 > POS 1 = 20%
CV 2 > POS 2 = 20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.8%

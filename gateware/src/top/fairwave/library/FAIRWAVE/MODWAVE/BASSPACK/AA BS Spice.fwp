FAIRWAVE PATCH 1
NAME  = AA BS SPICE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Spice by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/F3/D965CA0A.WAV
READ = CLEAN
TUNE = -36
POS = 28.0%

[OSC 2]
TABLE = MODWAVE/T/B2/2D5F15C3.WAV
READ = CLEAN
TUNE = -24
POS = 28.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 85%
RELEASE = 80.000 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 217.333 MS
SUSTAIN = 0%
RELEASE = 2.895 S
A CURVE = 30
D CURVE = 90
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
ENV 2 > POS 1 = 44%
ENV 2 > POS 2 = 44%
CV 2 > POS 1 = 33%
CV 2 > POS 2 = 33%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 8.7%

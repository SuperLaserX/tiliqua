FAIRWAVE PATCH 1
NAME  = AA BS TWITCH
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Twitch by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/A5/C96EDCCC.WAV
READ = CLEAN
TUNE = -24
POS = 31.6%

[OSC 2]
TABLE = MODWAVE/T/42/94482C41.WAV
READ = CLEAN
TUNE = -24
FINE = 15
POS = 34.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 76%
RELEASE = 68.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 69.333 MS
DECAY = 624.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -57%
CV 1 > POS 1 = -52.5%
CV 2 > POS 2 = 40%
CV 2 > POS 1 = 37%
ENV 2 > POS 2 = 31.5%
ENV 2 > POS 1 = 29%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 16.0%

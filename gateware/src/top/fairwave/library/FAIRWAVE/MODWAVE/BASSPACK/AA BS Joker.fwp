FAIRWAVE PATCH 1
NAME  = AA BS JOKER
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Joker by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Black 2x12.
[OSC 1]
TABLE = MODWAVE/T/EB/D55B7E81.WAV
READ = CLEAN
TUNE = -24
POS = 27.0%

[OSC 2]
TABLE = MODWAVE/T/C7/98CC33D9.WAV
READ = CLEAN
TUNE = -24
POS = 27.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 654.667 MS
SUSTAIN = 81%
RELEASE = 73.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 46.667 MS
SUSTAIN = 7%
RELEASE = 66.667 MS
A CURVE = 30
D CURVE = 70
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 46%
ENV 2 > POS 2 = 46%
CV 1 > POS 1 = -45%
CV 1 > POS 2 = -45%
CV 2 > POS 1 = 12.5%
CV 2 > POS 2 = 12.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.4%

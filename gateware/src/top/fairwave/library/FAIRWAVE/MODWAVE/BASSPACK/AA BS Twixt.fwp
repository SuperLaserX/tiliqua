FAIRWAVE PATCH 1
NAME  = AA BS TWIXT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Twixt by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/65/0F8F6B45.WAV
READ = CLEAN
TUNE = -24
FINE = 14
POS = 39.0%

[OSC 2]
TABLE = MODWAVE/T/AB/BE97C886.WAV
READ = CLEAN
TUNE = -36
POS = 39.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 661.333 MS
SUSTAIN = 100%
RELEASE = 708.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.544 S
DECAY = 2.476 S
SUSTAIN = 38%
RELEASE = 716.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -65%
CV 1 > POS 2 = -65%
CV 2 > POS 1 = 35%
CV 2 > POS 2 = 35%
ENV 2 > POS 1 = 22%
ENV 2 > POS 2 = 22%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.3%

FAIRWAVE PATCH 1
NAME  = AA BS GLYPH
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Glyph by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/79/4230A933.WAV
READ = CLEAN
TUNE = -24
FINE = 10
POS = 39.3%

[OSC 2]
TABLE = MODWAVE/T/D9/D9597ACE.WAV
READ = CLEAN
TUNE = -24
FINE = 5
POS = 35.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 654.667 MS
SUSTAIN = 78%
RELEASE = 65.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 133.333 MS
SUSTAIN = 2%
RELEASE = 56.000 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -65.5%
CV 1 > POS 2 = -59.5%
CV 2 > POS 1 = 31.5%
CV 2 > POS 2 = 28.5%
ENV 2 > POS 1 = 21.5%
ENV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.6%

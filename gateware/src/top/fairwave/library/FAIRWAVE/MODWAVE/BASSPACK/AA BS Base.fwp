FAIRWAVE PATCH 1
NAME  = AA BS BASE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Base by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/B8/EE8674B6.WAV
READ = CLEAN
TUNE = -24
POS = 29.1%

[OSC 2]
TABLE = MODWAVE/T/BB/BF62F9F1.WAV
READ = CLEAN
TUNE = -24
POS = 29.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 660.000 MS
SUSTAIN = 78%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 100.000 MS
SUSTAIN = 0%
RELEASE = 52.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48.5%
CV 1 > POS 2 = -48.5%
ENV 2 > POS 1 = 41.5%
ENV 2 > POS 2 = 41.5%
CV 2 > POS 1 = 29.5%
CV 2 > POS 2 = 29.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.0%

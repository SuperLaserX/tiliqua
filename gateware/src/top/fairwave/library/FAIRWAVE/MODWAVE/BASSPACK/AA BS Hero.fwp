FAIRWAVE PATCH 1
NAME  = AA BS HERO
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Hero by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/F7/DE1D8813.WAV
READ = CLEAN
TUNE = -24
FINE = 10
POS = 31.8%

[OSC 2]
TABLE = MODWAVE/T/BD/406C3892.WAV
READ = CLEAN
TUNE = -24
FINE = 17
POS = 31.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 654.667 MS
SUSTAIN = 100%
RELEASE = 886.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.515 S
DECAY = 2.484 S
SUSTAIN = 26%
RELEASE = 820.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -53%
CV 1 > POS 2 = -53%
CV 2 > POS 1 = 36.5%
CV 2 > POS 2 = 36.5%
ENV 2 > POS 1 = 18.5%
ENV 2 > POS 2 = 18.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.0%

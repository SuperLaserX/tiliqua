FAIRWAVE PATCH 1
NAME  = AA BS FLOAT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's AA BS Float by Anton Anru: Korg Modwave - Bass Pack Bundle (by Anton Anru).mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/12/5D8DCA02.WAV
READ = CLEAN
TUNE = -24
FINE = 10
POS = 30.8%

[OSC 2]
TABLE = MODWAVE/T/79/26368664.WAV
READ = CLEAN
TUNE = -12
FINE = -11
POS = 30.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 741.333 MS
SUSTAIN = 78%
RELEASE = 617.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 753.333 MS
DECAY = 1.928 S
SUSTAIN = 25%
RELEASE = 704.000 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51.5%
CV 1 > POS 2 = -51.5%
CV 2 > POS 1 = 38.5%
CV 2 > POS 2 = 38.5%
ENV 2 > POS 1 = 24.5%
ENV 2 > POS 2 = 24.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.3%

FAIRWAVE PATCH 1
NAME  = D-110 NOT A D-11
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Not a D-110 by ian Dixon: ID-D110Vol3.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Warm Pad.
# Oscillator 2 is B's 2, the sample Drm: Kick Gated.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer B oscillator 1, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/54/BB9E033A.WAV
READ = SAMPLE
TUNE = -18
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 23.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EA/CF47B211.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 240.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.9%

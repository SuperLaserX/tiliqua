FAIRWAVE PATCH 1
NAME  = D-110 SLAPIN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Slapin by ian Dixon: ID-D110Vol3.mwbundle.
# 0 V plays what its C2 key plays.
# Oscillator 1 is A's 1, the sample D110-Slappin.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/02/5D93BC58.WAV
READ = SAMPLE
TUNE = -18
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/02/5D93BC58.WAV
TUNE = -18
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.800 S
SUSTAIN = 0%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

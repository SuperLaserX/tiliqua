FAIRWAVE PATCH 1
NAME  = D-110 SOFT BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Soft Bass Dual by ian Dixon: ID-D110Vol3.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Soft Brass.
# Oscillator 2 is A's 2, the sample D110-Soft Brass.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/22/6527C5B8.WAV
READ = SAMPLE
TUNE = -6
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 15.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C5/06F2E8E8.WAV
READ = SAMPLE
TUNE = -6
FINE = 21
POS = 0.0%
EDGE = WRAP
LOOP = 15.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

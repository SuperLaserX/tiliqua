FAIRWAVE PATCH 1
NAME  = D-110 PAD AND AR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's D-110 Pad and ARP by ian Dixon: ID-D110Vol3.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample D110-Syn Lead 1.
# Oscillator 2 is A's 2, the sample D110-Voxy Women.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A8/54AEB7CA.WAV
READ = SAMPLE
TUNE = -6
FINE = 19
POS = 0.0%
EDGE = WRAP
LOOP = 7.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4E/3D6DB948.WAV
READ = SAMPLE
TUNE = -18
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 16.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 240.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.5%

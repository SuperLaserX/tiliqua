FAIRWAVE PATCH 1
NAME  = FAIRLLIGHT SYNTH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairllight Synth Bass 3 by Ian Dixon: FairlightVol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Syn Bass3.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/5C/547D7BE2.WAV
READ = SAMPLE
TUNE = -24
FINE = 10
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/5C/547D7BE2.WAV
TUNE = -24
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 480.000 MS
SUSTAIN = 0%
RELEASE = 66.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

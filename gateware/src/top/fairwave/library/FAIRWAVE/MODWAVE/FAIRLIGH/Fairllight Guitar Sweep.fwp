FAIRWAVE PATCH 1
NAME  = FAIRLLIGHT GUITA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairllight Guitar Sweep by Ian Dixon: FairlightVol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Guitar Hi4.
# Oscillator 2 is A's 2, the sample Fairlight Guitar Hi4.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/2B/9BF7D026.WAV
READ = SAMPLE
TUNE = -38
FINE = 10
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B8/1E6EA1A6.WAV
READ = SAMPLE
TUNE = -48
FINE = 13
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.200 S
SUSTAIN = 68%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.3%

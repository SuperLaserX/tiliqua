FAIRWAVE PATCH 1
NAME  = FAIRLLIGHT ACC B
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairllight Acc Bass by Ian Dixon: FairlightVol2.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Acc Bass.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/4C/6F55D1E4.WAV
READ = SAMPLE
TUNE = -48
FINE = 10
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/4C/6F55D1E4.WAV
TUNE = -48
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.867 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

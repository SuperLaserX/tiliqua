FAIRWAVE PATCH 1
NAME  = FAIRLLIGHT CHOUR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairllight Chours Guitar by Ian Dixon: FairlightVol2.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Chorus Guitar.
# Oscillator 2 is A's 2, the sample Fairlight Chorus Guitar.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/DA/FECD3A2D.WAV
READ = SAMPLE
TUNE = -36
FINE = 12
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/6D/DD2F62B2.WAV
READ = SAMPLE
TUNE = -36
FINE = 8
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

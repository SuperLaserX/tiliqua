FAIRWAVE PATCH 1
NAME  = JEN SX1000 BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jen SX1000 Bass by Ian Dixon: ID-JenSX1000.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/C0/93FE44A2.WAV
READ = CLEAN
TUNE = -24
POS = 20.6%

[OSC 2]
TABLE = MODWAVE/T/C0/93FE44A2.WAV
TUNE = -24
POS = 20.6%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 31.333 S
SUSTAIN = 14%
RELEASE = 5.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 801.333 MS
SUSTAIN = 22%
RELEASE = 280.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 59%
CV 1 > POS 1 = -34.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

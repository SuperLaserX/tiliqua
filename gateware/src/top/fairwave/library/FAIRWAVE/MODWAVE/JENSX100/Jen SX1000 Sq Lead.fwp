FAIRWAVE PATCH 1
NAME  = JEN SX1000 SQ LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jen SX1000 Sq Lead by Ian Dixon: ID-JenSX1000.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F2/76589112.WAV
READ = CLEAN
TUNE = -12
POS = 20.1%

[OSC 2]
TABLE = MODWAVE/T/F2/76589112.WAV
TUNE = -12
POS = 20.1%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.280 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 786.667 MS
SUSTAIN = 36%
RELEASE = 280.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 60%
CV 1 > POS 1 = -33.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

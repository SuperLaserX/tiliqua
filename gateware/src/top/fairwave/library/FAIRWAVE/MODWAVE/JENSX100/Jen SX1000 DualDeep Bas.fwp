FAIRWAVE PATCH 1
NAME  = JEN SX1000 DUALD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jen SX1000 DualDeep Bass by Ian Dixon: ID-JenSX1000.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/57/BCED3940.WAV
READ = CLEAN
TUNE = -24
FINE = 3
POS = 15.7%

[OSC 2]
TABLE = MODWAVE/T/AA/A01701DF.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 15.7%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 25.063 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 848.000 MS
DECAY = 449.333 MS
SUSTAIN = 84%
RELEASE = 2.541 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

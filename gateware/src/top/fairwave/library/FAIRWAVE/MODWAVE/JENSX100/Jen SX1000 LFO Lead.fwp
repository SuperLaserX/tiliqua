FAIRWAVE PATCH 1
NAME  = JEN SX1000 LFO L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jen SX1000 LFO Lead by Ian Dixon: ID-JenSX1000.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/E0/DB114AF8.WAV
READ = CLEAN
TUNE = 0
POS = 19.4%

[OSC 2]
TABLE = MODWAVE/T/E0/DB114AF8.WAV
TUNE = 0
POS = 19.4%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 513.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.000 S
SUSTAIN = 22%
RELEASE = 280.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 6.996 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 61%
CV 1 > POS 1 = -32.5%
LFO 1 > POS 1 = 2%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

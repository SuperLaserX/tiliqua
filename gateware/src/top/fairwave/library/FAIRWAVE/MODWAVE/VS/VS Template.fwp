FAIRWAVE PATCH 1
NAME  = VS TEMPLATE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Template by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
[OSC 1]
TABLE = MODWAVE/T/33/21E9C6E8.WAV
READ = CLEAN
TUNE = -12
POS = 15.6%

[OSC 2]
TABLE = MODWAVE/T/95/7C41EB1C.WAV
READ = CLEAN
TUNE = -12
POS = 15.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.733 S
DECAY = 440.000 MS
SUSTAIN = 64%
RELEASE = 16.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.0%

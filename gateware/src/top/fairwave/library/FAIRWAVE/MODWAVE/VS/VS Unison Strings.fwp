FAIRWAVE PATCH 1
NAME  = VS UNISON STRING
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Unison Strings by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A9/9EA9F19E.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 20.4%

[OSC 2]
TABLE = MODWAVE/T/BA/0EA7F157.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 20.4%

[ENV 1]
GATE = GATE 1
ATTACK = 1.896 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.925 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 190.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 63.304 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59%
ENV 2 > POS 2 = 59%
CV 1 > POS 1 = -34%
CV 1 > POS 2 = -34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.6%

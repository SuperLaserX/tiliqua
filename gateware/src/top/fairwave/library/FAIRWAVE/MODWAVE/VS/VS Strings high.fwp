FAIRWAVE PATCH 1
NAME  = VS STRINGS HIGH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Strings high by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/8A/90E320F4.WAV
READ = CLEAN
TUNE = 0
POS = 18.2%

[OSC 2]
TABLE = MODWAVE/T/CF/F95E99A5.WAV
READ = CLEAN
TUNE = 0
POS = 18.2%

[ENV 1]
GATE = GATE 1
ATTACK = 84.000 MS
DECAY = 2.933 S
SUSTAIN = 93%
RELEASE = 1.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 700.000 MS
DECAY = 90.000 S
SUSTAIN = 85%
RELEASE = 52.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63.5%
ENV 2 > POS 2 = 63.5%
CV 1 > POS 1 = -30.5%
CV 1 > POS 2 = -30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.5%

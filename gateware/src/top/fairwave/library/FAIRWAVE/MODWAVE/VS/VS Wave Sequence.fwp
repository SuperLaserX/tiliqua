FAIRWAVE PATCH 1
NAME  = VS WAVE SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Wave Sequence by Ian dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F5/3C6C3818.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[OSC 2]
TABLE = MODWAVE/T/6D/64B05EBF.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 2.905 S
SUSTAIN = 0%
RELEASE = 65.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69.5%
ENV 2 > POS 2 = 69.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.8%

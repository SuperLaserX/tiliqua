FAIRWAVE PATCH 1
NAME  = VS PLUCK FX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Pluck FX by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/79/5889CCFA.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 16.2%

[OSC 2]
TABLE = MODWAVE/T/92/D27E3399.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 16.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.067 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 19.333 S
SUSTAIN = 0%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.014 HZ
SHAPE = SINE

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 26%
CV 2 > POS 2 = 26%
LFO 1 > X DEPTH = 22.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.0%

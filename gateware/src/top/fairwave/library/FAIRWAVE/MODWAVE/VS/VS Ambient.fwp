FAIRWAVE PATCH 1
NAME  = VS AMBIENT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Ambient  by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Phaser, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/50/6A2E812C.WAV
READ = CLEAN
TUNE = -7
POS = 42.6%

[OSC 2]
TABLE = MODWAVE/T/74/0F2F93CE.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 64.000 MS
DECAY = 1.435 S
SUSTAIN = 97%
RELEASE = 941.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.043 HZ
SHAPE = TRI

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 79%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

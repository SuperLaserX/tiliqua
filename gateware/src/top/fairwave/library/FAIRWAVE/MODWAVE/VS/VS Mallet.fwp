FAIRWAVE PATCH 1
NAME  = VS MALLET
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Mallet by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Made 4 E.Pianos, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/0D/E1E6017B.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 14.6%

[OSC 2]
TABLE = MODWAVE/T/98/CC7B87D2.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 14.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.000 S
SUSTAIN = 9%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.333 S
SUSTAIN = 20%
RELEASE = 4.493 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 71%
ENV 2 > POS 2 = 71%
CV 1 > POS 1 = -24.5%
CV 1 > POS 2 = -24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

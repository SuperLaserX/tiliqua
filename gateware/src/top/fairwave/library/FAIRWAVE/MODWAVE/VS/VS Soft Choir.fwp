FAIRWAVE PATCH 1
NAME  = VS SOFT CHOIR
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Soft Choir by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/73/E3C50D22.WAV
READ = CLEAN
TUNE = -12
POS = 37.3%

[OSC 2]
TABLE = MODWAVE/T/73/E3C50D22.WAV
TUNE = -12
POS = 37.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.576 S
DECAY = 61.995 S
SUSTAIN = 100%
RELEASE = 2.041 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 261.333 MS
DECAY = 90.000 S
SUSTAIN = 94%
RELEASE = 918.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -62%
ENV 2 > POS 1 = 25.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = VS CHOIR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Choir by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/67/400B66FD.WAV
READ = STEPS
TUNE = -12
FINE = -4
POS = 72.1%

[OSC 2]
TABLE = MODWAVE/T/51/1A1FD028.WAV
READ = STEPS
TUNE = -12
FINE = 4
POS = 50.4%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.221 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 3.361 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 60.7%

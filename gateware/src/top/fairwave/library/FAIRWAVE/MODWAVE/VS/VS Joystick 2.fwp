FAIRWAVE PATCH 1
NAME  = VS JOYSTICK 2
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Joystick 2 by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/5B/8F94E1CE.WAV
READ = CLEAN
TUNE = -12
POS = 26.5%

[OSC 2]
TABLE = MODWAVE/T/C0/32C8EDDE.WAV
READ = CLEAN
TUNE = -12
POS = 26.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 61.995 S
SUSTAIN = 100%
RELEASE = 2.041 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 37.333 S
SUSTAIN = 8%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 47%
ENV 2 > POS 2 = 47%
CV 1 > POS 1 = -44%
CV 1 > POS 2 = -44%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.9%

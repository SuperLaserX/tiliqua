FAIRWAVE PATCH 1
NAME  = VS EP TO SOMETHI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS EP to something else by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Made 4 E.Pianos, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/F9/77EC0C71.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 16.1%

[OSC 2]
TABLE = MODWAVE/T/80/7DE75C5C.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 16.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.000 S
SUSTAIN = 47%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.533 S
SUSTAIN = 94%
RELEASE = 4.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
ENV 2 > POS 2 = 68%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.4%

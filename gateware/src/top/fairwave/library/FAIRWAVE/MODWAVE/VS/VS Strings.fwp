FAIRWAVE PATCH 1
NAME  = VS STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Strings by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CF/58A6372E.WAV
READ = CLEAN
TUNE = -12
POS = 25.4%

[OSC 2]
TABLE = MODWAVE/T/A6/B970581B.WAV
READ = CLEAN
TUNE = -12
FINE = 10
POS = 25.4%

[ENV 1]
GATE = GATE 1
ATTACK = 1.896 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.925 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 464.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 63.304 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 49%
ENV 2 > POS 2 = 49%
CV 1 > POS 1 = -42.5%
CV 1 > POS 2 = -42.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.6%

FAIRWAVE PATCH 1
NAME  = VS 5TH SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS 5th Saw by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/35/FF0ED603.WAV
READ = STEPS
TUNE = -12
FINE = 5
POS = 35.6%

[OSC 2]
TABLE = MODWAVE/T/B5/D747D2A2.WAV
READ = STEPS
TUNE = -12
FINE = -3
POS = 36.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 96.000 MS
SUSTAIN = 83%
RELEASE = 388.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.2%

FAIRWAVE PATCH 1
NAME  = VS TD SEQ 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS TD Seq 2 by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/CD/C578F3EA.WAV
READ = CLEAN
TUNE = -12
POS = 17.7%

[OSC 2]
TABLE = MODWAVE/T/CC/1AE9F132.WAV
READ = CLEAN
TUNE = -24
POS = 17.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 365.333 MS
SUSTAIN = 40%
RELEASE = 797.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 977.333 MS
SUSTAIN = 10%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 64.5%
ENV 2 > POS 2 = 64.5%
CV 1 > POS 1 = -29.5%
CV 1 > POS 2 = -29.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.0%

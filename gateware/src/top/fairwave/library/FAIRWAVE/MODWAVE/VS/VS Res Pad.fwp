FAIRWAVE PATCH 1
NAME  = VS RES PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Res Pad by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is A's 2, a table made along blend.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9B/28C481B3.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/DA/3DDA3964.WAV
READ = CLEAN
TUNE = 0
FINE = -4
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.560 S
DECAY = 90.000 S
SUSTAIN = 3%
RELEASE = 3.304 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.3%

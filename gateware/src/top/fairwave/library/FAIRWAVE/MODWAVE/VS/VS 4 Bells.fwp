FAIRWAVE PATCH 1
NAME  = VS 4 BELLS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS 4 Bells by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B8/8B8BE933.WAV
READ = CLEAN
TUNE = 0
POS = 15.1%

[OSC 2]
TABLE = MODWAVE/T/9C/07CDAAC4.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 15.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 653.333 MS
SUSTAIN = 67%
RELEASE = 81.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 73.333 S
SUSTAIN = 8%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.167 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70%
ENV 2 > POS 2 = 70%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.2%

FAIRWAVE PATCH 1
NAME  = VS POP BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Pop Bass by Ian Dixon: VS.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 dotted HPF, Super Chorus, Synth Clap.
[OSC 1]
TABLE = MODWAVE/T/7E/8ADCB49F.WAV
READ = CLEAN
TUNE = -24
POS = 14.5%

[OSC 2]
TABLE = MODWAVE/T/5A/7F0391AD.WAV
READ = CLEAN
TUNE = -24
POS = 14.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 71%
ENV 2 > POS 2 = 71%
CV 1 > POS 1 = -24%
CV 1 > POS 2 = -24%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

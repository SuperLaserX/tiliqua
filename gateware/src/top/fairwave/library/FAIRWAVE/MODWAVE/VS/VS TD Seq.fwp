FAIRWAVE PATCH 1
NAME  = VS TD SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS TD Seq by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Syn_WS: PWM String.
# Not carried over: 3 unison voices, layer A oscillator 1, layer A oscillator 2, performance modulators, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/9C/48FA62A1.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/69/8503B8F5.WAV
READ = SAMPLE
TUNE = -29
FINE = -32
POS = 0.0%
EDGE = WRAP
LOOP = 0.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 370.667 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 4.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 146.667 MS
SUSTAIN = 63%
RELEASE = 486.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 1.520 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
CV 1 > POS 1 = -21%
LFO 1 > LEVEL 1 = 6.5%
LFO 1 > LEVEL 2 = 6.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 94.0%

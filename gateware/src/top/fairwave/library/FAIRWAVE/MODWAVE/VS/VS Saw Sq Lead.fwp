FAIRWAVE PATCH 1
NAME  = VS SAW SQ LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's VS Saw Sq Lead by Ian Dixon: VS.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/06/FC34D9DA.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 15.3%

[OSC 2]
TABLE = MODWAVE/T/CC/8ACF5487.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 15.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.000 S
SUSTAIN = 9%
RELEASE = 1.600 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.533 S
SUSTAIN = 50%
RELEASE = 4.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69.5%
ENV 2 > POS 2 = 69.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.8%

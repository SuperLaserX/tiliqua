FAIRWAVE PATCH 1
NAME  = MWHEEL GRINDER
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's MWheel Grinder by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF 2, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/C7/A4129BF5.WAV
READ = CLEAN
TUNE = -36
FINE = 9
POS = 19.8%

[OSC 2]
TABLE = MODWAVE/T/47/9599AB2C.WAV
READ = CLEAN
TUNE = -24
POS = 19.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 157.333 MS
SUSTAIN = 83%
RELEASE = 12.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 564.000 MS
SUSTAIN = 85%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60.5%
ENV 2 > POS 2 = 60.5%
CV 1 > POS 1 = -33%
CV 1 > POS 2 = -33%
CV 2 > PITCH 1 = -20%
CV 2 > PITCH 2 = -20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.0%

FAIRWAVE PATCH 1
NAME  = CARVED PULSE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Carved Pulse by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/4 HPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/E7/27B234BD.WAV
READ = CLEAN
TUNE = -12
FINE = -12
POS = 27.1%

[OSC 2]
TABLE = MODWAVE/T/E7/27B234BD.WAV
READ = CLEAN
TUNE = -12
FINE = 12
POS = 27.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 62.667 MS
SUSTAIN = 61%
RELEASE = 10.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 34%
RELEASE = 680.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.765 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 46%
ENV 2 > POS 2 = 46%
CV 1 > POS 1 = -45%
CV 1 > POS 2 = -45%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%
LFO 1 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

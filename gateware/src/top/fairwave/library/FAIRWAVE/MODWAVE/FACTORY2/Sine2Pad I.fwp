FAIRWAVE PATCH 1
NAME  = SINE2PAD I
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sine2Pad I by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/89/F81253E3.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/D2/DF33C7E5.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 474.667 MS
SUSTAIN = 50%
RELEASE = 76.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
CV 2 > POS 2 = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

FAIRWAVE PATCH 1
NAME  = KLANGDESTINY GLA
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's KlangDestiny Glass by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/FF/29F6E927.WAV
READ = CLEAN
TUNE = 30
POS = 24.2%

[OSC 2]
TABLE = MODWAVE/T/BA/7AA1C576.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 24.2%

[ENV 1]
GATE = GATE 1
ATTACK = 3.544 S
DECAY = 46.213 S
SUSTAIN = 0%
RELEASE = 27.244 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 16.9%

[ENV 2]
GATE = GATE 1
ATTACK = 1.540 S
DECAY = 29.551 S
SUSTAIN = 0%
RELEASE = 10.712 S
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 0.172 HZ
SHAPE = TRI
PHASE = 270
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51.5%
ENV 2 > POS 2 = 51.5%
CV 1 > POS 1 = -40.5%
CV 1 > POS 2 = -40.5%
LFO 1 > X DEPTH = 7.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

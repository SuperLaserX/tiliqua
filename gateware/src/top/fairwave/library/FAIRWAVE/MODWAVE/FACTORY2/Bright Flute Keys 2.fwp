FAIRWAVE PATCH 1
NAME  = BRIGHT FLUTE KEY
ABOUT = WOODWIND FROM MODWAVE. GATE 1, CV 

# From the modwave's Bright Flute Keys by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Image 1, Warm Enhancer.
[OSC 1]
TABLE = MODWAVE/T/88/E437CBF7.WAV
READ = CLEAN
TUNE = -12
POS = 21.8%

[OSC 2]
TABLE = MODWAVE/T/A2/667F57E5.WAV
READ = CLEAN
TUNE = 12
POS = 21.8%

[ENV 1]
GATE = GATE 1
ATTACK = 56.000 MS
DECAY = 64.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 349.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
CV 2 > LEVEL 1 = 8%
CV 2 > LEVEL 2 = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

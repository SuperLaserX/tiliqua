FAIRWAVE PATCH 1
NAME  = CRUNCHCHOIR
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Crunchchoir by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Choir.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Crunchchoir.
[OSC 1]
TABLE = MODWAVE/T/85/FCCCDF87.WAV
READ = SAMPLE
TUNE = -19
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/85/FCCCDF87.WAV
TUNE = -19
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 240.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

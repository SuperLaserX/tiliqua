FAIRWAVE PATCH 1
NAME  = FMERA BELLS SOFT
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's FMera Bells Soft by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_WS:SftKalim1a.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/5E/0B43743C.WAV
READ = SAMPLE
TUNE = -5
FINE = -34
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FA/96370EC6.WAV
READ = CLEAN
TUNE = 12
FINE = 3
POS = 16.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 17.144 S
SUSTAIN = 0%
RELEASE = 17.144 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 6.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 30.991 S
SUSTAIN = 0%
RELEASE = 21.340 S
A CURVE = 30
D CURVE = 0
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 67.5%
LFO 1 > LEVEL 1 = 50%
LFO 1 > LEVEL 2 = 50%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

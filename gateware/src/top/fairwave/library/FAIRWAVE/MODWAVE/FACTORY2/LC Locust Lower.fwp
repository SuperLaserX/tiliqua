FAIRWAVE PATCH 1
NAME  = LC LOCUST LOWER
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's LC Locust Lower by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 16 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F8/719E092D.WAV
READ = CLEAN
TUNE = -48
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/D7/40DEC9A0.WAV
READ = CLEAN
TUNE = -36
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 533.333 MS
DECAY = 81.333 MS
SUSTAIN = 100%
RELEASE = 262.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 32.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 74.5%
CV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 2 > PITCH 1 = 1.5%
LFO 2 > PITCH 2 = 1.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.2%

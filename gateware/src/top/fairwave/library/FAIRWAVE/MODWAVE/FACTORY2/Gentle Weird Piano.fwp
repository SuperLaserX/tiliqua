FAIRWAVE PATCH 1
NAME  = GENTLE WEIRD PIA
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Gentle Weird Piano by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Dyno 2 Soft.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, the sub oscillator.
# Its effects, which FairWave hasn't got: Dark Comet Rumble, Gentle Weird Piano.
[OSC 1]
TABLE = MODWAVE/T/D8/15998C42.WAV
READ = SAMPLE
TUNE = -10
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 83.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/55/43990447.WAV
READ = CLEAN
TUNE = 0
POS = 24.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.715 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 20.5%

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 5.261 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 91.5%
CV 2 > X DEPTH = 58.5%
ENV 2 > X DEPTH = 28%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 75.6%

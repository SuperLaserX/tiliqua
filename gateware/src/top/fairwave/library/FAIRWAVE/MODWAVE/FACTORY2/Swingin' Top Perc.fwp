FAIRWAVE PATCH 1
NAME  = SWINGIN' TOP PER
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Swingin' Top Perc by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Sine2Pad I, Swingin' Top Perc.
[OSC 1]
TABLE = MODWAVE/T/64/AFB483FD.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/51/23DA6612.WAV
READ = CLEAN
TUNE = 3
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 39.8%

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW DN
PHASE = 124
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

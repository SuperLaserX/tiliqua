FAIRWAVE PATCH 1
NAME  = 5TH PAD
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's 5th Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF.
[OSC 1]
TABLE = MODWAVE/T/54/CE7AFC57.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3B/02B75DB0.WAV
READ = CLEAN
TUNE = -5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 408.000 MS
DECAY = 4.423 S
SUSTAIN = 58%
RELEASE = 1.280 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 78.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 85%
LFO 2 > LEVEL 2 = 85%
CV 1 > POS 1 = -39%
CV 1 > POS 2 = -39%
LFO 1 > POS 1 = 26.5%
LFO 1 > POS 2 = 26.5%
ENV 2 > POS 1 = 6%
ENV 2 > POS 2 = 6%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.5%

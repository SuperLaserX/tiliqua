FAIRWAVE PATCH 1
NAME  = DIGI MOTION PULS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digi Motion Pulse by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/DB/0F7DBF4C.WAV
READ = CLEAN
TUNE = 0
POS = 55.1%

[OSC 2]
TABLE = MODWAVE/T/6A/419464CC.WAV
READ = CLEAN
TUNE = 12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 736.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.7%

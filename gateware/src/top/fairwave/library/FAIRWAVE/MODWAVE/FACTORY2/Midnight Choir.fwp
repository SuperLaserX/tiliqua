FAIRWAVE PATCH 1
NAME  = MIDNIGHT CHOIR
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Midnight Choir by Francis Preve/Dan Phillips: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 3 unison voices.
# Not carried over: performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Midnight Choir, Polysix Ensemble, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/7D/EE914DF1.WAV
READ = CLEAN
TUNE = -24
FINE = -17
POS = 25.0%

[OSC 2]
TABLE = MODWAVE/T/7D/EE914DF1.WAV
READ = CLEAN
TUNE = -24
FINE = 17
POS = 25.0%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
CV 1 > POS 1 = 41.5%
CV 1 > POS 2 = 41.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

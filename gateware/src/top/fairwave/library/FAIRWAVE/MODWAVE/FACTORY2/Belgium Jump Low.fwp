FAIRWAVE PATCH 1
NAME  = BELGIUM JUMP LOW
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Belgium Jump Low by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, Ambient Clouds, Belgium Jump Low.
[OSC 1]
TABLE = MODWAVE/T/17/98F36419.WAV
READ = CLEAN
TUNE = -37
FINE = 16
POS = 42.0%

[OSC 2]
TABLE = MODWAVE/T/47/30C87E54.WAV
READ = CLEAN
TUNE = -13
FINE = 16
POS = 42.0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 462.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 100
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 85.333 MS
DECAY = 1.084 S
SUSTAIN = 68%
RELEASE = 50.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -70%
CV 1 > POS 2 = -70%
ENV 2 > PITCH 1 = 31.5%
ENV 2 > PITCH 2 = 31.5%
ENV 2 > POS 1 = 16%
ENV 2 > POS 2 = 16%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

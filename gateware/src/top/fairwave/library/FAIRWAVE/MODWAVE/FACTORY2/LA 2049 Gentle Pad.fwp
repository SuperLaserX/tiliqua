FAIRWAVE PATCH 1
NAME  = LA 2049 GENTLE P
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's LA 2049 Gentle Pad by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, modulation processors, the noise generator.
# Its effects, which FairWave hasn't got: LA 2049 Gentle Pad, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/C3/C17930ED.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 13.8%

[OSC 2]
TABLE = MODWAVE/T/C3/C17930ED.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 13.8%

[ENV 1]
GATE = GATE 1
ATTACK = 964.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.171 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.488 S
DECAY = 0.000 MS
SUSTAIN = 0%
RELEASE = 938.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 72.5%
CV 2 > POS 2 = 72.5%
CV 1 > POS 1 = -23%
CV 1 > POS 2 = -23%
ENV 2 > POS 1 = 3.5%
ENV 2 > POS 2 = 3.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

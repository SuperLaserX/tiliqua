FAIRWAVE PATCH 1
NAME  = DARKS & SPARKS A
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Darks & Sparks A by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: MxKg Gnarly Lead.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/11/D9709DCF.WAV
READ = CLEAN
TUNE = -12
POS = 28.1%

[OSC 2]
TABLE = MODWAVE/T/05/680CDDE4.WAV
READ = SAMPLE
TUNE = -17
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 46%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.620 S
DECAY = 49.981 S
SUSTAIN = 39%
RELEASE = 1.549 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 4.044 S
DECAY = 9.000 S
SUSTAIN = 0%
RELEASE = 3.228 S
A CURVE = 0
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -47%
ENV 2 > POS 1 = 44%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.1%

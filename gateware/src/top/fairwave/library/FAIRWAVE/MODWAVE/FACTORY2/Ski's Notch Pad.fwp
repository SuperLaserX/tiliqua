FAIRWAVE PATCH 1
NAME  = SKI'S NOTCH PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ski's Notch Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str_Guru: Flutterscape.
# Oscillator 2 is A's 2, the sample Str_Guru: Dream Ensemble.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the sub oscillator.
[OSC 1]
TABLE = MODWAVE/T/8F/48745ED8.WAV
READ = SAMPLE
TUNE = -18
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 34.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/10/58295C44.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 3.291 S
DECAY = 37.247 S
SUSTAIN = 15%
RELEASE = 3.248 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 58.6%

FAIRWAVE PATCH 1
NAME  = ABANDONED FACILI
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Abandoned Facility by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc_WS: Tri O loop.
# Oscillator 2 is A's 2, the sample Wave: DWGS Sine 1.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Abandoned Facility.
[OSC 1]
TABLE = MODWAVE/T/B9/67500315.WAV
READ = SAMPLE
TUNE = -48
FINE = 7
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F0/CE3EA81E.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 202.667 MS
DECAY = 172.000 MS
SUSTAIN = 69%
RELEASE = 110.667 MS
A CURVE = 10
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.0%

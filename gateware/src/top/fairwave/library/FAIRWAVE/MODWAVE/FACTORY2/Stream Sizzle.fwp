FAIRWAVE PATCH 1
NAME  = STREAM SIZZLE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stream Sizzle by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Stream Sizzle, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/F7/76CE6B23.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/99/8103BC74.WAV
READ = CLEAN
TUNE = 0
FINE = -9
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 253.333 MS
DECAY = 2.535 S
SUSTAIN = 15%
RELEASE = 585.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.243 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 50%
ENV 2 > POS 2 = 3.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.0%

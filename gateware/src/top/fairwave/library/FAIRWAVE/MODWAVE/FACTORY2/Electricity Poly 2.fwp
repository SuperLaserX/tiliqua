FAIRWAVE PATCH 1
NAME  = ELECTRICITY POLY
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Electricity Poly by Dan Phillips: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 & Dotted 1/8.
[OSC 1]
TABLE = MODWAVE/T/C7/7C001865.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 27.8%

[OSC 2]
TABLE = MODWAVE/T/E4/37946481.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 27.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 21.333 MS
SUSTAIN = 100%
RELEASE = 904.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 962.667 MS
DECAY = 2.533 S
SUSTAIN = 0%
RELEASE = 825.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
ENV 2 > POS 1 = 44.5%
ENV 2 > POS 2 = 44.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

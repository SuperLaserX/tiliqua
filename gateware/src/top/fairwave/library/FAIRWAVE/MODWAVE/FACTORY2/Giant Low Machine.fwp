FAIRWAVE PATCH 1
NAME  = GIANT LOW MACHIN
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Giant Low Machine by Airwave: backup1.mwbackup.
# 0 V plays what its C5 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along blend.
# Not carried over: 2 unison voices, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Giant Low Machine.
[OSC 1]
TABLE = MODWAVE/T/F6/32A31D8E.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/B2/44A5E506.WAV
READ = CLEAN
TUNE = -5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 474.667 MS
DECAY = 690.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.805 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 2 > POS 1 = 100%
LFO 1 > POS 2 = 50%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.1%

FAIRWAVE PATCH 1
NAME  = AMBIENT STARS
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Ambient Stars by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: DWGS Sine 2.
# Oscillator 2 is A's 2, the sample Wave: DWGS Sine 1.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/E1/E902FA61.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/F9/F3B16EDD.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 70.667 MS
SUSTAIN = 16%
RELEASE = 1.021 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 2%
LFO 1 > LEVEL 2 = 2%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 31.1%

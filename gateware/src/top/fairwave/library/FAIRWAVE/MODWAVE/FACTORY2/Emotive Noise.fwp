FAIRWAVE PATCH 1
NAME  = EMOTIVE NOISE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Emotive Noise by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Noise AL-1 1.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Slow Phaser.
[OSC 1]
TABLE = MODWAVE/T/AA/687B000E.WAV
READ = SAMPLE
TUNE = -18
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 61.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/AA/4384F164.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 646.667 MS
DECAY = 1.919 S
SUSTAIN = 54%
RELEASE = 809.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.998 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 2 = 33%
CV 1 > POS 2 = -28.5%
LFO 1 > PITCH 1 = 20%
LFO 1 > PITCH 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.6%

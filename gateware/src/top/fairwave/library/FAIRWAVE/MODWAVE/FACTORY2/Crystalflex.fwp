FAIRWAVE PATCH 1
NAME  = CRYSTALFLEX
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Crystalflex by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/57/74CBBD35.WAV
READ = CLEAN
TUNE = 0
FINE = -5
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3B/72D14E03.WAV
READ = CLEAN
TUNE = 0
FINE = 5
POS = 49.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 721.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.184 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

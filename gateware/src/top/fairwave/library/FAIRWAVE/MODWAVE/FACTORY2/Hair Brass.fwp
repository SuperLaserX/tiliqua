FAIRWAVE PATCH 1
NAME  = HAIR BRASS
ABOUT = BRASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Hair Brass by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6C/4CBDBE26.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 17.4%

[OSC 2]
TABLE = MODWAVE/T/A0/486FEAD9.WAV
READ = CLEAN
TUNE = 0
FINE = -9
POS = 17.4%

[ENV 1]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 38.667 MS
DECAY = 776.000 MS
SUSTAIN = 50%
RELEASE = 972.000 MS
A CURVE = 50
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
ENV 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.1%

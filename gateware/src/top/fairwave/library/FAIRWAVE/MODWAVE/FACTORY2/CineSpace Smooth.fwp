FAIRWAVE PATCH 1
NAME  = CINESPACE SMOOTH
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's CineSpace Smooth by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: CineSpace Smooth, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/1B/C0E0A4A9.WAV
READ = CLEAN
TUNE = 0
POS = 30.0%

[OSC 2]
TABLE = MODWAVE/T/45/334E2FFC.WAV
READ = CLEAN
TUNE = 7
POS = 30.0%

[ENV 1]
GATE = GATE 1
ATTACK = 977.333 MS
DECAY = 17.000 S
SUSTAIN = 0%
RELEASE = 2.815 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 49.1%

[ENV 2]
GATE = GATE 1
ATTACK = 2.931 S
DECAY = 13.724 S
SUSTAIN = 0%
RELEASE = 3.565 S
A CURVE = 0
D CURVE = 0
R CURVE = 60

[LFO 3]
RATE = 0.168 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 50%
CV 1 > POS 2 = 50%
CV 2 > POS 1 = 40%
CV 2 > POS 2 = 40%
ENV 2 > POS 1 = -10.5%
ENV 2 > POS 2 = -10.5%
LFO 3 > X DEPTH = 6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.7%

FAIRWAVE PATCH 1
NAME  = MOVIE PAD B
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Movie Pad B by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators.
[OSC 1]
TABLE = MODWAVE/T/90/B17949BC.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3E/B4C1F1AA.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 3.055 S
DECAY = 446.667 MS
SUSTAIN = 50%
RELEASE = 88.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 1.000 HZ
SHAPE = TRI
PHASE = 293
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 65%
LFO 3 > LEVEL 2 = 60%
LFO 1 > POS 1 = 33%
LFO 1 > POS 2 = 33%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 13.4%

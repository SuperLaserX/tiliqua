FAIRWAVE PATCH 1
NAME  = JUNK JAM LOW
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Junk Jam Low by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Abandoned Facility, Junk Jam Low, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/97/4FAD6C2C.WAV
READ = CLEAN
TUNE = -14
FINE = -22
POS = 27.5%

[OSC 2]
TABLE = MODWAVE/T/06/3143440D.WAV
READ = CLEAN
TUNE = -1
FINE = 1
POS = 27.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 752.000 MS
SUSTAIN = 1%
RELEASE = 97.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 0
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 397.333 MS
SUSTAIN = 0%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -46%
CV 1 > POS 2 = -46%
ENV 2 > POS 1 = 45%
ENV 2 > POS 2 = 45%
LFO 2 > LEVEL 2 = 19%
LFO 1 > POS 1 = 14%
LFO 1 > POS 2 = 14%
LFO 2 > POS 1 = -6%
LFO 2 > POS 2 = -6%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = GIANT LOW BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Giant Low Bass by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Giant Low Bass, Sine2Pad I, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/79/AFD3C960.WAV
READ = CLEAN
TUNE = -24
FINE = 14
POS = 20.1%

[OSC 2]
TABLE = MODWAVE/T/FD/84E8E8CA.WAV
READ = CLEAN
TUNE = -5
POS = 20.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.133 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.2%

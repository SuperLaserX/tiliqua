FAIRWAVE PATCH 1
NAME  = OBERKASE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's OberKase by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: VPM 5.
# Oscillator 2 is A's 2, the sample Wave: Pulse LoFi 125.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Billy's Nmare Sync, OberKase.
[OSC 1]
TABLE = MODWAVE/T/B6/88550D83.WAV
READ = SAMPLE
TUNE = -4
FINE = -32
POS = 0.0%
EDGE = WRAP
LOOP = 66.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2E/C5685077.WAV
READ = SAMPLE
TUNE = -7
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 58%
RELEASE = 846.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.9%

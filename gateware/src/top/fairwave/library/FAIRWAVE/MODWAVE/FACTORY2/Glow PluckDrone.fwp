FAIRWAVE PATCH 1
NAME  = GLOW PLUCK/DRONE
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Glow Pluck/Drone by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Glow Drone, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/17/69DD9A1B.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/72/A80D1822.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.641 S
SUSTAIN = 0%
RELEASE = 1.745 S
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.815 S
DECAY = 582.667 MS
SUSTAIN = 100%
RELEASE = 3.017 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > PITCH 1 = 20%
ENV 2 > PITCH 2 = 20%
LFO 2 > LEVEL 1 = 1%
LFO 2 > LEVEL 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 67.6%

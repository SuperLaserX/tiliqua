FAIRWAVE PATCH 1
NAME  = JUICY DRIVE LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juicy Drive Lead by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: DTMF Organ, Juicy Drive Lead.
[OSC 1]
TABLE = MODWAVE/T/51/65F22983.WAV
READ = CLEAN
TUNE = -36
POS = 21.6%

[OSC 2]
TABLE = MODWAVE/T/AF/9CCC1C3C.WAV
READ = CLEAN
TUNE = -24
POS = 21.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 906.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 100%
RELEASE = 430.667 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57%
ENV 2 > POS 2 = 57%
CV 1 > POS 1 = -36%
CV 1 > POS 2 = -36%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.9%

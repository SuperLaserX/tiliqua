FAIRWAVE PATCH 1
NAME  = SYNTH TECHNO KIC
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Synth Techno Kick by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: BPass Feedback BPM, Synth Techno Kick.
[OSC 1]
TABLE = MODWAVE/T/57/F6DC7885.WAV
READ = CLEAN
TUNE = -29
POS = 15.5%

[OSC 2]
TABLE = MODWAVE/T/57/F6DC7885.WAV
TUNE = -29
POS = 15.5%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 350.667 MS
SUSTAIN = 100%
RELEASE = 84.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 69%
CV 1 > POS 1 = 26%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = HOUSE STAB NOISE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's House Stab Noise by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: House Stab Noise.
[OSC 1]
TABLE = MODWAVE/T/A6/90281C87.WAV
READ = CLEAN
TUNE = 5
POS = 10.3%

[OSC 2]
TABLE = MODWAVE/T/A6/90281C87.WAV
TUNE = 5
POS = 10.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.744 S
SUSTAIN = 0%
RELEASE = 3.157 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.151 S
SUSTAIN = 0%
RELEASE = 4.043 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 79.5%
CV 1 > POS 1 = -17%
LFO 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

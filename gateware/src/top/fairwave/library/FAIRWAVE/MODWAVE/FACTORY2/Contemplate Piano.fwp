FAIRWAVE PATCH 1
NAME  = CONTEMPLATE PIAN
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Contemplate Piano by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Clean 5 p.
# Oscillator 2 is A's 2, the sample Bass: Pick Muted PB.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Clavi Chorus, Drum Squasher, bpm Long 4.
[OSC 1]
TABLE = MODWAVE/T/BB/2BEE881F.WAV
READ = SAMPLE
TUNE = -5
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 55.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/82/73756D1A.WAV
READ = SAMPLE
TUNE = -3
FINE = -44
POS = 0.0%
EDGE = WRAP
LOOP = 50%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 85.333 MS
SUSTAIN = 33%
RELEASE = 953.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 16%
LFO 1 > LEVEL 2 = 16%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.1%

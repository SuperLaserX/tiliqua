FAIRWAVE PATCH 1
NAME  = FORMANT TALK
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Formant Talk by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 3 unison voices, an LFO past the three here, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Multiband Chorus, Talking Modulator.
[OSC 1]
TABLE = MODWAVE/T/11/B79A5040.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/7B/B91F4287.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.940 S
SUSTAIN = 0%
RELEASE = 1.261 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 206.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 8.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 1 = 50%
LFO 3 > POS 2 = 50%
LFO 1 > LEVEL 1 = 50%
LFO 1 > LEVEL 2 = 50%
LFO 1 > PITCH 1 = 10%
CV 2 > PITCH 1 = 10%
LFO 1 > PITCH 2 = 10%
CV 2 > PITCH 2 = 10%
ENV 2 > POS 2 = 5.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.9%

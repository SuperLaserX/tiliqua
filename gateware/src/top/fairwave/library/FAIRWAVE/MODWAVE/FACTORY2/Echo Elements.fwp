FAIRWAVE PATCH 1
NAME  = ECHO ELEMENTS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Echo Elements by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/EF/25D03EE8.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/EF/25D03EE8.WAV
TUNE = 0
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 565.333 MS
SUSTAIN = 26%
RELEASE = 2.424 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 400.000 MS
SUSTAIN = 9%
RELEASE = 3.176 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 1.009 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -43%
ENV 2 > POS 1 = 39%
LFO 1 > POS 1 = 24.5%
LFO 2 > LEVEL 1 = -3%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

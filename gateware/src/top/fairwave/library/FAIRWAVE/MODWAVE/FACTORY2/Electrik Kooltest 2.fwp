FAIRWAVE PATCH 1
NAME  = ELECTRIK KOOLTES
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Electrik Kooltest by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, Electrik Kooltest.
[OSC 1]
TABLE = MODWAVE/T/06/403CE672.WAV
READ = CLEAN
TUNE = -12
POS = 49.3%

[OSC 2]
TABLE = MODWAVE/T/43/0C4FAAC8.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 62.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = -57%
CV 2 > LEVEL 1 = -40%
CV 2 > LEVEL 2 = -40%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.4%

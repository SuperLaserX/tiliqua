FAIRWAVE PATCH 1
NAME  = BLINKING SPARKLE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Blinking Sparkle by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: DWGS Sine 1.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Blinking Sparkle.
[OSC 1]
TABLE = MODWAVE/T/7C/A3A2D1CD.WAV
READ = SAMPLE
TUNE = 12
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7C/A3A2D1CD.WAV
TUNE = 12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 353.333 MS
DECAY = 64.013 S
SUSTAIN = 72%
RELEASE = 128.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > LEVEL 1 = 57%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

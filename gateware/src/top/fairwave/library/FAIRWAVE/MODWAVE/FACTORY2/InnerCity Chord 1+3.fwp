FAIRWAVE PATCH 1
NAME  = INNERCITY CHORD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's InnerCity Chord 1+3 by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: modulation processors, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, InnerCity Chord 1+3, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/06/D65831E7.WAV
READ = CLEAN
TUNE = -9
FINE = 11
POS = 18.4%

[OSC 2]
TABLE = MODWAVE/T/06/D65831E7.WAV
READ = CLEAN
TUNE = -9
FINE = 14
POS = 18.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63.5%
ENV 2 > POS 2 = 63.5%
CV 1 > POS 1 = -30.5%
CV 1 > POS 2 = -30.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

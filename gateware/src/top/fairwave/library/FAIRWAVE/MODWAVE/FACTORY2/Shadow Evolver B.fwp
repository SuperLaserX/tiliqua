FAIRWAVE PATCH 1
NAME  = SHADOW EVOLVER B
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Shadow Evolver B by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/88/5E04FB39.WAV
READ = CLEAN
TUNE = -36
POS = 41.4%

[OSC 2]
TABLE = MODWAVE/T/F6/310A4AD2.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.060 S
DECAY = 22.711 S
SUSTAIN = 6%
RELEASE = 4.449 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 9.327 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 2]
RATE = 1.333 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -69%
ENV 2 > LEVEL 1 = 43%
ENV 2 > POS 1 = 17.5%
LFO 2 > POS 1 = 4%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.9%

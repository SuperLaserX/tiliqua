FAIRWAVE PATCH 1
NAME  = DAY
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Day by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/BF/13EC106B.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/BF/13EC106B.WAV
TUNE = 0
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 308.000 MS
DECAY = 3.204 S
SUSTAIN = 35%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 3.481 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 4.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 3 > LEVEL 1 = 62%
LFO 1 > POS 1 = 50%
ENV 2 > POS 1 = 9.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = BEAUTY PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Beauty Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, the sample Str_Guru: Denali Cello.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, Beauty Pad, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/4C/CD27551D.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/CE/5AF35BB7.WAV
READ = SAMPLE
TUNE = -30
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 44.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 328.000 MS
DECAY = 15.668 S
SUSTAIN = 7%
RELEASE = 2.471 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.615 S
DECAY = 8.213 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > LEVEL 2 = 23%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = FANTA BELLS
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Fanta Bells by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Bandpass Triplets, Fanta Bells, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/2D/643CAFB9.WAV
READ = CLEAN
TUNE = 24
POS = 28.2%

[OSC 2]
TABLE = MODWAVE/T/1F/FF547140.WAV
READ = CLEAN
TUNE = -12
POS = 28.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 76.000 MS
SUSTAIN = 31%
RELEASE = 1.113 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 45.5%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 665.333 MS
SUSTAIN = 0%
RELEASE = 1.255 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -47%
CV 1 > POS 2 = -47%
ENV 2 > POS 1 = 43.5%
ENV 2 > POS 2 = 43.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = ELLY'S PADS A
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Elly's Pads A by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Texture Elly 1.
# Oscillator 2 is A's 2, the sample Syn: Texture Elly 2.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: Billy's Nmare Sync, Electrik Kooltest, Elly's Pads A.
[OSC 1]
TABLE = MODWAVE/T/20/43051893.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7B/AB034E14.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 25.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 908.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.631 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 22.0%

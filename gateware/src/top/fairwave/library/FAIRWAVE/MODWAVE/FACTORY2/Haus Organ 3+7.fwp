FAIRWAVE PATCH 1
NAME  = HAUS ORGAN 3+7
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Haus Organ 3+7 by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, what changes its envelope and LFO speeds.
[OSC 1]
TABLE = MODWAVE/T/44/C0F471B8.WAV
READ = CLEAN
TUNE = -9
FINE = -8
POS = 22.4%

[OSC 2]
TABLE = MODWAVE/T/52/8AC1B5F1.WAV
READ = CLEAN
TUNE = -2
FINE = 9
POS = 22.4%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 53.333 MS
SUSTAIN = 80%
RELEASE = 6.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 3.328 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 55.5%
CV 2 > POS 2 = 55.5%
CV 1 > POS 1 = 37.5%
CV 1 > POS 2 = 37.5%
ENV 2 > POS 1 = -20.5%
ENV 2 > POS 2 = -20.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.5%

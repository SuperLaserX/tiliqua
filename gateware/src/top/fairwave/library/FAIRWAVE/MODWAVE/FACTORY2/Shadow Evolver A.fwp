FAIRWAVE PATCH 1
NAME  = SHADOW EVOLVER A
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Shadow Evolver A by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/3F/99A0436F.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/60/47ABEA44.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.216 S
DECAY = 27.289 S
SUSTAIN = 0%
RELEASE = 4.455 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 494.667 MS
DECAY = 5.252 S
SUSTAIN = 0%
RELEASE = 5.251 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 3]
RATE = 3.572 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > POS 1 = 70.5%
LFO 3 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.1%

FAIRWAVE PATCH 1
NAME  = SUBTLE ANIMATION
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Subtle Animation by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0D/2E60AF2A.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 19.5%

[OSC 2]
TABLE = MODWAVE/T/AF/04CA0EB7.WAV
READ = CLEAN
TUNE = -12
FINE = -5
POS = 19.5%

[ENV 1]
GATE = GATE 1
ATTACK = 94.667 MS
DECAY = 216.000 MS
SUSTAIN = 100%
RELEASE = 544.000 MS
A CURVE = 100
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.409 S
DECAY = 4.468 S
SUSTAIN = 39%
RELEASE = 53.333 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61%
ENV 2 > POS 2 = 61%
CV 1 > POS 1 = -32.5%
CV 1 > POS 2 = -32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.6%

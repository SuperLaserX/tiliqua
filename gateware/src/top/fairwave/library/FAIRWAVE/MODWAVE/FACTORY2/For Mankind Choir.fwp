FAIRWAVE PATCH 1
NAME  = FOR MANKIND CHOI
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's For Mankind Choir by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir Whisper M.
# Oscillator 2 is A's 2, the sample Vox: Choir Ahh Falsetto.
# Its effects, which FairWave hasn't got: For Mankind Choir.
[OSC 1]
TABLE = MODWAVE/T/33/6CD2FDB3.WAV
READ = SAMPLE
TUNE = -30
FINE = 48
POS = 0.0%
EDGE = WRAP
LOOP = 20.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/01/AB960A2D.WAV
READ = SAMPLE
TUNE = -29
FINE = -34
POS = 0.0%
EDGE = WRAP
LOOP = 27.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 946.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.100 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 27.2%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 58.1%

FAIRWAVE PATCH 1
NAME  = ELLY'S PADS B
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Elly's Pads B by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 2 unison voices, the noise generator.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5.
[OSC 1]
TABLE = MODWAVE/T/15/6B962798.WAV
READ = CLEAN
TUNE = -12
POS = 26.7%

[OSC 2]
TABLE = MODWAVE/T/F9/9721960C.WAV
READ = CLEAN
TUNE = 7
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 8.763 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.480 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.112 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 75%
LFO 1 > POS 2 = 50%
CV 2 > POS 1 = 46.5%
CV 1 > POS 1 = -44.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 2.0%

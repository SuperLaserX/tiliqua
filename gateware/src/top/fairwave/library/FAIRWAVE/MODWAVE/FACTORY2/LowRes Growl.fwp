FAIRWAVE PATCH 1
NAME  = LOWRES GROWL
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's LowRes Growl by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators.
[OSC 1]
TABLE = MODWAVE/T/AB/19CD4FF4.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/AB/19CD4FF4.WAV
TUNE = -24
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 80.500 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
PHASE = 180
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 38.5%
CV 1 > POS 1 = -19.5%
LFO 3 > LEVEL 1 = 1%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

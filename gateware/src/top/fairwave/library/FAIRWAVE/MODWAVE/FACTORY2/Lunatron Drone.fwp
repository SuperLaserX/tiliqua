FAIRWAVE PATCH 1
NAME  = LUNATRON DRONE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Lunatron Drone by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Lunatron Drone, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/90/47988852.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/11/4F872D54.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.555 S
DECAY = 4.681 S
SUSTAIN = 75%
RELEASE = 4.364 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.137 S
DECAY = 23.436 S
SUSTAIN = 30%
RELEASE = 3.768 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 2 > LEVEL 2 = 100%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
LFO 1 > POS 1 = 30%
LFO 1 > POS 2 = 30%
ENV 2 > POS 1 = 17.5%
ENV 2 > POS 2 = 17.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.7%

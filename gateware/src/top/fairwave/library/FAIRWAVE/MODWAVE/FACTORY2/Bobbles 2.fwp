FAIRWAVE PATCH 1
NAME  = BOBBLES
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bobbles by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/53/B72329FE.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/68/29F90B19.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.356 S
SUSTAIN = 0%
RELEASE = 20.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.203 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 3]
RATE = 8.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 3 > LEVEL 1 = 100%
LFO 3 > LEVEL 2 = 100%
LFO 1 > POS 1 = 37%
LFO 1 > POS 2 = 37%
CV 1 > POS 1 = -22%
CV 1 > POS 2 = -22%
LFO 2 > POS 1 = 13.5%
LFO 2 > POS 2 = 13.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.9%

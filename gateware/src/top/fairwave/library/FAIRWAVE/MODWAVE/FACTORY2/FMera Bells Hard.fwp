FAIRWAVE PATCH 1
NAME  = FMERA BELLS HARD
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's FMera Bells Hard by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A1/C516CE9E.WAV
READ = CLEAN
TUNE = 14
FINE = 42
POS = 25.0%

[OSC 2]
TABLE = MODWAVE/T/C8/B1E978CE.WAV
READ = CLEAN
TUNE = 12
FINE = 10
POS = 25.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.465 S
SUSTAIN = 0%
RELEASE = 4.739 S
A CURVE = 30
D CURVE = 40
R CURVE = 100
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 23.4%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.420 S
SUSTAIN = 15%
RELEASE = 4.945 S
A CURVE = 30
D CURVE = 40
R CURVE = 30

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50%
ENV 2 > POS 2 = 50%
CV 1 > POS 1 = -41.5%
CV 1 > POS 2 = -41.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = MOD WHEEL ENGINE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mod Wheel Engine by AGeldert: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Mod Wheel Engine.
[OSC 1]
TABLE = MODWAVE/T/4E/61B031A9.WAV
READ = CLEAN
TUNE = 15
FINE = -8
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/0F/EC04769E.WAV
READ = CLEAN
TUNE = -11
FINE = -38
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 253.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 9.3%

[LFO 1]
RATE = 32.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 2 = 95%
LFO 1 > X DEPTH = 21%
CV 2 > PITCH 2 = 18.5%
CV 2 > PITCH 1 = 3.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

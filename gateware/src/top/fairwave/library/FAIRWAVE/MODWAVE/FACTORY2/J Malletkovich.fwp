FAIRWAVE PATCH 1
NAME  = J MALLETKOVICH
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's J Malletkovich by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Deep Houz Chord, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/2D/FD6082BA.WAV
READ = CLEAN
TUNE = -24
POS = 26.6%

[OSC 2]
TABLE = MODWAVE/T/4F/2724D67E.WAV
READ = CLEAN
TUNE = -12
POS = 26.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 752.000 MS
SUSTAIN = 1%
RELEASE = 100.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 0
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 397.333 MS
SUSTAIN = 0%
RELEASE = 94.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 2 = 60%
ENV 2 > POS 1 = 47%
ENV 2 > POS 2 = 47%
CV 1 > POS 1 = -44.5%
CV 1 > POS 2 = -44.5%
LFO 1 > POS 1 = -5.5%
LFO 1 > POS 2 = -5.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

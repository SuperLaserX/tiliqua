FAIRWAVE PATCH 1
NAME  = DARK COMET RUMBL
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dark Comet Rumble by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: MxKg Gnarly Lead.
# Oscillator 2 is A's 2, the sample Syn: Stereo Spectrum.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Dark Comet Rumble.
[OSC 1]
TABLE = MODWAVE/T/92/5A9C5212.WAV
READ = SAMPLE
TUNE = -17
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 51.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/12/6DCA06BA.WAV
READ = SAMPLE
TUNE = -30
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.133 S
DECAY = 8.063 S
SUSTAIN = 31%
RELEASE = 4.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 78.9%

[ENV 2]
GATE = GATE 1
ATTACK = 4.436 S
DECAY = 9.261 S
SUSTAIN = 0%
RELEASE = 4.000 S
A CURVE = 0
D CURVE = 50
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = -83.5%
LFO 1 > X DEPTH = 35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 83.6%

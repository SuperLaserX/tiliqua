FAIRWAVE PATCH 1
NAME  = CASSINI CLOUD
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cassini Cloud by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Cym: Chinese Gong.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Biegerish Bass, Cassini Cloud.
[OSC 1]
TABLE = MODWAVE/T/90/54663542.WAV
READ = SAMPLE
TUNE = -41
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 50.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/38/4318D0DF.WAV
READ = CLEAN
TUNE = 24
POS = 31.4%

[ENV 1]
GATE = GATE 1
ATTACK = 342.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 166.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 52.5%
CV 2 > POS 2 = 37%
LFO 1 > LEVEL 1 = 32%
LFO 2 > LEVEL 2 = 21%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 94.9%

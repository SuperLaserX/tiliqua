FAIRWAVE PATCH 1
NAME  = GENTLE HORNS
ABOUT = BRASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gentle Horns by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Brs: Trap Brass.
# Not carried over: 2 unison voices, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AB/C1024AE9.WAV
READ = CLEAN
TUNE = -12
POS = 25.8%

[OSC 2]
TABLE = MODWAVE/T/A6/09DEBF61.WAV
READ = SAMPLE
TUNE = -7
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 52.000 MS
DECAY = 3.280 S
SUSTAIN = 0%
RELEASE = 96.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 78.667 MS
DECAY = 3.701 S
SUSTAIN = 0%
RELEASE = 260.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
ENV 2 > POS 1 = 48.5%
CV 1 > POS 1 = -43%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.7%

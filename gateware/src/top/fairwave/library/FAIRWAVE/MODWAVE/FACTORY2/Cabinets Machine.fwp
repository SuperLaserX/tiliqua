FAIRWAVE PATCH 1
NAME  = CABINETS MACHINE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cabinets Machine by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 3 unison voices, an LFO past the three here.
# Its effects, which FairWave hasn't got: Cabinets Machine, Kaoss Y Wah, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/76/CF2BCD5C.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/93/9EAAD1E8.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 781.333 MS
DECAY = 284.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.083 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -52%
LFO 3 > POS 2 = 50%
LFO 1 > LEVEL 1 = 30%
LFO 1 > LEVEL 2 = 30%
LFO 2 > POS 1 = 19%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.8%

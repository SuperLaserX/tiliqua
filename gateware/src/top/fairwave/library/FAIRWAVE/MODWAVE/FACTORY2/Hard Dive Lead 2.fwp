FAIRWAVE PATCH 1
NAME  = HARD DIVE LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Hard Dive Lead by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Hard Dive Lead, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/CC/CA6045B7.WAV
READ = CLEAN
TUNE = -24
POS = 22.8%

[OSC 2]
TABLE = MODWAVE/T/2A/34D5FB42.WAV
READ = CLEAN
TUNE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 77.333 MS
SUSTAIN = 0%
RELEASE = 128.000 MS
A CURVE = 30
D CURVE = 40
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 58%
ENV 2 > PITCH 2 = 58%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.4%

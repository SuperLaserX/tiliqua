FAIRWAVE PATCH 1
NAME  = COMPLEXITY BEEPS
ABOUT = SOUNDSCAPE FROM MODWAVE. GATE 1, C

# From the modwave's Complexity Beeps by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Cricket Spectrum.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Cabinets Machine, Slow Phaser, bpm Mband Up Chor.
[OSC 1]
TABLE = MODWAVE/T/4C/BAE15293.WAV
READ = SAMPLE
TUNE = -46
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 4.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/49/27FD8357.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 646.667 MS
DECAY = 1.919 S
SUSTAIN = 54%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.995 HZ
SHAPE = SQUARE
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 100%
CV 2 > LEVEL 2 = -100%
LFO 2 > POS 2 = 33%
CV 1 > POS 2 = -28.5%
LFO 1 > PITCH 1 = 20%
LFO 1 > PITCH 2 = 20%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 83.7%

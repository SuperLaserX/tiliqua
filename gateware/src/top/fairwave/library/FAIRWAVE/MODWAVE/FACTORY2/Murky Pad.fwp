FAIRWAVE PATCH 1
NAME  = MURKY PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Murky Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/2E/C79FDE3A.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3B/07D025FA.WAV
READ = CLEAN
TUNE = -7
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.836 S
DECAY = 4.984 S
SUSTAIN = 36%
RELEASE = 1.627 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 413.333 MS
DECAY = 4.912 S
SUSTAIN = 64%
RELEASE = 462.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.167 HZ
SHAPE = TRI
PHASE = 359
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 50%
LFO 3 > LEVEL 1 = 30%
LFO 3 > LEVEL 2 = 30%
ENV 2 > POS 1 = 29.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.7%

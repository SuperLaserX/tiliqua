FAIRWAVE PATCH 1
NAME  = BATESQUE BASSLIN
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's BATesque Bassline by Airwave: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: BATesque Bassline.
[OSC 1]
TABLE = MODWAVE/T/16/A733B50B.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/C9/32C8E9E4.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.5%

FAIRWAVE PATCH 1
NAME  = MOONSCAPE PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Moonscape Pad by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5, DTMF Organ, Moonscape Pad.
[OSC 1]
TABLE = MODWAVE/T/8C/41BE8A38.WAV
READ = CLEAN
TUNE = -12
POS = 25.1%

[OSC 2]
TABLE = MODWAVE/T/9A/6D9571AB.WAV
READ = CLEAN
TUNE = 7
POS = 25.1%

[ENV 1]
GATE = GATE 1
ATTACK = 976.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 7.433 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 896.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 26.589 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 50%
CV 2 > POS 2 = 50%
CV 1 > POS 1 = -42%
CV 1 > POS 2 = -42%
ENV 2 > POS 1 = 41.5%
ENV 2 > POS 2 = 41.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 16.1%

FAIRWAVE PATCH 1
NAME  = DAT BELL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Dat Bell by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/D2/21FD1275.WAV
READ = CLEAN
TUNE = 10
FINE = -24
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/38/CCE4C442.WAV
READ = CLEAN
TUNE = 4
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 700.000 MS
SUSTAIN = 0%
RELEASE = 886.667 MS
A CURVE = 30
D CURVE = 100
R CURVE = 100
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 11.7%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.445 S
SUSTAIN = 0%
RELEASE = 3.373 S
A CURVE = 0
D CURVE = 100
R CURVE = 50

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 145%
ENV 2 > X DEPTH = 56.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 97.1%

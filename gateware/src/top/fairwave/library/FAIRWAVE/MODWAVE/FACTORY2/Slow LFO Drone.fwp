FAIRWAVE PATCH 1
NAME  = SLOW LFO DRONE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Slow LFO Drone by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Slow LFO Drone, Stereo Chorus, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/05/B67F5F1E.WAV
READ = CLEAN
TUNE = -12
POS = 22.3%

[OSC 2]
TABLE = MODWAVE/T/82/A9E6171B.WAV
READ = CLEAN
TUNE = -12
POS = 22.3%

[ENV 1]
GATE = GATE 1
ATTACK = 702.667 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 3.824 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 990.667 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 3.783 S
A CURVE = 30
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 5.032 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 55.5%
ENV 2 > POS 2 = 55.5%
CV 1 > POS 1 = -37%
CV 1 > POS 2 = -37%
ENV 2 > PITCH 1 = 3%
ENV 2 > PITCH 2 = 3%
LFO 1 > PITCH 1 = 1%
LFO 1 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.9%

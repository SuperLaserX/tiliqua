FAIRWAVE PATCH 1
NAME  = LITTLE PIRATE SA
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Little Pirate Saw by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Little Pirate Saw.
[OSC 1]
TABLE = MODWAVE/T/C5/FD5ED9BF.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/60/31B4B735.WAV
READ = CLEAN
TUNE = 0
POS = 50.7%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.0%

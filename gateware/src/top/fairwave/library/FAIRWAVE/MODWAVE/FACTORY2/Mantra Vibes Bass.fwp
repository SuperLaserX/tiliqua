FAIRWAVE PATCH 1
NAME  = MANTRA VIBES BAS
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mantra Vibes Bass by Airwave: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5, Mantra Vibes Bass.
[OSC 1]
TABLE = MODWAVE/T/6B/00D9359C.WAV
READ = CLEAN
TUNE = -48
FINE = 7
POS = 20.2%

[OSC 2]
TABLE = MODWAVE/T/C9/ADAD44C2.WAV
READ = CLEAN
TUNE = -24
FINE = -7
POS = 20.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 428.000 MS
SUSTAIN = 0%
RELEASE = 164.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 59.5%
CV 2 > POS 2 = 59.5%
ENV 2 > POS 1 = 42%
ENV 2 > POS 2 = 42%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
LFO 1 > POS 1 = 19%
LFO 1 > POS 2 = 19%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.9%

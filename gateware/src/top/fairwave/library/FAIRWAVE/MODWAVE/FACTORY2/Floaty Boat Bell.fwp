FAIRWAVE PATCH 1
NAME  = FLOATY BOAT BELL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Floaty Boat Bell by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, performance modulators.
# Its effects, which FairWave hasn't got: Odd Piano.
[OSC 1]
TABLE = MODWAVE/T/B5/CAFAD70C.WAV
READ = CLEAN
TUNE = -36
POS = 21.8%

[OSC 2]
TABLE = MODWAVE/T/2F/5720EB5B.WAV
READ = CLEAN
TUNE = 12
POS = 21.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 23.371 S
SUSTAIN = 0%
RELEASE = 2.000 S
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.480 S
SUSTAIN = 100%
RELEASE = 2.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = -195%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

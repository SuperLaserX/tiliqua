FAIRWAVE PATCH 1
NAME  = MODW RIPPER LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's ModW Ripper Lead by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/16 - 1/8 HPF, Stereo Chorus, Tweed 4x10.
[OSC 1]
TABLE = MODWAVE/T/0D/1DC94ACC.WAV
READ = CLEAN
TUNE = -24
FINE = -10
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/C5/9C250753.WAV
READ = CLEAN
TUNE = -24
POS = 35.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.333 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 6.302 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 2 = -67%
CV 1 > POS 2 = 59%
LFO 1 > POS 1 = 50%
CV 2 > POS 2 = 29.5%
CV 2 > PITCH 1 = 1%
LFO 3 > PITCH 1 = 1%
LFO 3 > PITCH 2 = 1%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.6%

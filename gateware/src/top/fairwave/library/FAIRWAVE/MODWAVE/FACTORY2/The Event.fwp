FAIRWAVE PATCH 1
NAME  = THE EVENT
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's The Event by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample FX: Piano SFX Bend A.
# Oscillator 2 is A's 2, the sample FX: Piano SFX Pluck 1.
# Not carried over: the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/BE/2ECD9580.WAV
READ = SAMPLE
TUNE = -33
FINE = -42
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/DE/47BC3AB7.WAV
READ = SAMPLE
TUNE = -27
FINE = -42
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 138.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 624.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.8%

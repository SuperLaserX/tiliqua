FAIRWAVE PATCH 1
NAME  = METALLURGY PRIMO
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Metallurgy Primo by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Metallurgy Primo, Small Phaser Color.
[OSC 1]
TABLE = MODWAVE/T/16/878DD9A1.WAV
READ = CLEAN
TUNE = -24
POS = 16.2%

[OSC 2]
TABLE = MODWAVE/T/26/2842A042.WAV
READ = CLEAN
TUNE = -12
POS = 16.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 17.396 S
SUSTAIN = 100%
RELEASE = 1.629 S
A CURVE = 30
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 38.667 MS
DECAY = 716.000 MS
SUSTAIN = 15%
RELEASE = 3.232 S
A CURVE = 30
D CURVE = 20
R CURVE = 60

[LFO 2]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
LFO 2 > POS 1 = 8.5%
LFO 2 > POS 2 = 8.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.0%

FAIRWAVE PATCH 1
NAME  = LITTLE SPRITE HI
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Little Sprite High by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, the sub oscillator.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/BC/838E31EA.WAV
READ = CLEAN
TUNE = 36
FINE = -4
POS = 26.6%

[OSC 2]
TABLE = MODWAVE/T/10/36CAE8D1.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 80.000 MS
SUSTAIN = 50%
RELEASE = 2.812 S
A CURVE = 0
D CURVE = 70
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 62.1%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 809.333 MS
SUSTAIN = 0%
RELEASE = 2.668 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > POS 1 = 47%
CV 1 > POS 1 = -44.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

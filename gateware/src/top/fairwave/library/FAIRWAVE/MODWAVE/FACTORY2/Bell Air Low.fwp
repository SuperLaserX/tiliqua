FAIRWAVE PATCH 1
NAME  = BELL AIR LOW
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bell Air Low by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Twinkler.
# Not carried over: 2 unison voices, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Bell Air Low, Stereo Chorus, Stereo Image 3 SC.
[OSC 1]
TABLE = MODWAVE/T/2A/5D6911AB.WAV
READ = CLEAN
TUNE = 24
POS = 11.5%

[OSC 2]
TABLE = MODWAVE/T/EB/F2C98184.WAV
READ = SAMPLE
TUNE = -21
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 16.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 42.667 MS
SUSTAIN = 100%
RELEASE = 745.333 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 14.8%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 80.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 77%
ENV 2 > X DEPTH = 55%
CV 1 > POS 1 = -19%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 87.1%

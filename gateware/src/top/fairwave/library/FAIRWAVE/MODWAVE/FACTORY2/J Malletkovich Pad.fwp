FAIRWAVE PATCH 1
NAME  = J MALLETKOVICH P
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's J Malletkovich Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_Guru: Chorus Dreamz.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F1/76832185.WAV
READ = SAMPLE
TUNE = -28
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 55%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/57/C69BEA64.WAV
READ = CLEAN
TUNE = -24
POS = 19.6%

[ENV 1]
GATE = GATE 1
ATTACK = 3.897 S
DECAY = 10.339 S
SUSTAIN = 0%
RELEASE = 3.339 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.807 S
SUSTAIN = 18%
RELEASE = 2.411 S
A CURVE = 30
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 60.5%
CV 1 > POS 2 = -32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 69.3%

FAIRWAVE PATCH 1
NAME  = BELL AIR HIGH
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bell Air High by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Attack Up, Bell Air High.
[OSC 1]
TABLE = MODWAVE/T/E7/6C4E9B38.WAV
READ = CLEAN
TUNE = 26
POS = 27.3%

[OSC 2]
TABLE = MODWAVE/T/50/D503033F.WAV
READ = CLEAN
TUNE = 43
POS = 27.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 798.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 488.000 MS
SUSTAIN = 0%
RELEASE = 5.015 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
ENV 2 > X DEPTH = 95%
CV 2 > POS 1 = 45.5%
CV 2 > POS 2 = 45.5%
CV 1 > POS 1 = -45.5%
CV 1 > POS 2 = -45.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

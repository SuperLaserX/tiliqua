FAIRWAVE PATCH 1
NAME  = BIEGERISH BASS
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Biegerish Bass by Airwave: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Biegerish Bass, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/CD/6D1A62DC.WAV
READ = CLEAN
TUNE = -36
FINE = -5
POS = 20.0%

[OSC 2]
TABLE = MODWAVE/T/AA/51A6AC56.WAV
READ = CLEAN
TUNE = -24
FINE = 18
POS = 20.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 396.000 MS
SUSTAIN = 59%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 453.333 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 3]
RATE = 2.217 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33.5%
CV 1 > POS 2 = -33.5%
LFO 2 > LEVEL 1 = 28%
LFO 2 > LEVEL 2 = 28%
LFO 1 > POS 1 = 12%
LFO 1 > POS 2 = 12%
LFO 3 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.1%

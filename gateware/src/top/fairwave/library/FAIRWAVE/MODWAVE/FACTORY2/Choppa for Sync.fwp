FAIRWAVE PATCH 1
NAME  = CHOPPA FOR SYNC
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Choppa for Sync by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Drm: Kick Dance 11.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: an LFO past the three here, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Choppa for Sync, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/84/ADBBD293.WAV
READ = CLEAN
TUNE = -12
POS = 26.6%

[OSC 2]
TABLE = MODWAVE/T/4A/D210585F.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 5.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.832 S
SUSTAIN = 0%
RELEASE = 446.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 46.5%
CV 1 > POS 1 = -44.5%
LFO 2 > POS 1 = 25%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.8%

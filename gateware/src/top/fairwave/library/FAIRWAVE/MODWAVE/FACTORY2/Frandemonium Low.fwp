FAIRWAVE PATCH 1
NAME  = FRANDEMONIUM LOW
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Frandemonium Low by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/58/1290B965.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/31/2DF39133.WAV
READ = CLEAN
TUNE = -24
POS = 49.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.6%

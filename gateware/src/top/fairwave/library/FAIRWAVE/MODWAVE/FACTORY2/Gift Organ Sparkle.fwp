FAIRWAVE PATCH 1
NAME  = GIFT ORGAN SPARK
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gift Organ Sparkle by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF.
[OSC 1]
TABLE = MODWAVE/T/71/6907D268.WAV
READ = STEPS
TUNE = 12
POS = 32.5%

[OSC 2]
TABLE = MODWAVE/T/71/6907D268.WAV
TUNE = 12
POS = 32.5%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.199 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 3.803 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 17%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

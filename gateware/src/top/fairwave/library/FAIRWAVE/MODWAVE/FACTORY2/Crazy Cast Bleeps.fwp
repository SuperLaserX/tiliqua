FAIRWAVE PATCH 1
NAME  = CRAZY CAST BLEEP
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Crazy Cast Bleeps by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1000ms, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A4/AB983DAA.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/CD/164E1BB1.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 918.667 MS
SUSTAIN = 100%
RELEASE = 1.421 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.440 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.557 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 100%
LFO 3 > LEVEL 1 = 42%
LFO 3 > LEVEL 2 = 42%
LFO 1 > POS 1 = 37.5%
LFO 1 > POS 2 = 37.5%
CV 1 > POS 1 = 20.5%
CV 1 > POS 2 = 20.5%
ENV 2 > POS 1 = 14.5%
ENV 2 > POS 2 = 14.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

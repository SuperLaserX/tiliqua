FAIRWAVE PATCH 1
NAME  = DIGI MOTION S&H
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digi Motion S&H Kn3 by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Digi Motion S&H.
[OSC 1]
TABLE = MODWAVE/T/6F/1F5985C1.WAV
READ = CLEAN
TUNE = 0
POS = 44.5%

[OSC 2]
TABLE = MODWAVE/T/1C/DFA91A25.WAV
READ = CLEAN
TUNE = 0
POS = 44.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 100%
RELEASE = 38.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 91%
CV 1 > POS 2 = 91%
CV 2 > POS 1 = 11%
CV 2 > POS 2 = 11%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.6%

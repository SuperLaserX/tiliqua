FAIRWAVE PATCH 1
NAME  = GOOD NIGHT PLUCK
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Good Night Pluck by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Dyno 2 Soft.
# Oscillator 2 is A's 2, the sample Bell: Marimba.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Clavi Chorus, Drum Squasher, Good Night Pluck.
[OSC 1]
TABLE = MODWAVE/T/87/C047E870.WAV
READ = SAMPLE
TUNE = -10
POS = 0.0%
EDGE = WRAP
LOOP = 83.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/38/E6FD9363.WAV
READ = SAMPLE
TUNE = -11
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 65.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 85.333 MS
SUSTAIN = 18%
RELEASE = 36.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 6.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 1%
LFO 1 > LEVEL 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.8%

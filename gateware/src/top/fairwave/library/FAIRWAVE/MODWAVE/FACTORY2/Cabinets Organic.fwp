FAIRWAVE PATCH 1
NAME  = CABINETS ORGANIC
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cabinets Organic by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 6 unison voices.
# Its effects, which FairWave hasn't got: Cabinets Machine, Kaoss Y Wah, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/DC/5553CEB6.WAV
READ = CLEAN
TUNE = -12
POS = 15.5%

[OSC 2]
TABLE = MODWAVE/T/84/CDA0E1F8.WAV
READ = CLEAN
TUNE = 12
FINE = 17
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 192.000 MS
DECAY = 284.000 MS
SUSTAIN = 100%
RELEASE = 694.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 14.087 S
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.056 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.341 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
LFO 1 > POS 1 = -8%
LFO 1 > POS 2 = -8%
LFO 2 > PITCH 1 = 3%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.1%

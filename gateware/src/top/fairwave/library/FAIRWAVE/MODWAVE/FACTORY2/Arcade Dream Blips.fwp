FAIRWAVE PATCH 1
NAME  = ARCADE DREAM BLI
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Arcade Dream Blips by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 7 unison voices, the sub oscillator.
[OSC 1]
TABLE = MODWAVE/T/64/C909A343.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/57/12206D2E.WAV
READ = CLEAN
TUNE = -12
POS = 22.2%

[ENV 1]
GATE = GATE 1
ATTACK = 837.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 100.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 26.621 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > LEVEL 1 = 9%
LFO 2 > LEVEL 2 = 9%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.8%

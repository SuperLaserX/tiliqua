FAIRWAVE PATCH 1
NAME  = DARK COMET PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dark Comet Pad by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str_Guru: Dream Ensemble.
# Not carried over: performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bad Beta Grit, Made 4 E.Pianos.
[OSC 1]
TABLE = MODWAVE/T/C3/914FBE8E.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C3/914FBE8E.WAV
TUNE = -30
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 4.041 S
DECAY = 16.293 S
SUSTAIN = 0%
RELEASE = 4.808 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

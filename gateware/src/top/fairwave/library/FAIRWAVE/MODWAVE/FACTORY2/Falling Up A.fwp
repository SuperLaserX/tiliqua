FAIRWAVE PATCH 1
NAME  = FALLING UP A
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Falling Up A by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 5 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Falling Up A, Stereo Image 4 SC.
[OSC 1]
TABLE = MODWAVE/T/32/0009ED61.WAV
READ = CLEAN
TUNE = -36
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 201.333 MS
DECAY = 56.277 S
SUSTAIN = 60%

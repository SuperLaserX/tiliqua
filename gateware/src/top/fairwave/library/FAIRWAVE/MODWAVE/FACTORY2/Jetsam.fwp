FAIRWAVE PATCH 1
NAME  = JETSAM
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jetsam by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Electrik Kooltest, Ring Note Follower, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/A1/4AE78DD0.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/AE/6F56A15C.WAV
READ = CLEAN
TUNE = -17
FINE = -35
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 8.9%

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW DN
PHASE = 180
SYNC = GATE 1

[LFO 2]
RATE = 1.000 HZ
SHAPE = SAW DN
PHASE = 354
SYNC = GATE 1

[LFO 3]
RATE = 4.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 1 > POS 1 = 48.5%
CV 1 > POS 2 = 48.5%
LFO 3 > POS 1 = 21%
LFO 3 > POS 2 = 21%
LFO 1 > X DEPTH = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = DARK TRIUMPH BUZ
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dark Triumph Buzz by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Dark Triumph Buzz, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A7/2F8912AA.WAV
READ = CLEAN
TUNE = -12
POS = 39.7%

[OSC 2]
TABLE = MODWAVE/T/A4/F88E6A34.WAV
READ = CLEAN
TUNE = -12
FINE = 7
POS = 44.9%

[ENV 1]
GATE = GATE 1
ATTACK = 1.357 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.209 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 100.0%

[LFO 1]
RATE = 0.287 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = -5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.8%

FAIRWAVE PATCH 1
NAME  = LOWRES BITZ
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's LowRes Bitz by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Junk Jam Low, LowRes Bitz.
[OSC 1]
TABLE = MODWAVE/T/29/C2177BD4.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/81/3DE8F01A.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 16.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 36.5%
LFO 1 > POS 2 = 36.5%
CV 1 > POS 1 = -22%
CV 1 > POS 2 = -22%
LFO 2 > PITCH 1 = 20%
LFO 2 > PITCH 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.9%

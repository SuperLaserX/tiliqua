FAIRWAVE PATCH 1
NAME  = ETCHING
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Etching by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along blend.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Etching, Stream Sizzle, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/06/58066A41.WAV
READ = CLEAN
TUNE = 0
FINE = -9
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/59/123DE28C.WAV
READ = CLEAN
TUNE = -12
FINE = -9
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 729.333 MS
SUSTAIN = 0%
RELEASE = 545.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > POS 2 = 50%
CV 2 > LEVEL 1 = -17%
CV 2 > LEVEL 2 = -17%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.6%

FAIRWAVE PATCH 1
NAME  = STABBY
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stabby by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/4E/AAC576F0.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 23.7%

[OSC 2]
TABLE = MODWAVE/T/F9/DE4D9FB9.WAV
READ = CLEAN
TUNE = -12
POS = 23.7%

[ENV 1]
GATE = GATE 1
ATTACK = 2.667 MS
DECAY = 820.000 MS
SUSTAIN = 49%
RELEASE = 1.664 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 420.000 MS
SUSTAIN = 0%
RELEASE = 1.895 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 52.5%
ENV 2 > POS 2 = 52.5%
CV 1 > POS 1 = -39.5%
CV 1 > POS 2 = -39.5%
LFO 1 > POS 1 = 6.5%
LFO 1 > POS 2 = 6.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.0%

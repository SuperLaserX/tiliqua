FAIRWAVE PATCH 1
NAME  = COLD ATMOS GLASS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cold Atmos Glassy by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Bell_Guru: WoodpckrMallt.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/D9/FEF75AE8.WAV
READ = SAMPLE
TUNE = -18
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 45.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/80/78DA6317.WAV
READ = CLEAN
TUNE = 10
FINE = 40
POS = 31.2%

[ENV 1]
GATE = GATE 1
ATTACK = 1.572 S
DECAY = 13.397 S
SUSTAIN = 0%
RELEASE = 7.000 S
A CURVE = 20
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 276.000 MS
DECAY = 9.856 S
SUSTAIN = 0%
RELEASE = 7.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -52%
ENV 2 > POS 2 = 37.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

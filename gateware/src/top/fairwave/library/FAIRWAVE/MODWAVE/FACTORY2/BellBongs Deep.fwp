FAIRWAVE PATCH 1
NAME  = BELLBONGS DEEP
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's BellBongs Deep by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A7/67B5D90B.WAV
READ = CLEAN
TUNE = 2
FINE = 42
POS = 27.8%

[OSC 2]
TABLE = MODWAVE/T/D7/32347101.WAV
READ = CLEAN
TUNE = 0
FINE = 16
POS = 27.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 22.403 S
SUSTAIN = 0%
RELEASE = 15.059 S
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 27.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.376 S
SUSTAIN = 0%
RELEASE = 3.376 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 49.5%
CV 1 > POS 1 = -46.5%
CV 1 > POS 2 = -46.5%
ENV 2 > POS 1 = 44.5%
ENV 2 > POS 2 = 44.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

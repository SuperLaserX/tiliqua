FAIRWAVE PATCH 1
NAME  = 138 BABY KICK HA
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's 138 Baby Kick Hat by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc: Windchimes.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Oscillator 2 is A's 2, the sample Drm: Kick Dance 04.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: 138 Baby Bass, 138 Baby Kick Hat.
[OSC 1]
TABLE = MODWAVE/T/E5/CD729135.WAV
READ = SAMPLE
TUNE = -6
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 65.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3C/0A7502A9.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 2.667 MS
A CURVE = 0
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

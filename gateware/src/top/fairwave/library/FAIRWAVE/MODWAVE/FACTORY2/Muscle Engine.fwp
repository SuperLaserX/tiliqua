FAIRWAVE PATCH 1
NAME  = MUSCLE ENGINE
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Muscle Engine by AGeldert: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: some modulation routings, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Muscle Engine.
[OSC 1]
TABLE = MODWAVE/T/BD/C93BEE98.WAV
READ = CLEAN
TUNE = -16
FINE = -35
POS = 29.5%

[OSC 2]
TABLE = MODWAVE/T/47/CD08B98D.WAV
READ = CLEAN
TUNE = -27
FINE = -47
POS = 29.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 300.000 MS
SUSTAIN = 66%
RELEASE = 253.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 0
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 14.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 54.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 120%
CV 1 > POS 1 = -49%
CV 1 > POS 2 = -49%
CV 2 > POS 1 = 41%
CV 2 > POS 2 = 41%
CV 2 > PITCH 1 = 21.5%
ENV 2 > PITCH 1 = 19%
CV 2 > PITCH 2 = 17%
CV 2 > LEVEL 2 = 10%
CV 2 > X DEPTH = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 90.5%

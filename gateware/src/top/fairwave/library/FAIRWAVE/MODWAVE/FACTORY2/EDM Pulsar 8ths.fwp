FAIRWAVE PATCH 1
NAME  = EDM PULSAR 8THS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's EDM Pulsar 8ths by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
[OSC 1]
TABLE = MODWAVE/T/1F/37E0BA19.WAV
READ = CLEAN
TUNE = -24
FINE = 3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/3D/6062C078.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 82%
LFO 2 > LEVEL 2 = 82%
CV 2 > LEVEL 1 = -58%
CV 2 > LEVEL 2 = -58%
LFO 1 > POS 1 = 33%
LFO 1 > POS 2 = 33%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.9%

FAIRWAVE PATCH 1
NAME  = GLORIA INTIMATE
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gloria Intimate by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Str_Guru: Dream Ensemble.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/8D/130AB6DF.WAV
READ = CLEAN
TUNE = 0
POS = 4.5%

[OSC 2]
TABLE = MODWAVE/T/19/7240D1F8.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 2.115 S
DECAY = 16.137 S
SUSTAIN = 50%
RELEASE = 4.456 S
A CURVE = 30
D CURVE = 60
R CURVE = 50
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 27.324 S
SUSTAIN = 0%
RELEASE = 55.461 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > POS 1 = 91%
ENV 2 > LEVEL 2 = 49%
CV 1 > POS 1 = -7.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.7%

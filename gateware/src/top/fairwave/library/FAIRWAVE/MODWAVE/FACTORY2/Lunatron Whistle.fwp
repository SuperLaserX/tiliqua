FAIRWAVE PATCH 1
NAME  = LUNATRON WHISTLE
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Lunatron Whistle by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: Lunatron Whistle, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0B/95D25242.WAV
READ = CLEAN
TUNE = 12
POS = 33.2%

[OSC 2]
TABLE = MODWAVE/T/B0/6B796602.WAV
READ = CLEAN
TUNE = 24
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 84.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 78.667 MS
DECAY = 249.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60

[LFO 1]
RATE = 5.504 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 1 > POS 1 = -55.5%
ENV 2 > POS 1 = 33.5%
LFO 1 > PITCH 1 = 1%
LFO 1 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.9%

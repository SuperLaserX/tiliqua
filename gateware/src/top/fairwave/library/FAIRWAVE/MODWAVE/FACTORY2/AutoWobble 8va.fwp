FAIRWAVE PATCH 1
NAME  = AUTOWOBBLE 8VA
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's AutoWobble 8va by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: AutoWobble 8va, AutoWobble Bass.
[OSC 1]
TABLE = MODWAVE/T/9F/AF59E662.WAV
READ = CLEAN
TUNE = -5
FINE = -3
POS = 28.9%

[OSC 2]
TABLE = MODWAVE/T/95/733F3CC5.WAV
READ = CLEAN
TUNE = 14
POS = 28.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -48%
CV 1 > POS 2 = -48%
CV 2 > POS 1 = 42%
CV 2 > POS 2 = 42%
LFO 1 > LEVEL 1 = 40%
LFO 1 > LEVEL 2 = 40%
LFO 3 > POS 1 = -2.5%
LFO 3 > POS 2 = -2.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 5.4%

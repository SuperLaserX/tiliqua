FAIRWAVE PATCH 1
NAME  = HARDSTYLE-O-RAMA
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Hardstyle-o-Rama by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Hardstyle-o-Rama, Inharmonic Twang, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/89/D4EDA456.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/36/41D36448.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 1.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 1.000 HZ
SHAPE = SAW DN
PHASE = 180
SYNC = GATE 1

[LFO 3]
RATE = 1.000 HZ
SHAPE = SAW DN
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 3 > LEVEL 1 = -66%
CV 1 > POS 1 = -49.5%
CV 1 > POS 2 = -49.5%
LFO 2 > POS 1 = 20.5%
LFO 2 > POS 2 = 20.5%
LFO 1 > PITCH 1 = 19.5%
LFO 2 > LEVEL 2 = 19%
LFO 2 > PITCH 2 = 2.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

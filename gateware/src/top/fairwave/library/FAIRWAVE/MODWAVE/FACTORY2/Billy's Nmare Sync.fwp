FAIRWAVE PATCH 1
NAME  = BILLY'S NMARE SY
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Billy's Nmare Sync by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Billy's Nmare Sync, Mid Crunch, Synth Lead Sweep 2.
[OSC 1]
TABLE = MODWAVE/T/03/F36DB1E8.WAV
READ = CLEAN
TUNE = -24
POS = 15.4%

[OSC 2]
TABLE = MODWAVE/T/8C/FF130CEE.WAV
READ = CLEAN
TUNE = -12
POS = 15.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.295 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 69%
CV 2 > POS 2 = 69%
CV 1 > POS 1 = 25.5%
CV 1 > POS 2 = 25.5%
ENV 2 > POS 1 = -11%
ENV 2 > POS 2 = -11%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 23.7%

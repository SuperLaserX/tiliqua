FAIRWAVE PATCH 1
NAME  = DEEP SEA VOICES
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deep Sea Voices by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 9 unison voices, some modulation routings.
# Its effects, which FairWave hasn't got: Deep Sea Voices, Mangled, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/24/7461DF36.WAV
READ = CLEAN
TUNE = -12
POS = 6.4%

[OSC 2]
TABLE = MODWAVE/T/BB/F0830A00.WAV
READ = CLEAN
TUNE = -12
POS = 6.4%

[ENV 1]
GATE = GATE 1
ATTACK = 712.000 MS
DECAY = 92.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.370 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 100%
ENV 2 > POS 1 = 87%
ENV 2 > POS 2 = 87%
LFO 1 > LEVEL 1 = -61%
LFO 1 > LEVEL 2 = -61%
CV 2 > PITCH 1 = 22.5%
CV 2 > PITCH 2 = 22.5%
LFO 2 > POS 1 = 12%
LFO 2 > POS 2 = 12%
CV 1 > POS 1 = 10.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 77.9%

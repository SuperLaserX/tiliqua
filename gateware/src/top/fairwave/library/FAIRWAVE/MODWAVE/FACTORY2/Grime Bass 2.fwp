FAIRWAVE PATCH 1
NAME  = GRIME BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Grime Bass by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Grime Bass.
[OSC 1]
TABLE = MODWAVE/T/BF/6990B650.WAV
READ = CLEAN
TUNE = -24
FINE = 0
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BF/6990B650.WAV
READ = CLEAN
TUNE = -24
FINE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 100%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 23.5%
ENV 2 > POS 2 = 23.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = GLASSY
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Glassy by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Stereo & Mid Boost.
[OSC 1]
TABLE = MODWAVE/T/90/AAE77142.WAV
READ = CLEAN
TUNE = -12
POS = 16.5%

[OSC 2]
TABLE = MODWAVE/T/E5/89EA3150.WAV
READ = CLEAN
TUNE = 0
POS = 14.1%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 728.000 MS
SUSTAIN = 10%
RELEASE = 2.991 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.2%

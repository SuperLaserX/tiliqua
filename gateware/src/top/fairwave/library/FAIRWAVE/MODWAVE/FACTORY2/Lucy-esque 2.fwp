FAIRWAVE PATCH 1
NAME  = LUCY-ESQUE
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Lucy-esque by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/06/B650A277.WAV
READ = CLEAN
TUNE = 0
FINE = -8
POS = 22.6%

[OSC 2]
TABLE = MODWAVE/T/06/B650A277.WAV
READ = CLEAN
TUNE = 0
FINE = 8
POS = 22.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 34.271 S
SUSTAIN = 0%
RELEASE = 985.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.771 S
SUSTAIN = 0%
RELEASE = 3.812 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 55%
ENV 2 > POS 2 = 55%
CV 1 > POS 1 = -37.5%
CV 1 > POS 2 = -37.5%
LFO 1 > POS 1 = 20.5%
LFO 1 > POS 2 = 20.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

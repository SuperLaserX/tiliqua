FAIRWAVE PATCH 1
NAME  = MODCLOUD
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Modcloud by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Bell_Guru: WoodpckrMallt.
# Not carried over: controllers, random and Kaoss Physics, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modcloud, Stereo EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/4643D2E8.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 23.8%

[OSC 2]
TABLE = MODWAVE/T/5F/27C54BC0.WAV
READ = SAMPLE
TUNE = -30
FINE = 21
POS = 0.0%
EDGE = WRAP
LOOP = 45.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 570.667 MS
SUSTAIN = 56%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 1.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 36.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 3.492 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 52.5%
CV 1 > POS 1 = -39.5%
CV 2 > PITCH 1 = 20%
ENV 2 > PITCH 2 = 6.5%
LFO 1 > POS 1 = 3.5%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = DECEPTICHOIR
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Deceptichoir by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Deceptichoir, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/F1/1FADDE75.WAV
READ = STEPS
TUNE = -12
POS = 51.4%

[OSC 2]
TABLE = MODWAVE/T/D8/05EA3CB0.WAV
READ = CLEAN
TUNE = -12
POS = 49.7%

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = -51%
LFO 1 > POS 1 = 51%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

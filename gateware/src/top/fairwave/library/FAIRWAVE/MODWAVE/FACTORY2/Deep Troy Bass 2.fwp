FAIRWAVE PATCH 1
NAME  = DEEP TROY BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deep Troy Bass by YO & Dan Phillips: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Bass Preserver, Buzz Troy Bass.
[OSC 1]
TABLE = MODWAVE/T/E2/4ADFBE00.WAV
READ = CLEAN
TUNE = -36
POS = 77.7%

[OSC 2]
TABLE = MODWAVE/T/DD/D1478735.WAV
READ = CLEAN
TUNE = -24
POS = 14.8%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

FAIRWAVE PATCH 1
NAME  = MOUNTAIN VIEW
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Mountain View by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Steel Guitar mf.
# Oscillator 2 is A's 2, the sample Atk: Granular St Noise 5.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Clavi Chorus, Drum Squasher, Mono 1/4 note dly.
[OSC 1]
TABLE = MODWAVE/T/1F/1C4FF01B.WAV
READ = SAMPLE
TUNE = -11
FINE = -3
POS = 0.0%
EDGE = WRAP
LOOP = 94.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/93/8745BD46.WAV
READ = SAMPLE
TUNE = -13
FINE = 24
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.812 S
SUSTAIN = 66%
RELEASE = 680.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 50%
LFO 1 > LEVEL 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 18.7%

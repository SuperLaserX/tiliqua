FAIRWAVE PATCH 1
NAME  = FRANDEMONIUM HIG
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Frandemonium High by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/58/756EF390.WAV
READ = CLEAN
TUNE = -12
POS = 99.9%

[OSC 2]
TABLE = MODWAVE/T/66/29340D59.WAV
READ = CLEAN
TUNE = 12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = -22%
CV 2 > LEVEL 2 = -22%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.9%

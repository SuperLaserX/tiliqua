FAIRWAVE PATCH 1
NAME  = SOFT ORCHESTRAL
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Soft Orchestral by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Choir.
# Oscillator 2 is A's 2, the sample Str: Orchestra Strings.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Soft Orchestral.
[OSC 1]
TABLE = MODWAVE/T/E9/074439E1.WAV
READ = SAMPLE
TUNE = -15
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 1.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/27/D38B2049.WAV
READ = SAMPLE
TUNE = -18
FINE = 19
POS = 0.0%
EDGE = WRAP
LOOP = 12.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 70.667 MS
DECAY = 350.667 MS
SUSTAIN = 100%
RELEASE = 544.000 MS
A CURVE = 100
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

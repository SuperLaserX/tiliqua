FAIRWAVE PATCH 1
NAME  = NONSENSE A
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Nonsense A by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Noise.
# Oscillator 2 is A's 2, the sample Syn: Air Noise.
# Not carried over: performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: Nonsense A, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/7D/5C250FB3.WAV
READ = SAMPLE
TUNE = -48
FINE = 4
POS = 0.0%
EDGE = WRAP
LOOP = 0.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/12/F238033A.WAV
READ = SAMPLE
TUNE = -1
FINE = -47
POS = 0.0%
EDGE = WRAP
LOOP = 5.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 39.9%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 148.000 MS
SUSTAIN = 0%
RELEASE = 918.667 MS
A CURVE = 0
D CURVE = 100
R CURVE = 100

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = 103%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 1.5%

FAIRWAVE PATCH 1
NAME  = FLUTE MORDENT
ABOUT = WOODWIND FROM MODWAVE. GATE 1, CV 

# From the modwave's Flute Mordent by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Atk_Guru: Wind Nz 08 Dcy.
# Oscillator 2 is A's 2, the sample Wnd: Clarinet 2 p.
# Not carried over: the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Flute Mordent.
[OSC 1]
TABLE = MODWAVE/T/82/6052A3F4.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/DB/C881525D.WAV
READ = SAMPLE
TUNE = -30
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 75.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 464.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 224.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 4.054 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 1 = 100%
ENV 2 > LEVEL 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

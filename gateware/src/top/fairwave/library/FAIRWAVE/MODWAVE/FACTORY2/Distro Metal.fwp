FAIRWAVE PATCH 1
NAME  = DISTRO METAL
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Distro Metal by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Distro Metal, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/3C/CFB920D0.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/00/58E86289.WAV
READ = CLEAN
TUNE = -12
POS = 33.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 10.364 S
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.241 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -56%
LFO 2 > POS 1 = 42.5%
ENV 2 > POS 2 = 32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 77.8%

FAIRWAVE PATCH 1
NAME  = CARVED PAD
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Carved Pad by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
[OSC 1]
TABLE = MODWAVE/T/BC/5F83762A.WAV
READ = CLEAN
TUNE = -12
POS = 25.5%

[OSC 2]
TABLE = MODWAVE/T/BC/5F83762A.WAV
READ = CLEAN
TUNE = -12
POS = 25.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 750.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 832.000 MS
DECAY = 2.577 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 49%
CV 2 > POS 2 = 49%
CV 1 > POS 1 = -42.5%
CV 1 > POS 2 = -42.5%
ENV 2 > POS 1 = 35%
ENV 2 > POS 2 = 35%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 23.7%

FAIRWAVE PATCH 1
NAME  = DELICATE PLUCKS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Delicate Plucks by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/8F/FF4D2A44.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/79/7BD373D5.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 87.093 S
SUSTAIN = 6%
RELEASE = 729.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 181.333 MS
SUSTAIN = 0%
RELEASE = 3.301 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > LEVEL 1 = -50%
LFO 2 > LEVEL 2 = -50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.7%

FAIRWAVE PATCH 1
NAME  = COLD ATMOS MUTTE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cold Atmos Mutter by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, the sample Syn: Stereo Spectrum.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/90/3AA7503C.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/66/9F9E2A3D.WAV
READ = SAMPLE
TUNE = -42
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.145 S
DECAY = 14.877 S
SUSTAIN = 17%
RELEASE = 7.000 S
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 84.7%

[ENV 2]
GATE = GATE 1
ATTACK = 7.479 S
DECAY = 56.861 S
SUSTAIN = 100%
RELEASE = 7.000 S
A CURVE = 0
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
ENV 2 > X DEPTH = -42%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

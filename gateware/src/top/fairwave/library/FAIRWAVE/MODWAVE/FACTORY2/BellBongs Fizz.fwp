FAIRWAVE PATCH 1
NAME  = BELLBONGS FIZZ
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's BellBongs Fizz by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/CF/AFD61BF7.WAV
READ = CLEAN
TUNE = 46
POS = 14.8%

[OSC 2]
TABLE = MODWAVE/T/1F/1D0D5CAA.WAV
READ = CLEAN
TUNE = 12
POS = 14.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 22.725 S
SUSTAIN = 0%
RELEASE = 16.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 26.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 30.840 S
SUSTAIN = 0%
RELEASE = 30.840 S
A CURVE = 30
D CURVE = 0
R CURVE = 40

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70.5%
ENV 2 > POS 2 = 70.5%
CV 1 > POS 1 = -24.5%
CV 1 > POS 2 = -24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

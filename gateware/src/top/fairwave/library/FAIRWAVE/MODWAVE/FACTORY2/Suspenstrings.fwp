FAIRWAVE PATCH 1
NAME  = SUSPENSTRINGS
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Suspenstrings by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Symphonic Violins.
# Oscillator 2 is A's 2, the sample Str: Orchestra Tremolo.
# Not carried over: the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Modern Compressor, Suspenstrings.
[OSC 1]
TABLE = MODWAVE/T/48/5D60C06F.WAV
READ = SAMPLE
TUNE = -31
FINE = 19
POS = 0.0%
EDGE = WRAP
LOOP = 52.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/7C/A6686133.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = WRAP
LOOP = 9.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 294.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 197.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 2 = 41%
CV 2 > PITCH 2 = 1.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 17.8%

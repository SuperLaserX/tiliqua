FAIRWAVE PATCH 1
NAME  = BLINKY LIGHTS PL
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Blinky Lights Pluck by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Not carried over: controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/26/74352362.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/26/74352362.WAV
TUNE = 0
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.713 S
SUSTAIN = 66%
RELEASE = 140.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = GENTLE WEIRD PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gentle Weird Pad by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Gentle Weird Pad, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/09/3B528953.WAV
READ = CLEAN
TUNE = 12
FINE = 1
POS = 16.9%

[OSC 2]
TABLE = MODWAVE/T/19/0C0ACC5A.WAV
READ = CLEAN
TUNE = 12
FINE = -2
POS = 19.6%

[ENV 1]
GATE = GATE 1
ATTACK = 17.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.168 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 641.333 MS
SUSTAIN = 0%
RELEASE = 24.045 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = -77%
CV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 61%
ENV 2 > POS 1 = -52.5%
CV 1 > POS 2 = -32.5%
CV 1 > POS 1 = 28%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.4%

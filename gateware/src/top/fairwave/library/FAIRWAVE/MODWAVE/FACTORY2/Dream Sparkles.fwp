FAIRWAVE PATCH 1
NAME  = DREAM SPARKLES
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dream Sparkles by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/70/9D11A449.WAV
READ = CLEAN
TUNE = 19
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/72/D765B3C9.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 3.423 S
DECAY = 64.013 S
SUSTAIN = 47%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 3 > LEVEL 1 = 81%
LFO 3 > LEVEL 2 = 81%
LFO 1 > POS 1 = 42.5%
LFO 1 > POS 2 = 42.5%
LFO 2 > POS 1 = 15.5%
LFO 2 > POS 2 = 15.5%
ENV 2 > POS 1 = 13%
ENV 2 > POS 2 = 13%
CV 1 > POS 1 = -13%
CV 1 > POS 2 = -13%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.2%

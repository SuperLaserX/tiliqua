FAIRWAVE PATCH 1
NAME  = DRUM PHASE 2 B
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Drum Phase 2 B by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc_WS: LogDrmLoop.
# Oscillator 2 is A's 2, the sample Prc_WS: LogDrmLoop.
# Not carried over: 4 unison voices.
# Its effects, which FairWave hasn't got: Drum Phase 2 B, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/0A/6A5D5BB8.WAV
READ = SAMPLE
TUNE = -34
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/53/B6BCC590.WAV
READ = SAMPLE
TUNE = -10
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 82.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 8%
LFO 1 > PITCH 2 = 8%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.1%

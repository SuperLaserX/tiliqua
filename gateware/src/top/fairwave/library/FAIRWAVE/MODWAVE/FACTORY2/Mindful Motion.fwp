FAIRWAVE PATCH 1
NAME  = MINDFUL MOTION
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Mindful Motion by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str: Chamber Strings 1.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: Bad Beta Wobble, Made4 Slow Pads, Mindful Motion.
[OSC 1]
TABLE = MODWAVE/T/76/E9072671.WAV
READ = SAMPLE
TUNE = -6
FINE = 30
POS = 0.0%
EDGE = WRAP
LOOP = 20.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9B/C2BF4E5D.WAV
READ = CLEAN
TUNE = -5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 913.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.043 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 6.512 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.9%

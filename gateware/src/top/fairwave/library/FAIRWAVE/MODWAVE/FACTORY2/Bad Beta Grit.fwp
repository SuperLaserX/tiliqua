FAIRWAVE PATCH 1
NAME  = BAD BETA GRIT
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bad Beta Grit by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Bad Beta Grit, Sine2Pad I, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F5/C9F5F537.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/E1/3CA30ED9.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 39%
RELEASE = 1.020 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 3.019 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 79.0%

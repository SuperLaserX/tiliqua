FAIRWAVE PATCH 1
NAME  = MOONSCAPE AIR
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Moonscape Air by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Texture Elly 1.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: AutoWobble Bass, Smile Curve, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/56/306F50AE.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/D6/6CE013C5.WAV
READ = CLEAN
TUNE = 24
POS = 72.5%

[ENV 1]
GATE = GATE 1
ATTACK = 405.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 6.451 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 58.3%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

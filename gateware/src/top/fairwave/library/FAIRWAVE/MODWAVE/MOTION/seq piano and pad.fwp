FAIRWAVE PATCH 1
NAME  = SEQ PIANO AND PA
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's seq piano and pad by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Odd Piano, Stereo Chorus, Wave Piano Bite, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/7D/DB03E661.WAV
READ = CLEAN
TUNE = -12
POS = 22.5%

[OSC 2]
TABLE = MODWAVE/T/7D/8EC09DCA.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 22.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.840 S
SUSTAIN = 7%
RELEASE = 4.248 S
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 9.669 S
SUSTAIN = 13%
RELEASE = 836.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 55%
ENV 2 > POS 2 = 55%
CV 1 > POS 1 = -37.5%
CV 1 > POS 2 = -37.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 27.2%

FAIRWAVE PATCH 1
NAME  = POLYSIX SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Polysix Sequence by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A2/B74F8E63.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 23.2%

[OSC 2]
TABLE = MODWAVE/T/7F/67B37E51.WAV
READ = CLEAN
TUNE = -24
FINE = 4
POS = 23.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.619 S
SUSTAIN = 38%
RELEASE = 637.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.260 S
SUSTAIN = 45%
RELEASE = 557.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 53.5%
ENV 2 > POS 2 = 53.5%
CV 1 > POS 1 = -38.5%
CV 1 > POS 2 = -38.5%
LFO 1 > POS 1 = 14.5%
LFO 1 > POS 2 = 14.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

FAIRWAVE PATCH 1
NAME  = PPG DIGITAL SENT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's PPG Digital Sentinal by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: layer A oscillator 1, layer A oscillator 2, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/97/B5D845B8.WAV
READ = CLEAN
TUNE = 0
POS = 9.3%

[OSC 2]
TABLE = MODWAVE/T/B4/11C3EFEC.WAV
READ = CLEAN
TUNE = 24
POS = 9.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 94.667 MS
SUSTAIN = 0%
RELEASE = 4.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.368 S
SUSTAIN = 34%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 81.5%
ENV 2 > POS 2 = 81.5%
CV 1 > POS 1 = -15.5%
CV 1 > POS 2 = -15.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

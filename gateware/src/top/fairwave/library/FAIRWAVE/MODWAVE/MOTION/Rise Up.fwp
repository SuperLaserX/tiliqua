FAIRWAVE PATCH 1
NAME  = RISE UP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rise Up by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/BD/94E7D388.WAV
READ = CLEAN
TUNE = -12
POS = 19.5%

[OSC 2]
TABLE = MODWAVE/T/EF/E31FFA89.WAV
READ = CLEAN
TUNE = -12
POS = 19.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.531 S
SUSTAIN = 2%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.064 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61%
ENV 2 > POS 2 = 61%
CV 1 > POS 1 = -32.5%
CV 1 > POS 2 = -32.5%
LFO 1 > POS 1 = 27.5%
LFO 1 > POS 2 = 27.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 24.6%

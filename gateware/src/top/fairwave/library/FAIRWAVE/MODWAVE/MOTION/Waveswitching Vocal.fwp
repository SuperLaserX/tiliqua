FAIRWAVE PATCH 1
NAME  = WAVESWITCHING VO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Waveswitching Vocal by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Vox: Gospel Ah.
# Oscillator 2 is B's 2, the sample Vox: Pop Ah.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/CE/1B3DE756.WAV
READ = SAMPLE
TUNE = -14
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 16.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/0A/1F99D777.WAV
READ = SAMPLE
TUNE = -27
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 36.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

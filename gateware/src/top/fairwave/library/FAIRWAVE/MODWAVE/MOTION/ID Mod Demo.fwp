FAIRWAVE PATCH 1
NAME  = ID MOD DEMO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ID Mod Demo by Ian Dixon: Motion.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/91/4121F5F8.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[OSC 2]
TABLE = MODWAVE/T/4D/F81F8832.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 50.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 78.667 MS
SUSTAIN = 3%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.750 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70%
ENV 2 > POS 2 = 70%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
LFO 1 > X DEPTH = 22.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.3%

FAIRWAVE PATCH 1
NAME  = THEREMIN LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Theremin Lead by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox_WS:Voices.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/6C/00234976.WAV
READ = SAMPLE
TUNE = -19
FINE = -46
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/57/B329F856.WAV
READ = CLEAN
TUNE = 12
POS = 21.8%

[ENV 1]
GATE = GATE 1
ATTACK = 193.333 MS
DECAY = 180.000 MS
SUSTAIN = 53%
RELEASE = 1.733 S
A CURVE = 80
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 600.000 MS
DECAY = 580.000 MS
SUSTAIN = 66%
RELEASE = 1.733 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 2 = -36.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.5%

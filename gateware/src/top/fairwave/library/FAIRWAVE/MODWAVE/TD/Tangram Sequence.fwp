FAIRWAVE PATCH 1
NAME  = TANGRAM SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Sequence by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E7/EE027824.WAV
READ = CLEAN
TUNE = 12
FINE = 3
POS = 19.3%

[OSC 2]
TABLE = MODWAVE/T/E7/EE027824.WAV
TUNE = 12
POS = 19.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 440.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.000 S
SUSTAIN = 3%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 61.5%
CV 1 > POS 1 = -32%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

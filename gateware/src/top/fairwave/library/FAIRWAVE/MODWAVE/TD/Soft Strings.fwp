FAIRWAVE PATCH 1
NAME  = SOFT STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Soft Strings by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Str_Guru: Dream Ensemble.
# Oscillator 2 is A's 2, the sample Syn: Detuned Quiet.
[OSC 1]
TABLE = MODWAVE/T/94/70ECA339.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/15/C0607FAE.WAV
READ = SAMPLE
TUNE = -4
FINE = -22
POS = 0.0%
EDGE = WRAP
LOOP = 9.4%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 333.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.0%

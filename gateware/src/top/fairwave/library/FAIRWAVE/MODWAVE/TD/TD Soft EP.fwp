FAIRWAVE PATCH 1
NAME  = TD SOFT EP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Soft EP by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Stage Soft.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FC/6C06F7F5.WAV
READ = SAMPLE
TUNE = -2
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 85.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FC/6C06F7F5.WAV
TUNE = -2
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 23.333 S
SUSTAIN = 0%
RELEASE = 320.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

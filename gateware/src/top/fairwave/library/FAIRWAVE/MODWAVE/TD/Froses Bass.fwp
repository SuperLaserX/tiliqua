FAIRWAVE PATCH 1
NAME  = FROSES BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Froses Bass by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/77/E363F0A7.WAV
READ = CLEAN
TUNE = -12
POS = 12.0%

[OSC 2]
TABLE = MODWAVE/T/74/5D7A13EB.WAV
READ = CLEAN
TUNE = -12
POS = 43.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 506.667 MS
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 560.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 76%
CV 1 > POS 2 = -72%
CV 1 > POS 1 = -20%
ENV 2 > POS 2 = 13.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.2%

FAIRWAVE PATCH 1
NAME  = TD VOCODER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Vocoder by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, the sample Vox: Vocoder VP.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/A5/F1D9B0EE.WAV
READ = SAMPLE
TUNE = -12
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/28/3C5FD5AD.WAV
READ = SAMPLE
TUNE = -13
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 3.000 S
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 9.9%

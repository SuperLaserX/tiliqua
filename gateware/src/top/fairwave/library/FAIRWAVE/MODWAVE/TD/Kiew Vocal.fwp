FAIRWAVE PATCH 1
NAME  = KIEW VOCAL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Kiew Vocal by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/7E/8C2CC3D7.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/CF/957A79CF.WAV
READ = CLEAN
TUNE = 0
FINE = -2
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 13.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -63.5%
CV 1 > POS 2 = -63.5%
LFO 1 > POS 1 = 12%
LFO 1 > POS 2 = 12%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.9%

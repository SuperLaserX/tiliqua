FAIRWAVE PATCH 1
NAME  = DOLPHIN DANCE BA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dolphin Dance Bass by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/8B/6281807A.WAV
READ = CLEAN
TUNE = -12
POS = 16.3%

[OSC 2]
TABLE = MODWAVE/T/DE/28581DCE.WAV
READ = CLEAN
TUNE = 0
FINE = 13
POS = 16.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 993.333 MS
SUSTAIN = 26%
RELEASE = 780.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 633.333 MS
SUSTAIN = 30%
RELEASE = 8.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

FAIRWAVE PATCH 1
NAME  = TD GUITAR LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Guitar Lead by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Distortion 1 f.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here.
# Its effects, which FairWave hasn't got: Airstrings, Cathedral Pad, Stereo Chorus, US Modern V30, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/C5/CAF74297.WAV
READ = SAMPLE
TUNE = -8
FINE = -8
POS = 0.0%
EDGE = WRAP
LOOP = 49.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/99/6B7370E5.WAV
READ = CLEAN
TUNE = 0
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 20.000 MS
SUSTAIN = 74%
RELEASE = 186.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 19.7%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 74.667 S
SUSTAIN = 83%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.325 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 100%
ENV 2 > POS 2 = 69%
CV 1 > POS 2 = -26%
CV 2 > PITCH 1 = 1%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.7%

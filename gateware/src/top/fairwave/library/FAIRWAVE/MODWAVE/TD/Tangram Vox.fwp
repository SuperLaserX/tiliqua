FAIRWAVE PATCH 1
NAME  = TANGRAM VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Vox by Ian dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D3/69712B76.WAV
READ = CLEAN
TUNE = 0
POS = 44.5%

[OSC 2]
TABLE = MODWAVE/T/50/BBAAB9A4.WAV
READ = CLEAN
TUNE = -12
POS = 44.5%

[ENV 1]
GATE = GATE 1
ATTACK = 1.133 S
DECAY = 26.667 MS
SUSTAIN = 79%
RELEASE = 2.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 12.5%
LFO 1 > POS 1 = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.3%

FAIRWAVE PATCH 1
NAME  = TANGRAM BRASS&CP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Brass&CP by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, the sample Key: Electric Grand.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: EP Chorus, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B0/1D24FDDA.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 23.4%

[OSC 2]
TABLE = MODWAVE/T/53/1FA3E1C0.WAV
READ = SAMPLE
TUNE = -17
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 69.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 173.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.320 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 666.667 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 4.083 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 53%
CV 1 > POS 1 = -39%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.0%

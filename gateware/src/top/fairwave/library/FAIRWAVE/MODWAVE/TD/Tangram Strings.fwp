FAIRWAVE PATCH 1
NAME  = TANGRAM STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Strings by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus 2, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/AD/732043F9.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/B7/2C39A6B8.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.133 S
DECAY = 21.333 MS
SUSTAIN = 100%
RELEASE = 1.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

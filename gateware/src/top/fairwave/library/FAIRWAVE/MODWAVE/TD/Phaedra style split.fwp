FAIRWAVE PATCH 1
NAME  = PHAEDRA STYLE SP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Phaedra style split by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, the sample Str: Tape 3 Violins-Chmb.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Modern Compressor, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/48/BFF9F8E4.WAV
READ = CLEAN
TUNE = -24
POS = 11.6%

[OSC 2]
TABLE = MODWAVE/T/EB/213D44AC.WAV
READ = SAMPLE
TUNE = -27
FINE = -23
POS = 0.0%
EDGE = WRAP
LOOP = 35.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 16.000 MS
DECAY = 633.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 41%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 77%
CV 1 > POS 1 = -19.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.0%

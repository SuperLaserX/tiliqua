FAIRWAVE PATCH 1
NAME  = DIGITAL PULSE CH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digital Pulse Chords by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/1F/EF7278C3.WAV
READ = CLEAN
TUNE = 0
POS = 78.8%

[OSC 2]
TABLE = MODWAVE/T/26/25F51B2C.WAV
READ = CLEAN
TUNE = -12
POS = 92.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.333 S
SUSTAIN = 2%
RELEASE = 386.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = -58.5%
ENV 2 > POS 1 = -39%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.1%

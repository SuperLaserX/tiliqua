FAIRWAVE PATCH 1
NAME  = STUNT MAN BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stunt Man Bass by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/88/4E092B9B.WAV
READ = CLEAN
TUNE = -12
POS = 41.4%

[OSC 2]
TABLE = MODWAVE/T/88/4E092B9B.WAV
TUNE = -12
POS = 41.4%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 226.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = 69%
ENV 2 > POS 1 = 17%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = TANGRAM VOCODER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Vocoder by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is B's 1, the sample Str_Guru: Dream Ensemble.
# Not carried over: layer A oscillator 2, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/2A/B0B194E8.WAV
READ = SAMPLE
TUNE = -12
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/94/70ECA339.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 74.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 3.000 S
DECAY = 90.000 S
SUSTAIN = 98%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.7%

FAIRWAVE PATCH 1
NAME  = BELL CHORDS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bell Chords by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Wave: DWGS Bell 1.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/36/3D1CCF49.WAV
READ = CLEAN
TUNE = 0
POS = 26.7%

[OSC 2]
TABLE = MODWAVE/T/52/57FE8DB6.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.733 S
SUSTAIN = 81%
RELEASE = 2.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.4%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.1%

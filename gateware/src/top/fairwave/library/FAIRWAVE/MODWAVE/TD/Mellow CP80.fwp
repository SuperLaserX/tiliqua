FAIRWAVE PATCH 1
NAME  = MELLOW CP80
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mellow CP80 by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Key: Electric Grand.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BE/65C5C15B.WAV
READ = SAMPLE
TUNE = -17
FINE = 14
POS = 0.0%
EDGE = WRAP
LOOP = 69.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BE/65C5C15B.WAV
TUNE = -17
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 16.667 S
SUSTAIN = 0%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

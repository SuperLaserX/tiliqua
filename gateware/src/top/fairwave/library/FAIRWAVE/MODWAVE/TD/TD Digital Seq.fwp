FAIRWAVE PATCH 1
NAME  = TD DIGITAL SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Digital Seq by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BC/C194D851.WAV
READ = CLEAN
TUNE = 0
POS = 16.0%

[OSC 2]
TABLE = MODWAVE/T/50/3A211765.WAV
READ = CLEAN
TUNE = 0
POS = 16.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 440.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 776.000 MS
SUSTAIN = 3%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
ENV 2 > POS 2 = 68%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.3%

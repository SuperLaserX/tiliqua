FAIRWAVE PATCH 1
NAME  = BELL SEQUENCE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Bell Sequence by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/61/CB0476DF.WAV
READ = CLEAN
TUNE = 0
POS = 71.8%

[OSC 2]
TABLE = MODWAVE/T/5C/4F1B8FF1.WAV
READ = CLEAN
TUNE = -12
POS = 79.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 946.667 MS
SUSTAIN = 0%
RELEASE = 2.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 5.5%
LFO 1 > POS 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

FAIRWAVE PATCH 1
NAME  = TD STYLE SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Style Seq by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, Vintage Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/78/5AA6AC26.WAV
READ = SAMPLE
TUNE = -12
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 9.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/86/02F328FF.WAV
READ = CLEAN
TUNE = -12
POS = 25.3%

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.895 S
DECAY = 14.721 S
SUSTAIN = 82%
RELEASE = 1.964 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 49.5%
CV 1 > POS 2 = -42%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 63.3%

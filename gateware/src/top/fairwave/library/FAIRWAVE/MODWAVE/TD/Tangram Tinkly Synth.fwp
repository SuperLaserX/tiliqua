FAIRWAVE PATCH 1
NAME  = TANGRAM TINKLY S
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Tinkly Synth by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/48/F2B05FB2.WAV
READ = CLEAN
TUNE = 0
POS = 28.5%

[OSC 2]
TABLE = MODWAVE/T/CA/276BFD30.WAV
READ = CLEAN
TUNE = 12
POS = 13.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.733 S
SUSTAIN = 81%
RELEASE = 2.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.4%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

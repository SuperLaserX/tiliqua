FAIRWAVE PATCH 1
NAME  = REAL TRAIN EP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Real Train EP by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is B's 1, the sample E.Piano: Mark V velo.1.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/5E/72FBFDA7.WAV
READ = SAMPLE
TUNE = -12
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 9.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/8D/CCE13D9F.WAV
READ = SAMPLE
TUNE = -8
FINE = -14
POS = 0.0%
EDGE = WRAP
LOOP = 98.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 4.000 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

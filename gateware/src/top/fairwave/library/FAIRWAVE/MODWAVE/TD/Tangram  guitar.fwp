FAIRWAVE PATCH 1
NAME  = TANGRAM  GUITAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram  guitar by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Steel Guitar p.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/58/341F5457.WAV
READ = SAMPLE
TUNE = -8
FINE = 34
POS = 0.0%
EDGE = WRAP
LOOP = 94.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/58/341F5457.WAV
TUNE = -8
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.067 S
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > LEVEL 1 = 4%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

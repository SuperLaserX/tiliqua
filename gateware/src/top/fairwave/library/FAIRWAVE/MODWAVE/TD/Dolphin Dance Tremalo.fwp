FAIRWAVE PATCH 1
NAME  = DOLPHIN DANCE TR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dolphin Dance Tremalo by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CB/D8404B79.WAV
READ = CLEAN
TUNE = 0
POS = 16.0%

[OSC 2]
TABLE = MODWAVE/T/CB/D8404B79.WAV
TUNE = 0
POS = 16.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 54.667 S
SUSTAIN = 100%
RELEASE = 440.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 68%
CV 1 > POS 1 = -26.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

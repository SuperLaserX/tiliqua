FAIRWAVE PATCH 1
NAME  = TD SEQUENCER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Sequencer by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E4/5BEF1E88.WAV
READ = CLEAN
TUNE = -24
FINE = -1
POS = 17.2%

[OSC 2]
TABLE = MODWAVE/T/E4/5BEF1E88.WAV
TUNE = -24
POS = 17.2%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 333.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.267 S
SUSTAIN = 3%
RELEASE = 81.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 65.5%
CV 1 > POS 1 = -28.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

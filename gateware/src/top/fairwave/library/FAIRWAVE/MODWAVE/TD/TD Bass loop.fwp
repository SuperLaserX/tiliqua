FAIRWAVE PATCH 1
NAME  = TD BASS LOOP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Bass loop by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Slow & Warm.
[OSC 1]
TABLE = MODWAVE/T/EC/726311FB.WAV
READ = CLEAN
TUNE = 0
FINE = -5
POS = 18.1%

[OSC 2]
TABLE = MODWAVE/T/CD/8F404666.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 18.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.653 S
SUSTAIN = 0%
RELEASE = 506.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 737.333 MS
SUSTAIN = 29%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.125 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 64%
ENV 2 > POS 2 = 64%
CV 1 > POS 1 = -30%
CV 1 > POS 2 = -30%
LFO 1 > POS 1 = 9.5%
LFO 1 > POS 2 = 9.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

FAIRWAVE PATCH 1
NAME  = TANGRAM BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Tangram Bass by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/21/BFDC20A6.WAV
READ = CLEAN
TUNE = -24
POS = 15.4%

[OSC 2]
TABLE = MODWAVE/T/07/D9D9A2CE.WAV
READ = CLEAN
TUNE = -12
POS = 15.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.267 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 89.333 MS
DECAY = 2.733 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.5%

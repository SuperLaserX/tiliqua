FAIRWAVE PATCH 1
NAME  = TD WARM PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's TD Warm Pad by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CA/896BFB21.WAV
READ = CLEAN
TUNE = -12
POS = 40.8%

[OSC 2]
TABLE = MODWAVE/T/CA/896BFB21.WAV
TUNE = -12
POS = 40.8%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 542.667 MS
DECAY = 90.000 S
SUSTAIN = 85%
RELEASE = 466.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 10.667 MS
DECAY = 1.187 S
SUSTAIN = 95%
RELEASE = 224.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -68%
ENV 2 > POS 1 = 18.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

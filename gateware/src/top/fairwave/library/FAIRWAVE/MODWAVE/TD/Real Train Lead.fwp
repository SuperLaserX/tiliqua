FAIRWAVE PATCH 1
NAME  = REAL TRAIN LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Real Train Lead by Ian Dixon: TD.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 3 unison voices.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/1D/1C9EA054.WAV
READ = CLEAN
TUNE = 0
FINE = -9
POS = 20.5%

[OSC 2]
TABLE = MODWAVE/T/1D/1C9EA054.WAV
READ = CLEAN
TUNE = 0
FINE = -3
POS = 20.5%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 49.333 MS
SUSTAIN = 100%
RELEASE = 2.016 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.115 S
SUSTAIN = 55%
RELEASE = 20.963 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59%
ENV 2 > POS 2 = 59%
CV 1 > POS 1 = -34%
CV 1 > POS 2 = -34%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = AUTOBAN MAJOR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Autoban Major  by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100.
[OSC 1]
TABLE = MODWAVE/T/E0/9088F75D.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/30/CB434E83.WAV
READ = CLEAN
TUNE = -8
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

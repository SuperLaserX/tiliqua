FAIRWAVE PATCH 1
NAME  = COMPUTER LOVE LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Computer Love Lead by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/5B/A05A7671.WAV
READ = CLEAN
TUNE = 12
FINE = 5
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/9E/1A0D58BC.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.467 S
SUSTAIN = 17%
RELEASE = 232.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 98.5%

[LFO 1]
RATE = 9.109 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.4%

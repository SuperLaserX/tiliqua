FAIRWAVE PATCH 1
NAME  = POCKET CALCUALTO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pocket Calcualtor Loop by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Delay, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D4/ED0EE79A.WAV
READ = CLEAN
TUNE = 12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/4A/52DE160B.WAV
READ = CLEAN
TUNE = -24
POS = 13.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 880.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 773.333 MS
SUSTAIN = 4%
RELEASE = 86.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 73%
CV 1 > POS 2 = -22.5%
CV 1 > POS 1 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 70.4%

FAIRWAVE PATCH 1
NAME  = AUTOBAHN CAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Autobahn Car by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/75/47C01B62.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BC/4FEE639C.WAV
READ = CLEAN
TUNE = -5
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.680 S
DECAY = 686.667 MS
SUSTAIN = 1%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.500 S
SUSTAIN = 3%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 2 = 11%
ENV 2 > PITCH 1 = 11%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.2%

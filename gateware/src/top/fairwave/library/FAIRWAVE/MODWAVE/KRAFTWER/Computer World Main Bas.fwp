FAIRWAVE PATCH 1
NAME  = COMPUTER WORLD M
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Computer World Main Bas by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B4/D5ABE450.WAV
READ = CLEAN
TUNE = -12
POS = 16.6%

[OSC 2]
TABLE = MODWAVE/T/44/D1752272.WAV
READ = CLEAN
TUNE = -24
POS = 16.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.341 S
SUSTAIN = 0%
RELEASE = 80.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.347 S
SUSTAIN = 1%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67%
ENV 2 > POS 2 = 67%
CV 1 > POS 1 = -27.5%
CV 1 > POS 2 = -27.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.2%

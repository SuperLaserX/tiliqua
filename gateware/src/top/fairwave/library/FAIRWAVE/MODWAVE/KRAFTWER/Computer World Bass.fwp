FAIRWAVE PATCH 1
NAME  = COMPUTER WORLD B
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Computer World Bass by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/C5/04920FDE.WAV
READ = CLEAN
TUNE = -24
FINE = 2
POS = 19.3%

[OSC 2]
TABLE = MODWAVE/T/AF/32DD0078.WAV
READ = CLEAN
TUNE = -24
FINE = -2
POS = 19.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 173.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 73.333 MS
SUSTAIN = 61%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61.5%
ENV 2 > POS 2 = 61.5%
CV 1 > POS 1 = -32%
CV 1 > POS 2 = -32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.3%

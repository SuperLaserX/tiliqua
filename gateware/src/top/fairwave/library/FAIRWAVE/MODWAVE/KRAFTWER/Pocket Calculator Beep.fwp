FAIRWAVE PATCH 1
NAME  = POCKET CALCULATO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pocket Calculator Beep by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Ring Modulator, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E1/2A2C4A23.WAV
READ = CLEAN
TUNE = 11
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/30/3A8BE769.WAV
READ = CLEAN
TUNE = 1
FINE = -7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 38.7%

[ENV 2]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 77.333 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 16.109 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
ENV 2 > PITCH 1 = 2.5%
ENV 2 > PITCH 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

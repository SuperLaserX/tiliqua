FAIRWAVE PATCH 1
NAME  = COMPUTER WORLD L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Computer World Lead by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/16/3C9B3B9C.WAV
READ = CLEAN
TUNE = 12
FINE = -4
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/6C/F376DE9D.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 232.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.4%

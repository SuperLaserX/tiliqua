FAIRWAVE PATCH 1
NAME  = THE ROBOT VOX
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's The Robot Vox by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Vox: Vocoder VP.
# Oscillator 2 is A's 2, the sample Vox: Vocoder VP.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/69/1CF4F266.WAV
READ = SAMPLE
TUNE = -12
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 22.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/BA/9A6721AA.WAV
READ = SAMPLE
TUNE = -12
FINE = 17
POS = 0.0%
EDGE = WRAP
LOOP = 9.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 48.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 418.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 3.176 S
DECAY = 39.680 S
SUSTAIN = 100%
RELEASE = 496.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = THE MODEL MID LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's The Model Mid Lead by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/3D/0C9C4F56.WAV
READ = CLEAN
TUNE = -12
POS = 62.5%

[OSC 2]
TABLE = MODWAVE/T/6A/D523622B.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 65.2%

[ENV 1]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 677.333 MS
SUSTAIN = 61%
RELEASE = 76.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.9%

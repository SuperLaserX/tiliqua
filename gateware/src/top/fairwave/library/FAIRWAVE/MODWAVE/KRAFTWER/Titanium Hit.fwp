FAIRWAVE PATCH 1
NAME  = TITANIUM HIT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Titanium Hit by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Cym: HH 2 Closed 2.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/C2/473B1374.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/FD/51134510.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.8%

FAIRWAVE PATCH 1
NAME  = COMPUTER WORLD H
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Computer World High Lead by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/12/6DF53802.WAV
READ = CLEAN
TUNE = 12
FINE = -4
POS = 64.0%

[OSC 2]
TABLE = MODWAVE/T/FD/03819392.WAV
READ = CLEAN
TUNE = 0
FINE = 3
POS = 71.9%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 689.333 MS
SUSTAIN = 0%
RELEASE = 62.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

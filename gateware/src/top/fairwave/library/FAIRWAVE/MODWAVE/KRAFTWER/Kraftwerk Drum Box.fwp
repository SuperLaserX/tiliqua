FAIRWAVE PATCH 1
NAME  = KRAFTWERK DRUM B
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Kraftwerk Drum Box by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Light OD Gtr, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/62/C2EACC86.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 15.2%

[OSC 2]
TABLE = MODWAVE/T/08/14D17707.WAV
READ = CLEAN
TUNE = -36
FINE = 1
POS = 15.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 960.000 MS
SUSTAIN = 0%
RELEASE = 77.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 70.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69.5%
ENV 2 > POS 2 = 69.5%
ENV 2 > PITCH 1 = 44.5%
ENV 2 > PITCH 2 = 44.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

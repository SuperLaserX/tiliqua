FAIRWAVE PATCH 1
NAME  = THE ROBOTS BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's The Robots Bass by Ian Dixon: Kraftwerk.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/04/5AC3AD3F.WAV
READ = CLEAN
TUNE = -12
POS = 6.4%

[OSC 2]
TABLE = MODWAVE/T/EA/65F0D40F.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 6.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 216.000 MS
SUSTAIN = 0%
RELEASE = 65.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 58.667 MS
SUSTAIN = 11%
RELEASE = 466.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 87%
ENV 2 > POS 2 = 87%
CV 1 > POS 1 = -10.5%
CV 1 > POS 2 = -10.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

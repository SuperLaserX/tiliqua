FAIRWAVE PATCH 1
NAME  = GOING OFF WOLD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Going off wold by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CE/00755375.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 17.5%

[OSC 2]
TABLE = MODWAVE/T/6D/2DD827E2.WAV
READ = CLEAN
TUNE = 24
POS = 17.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.835 S
SUSTAIN = 0%
RELEASE = 580.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.632 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29%
CV 1 > POS 2 = -29%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 39.8%

FAIRWAVE PATCH 1
NAME  = 2 OP FM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 2 Op FM by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/B3/6912061D.WAV
READ = CLEAN
TUNE = 36
FINE = -1
POS = 15.7%

[OSC 2]
TABLE = MODWAVE/T/55/D800B640.WAV
READ = CLEAN
TUNE = -12
POS = 15.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 26.7%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.133 S
SUSTAIN = 42%
RELEASE = 160.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 61.7%

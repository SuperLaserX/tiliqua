FAIRWAVE PATCH 1
NAME  = ENSEMBLE SQ LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ensemble Sq Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/BB/2BCFE542.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 19.5%

[OSC 2]
TABLE = MODWAVE/T/E9/EBCC19AC.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 19.5%

[ENV 1]
GATE = GATE 1
ATTACK = 133.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.013 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 753.333 MS
DECAY = 449.333 MS
SUSTAIN = 54%
RELEASE = 1.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61%
ENV 2 > POS 2 = 61%
CV 1 > POS 1 = -32.5%
CV 1 > POS 2 = -32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.9%

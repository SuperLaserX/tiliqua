FAIRWAVE PATCH 1
NAME  = TRIGGER PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Trigger Pad by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Slowchug Lead, Vintage Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/53/786575DC.WAV
READ = CLEAN
TUNE = -12
FINE = -5
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/6C/CFDC6C21.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 46.667 MS
DECAY = 506.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 41%
LFO 1 > POS 2 = 41%
CV 1 > POS 1 = -15%
CV 1 > POS 2 = -15%
ENV 2 > POS 1 = 2%
ENV 2 > POS 2 = 2%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

FAIRWAVE PATCH 1
NAME  = PULSE LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pulse Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, a table made along morph.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage.
[OSC 1]
TABLE = MODWAVE/T/70/7FBBBF47.WAV
READ = CLEAN
TUNE = -12
POS = 47.6%

[OSC 2]
TABLE = MODWAVE/T/55/E03351F1.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 500.000 MS
SUSTAIN = 46%
RELEASE = 733.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > POS 1 = 46.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.5%

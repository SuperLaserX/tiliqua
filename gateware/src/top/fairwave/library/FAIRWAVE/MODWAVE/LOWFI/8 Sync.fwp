FAIRWAVE PATCH 1
NAME  = 8 SYNC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 8 Sync by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape Rhythm.
[OSC 1]
TABLE = MODWAVE/T/D3/DC6EDC7C.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 15.7%

[OSC 2]
TABLE = MODWAVE/T/04/72387A95.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 15.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 36.000 S
SUSTAIN = 0%
RELEASE = 66.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.9%

FAIRWAVE PATCH 1
NAME  = KEEP WARM STRING
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Keep Warm Strings by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Ensemble A2600.
# Oscillator 2 is A's 2, the sample Syn: Ensemble A2600.
# Its effects, which FairWave hasn't got: Modern Compressor, Suspenstrings, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/4C/1EC8127C.WAV
READ = SAMPLE
TUNE = -7
FINE = 41
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/92/9ECBBFFC.WAV
READ = SAMPLE
TUNE = -7
FINE = 47
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 326.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

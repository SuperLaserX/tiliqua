FAIRWAVE PATCH 1
NAME  = JAN 'S LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jan 's Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/62/9173087B.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 20.8%

[OSC 2]
TABLE = MODWAVE/T/32/5A2960CB.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 20.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 800.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 8.000 MS
DECAY = 2.400 S
SUSTAIN = 78%
RELEASE = 80.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58.5%
ENV 2 > POS 2 = 58.5%
CV 1 > POS 1 = -34.5%
CV 1 > POS 2 = -34.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.0%

FAIRWAVE PATCH 1
NAME  = POP AND HISS EP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pop and Hiss EP by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample E.Piano: Stage Soft.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the noise generator.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage, Vintage Tine EP Chorus.
[OSC 1]
TABLE = MODWAVE/T/76/E8B8CA04.WAV
READ = SAMPLE
TUNE = -2
FINE = 16
POS = 0.0%
EDGE = WRAP
LOOP = 85.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/1B/B1175CF3.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.933 S
SUSTAIN = 19%
RELEASE = 2.400 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 0.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

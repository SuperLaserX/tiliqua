FAIRWAVE PATCH 1
NAME  = WOBLEY LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wobley Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/05/776FC54B.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/19/60F2CC8D.WAV
READ = CLEAN
TUNE = -12
POS = 75.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.467 S
SUSTAIN = 0%
RELEASE = 666.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.6%

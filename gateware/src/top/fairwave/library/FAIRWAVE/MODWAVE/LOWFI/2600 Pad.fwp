FAIRWAVE PATCH 1
NAME  = 2600 PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 2600 Pad by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Wave: Saw Down A2600.
# Oscillator 2 is A's 2, the sample Wave: Pulse 90% A2600.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Suspenstrings, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/9F/4EC4DAA6.WAV
READ = SAMPLE
TUNE = -12
FINE = 6
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EF/D852DD2F.WAV
READ = SAMPLE
TUNE = -11
FINE = -9
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 326.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 15.7%

FAIRWAVE PATCH 1
NAME  = JEN SX1000 SAW L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Jen SX1000 Saw Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C3/A7B2853D.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 19.8%

[OSC 2]
TABLE = MODWAVE/T/C3/A7B2853D.WAV
TUNE = -12
POS = 19.8%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 6.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 918.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 65.333 MS
DECAY = 593.333 MS
SUSTAIN = 53%
RELEASE = 600.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 60.5%
CV 1 > POS 1 = -33%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

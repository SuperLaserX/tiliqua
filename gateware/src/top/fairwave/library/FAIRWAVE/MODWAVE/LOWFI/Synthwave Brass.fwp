FAIRWAVE PATCH 1
NAME  = SYNTHWAVE BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Synthwave Brass by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/B7/8A058A13.WAV
READ = CLEAN
TUNE = -12
POS = 21.8%

[OSC 2]
TABLE = MODWAVE/T/B7/8A058A13.WAV
READ = CLEAN
TUNE = -12
POS = 21.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 953.333 MS
SUSTAIN = 83%
RELEASE = 1.800 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 400.000 MS
DECAY = 75.333 S
SUSTAIN = 89%
RELEASE = 20.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

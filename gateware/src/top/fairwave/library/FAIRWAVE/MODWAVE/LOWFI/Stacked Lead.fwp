FAIRWAVE PATCH 1
NAME  = STACKED LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stacked Lead by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/04/E70AA2B8.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1D/CCE61276.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

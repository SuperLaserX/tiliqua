FAIRWAVE PATCH 1
NAME  = MINILOGUE MONO C
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Minilogue mono Classic by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the noise generator.
# Its effects, which FairWave hasn't got: bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/63/F0A9FAFB.WAV
READ = CLEAN
TUNE = -12
POS = 13.3%

[OSC 2]
TABLE = MODWAVE/T/63/F0A9FAFB.WAV
READ = CLEAN
TUNE = -12
POS = 13.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 2.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.347 S
DECAY = 626.667 MS
SUSTAIN = 58%
RELEASE = 46.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 73.5%
ENV 2 > POS 2 = 73.5%
CV 1 > POS 1 = -22%
CV 1 > POS 2 = -22%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

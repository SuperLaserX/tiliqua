FAIRWAVE PATCH 1
NAME  = WARM JUNO STRING
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Warm Juno Strings by Ian Dixon: ID-lowfi.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Tine EP Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/E4/9B3613D0.WAV
READ = CLEAN
TUNE = -12
POS = 31.4%

[OSC 2]
TABLE = MODWAVE/T/E4/9B3613D0.WAV
TUNE = -12
POS = 31.4%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 188.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.221 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1

FAIRWAVE PATCH 1
NAME  = FAIRLIGHT SYNTH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Synth Bass  by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Synth Bass 3.
# Oscillator 2 is A's 2, the sample Fairlight Synth Bass 3.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/90/C5EC354A.WAV
READ = SAMPLE
TUNE = -36
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/90/C5EC354A.WAV
READ = SAMPLE
TUNE = -36
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

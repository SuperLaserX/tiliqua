FAIRWAVE PATCH 1
NAME  = FAIRLIGHT ENS BR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Ens Brass by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Brass 1.
# Oscillator 2 is A's 2, the sample Fairlight Brass 1.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Buzz Troy Bass, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/7F/E4D5A0BA.WAV
READ = SAMPLE
TUNE = -36
FINE = 9
POS = 0.0%
EDGE = WRAP
LOOP = 88.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FA/BF827D89.WAV
READ = SAMPLE
TUNE = -36
POS = 0.0%
EDGE = WRAP
LOOP = 88.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > PITCH 1 = 0.5%
CV 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

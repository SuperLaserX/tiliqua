FAIRWAVE PATCH 1
NAME  = RUNNING UP CELLO
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Running up Cello by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Cello 1.
# Oscillator 2 is A's 2, the sample Fairlight TRAMCHLO.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/B8/D056EB15.WAV
READ = SAMPLE
TUNE = -12
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/FB/4072DBCE.WAV
READ = SAMPLE
TUNE = -12
FINE = 10
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 733.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 58.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > PITCH 1 = -5%
ENV 2 > PITCH 2 = -5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 98.5%

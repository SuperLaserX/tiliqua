FAIRWAVE PATCH 1
NAME  = FAIRLIGHT BUCCHI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Bucchi by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Bucchi.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/E4/F753DA85.WAV
READ = SAMPLE
TUNE = -24
FINE = 7
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E4/F753DA85.WAV
TUNE = -24
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = FAIRLIGHT HIPASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Hipass vocal by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Bass Vocal.
# Its effects, which FairWave hasn't got: Cross DDL 1, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/B7/2C3FDBE2.WAV
READ = SAMPLE
TUNE = -36
FINE = -2
POS = 0.0%
EDGE = WRAP
LOOP = 84.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/B7/2C3FDBE2.WAV
TUNE = -36
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = FAIRLIGHT MMM CH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight MMM Choir by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight MMM.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus 2.
[OSC 1]
TABLE = MODWAVE/T/54/F24BC864.WAV
READ = SAMPLE
TUNE = -24
FINE = 11
POS = 0.0%
EDGE = WRAP
LOOP = 17.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/54/F24BC864.WAV
TUNE = -24
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 66.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

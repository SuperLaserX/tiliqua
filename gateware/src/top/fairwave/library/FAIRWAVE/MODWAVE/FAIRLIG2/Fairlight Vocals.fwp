FAIRWAVE PATCH 1
NAME  = FAIRLIGHT VOCALS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Vocals by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight AH2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/0C/1BEDE5E7.WAV
READ = SAMPLE
TUNE = -24
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 47.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/0C/1BEDE5E7.WAV
TUNE = -24
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 793.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

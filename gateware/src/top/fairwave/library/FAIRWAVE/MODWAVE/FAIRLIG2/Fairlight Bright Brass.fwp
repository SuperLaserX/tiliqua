FAIRWAVE PATCH 1
NAME  = FAIRLIGHT BRIGHT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Bright Brass by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Prais Brass.
# Oscillator 2 is A's 2, the sample Fairlight Prais Brass.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/98/FF306CAB.WAV
READ = SAMPLE
TUNE = -36
FINE = 3
POS = 0.0%
EDGE = WRAP
LOOP = 88.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/ED/8A8FB5BF.WAV
READ = SAMPLE
TUNE = -24
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 88.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 16.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 66.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.400 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.4%

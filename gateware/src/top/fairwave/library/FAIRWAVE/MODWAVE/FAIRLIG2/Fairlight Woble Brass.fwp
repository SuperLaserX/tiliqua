FAIRWAVE PATCH 1
NAME  = FAIRLIGHT WOBLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fairlight Woble Brass by Ian Dixon: IDFairlight.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Fairlight Trumpet.
# Oscillator 2 is A's 2, the sample Fairlight Trumpet 8.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/8F/A7B8397F.WAV
READ = SAMPLE
TUNE = -12
FINE = 43
POS = 0.0%
EDGE = WRAP
LOOP = 14.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E8/A522AF10.WAV
READ = SAMPLE
TUNE = -44
FINE = 45
POS = 0.0%
EDGE = WRAP
LOOP = 88.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.9%

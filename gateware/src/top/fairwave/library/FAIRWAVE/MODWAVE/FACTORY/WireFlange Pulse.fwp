FAIRWAVE PATCH 1
NAME  = WIREFLANGE PULSE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's WireFlange Pulse by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn_Guru: Guitaritronik.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Stereo Chorus, WireFlange Pulse.
[OSC 1]
TABLE = MODWAVE/T/7C/A565FD7D.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/D1/8C8DEECD.WAV
READ = SAMPLE
TUNE = -34
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 28.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 2.012 S
DECAY = 4.604 S
SUSTAIN = 24%
RELEASE = 2.199 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
PHASE = 35
SYNC = GATE 1

[LFO 2]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > LEVEL 2 = 89%
LFO 2 > LEVEL 1 = 48%
ENV 2 > POS 1 = 42%
CV 1 > POS 1 = -41.5%
LFO 1 > POS 1 = 25%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.6%

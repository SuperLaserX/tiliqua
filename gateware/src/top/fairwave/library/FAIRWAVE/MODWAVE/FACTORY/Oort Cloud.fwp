FAIRWAVE PATCH 1
NAME  = OORT CLOUD
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Oort Cloud by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Stereo Spectrum.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/EF/616C9D0B.WAV
READ = SAMPLE
TUNE = -30
FINE = 28
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/6D/6175DC61.WAV
READ = CLEAN
TUNE = 0
POS = 21.1%

[ENV 1]
GATE = GATE 1
ATTACK = 693.333 MS
DECAY = 28.593 S
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 21.920 S
SUSTAIN = 0%
RELEASE = 896.000 MS
A CURVE = 30
D CURVE = 50
R CURVE = 60

[LFO 2]
RATE = 3.785 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 58%
CV 1 > POS 2 = -35%
ENV 2 > PITCH 1 = -0.5%
LFO 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 60.9%

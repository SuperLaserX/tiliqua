FAIRWAVE PATCH 1
NAME  = METALLURGY BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Metallurgy Bass #9 by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 6 unison voices, modulation processors, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Metallurgy Bass 9, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6C/12EBB0D1.WAV
READ = CLEAN
TUNE = -24
POS = 4.6%

[OSC 2]
TABLE = MODWAVE/T/BC/687C55A7.WAV
READ = CLEAN
TUNE = -24
POS = 4.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 572.000 MS
SUSTAIN = 75%
RELEASE = 3.896 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 17.333 MS
DECAY = 1.536 S
SUSTAIN = 32%
RELEASE = 3.185 S
A CURVE = 90
D CURVE = 40
R CURVE = 60

[LFO 2]
RATE = 1.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 90.5%
ENV 2 > POS 2 = 90.5%
CV 1 > POS 1 = -7.5%
CV 1 > POS 2 = -7.5%
LFO 2 > POS 1 = 4%
LFO 2 > POS 2 = 4%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 61.6%

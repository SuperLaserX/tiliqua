FAIRWAVE PATCH 1
NAME  = ROBO CHOIR SPLIT
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Robo Choir Split by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along blend.
# Oscillator 2 is B's 2, the sample Vox: Choir Ooh.
# Not carried over: 11 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, the sub oscillator.
# Its effects, which FairWave hasn't got: Easy Comp, Easy Go.
[OSC 1]
TABLE = MODWAVE/T/8A/347A2C88.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/29/F5DF1DD2.WAV
READ = SAMPLE
TUNE = -30
FINE = 20
POS = 0.0%
EDGE = WRAP
LOOP = 27.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 6.708 S
DECAY = 70.521 S
SUSTAIN = 92%
RELEASE = 966.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 54.7%

[LFO 1]
RATE = 0.010 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.019 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
LFO 2 > POS 1 = 50%
LFO 2 > LEVEL 2 = -32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 43.7%

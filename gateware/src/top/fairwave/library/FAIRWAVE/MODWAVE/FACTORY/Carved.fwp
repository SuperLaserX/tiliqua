FAIRWAVE PATCH 1
NAME  = CARVED
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Carved by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/4 HPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/1F/6777D264.WAV
READ = CLEAN
TUNE = -12
POS = 27.1%

[OSC 2]
TABLE = MODWAVE/T/BC/5F83762A.WAV
READ = CLEAN
TUNE = -12
POS = 25.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 62.667 MS
SUSTAIN = 61%
RELEASE = 10.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 34%
RELEASE = 680.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.333 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 3.765 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 49%
ENV 2 > POS 1 = 46%
CV 1 > POS 1 = -45%
CV 1 > POS 2 = -42.5%
ENV 2 > POS 2 = 35%
LFO 1 > POS 1 = 30%
CV 2 > POS 1 = 25%
LFO 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.6%

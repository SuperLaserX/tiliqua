FAIRWAVE PATCH 1
NAME  = TREM VOX
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Trem Vox by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Vox_WS:Choir.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/D2/DA79E3C5.WAV
READ = CLEAN
TUNE = -12
FINE = -16
POS = 43.1%

[OSC 2]
TABLE = MODWAVE/T/C2/31FBA70A.WAV
READ = SAMPLE
TUNE = -31
FINE = 12
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 10.037 S
SUSTAIN = 75%
RELEASE = 4.084 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 788.000 MS
DECAY = 3.844 S
SUSTAIN = 16%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 1.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -72%
LFO 1 > X DEPTH = 51%
ENV 2 > POS 1 = 14%
LFO 2 > POS 1 = 13.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 79.9%

FAIRWAVE PATCH 1
NAME  = BILLY'S NIGHTMAR
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Billy's Nightmare by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Syn: Texture Elly 1.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 1, performance modulators, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Billy's Nmare Pad, Billy's Nmare Sync, Inharmonic Twang, Mid Crunch, Synth Lead Sweep 2, Vintage.
[OSC 1]
TABLE = MODWAVE/T/03/F36DB1E8.WAV
READ = CLEAN
TUNE = -24
POS = 15.4%

[OSC 2]
TABLE = MODWAVE/T/CB/8172CAB1.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.295 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 69%
ENV 2 > POS 1 = -26%
CV 1 > POS 1 = 25.5%
LFO 1 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.0%

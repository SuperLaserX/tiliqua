FAIRWAVE PATCH 1
NAME  = VIBRANT BELL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Vibrant Bell by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stereo EP Chorus, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/44/A42D64AC.WAV
READ = CLEAN
TUNE = 0
POS = 19.8%

[OSC 2]
TABLE = MODWAVE/T/E9/CA4242FF.WAV
READ = CLEAN
TUNE = 12
POS = 19.8%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 1.741 S
SUSTAIN = 0%
RELEASE = 1.720 S
A CURVE = 30
D CURVE = 40
R CURVE = 40
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.300 S
SUSTAIN = 0%
RELEASE = 2.679 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 60.5%
CV 2 > POS 2 = 60.5%
ENV 2 > POS 1 = -59.5%
ENV 2 > POS 2 = -59.5%
CV 1 > POS 1 = 33%
CV 1 > POS 2 = 33%
LFO 1 > LEVEL 1 = 8%
LFO 1 > LEVEL 2 = 8%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.3%

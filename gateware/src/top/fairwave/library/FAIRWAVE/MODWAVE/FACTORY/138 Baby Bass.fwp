FAIRWAVE PATCH 1
NAME  = 138 BABY BASS
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's 138 Baby Bass by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: 138 Baby Bass, Kaoss Y Sweep+Add Low.
[OSC 1]
TABLE = MODWAVE/T/A4/AFA789AD.WAV
READ = CLEAN
TUNE = -36
FINE = -11
POS = 21.7%

[OSC 2]
TABLE = MODWAVE/T/A4/AFA789AD.WAV
READ = CLEAN
TUNE = -36
FINE = 11
POS = 21.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 74.667 MS
SUSTAIN = 100%
RELEASE = 32.000 MS
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 184.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36%
CV 1 > POS 2 = -36%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

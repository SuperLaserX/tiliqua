FAIRWAVE PATCH 1
NAME  = SLOPPY BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Sloppy Bass by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Nylon Guitar 1 f.
# Oscillator 2 is A's 2, the sample Gtr: Steel Guitar f.
# Not carried over: 6 unison voices, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Sloppy Bass, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/36/199348C7.WAV
READ = SAMPLE
TUNE = -15
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 93.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/47/6DF9197D.WAV
READ = SAMPLE
TUNE = -22
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 93.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.600 S
SUSTAIN = 0%
RELEASE = 500.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 95.7%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 83%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 28.5%

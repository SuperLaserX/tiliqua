FAIRWAVE PATCH 1
NAME  = ARCADE DREAM
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Arcade Dream by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along morph.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: 6 unison voices, layer A oscillator 1, layer A oscillator 2, the sub oscillator.
# Its effects, which FairWave hasn't got: Arcade Dream Blips, Arcade Dream Pad.
[OSC 1]
TABLE = MODWAVE/T/6E/CC3A9A20.WAV
READ = CLEAN
TUNE = 12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/7B/D36197CF.WAV
READ = CLEAN
TUNE = -12
POS = 65.3%

[ENV 1]
GATE = GATE 1
ATTACK = 945.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 100.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.248 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > LEVEL 1 = 9%
LFO 2 > LEVEL 2 = 9%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.4%

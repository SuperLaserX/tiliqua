FAIRWAVE PATCH 1
NAME  = BELLISIMO
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Bellisimo by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, its wavetable.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Sine2Pad I, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/F6/85E5C84A.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/EA/9FF49B4A.WAV
READ = CLEAN
TUNE = -12
POS = 41.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 568.000 MS
SUSTAIN = 0%
RELEASE = 588.000 MS
A CURVE = 30
D CURVE = 100
R CURVE = 100
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 12.000 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 100
R CURVE = 0

[LFO 1]
RATE = 1.248 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 151%
ENV 2 > POS 2 = 137%
LFO 1 > POS 2 = 26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.9%

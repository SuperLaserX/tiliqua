FAIRWAVE PATCH 1
NAME  = CASSINI
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cassini by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, the sample Cym: Chinese Gong.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Biegerish Bass, Cassini Cloud, Lost Satellite.
[OSC 1]
TABLE = MODWAVE/T/96/AC5B638C.WAV
READ = CLEAN
TUNE = 31
POS = 20.2%

[OSC 2]
TABLE = MODWAVE/T/90/54663542.WAV
READ = SAMPLE
TUNE = -41
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 50.9%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 432.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 497.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 89.623 S
DECAY = 38.980 S
SUSTAIN = 50%
RELEASE = 925.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 0.167 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
ENV 2 > POS 1 = 59.5%
CV 1 > POS 1 = -33.5%
LFO 2 > POS 1 = 31%
CV 2 > POS 1 = 18%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 1.1%

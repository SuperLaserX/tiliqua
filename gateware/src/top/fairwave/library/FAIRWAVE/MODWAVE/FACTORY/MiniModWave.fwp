FAIRWAVE PATCH 1
NAME  = MINIMODWAVE
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's MiniModWave by Airwave: backup1.mwbackup.
# 0 V plays what its C2 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: 16ths - 3,5,6 Knb2->Fdbk, Mini MW Bass, Mini MW Noise, Step Chill Bass.
[OSC 1]
TABLE = MODWAVE/T/FC/CC6CD466.WAV
READ = CLEAN
TUNE = -48
FINE = -10
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/0C/FC815EC1.WAV
READ = CLEAN
TUNE = -36
FINE = 10
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 724.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 74.5%
CV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
ENV 2 > POS 1 = 19.5%
ENV 2 > POS 2 = 19.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.9%

FAIRWAVE PATCH 1
NAME  = CHIME PAD
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Chime Pad by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/59/B7DAC984.WAV
READ = CLEAN
TUNE = -24
POS = 26.0%

[OSC 2]
TABLE = MODWAVE/T/F7/BF62BE29.WAV
READ = CLEAN
TUNE = -12
POS = 26.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 39.584 S
SUSTAIN = 36%
RELEASE = 1.731 S
A CURVE = 30
D CURVE = 60
R CURVE = 90
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.572 S
SUSTAIN = 0%
RELEASE = 2.663 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 48%
ENV 2 > POS 2 = 48%
CV 1 > POS 1 = -43.5%
CV 1 > POS 2 = -43.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 29.1%

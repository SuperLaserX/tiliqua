FAIRWAVE PATCH 1
NAME  = STRUNG & BLOWN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Strung & Blown by Korg: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample E.Piano: Mark V velo.1.
# Oscillator 2 is B's 2, the sample Str: Cello & Violin Ens..
# Not carried over: layer A oscillator 1, layer A oscillator 2, the sub oscillator.
# Its effects, which FairWave hasn't got: bpm Old Tape.
[OSC 1]
TABLE = MODWAVE/T/04/2F9267D3.WAV
READ = SAMPLE
TUNE = -12
POS = 0.0%
EDGE = WRAP
LOOP = 98.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/89/B5EF544E.WAV
READ = SAMPLE
TUNE = -13
FINE = -15
POS = 0.0%
EDGE = WRAP
LOOP = 43%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

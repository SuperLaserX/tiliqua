FAIRWAVE PATCH 1
NAME  = FRANSITORIZED
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Fransitorized by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, layer A oscillator 2, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, DTMF Organ, Pulsariffic, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/5B/EA4435AB.WAV
READ = CLEAN
TUNE = 12
FINE = -2
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/5A/58A42FAD.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 52.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.667 MS
SUSTAIN = 23%
RELEASE = 90.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.333 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
CV 1 > POS 2 = -49.5%
CV 1 > POS 1 = -21%
LFO 1 > POS 2 = 20.5%
LFO 1 > POS 1 = 10.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 86.8%

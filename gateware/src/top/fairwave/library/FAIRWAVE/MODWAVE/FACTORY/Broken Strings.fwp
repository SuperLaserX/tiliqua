FAIRWAVE PATCH 1
NAME  = BROKEN STRINGS
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Broken Strings by Rodier: backup1.mwbackup.
# 0 V plays what its C1 key plays.
# Oscillator 1 is A's 1, the sample Gtr: Nylon Guitar 1 f.
# Oscillator 2 is A's 2, the sample Gtr: Steel Guitar f.
# Not carried over: 13 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Endless Plucks, Sloppy Bass, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A5/D2B71A5F.WAV
READ = SAMPLE
TUNE = -5
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 94.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/35/85CFC7B7.WAV
READ = SAMPLE
TUNE = -10
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 93.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 60.000 MS
DECAY = 90.000 S
SUSTAIN = 78%
RELEASE = 500.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 88.7%

[LFO 1]
RATE = 0.833 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 14%
LFO 1 > LEVEL 2 = 14%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 76.1%

FAIRWAVE PATCH 1
NAME  = FOR MANKIND
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's For Mankind by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is A's 2, the sample Vox_WS:"OO" Vox.
# Not carried over: an LFO past the three here, layer B oscillator 1, layer B oscillator 2, performance modulators, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: Billy's Nmare Sync, For Mankind Choir, For Mankind Pulse, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/DA/68FBF694.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/47/30D669B9.WAV
READ = SAMPLE
TUNE = -20
FINE = -26
POS = 0.0%
EDGE = WRAP
LOOP = 38.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.868 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.464 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 59.3%

[LFO 1]
RATE = 0.500 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 93.9%

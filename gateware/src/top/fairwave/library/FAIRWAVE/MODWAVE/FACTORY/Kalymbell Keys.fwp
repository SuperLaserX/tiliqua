FAIRWAVE PATCH 1
NAME  = KALYMBELL KEYS
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's Kalymbell Keys by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/4 HPF, Smile Curve.
[OSC 1]
TABLE = MODWAVE/T/03/B6C002D3.WAV
READ = CLEAN
TUNE = -12
POS = 18.9%

[OSC 2]
TABLE = MODWAVE/T/EB/628FB263.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 18.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 64.000 MS
SUSTAIN = 81%
RELEASE = 666.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62.5%
ENV 2 > POS 2 = 62.5%
CV 1 > POS 1 = -31.5%
CV 1 > POS 2 = -31.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.8%

FAIRWAVE PATCH 1
NAME  = MOONSCAPE FROM I
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Moonscape From ISS by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Syn: Texture Elly 1.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: layer A oscillator 1, layer A oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5, AutoWobble Bass, DTMF Organ, Moonscape Pad, Smile Curve, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2F/C1868FA0.WAV
READ = SAMPLE
TUNE = 6
FINE = -33
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E1/54130326.WAV
READ = CLEAN
TUNE = 24
POS = 72.5%

[ENV 1]
GATE = GATE 1
ATTACK = 405.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 6.451 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 58.3%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

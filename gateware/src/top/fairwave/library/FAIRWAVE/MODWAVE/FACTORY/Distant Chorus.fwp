FAIRWAVE PATCH 1
NAME  = DISTANT CHORUS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Distant Chorus by AGeldert: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Noise AL-1 7.
# Oscillator 2 is A's 2, the sample Syn: Noise AL-1 2.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: 2 unison voices, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Distant Chorus, Talking Modulator.
[OSC 1]
TABLE = MODWAVE/T/EB/B17CFC2D.WAV
READ = SAMPLE
TUNE = -18
FINE = 26
POS = 0.0%
EDGE = WRAP
LOOP = 0.8%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/ED/7CBA069B.WAV
READ = SAMPLE
TUNE = -18
FINE = 24
POS = 0.0%
EDGE = WRAP
LOOP = 14%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 138.667 MS
DECAY = 15.240 S
SUSTAIN = 70%
RELEASE = 382.667 MS
A CURVE = 80
D CURVE = 50
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 3.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = -4.5%
LFO 1 > LEVEL 2 = -4.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 21.4%

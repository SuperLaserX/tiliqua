FAIRWAVE PATCH 1
NAME  = MINDFULNESS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Mindfulness by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, performance modulators, the noise generator, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bad Beta Wobble, Made4 Slow Pads, Mindful Air, Mindful Motion, Polysix Ensemble, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/D8/E13CB3BA.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[OSC 2]
TABLE = MODWAVE/T/C2/3B60C403.WAV
READ = CLEAN
TUNE = 7
POS = 15.3%

[ENV 1]
GATE = GATE 1
ATTACK = 1.607 S
DECAY = 1.760 S
SUSTAIN = 100%
RELEASE = 3.045 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 43.6%

[LFO 1]
RATE = 0.384 HZ
SHAPE = RANDOM
PHASE = 100
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 69.5%
CV 2 > POS 2 = 69.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
LFO 1 > POS 1 = 13.5%
LFO 1 > POS 2 = 13.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 58.5%

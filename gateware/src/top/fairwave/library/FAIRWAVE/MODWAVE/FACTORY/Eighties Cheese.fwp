FAIRWAVE PATCH 1
NAME  = EIGHTIES CHEESE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Eighties Cheese by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample E.Piano: VPM 5.
# Oscillator 2 is B's 2, the sample Wave: Pulse LoFi 125.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: Billy's Nmare Sync, Inharmonic Twang, OberKase, Oberjump.
[OSC 1]
TABLE = MODWAVE/T/C8/CB6D246A.WAV
READ = SAMPLE
TUNE = -4
FINE = -32
POS = 0.0%
EDGE = WRAP
LOOP = 66.7%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/58/35E536CA.WAV
READ = SAMPLE
TUNE = -7
FINE = 35
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 58%
RELEASE = 846.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.7%

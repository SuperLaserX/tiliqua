FAIRWAVE PATCH 1
NAME  = CATHEDRAL PAD
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cathedral Pad by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Cathedral Pad, GEQ Wide Flat.
[OSC 1]
TABLE = MODWAVE/T/13/C061CBA2.WAV
READ = CLEAN
TUNE = -12
POS = 9.6%

[OSC 2]
TABLE = MODWAVE/T/DA/F6F5DC17.WAV
READ = CLEAN
TUNE = -12
POS = 21.3%

[ENV 1]
GATE = GATE 1
ATTACK = 2.103 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 80
VCA = BOTH

[LFO 1]
RATE = 0.067 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.169 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 42.5%
LFO 2 > POS 2 = 35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 66.5%

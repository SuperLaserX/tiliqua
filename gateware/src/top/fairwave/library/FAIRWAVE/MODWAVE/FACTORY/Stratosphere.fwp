FAIRWAVE PATCH 1
NAME  = STRATOSPHERE
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Stratosphere by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 6 unison voices, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Stratosphere, bpm Tape 3-Head, bpm Thin 1/8 Swoosh.
[OSC 1]
TABLE = MODWAVE/T/45/0F284819.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 21.5%

[OSC 2]
TABLE = MODWAVE/T/D6/D102A59E.WAV
READ = CLEAN
TUNE = -7
POS = 21.5%

[ENV 1]
GATE = GATE 1
ATTACK = 858.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.772 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.380 S
DECAY = 18.087 S
SUSTAIN = 50%
RELEASE = 3.515 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 4.145 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57%
ENV 2 > POS 2 = 57%
CV 1 > POS 1 = -36%
CV 1 > POS 2 = -36%
LFO 2 > POS 1 = 2.5%
LFO 2 > POS 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.6%

FAIRWAVE PATCH 1
NAME  = DEEP SEA GHOSTS
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deep Sea Ghosts by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample FX: Applause.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: 6 unison voices, layer A oscillator 1, layer A oscillator 2, the noise generator.
# Its effects, which FairWave hasn't got: Deep Sea Grit, Deep Sea Voices, Inharmonic Twang, Mangled, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/1E/BCB4073F.WAV
READ = SAMPLE
TUNE = -37
FINE = 31
POS = 0.0%
EDGE = WRAP
LOOP = 27.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/43/31103606.WAV
READ = CLEAN
TUNE = -24
POS = 37.4%

[ENV 1]
GATE = GATE 1
ATTACK = 68.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.775 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 50.0%

[ENV 2]
GATE = GATE 1
ATTACK = 20.167 S
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 70
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 0.428 HZ
SHAPE = TRI
PHASE = 49
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 86.5%
LFO 1 > POS 2 = 16.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.2%

FAIRWAVE PATCH 1
NAME  = GROUND KICK
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ground Kick by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is B's 1, the sample Drm: Kick Hip 2.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Ground Sub Bass, Noise Kick.
[OSC 1]
TABLE = MODWAVE/T/B5/F1627297.WAV
READ = CLEAN
TUNE = -24
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/64/9F671210.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 140.000 MS
DECAY = 948.000 MS
SUSTAIN = 100%
RELEASE = 974.667 MS
A CURVE = 100
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 24.9%

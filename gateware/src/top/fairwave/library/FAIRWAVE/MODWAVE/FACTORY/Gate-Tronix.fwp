FAIRWAVE PATCH 1
NAME  = GATE-TRONIX
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gate-Tronix by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Electro Beatz, GateTronix, GateTronix Beat, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/82/1A5D88D2.WAV
READ = CLEAN
TUNE = 12
POS = 31.4%

[OSC 2]
TABLE = MODWAVE/T/EE/6CEF04AF.WAV
READ = CLEAN
TUNE = 0
POS = 31.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 60.000 MS
SUSTAIN = 82%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 77.333 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 3]
RATE = 0.533 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 52.5%
CV 1 > POS 2 = 52.5%
ENV 2 > POS 1 = 37%
ENV 2 > POS 2 = 37%
LFO 3 > POS 1 = 7%
LFO 3 > POS 2 = 7%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.4%

FAIRWAVE PATCH 1
NAME  = ORGANELLE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Organelle by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Organ_WS: Organ 1.
# Oscillator 2 is B's 2, the sample Organ: Reed.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 250_500_750ms DDL, Organic Pad, Paddish Organ, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/96/3E1C3547.WAV
READ = SAMPLE
TUNE = -17
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 33.4%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/64/43DF6D5C.WAV
READ = SAMPLE
TUNE = -42
FINE = 40
POS = 0.0%
EDGE = WRAP
LOOP = 12.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 76.000 MS
SUSTAIN = 69%
RELEASE = 142.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = -10.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.6%

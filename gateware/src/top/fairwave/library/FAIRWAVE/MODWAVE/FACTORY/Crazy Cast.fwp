FAIRWAVE PATCH 1
NAME  = CRAZY CAST
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Crazy Cast by TO: backup1.mwbackup.
# 0 V plays what its C1 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, layer A oscillator 2, layer B oscillator 1, the mod wheel's scaling of a modulation, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: 1000ms, Crazy Cast Bass, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9B/A80F89E6.WAV
READ = CLEAN
TUNE = -60
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/6A/F8312091.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 3 > LEVEL 2 = 42%
LFO 1 > POS 2 = 37.5%
CV 1 > POS 1 = -31.5%
LFO 1 > POS 1 = 31%
CV 1 > POS 2 = 20.5%
LFO 3 > LEVEL 1 = -20%
ENV 2 > POS 1 = 18%
ENV 2 > POS 2 = 14.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.0%

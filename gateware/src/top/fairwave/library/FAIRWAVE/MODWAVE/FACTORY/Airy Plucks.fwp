FAIRWAVE PATCH 1
NAME  = AIRY PLUCKS
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Airy Plucks by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Wave: Sine.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Airy Plucks, Inharmonic Twang, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/41/BCABE068.WAV
READ = SAMPLE
TUNE = -3
FINE = -48
POS = 0.0%
EDGE = WRAP
LOOP = 11.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/3B/BF360EA0.WAV
READ = CLEAN
TUNE = 12
POS = 42.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 416.000 MS
SUSTAIN = 17%
RELEASE = 3.576 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 33.333 MS
SUSTAIN = 0%
RELEASE = 994.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -70%
ENV 2 > POS 2 = 16%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.2%

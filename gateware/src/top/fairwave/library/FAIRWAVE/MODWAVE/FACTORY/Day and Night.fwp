FAIRWAVE PATCH 1
NAME  = DAY AND NIGHT
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Day and Night by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Syn_WS: Synbass1.
# Oscillator 2 is B's 2, the sample Syn: Reso Poly6 2.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Night, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/A9/3EB4C524.WAV
READ = SAMPLE
TUNE = -12
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 69.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/15/AF0F3E27.WAV
READ = SAMPLE
TUNE = -3
FINE = -16
POS = 0.0%
EDGE = WRAP
LOOP = 35.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 64.013 S
SUSTAIN = 70%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 4.000 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 6%
LFO 1 > PITCH 2 = 6%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 30.6%

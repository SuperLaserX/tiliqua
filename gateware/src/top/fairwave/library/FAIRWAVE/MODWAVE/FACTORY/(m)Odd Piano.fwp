FAIRWAVE PATCH 1
NAME  = (M)ODD PIANO
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's (m)Odd Piano by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Syn: Bass/Lead DSP Metal.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0B/94ECFD48.WAV
READ = CLEAN
TUNE = 24
POS = 20.5%

[OSC 2]
TABLE = MODWAVE/T/0C/CC5D425F.WAV
READ = SAMPLE
TUNE = -4
FINE = -26
POS = 0.0%
EDGE = WRAP
LOOP = 62%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.439 S
SUSTAIN = 0%
RELEASE = 1.711 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 18.667 MS
DECAY = 4.839 S
SUSTAIN = 0%
RELEASE = 3.017 S
A CURVE = 30
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59%
CV 1 > POS 1 = -34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

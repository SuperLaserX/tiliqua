FAIRWAVE PATCH 1
NAME  = RHYTHMATIKA
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rhythmatika by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Phaseticker, Pulsariffic, Slowchug Lead.
[OSC 1]
TABLE = MODWAVE/T/7D/95C92FDA.WAV
READ = CLEAN
TUNE = -24
POS = 29.7%

[OSC 2]
TABLE = MODWAVE/T/3B/86EAD5D4.WAV
READ = CLEAN
TUNE = -12
POS = 29.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 112.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 49.5%
CV 1 > POS 2 = 49.5%
ENV 2 > POS 1 = 40.5%
ENV 2 > POS 2 = 40.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.9%

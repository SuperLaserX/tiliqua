FAIRWAVE PATCH 1
NAME  = SLOMO SHOCK
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's SloMo Shock by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, layer B oscillator 1, layer B oscillator 2, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Cross DDL 1, Slow Mo Shock Low.
[OSC 1]
TABLE = MODWAVE/T/77/4649FCDF.WAV
READ = CLEAN
TUNE = -12
FINE = 19
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/9A/B7B014E6.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.589 S
SUSTAIN = 51%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 59.2%

[ENV 2]
GATE = GATE 1
ATTACK = 14.607 S
DECAY = 90.000 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.299 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 2]
RATE = 0.010 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 76%
LFO 2 > LEVEL 2 = 76%
LFO 1 > POS 1 = 31.5%
LFO 1 > POS 2 = 31.5%
CV 1 > POS 1 = 31%
CV 1 > POS 2 = 31%
ENV 2 > POS 1 = 17%
ENV 2 > POS 2 = 17%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 52.6%

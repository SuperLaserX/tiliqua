FAIRWAVE PATCH 1
NAME  = TRIP ARP
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Trip Arp by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/4 HPF, Mix Pop, Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F6/DFBD937A.WAV
READ = CLEAN
TUNE = -12
POS = 30.4%

[OSC 2]
TABLE = MODWAVE/T/2D/DBFDD56B.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 62.667 MS
SUSTAIN = 61%
RELEASE = 10.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 6%
RELEASE = 3.235 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.400 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 3.765 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -50.5%
CV 2 > POS 1 = 39.5%
LFO 1 > POS 2 = 32%
ENV 2 > POS 1 = 31%
CV 1 > POS 2 = -30%
LFO 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 77.8%

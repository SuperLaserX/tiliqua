FAIRWAVE PATCH 1
NAME  = DECI DUB BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deci Dub Bass by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Deci Dub Bass, Grime Bass.
[OSC 1]
TABLE = MODWAVE/T/D4/C1C2597D.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/7C/A89892A0.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 100%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[LFO 1]
RATE = 3.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
LFO 1 > POS 2 = 43.5%
LFO 2 > POS 2 = 25%
CV 1 > POS 2 = 11%
ENV 2 > POS 2 = 4%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

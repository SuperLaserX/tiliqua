FAIRWAVE PATCH 1
NAME  = HAWKINS MASSACRE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Hawkins Massacre by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Hawkins Massacre, Hawkins Noise, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/B4/CD06DB07.WAV
READ = CLEAN
TUNE = -12
POS = 17.2%

[OSC 2]
TABLE = MODWAVE/T/FC/E7E43DF6.WAV
READ = CLEAN
TUNE = -12
POS = 17.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 138.667 MS
SUSTAIN = 87%
RELEASE = 38.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 246.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
CV 2 > POS 1 = 65.5%
CV 2 > POS 2 = 65.5%
ENV 2 > POS 1 = 46.5%
ENV 2 > POS 2 = 46.5%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.6%

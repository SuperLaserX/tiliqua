FAIRWAVE PATCH 1
NAME  = MASH LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mash Lead by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Aggressive Mix.
[OSC 1]
TABLE = MODWAVE/T/2E/76C9BF50.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/60/EED67B00.WAV
READ = CLEAN
TUNE = -12
POS = 33.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 100
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 110.667 MS
DECAY = 449.333 MS
SUSTAIN = 39%
RELEASE = 40.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 1 > POS 2 = -56.5%
ENV 2 > POS 2 = 32%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 26.6%

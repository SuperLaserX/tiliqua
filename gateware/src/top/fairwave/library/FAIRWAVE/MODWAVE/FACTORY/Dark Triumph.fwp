FAIRWAVE PATCH 1
NAME  = DARK TRIUMPH
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dark Triumph by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Str_Guru: Denali Cello.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Cathedral Pad, Dark Triumph Bass, Dark Triumph Buzz, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BF/C2ECDAEA.WAV
READ = SAMPLE
TUNE = -30
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 35.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/62/E0DF3217.WAV
READ = CLEAN
TUNE = -24
POS = 72.3%

[ENV 1]
GATE = GATE 1
ATTACK = 65.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 52.2%

[LFO 1]
RATE = 0.326 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > X DEPTH = 24.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.2%

FAIRWAVE PATCH 1
NAME  = UNE SOURIS MEURT
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Une Souris Meurt by Airwave: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 2, the noise generator.
# Its effects, which FairWave hasn't got: Souris Bass Pulse, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/CE/71F25EDB.WAV
READ = CLEAN
TUNE = -36
POS = 24.6%

[OSC 2]
TABLE = MODWAVE/T/4A/B845C9F4.WAV
READ = CLEAN
TUNE = -17
POS = 24.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 96.000 MS
SUSTAIN = 46%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 4.267 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 51%
CV 2 > POS 2 = 51%
CV 1 > POS 1 = -41%
CV 1 > POS 2 = -41%
LFO 1 > POS 1 = 34%
LFO 1 > POS 2 = 34%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.7%

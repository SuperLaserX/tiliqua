FAIRWAVE PATCH 1
NAME  = ONE LITTLE MARTI
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's One Little Martian (MW) by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 2 unison voices, layer A oscillator 2, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1 Lil Martian A, 10 Cycle.
[OSC 1]
TABLE = MODWAVE/T/04/8AD4DF34.WAV
READ = CLEAN
TUNE = -12
POS = 36.4%

[OSC 2]
TABLE = MODWAVE/T/1A/26A59277.WAV
READ = CLEAN
TUNE = 0
POS = 36.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 60.5%
CV 1 > POS 2 = 60.5%
CV 2 > POS 1 = 27.5%
CV 2 > POS 2 = 27.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.3%

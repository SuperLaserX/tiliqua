FAIRWAVE PATCH 1
NAME  = DIGI MOTION
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Digi Motion by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Digi Motion S&H, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/15/4371BC96.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/1C/DFA91A25.WAV
READ = CLEAN
TUNE = 0
POS = 44.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 84.000 MS
SUSTAIN = 100%
RELEASE = 38.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.311 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 1.733 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = 91%
LFO 1 > LEVEL 1 = 69%
LFO 1 > LEVEL 2 = 69%
LFO 2 > POS 1 = 50%
CV 2 > POS 2 = 11%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.7%

FAIRWAVE PATCH 1
NAME  = TECHNO SEVENTHS
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Techno Sevenths by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Sine2Pad I, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/1F/B577B901.WAV
READ = CLEAN
TUNE = -24
POS = 43.7%

[OSC 2]
TABLE = MODWAVE/T/85/10251B6C.WAV
READ = CLEAN
TUNE = -5
POS = 43.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 94.667 MS
SUSTAIN = 50%
RELEASE = 43.725 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = 73%
CV 1 > POS 2 = 73%
ENV 2 > POS 1 = 12.5%
ENV 2 > POS 2 = 12.5%
CV 2 > POS 1 = -5.5%
CV 2 > POS 2 = -5.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 42.0%

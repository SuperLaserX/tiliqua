FAIRWAVE PATCH 1
NAME  = COOL SHADES
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Cool Shades by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Cool Shades Pad, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/4C/504F0FB5.WAV
READ = CLEAN
TUNE = 12
POS = 19.9%

[OSC 2]
TABLE = MODWAVE/T/3F/E01CC544.WAV
READ = CLEAN
TUNE = 12
FINE = 4
POS = 19.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 25.884 S
SUSTAIN = 25%
RELEASE = 2.972 S
A CURVE = 30
D CURVE = 50
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.589 S
SUSTAIN = 0%
RELEASE = 3.756 S
A CURVE = 30
D CURVE = 50
R CURVE = 60

[LFO 3]
RATE = 3.185 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 60%
ENV 2 > POS 2 = 60%
CV 1 > POS 1 = -33%
CV 1 > POS 2 = -33%
LFO 3 > PITCH 2 = 0.5%
ENV 2 > PITCH 2 = -0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.6%

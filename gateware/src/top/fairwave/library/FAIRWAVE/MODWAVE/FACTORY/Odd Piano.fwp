FAIRWAVE PATCH 1
NAME  = ODD PIANO
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Odd Piano by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Airchime.
# Not carried over: 3 unison voices, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F9/DB7BBB85.WAV
READ = CLEAN
TUNE = -12
POS = 24.7%

[OSC 2]
TABLE = MODWAVE/T/5C/85D98701.WAV
READ = SAMPLE
TUNE = -48
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 10.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 11.245 S
SUSTAIN = 0%
RELEASE = 616.000 MS
A CURVE = 30
D CURVE = 40
R CURVE = 80
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 18.667 MS
DECAY = 3.235 S
SUSTAIN = 29%
RELEASE = 2.240 S
A CURVE = 30
D CURVE = 40
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50.5%
CV 1 > POS 1 = -41%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 4.6%

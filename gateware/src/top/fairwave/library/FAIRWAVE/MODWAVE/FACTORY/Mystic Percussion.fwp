FAIRWAVE PATCH 1
NAME  = MYSTIC PERCUSSIO
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Mystic Percussion by AGeldert: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Biegerish Bass, Tribal Drums.
[OSC 1]
TABLE = MODWAVE/T/00/E8019F9E.WAV
READ = CLEAN
TUNE = 0
FINE = 15
POS = 13.5%

[OSC 2]
TABLE = MODWAVE/T/CF/8BAA038F.WAV
READ = CLEAN
TUNE = -3
FINE = -45
POS = 13.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 300.000 MS
SUSTAIN = 0%
RELEASE = 1.400 S
A CURVE = 30
D CURVE = 70
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 6.1%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 100.000 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 30
R CURVE = 60

[LFO 1]
RATE = 4.200 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 73%
ENV 2 > POS 2 = 73%
ENV 2 > X DEPTH = 30%
CV 1 > POS 1 = -22.5%
CV 1 > POS 2 = -22.5%
LFO 1 > X DEPTH = 2%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

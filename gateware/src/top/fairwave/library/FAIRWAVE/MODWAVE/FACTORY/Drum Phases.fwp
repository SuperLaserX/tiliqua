FAIRWAVE PATCH 1
NAME  = DRUM PHASES
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Drum Phases by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Prc_WS: LogDrmLoop.
# Oscillator 2 is A's 2, the sample Prc_WS: LogDrmLoop.
# Not carried over: 7 unison voices, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Drum Phase 2 A, Drum Phase 2 B, Inharmonic Twang, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2E/2EF86856.WAV
READ = SAMPLE
TUNE = -22
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C4/0E2AE060.WAV
READ = SAMPLE
TUNE = -10
FINE = -25
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 402.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.3%

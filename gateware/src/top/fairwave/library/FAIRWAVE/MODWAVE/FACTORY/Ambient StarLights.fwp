FAIRWAVE PATCH 1
NAME  = AMBIENT STARLIGH
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ambient StarLights by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is B's 1, the sample Wave: DWGS Sine 2.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, layer B oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Ambient Clouds, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/89/13065755.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/E1/E902FA61.WAV
READ = SAMPLE
TUNE = 12
FINE = -1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 609.333 MS
DECAY = 3.812 S
SUSTAIN = 66%
RELEASE = 168.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 85.8%

FAIRWAVE PATCH 1
NAME  = CRYSTALGAZER
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Crystalgazer by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Str: String Ensemble 2.
# Oscillator 2 is B's 2, the sample Syn: Air Vox.
# Not carried over: 3 unison voices, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Airstrings, Cathedral Pad, Inharmonic Twang.
[OSC 1]
TABLE = MODWAVE/T/63/B5EF2A96.WAV
READ = SAMPLE
TUNE = -18
FINE = 27
POS = 0.0%
EDGE = WRAP
LOOP = 37.9%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/9B/0A084AB3.WAV
READ = SAMPLE
TUNE = -14
FINE = 34
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 90.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.736 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 12.6%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.3%

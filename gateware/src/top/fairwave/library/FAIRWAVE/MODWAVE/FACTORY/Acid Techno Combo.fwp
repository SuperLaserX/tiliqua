FAIRWAVE PATCH 1
NAME  = ACID TECHNO COMB
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Acid Techno Combo by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Acid Techno Beat, Acid Techno Buzz, Drum Squasher.
[OSC 1]
TABLE = MODWAVE/T/B9/825A7248.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/0B/97C33C31.WAV
READ = CLEAN
TUNE = -5
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.788 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 8.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = 100%
CV 2 > LEVEL 2 = 100%
CV 1 > POS 1 = -53.5%
CV 1 > POS 2 = -53.5%
LFO 1 > LEVEL 1 = 40%
LFO 1 > LEVEL 2 = 40%
LFO 2 > POS 1 = 18%
LFO 2 > POS 2 = 18%
ENV 2 > POS 1 = 11%
ENV 2 > POS 2 = 11%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 34.8%

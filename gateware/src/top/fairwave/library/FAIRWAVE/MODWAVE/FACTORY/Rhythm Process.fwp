FAIRWAVE PATCH 1
NAME  = RHYTHM PROCESS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Rhythm Process by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Processed Dirt.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 LPF, 1/8 - 1/8 dot LPF, Midnight Choir, Rhythm Process.
[OSC 1]
TABLE = MODWAVE/T/3A/4100B620.WAV
READ = SAMPLE
TUNE = -44
FINE = 42
POS = 0.0%
EDGE = WRAP
LOOP = 38.3%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E6/3CB54459.WAV
READ = CLEAN
TUNE = 0
POS = 17.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 701.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 65.5%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 75.6%

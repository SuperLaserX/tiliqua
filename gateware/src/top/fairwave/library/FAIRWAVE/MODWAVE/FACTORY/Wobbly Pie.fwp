FAIRWAVE PATCH 1
NAME  = WOBBLY PIE
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Wobbly Pie by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/4 HPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/5A/4AA20B3C.WAV
READ = CLEAN
TUNE = -12
FINE = 24
POS = 26.2%

[OSC 2]
TABLE = MODWAVE/T/6E/B28482C6.WAV
READ = CLEAN
TUNE = -12
FINE = -26
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 6.667 MS
DECAY = 804.000 MS
SUSTAIN = 93%
RELEASE = 10.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 98.667 MS
DECAY = 449.333 MS
SUSTAIN = 34%
RELEASE = 3.409 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.833 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 3.765 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 47.5%
CV 1 > POS 1 = -43.5%
LFO 1 > POS 1 = 38%
CV 2 > POS 2 = 37%
CV 1 > POS 2 = -34%
ENV 2 > POS 1 = 34%
LFO 1 > POS 2 = 29.5%
ENV 2 > POS 2 = 26.5%
LFO 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.3%

FAIRWAVE PATCH 1
NAME  = YEAH-YAH
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Yeah-Yah by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Yeah/Yah.
[OSC 1]
TABLE = MODWAVE/T/21/959E98FC.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/58/89ECC8C7.WAV
READ = CLEAN
TUNE = 30
FINE = 29
POS = 76.5%

[ENV 1]
GATE = GATE 1
ATTACK = 57.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 89.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 100.0%

[ENV 2]
GATE = GATE 1
ATTACK = 5.333 MS
DECAY = 264.000 MS
SUSTAIN = 0%
RELEASE = 77.333 MS
A CURVE = 0
D CURVE = 100
R CURVE = 0

[LFO 1]
RATE = 5.096 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
CV 2 > LEVEL 1 = -77%
CV 2 > LEVEL 2 = -77%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 59.7%

FAIRWAVE PATCH 1
NAME  = COMPLEX ARRAY
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Complex Array by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Cabinets Machine, Complexity Pad, Inharmonic Twang, Slow Phaser, bpm Mband Up Chor, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/6F/A3E73001.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/4A/EB0C0B2F.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 2.477 S
DECAY = 44.128 S
SUSTAIN = 43%
RELEASE = 596.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.167 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > LEVEL 1 = -100%
LFO 3 > LEVEL 1 = 63%
LFO 3 > LEVEL 2 = 63%
LFO 1 > POS 1 = 50%
LFO 1 > POS 2 = 50%
CV 2 > LEVEL 2 = 17%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 25.9%

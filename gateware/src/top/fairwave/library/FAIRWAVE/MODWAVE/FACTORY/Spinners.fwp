FAIRWAVE PATCH 1
NAME  = SPINNERS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Spinners by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, an LFO past the three here, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Spinners, Stereo Chorus, bpm Rush More.
[OSC 1]
TABLE = MODWAVE/T/81/DC64306F.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/F9/14B85303.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 60.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.199 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 8.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 2 > LEVEL 2 = 100%
LFO 3 > LEVEL 1 = 50%
LFO 3 > LEVEL 2 = 50%
LFO 1 > POS 1 = 40.5%
LFO 1 > POS 2 = 40.5%
CV 1 > POS 1 = -16%
CV 1 > POS 2 = -16%
ENV 2 > POS 1 = 6.5%
ENV 2 > POS 2 = 6.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 56.5%

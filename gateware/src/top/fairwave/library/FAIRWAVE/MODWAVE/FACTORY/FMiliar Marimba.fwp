FAIRWAVE PATCH 1
NAME  = FMILIAR MARIMBA
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's FMiliar Marimba by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Desert Walking, FMarimba, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/8D/697B085E.WAV
READ = CLEAN
TUNE = 28
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/78/E17908F4.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 368.000 MS
SUSTAIN = 0%
RELEASE = 246.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 438.667 MS
SUSTAIN = 0%
RELEASE = 3.373 S
A CURVE = 0
D CURVE = 100
R CURVE = 50

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 145%
ENV 2 > X DEPTH = 26.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

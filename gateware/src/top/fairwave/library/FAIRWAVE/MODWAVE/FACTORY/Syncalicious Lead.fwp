FAIRWAVE PATCH 1
NAME  = SYNCALICIOUS LEA
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Syncalicious Lead by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is B's 2, the sample Syn_Guru: Dub Chunk 09.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Modern Compressor, RingMod Maca B, Stereo Chorus, Syncalicious L Yay, bpm Old Tape.
[OSC 1]
TABLE = MODWAVE/T/9C/27152497.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/1C/B99FBBE6.WAV
READ = SAMPLE
TUNE = -6
FINE = 23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 53.0%

FAIRWAVE PATCH 1
NAME  = MANTRA VIBES
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Mantra Vibes by Airwave: backup1.mwbackup.
# 0 V plays what its C1 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Texture Elly 1.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5, Giant Low Bass, Mantra Vibes Bass, Mantra Vibes Gate.
[OSC 1]
TABLE = MODWAVE/T/63/7BD54A3B.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/DC/DA40BE88.WAV
READ = SAMPLE
TUNE = -48
FINE = 2
POS = 0.0%
EDGE = WRAP
LOOP = 40.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 0.417 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 6.667 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > X DEPTH = 100%
LFO 2 > LEVEL 2 = 100%
LFO 1 > POS 1 = 39%
CV 1 > POS 1 = -18.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 72.1%

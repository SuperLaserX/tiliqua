FAIRWAVE PATCH 1
NAME  = ALLIGATOR DIALS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Alligator Dials by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Alligatorz, Glowing Eyes, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/33/0B4042FC.WAV
READ = CLEAN
TUNE = -12
FINE = -3
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/BE/99F629FE.WAV
READ = CLEAN
TUNE = -24
FINE = 3
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 362.667 MS
SUSTAIN = 66%
RELEASE = 808.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 1.082 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 3]
RATE = 1.082 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 3 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 47.7%

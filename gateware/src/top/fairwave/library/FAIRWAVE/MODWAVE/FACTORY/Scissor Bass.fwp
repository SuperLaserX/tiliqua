FAIRWAVE PATCH 1
NAME  = SCISSOR BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Scissor Bass by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Electro Beatz, Scissor Bass.
[OSC 1]
TABLE = MODWAVE/T/C1/30641602.WAV
READ = CLEAN
TUNE = -36
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/4B/C9E4C4A7.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 60.000 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.199 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 38.5%
LFO 1 > POS 2 = 38.5%
LFO 2 > LEVEL 1 = 33%
LFO 2 > LEVEL 2 = 33%
CV 1 > POS 1 = -19.5%
CV 1 > POS 2 = -19.5%
LFO 2 > POS 1 = 16%
LFO 2 > POS 2 = 16%
ENV 2 > POS 1 = 8%
ENV 2 > POS 2 = 8%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.0%

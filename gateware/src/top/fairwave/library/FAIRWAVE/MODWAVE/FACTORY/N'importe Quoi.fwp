FAIRWAVE PATCH 1
NAME  = N'IMPORTE QUOI
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's N'importe Quoi by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: 16ths - 2,3,5 B, 16ths - 2,4,5, Alligatorz, N'importe Noise, N'importe Rumble, Slow LFO Drone.
[OSC 1]
TABLE = MODWAVE/T/0E/BC6B0D4F.WAV
READ = STEPS
TUNE = 12
FINE = 44
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/66/50F1026B.WAV
READ = CLEAN
TUNE = -12
POS = 76.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 5.333 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 55.5%
LFO 1 > PITCH 2 = 55.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 92.9%

FAIRWAVE PATCH 1
NAME  = AMBIOTIC
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ambiotic by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Cross DDL 1, Modern Compressor, Sine2Pad I, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/0C/F34EFC84.WAV
READ = CLEAN
TUNE = -24
FINE = -2
POS = 23.2%

[OSC 2]
TABLE = MODWAVE/T/87/CA45ADE2.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 23.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 474.667 MS
SUSTAIN = 75%
RELEASE = 76.000 MS
A CURVE = 0
D CURVE = 100
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 1.361 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.667 HZ
SHAPE = TRI
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = -83.5%
LFO 1 > POS 2 = -83.5%
ENV 2 > POS 1 = 53.5%
ENV 2 > POS 2 = 53.5%
CV 2 > POS 1 = -50%
CV 2 > POS 2 = -50%
CV 1 > POS 1 = 38.5%
CV 1 > POS 2 = 38.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.9%

FAIRWAVE PATCH 1
NAME  = UPBEAT PULSES
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's UpBeat Pulses by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along blend.
# Oscillator 2 is B's 1, the sample Drm_Guru: Kick Trance.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot HPF, Inharmonic Twang, Modern Compressor, PEQ Mid, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AC/3E6EF7D2.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/C7/F8DCCBA2.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 13.180 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 1.067 HZ
SHAPE = SQUARE
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.0%

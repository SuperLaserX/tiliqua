FAIRWAVE PATCH 1
NAME  = 5TH PADS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's 5th Pads by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, bpm Long 1.
[OSC 1]
TABLE = MODWAVE/T/5D/D8B640CD.WAV
READ = CLEAN
TUNE = -5
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/EF/25D03EE8.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 565.333 MS
SUSTAIN = 26%
RELEASE = 2.424 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 400.000 MS
SUSTAIN = 9%
RELEASE = 3.176 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 2]
RATE = 1.009 HZ
SHAPE = SINE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -43%
CV 1 > POS 2 = -43%
ENV 2 > POS 1 = 39%
ENV 2 > POS 2 = 39%
LFO 1 > POS 1 = 24.5%
LFO 1 > POS 2 = 24.5%
LFO 2 > LEVEL 1 = -3%
LFO 2 > LEVEL 2 = -3%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 46.5%

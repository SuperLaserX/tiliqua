FAIRWAVE PATCH 1
NAME  = GATES TO ROSE GA
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Gates To Rose Garden by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Syn: Texture Elly 1.
# Not carried over: layer B oscillator 1, layer B oscillator 2, the sub oscillator.
# Its effects, which FairWave hasn't got: Rose Garden Pad, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/42/E61F3487.WAV
READ = CLEAN
TUNE = 24
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/FE/2949E213.WAV
READ = SAMPLE
TUNE = -43
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 190.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.885 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 30.8%

[LFO 1]
RATE = 0.179 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 14.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

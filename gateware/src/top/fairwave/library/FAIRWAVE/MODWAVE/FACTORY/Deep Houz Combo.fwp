FAIRWAVE PATCH 1
NAME  = DEEP HOUZ COMBO
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Deep Houz Combo by Airwave: backup1.mwbackup.
# 0 V plays what its F2 key plays.
# Oscillator 1 is A's 1, the sample Bell: Poly Pipe.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, layer B oscillator 1, layer B oscillator 2, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: Bad Beta Wobble, Deep Houz Bass, Deep Houz Chord, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/99/4D30542F.WAV
READ = SAMPLE
TUNE = -17
FINE = -5
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C9/C6571107.WAV
READ = CLEAN
TUNE = -24
POS = 17.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 832.000 MS
SUSTAIN = 5%
RELEASE = 449.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 39.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 217.333 MS
SUSTAIN = 0%
RELEASE = 605.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 66%
CV 1 > POS 2 = -28.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

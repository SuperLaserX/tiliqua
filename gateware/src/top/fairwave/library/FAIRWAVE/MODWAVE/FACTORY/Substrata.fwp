FAIRWAVE PATCH 1
NAME  = SUBSTRATA
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Substrata by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along position.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Pianotable, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/20/9019767F.WAV
READ = CLEAN
TUNE = -5
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/38/159FFBCB.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 992.000 MS
DECAY = 64.013 S
SUSTAIN = 47%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
LFO 2 > LEVEL 1 = 76%
LFO 2 > LEVEL 2 = 76%
LFO 1 > POS 2 = 35%
CV 1 > POS 2 = -24.5%
ENV 2 > POS 2 = 20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 17.8%

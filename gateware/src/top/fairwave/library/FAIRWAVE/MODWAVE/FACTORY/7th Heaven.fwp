FAIRWAVE PATCH 1
NAME  = 7TH HEAVEN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 7th Heaven by Korg: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Wnd_Guru: Pan Flute 3.
# Not carried over: layer A oscillator 1, layer B oscillator 1, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Slow & Warm, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/A6/1C2AF426.WAV
READ = CLEAN
TUNE = -12
POS = 26.4%

[OSC 2]
TABLE = MODWAVE/T/61/A0C2F06A.WAV
READ = SAMPLE
TUNE = -48
FINE = 15
POS = 0.0%
EDGE = WRAP
LOOP = 51.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 413.333 MS
SUSTAIN = 0%
RELEASE = 806.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 47.5%
CV 1 > POS 1 = -44%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.4%

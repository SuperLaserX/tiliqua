FAIRWAVE PATCH 1
NAME  = ELLY'S PADS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Elly's Pads by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Syn: Texture Elly 2.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer A oscillator 1, layer B oscillator 2, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5, Billy's Nmare Sync, Electrik Kooltest, Elly's Pads A.
[OSC 1]
TABLE = MODWAVE/T/7B/AB034E14.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 25.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/CD/E83B861B.WAV
READ = CLEAN
TUNE = -12
POS = 26.7%

[ENV 1]
GATE = GATE 1
ATTACK = 908.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.631 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 46.5%
CV 1 > POS 2 = -44.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 83.4%

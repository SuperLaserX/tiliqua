FAIRWAVE PATCH 1
NAME  = REVWIRE MOTIONSC
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's RevWire MotionScape by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Str_Guru: Denali Cello.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/C4/03860681.WAV
READ = CLEAN
TUNE = 0
POS = 16.8%

[OSC 2]
TABLE = MODWAVE/T/E1/571BB87B.WAV
READ = SAMPLE
TUNE = -30
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 44.6%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 61.333 MS
DECAY = 25.000 S
SUSTAIN = 9%
RELEASE = 90.667 MS
A CURVE = 30
D CURVE = 0
R CURVE = 100
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 36.517 S
SUSTAIN = 9%
RELEASE = 421.333 MS
A CURVE = 30
D CURVE = 10
R CURVE = 100

[LFO 1]
RATE = 8.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 0.373 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 73%
LFO 2 > LEVEL 2 = 67%
ENV 2 > POS 1 = 66.5%
CV 1 > POS 1 = -28%
ENV 2 > PITCH 1 = -10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 35.3%

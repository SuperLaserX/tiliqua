FAIRWAVE PATCH 1
NAME  = GET READY FOR TH
ABOUT = SFX FROM MODWAVE. GATE 1, CV 1

# From the modwave's Get Ready For That by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample FX: Verre Casse.
# Oscillator 2 is A's 2, the sample Hit: Orch 1.
# Not carried over: 2 unison voices, layer B oscillator 1, layer B oscillator 2, modulation processors, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: Flashy Wah Knob 3, Glass Orch Hit, Stereo Chorus, Use Your Words, Whoosh Hit.
[OSC 1]
TABLE = MODWAVE/T/3B/2A7E95A5.WAV
READ = SAMPLE
TUNE = -19
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/97/26685228.WAV
READ = SAMPLE
TUNE = -22
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 10.777 S
SUSTAIN = 0%
RELEASE = 954.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > X DEPTH = 100%
CV 2 > LEVEL 1 = -100%
CV 2 > PITCH 1 = 40%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 62.4%

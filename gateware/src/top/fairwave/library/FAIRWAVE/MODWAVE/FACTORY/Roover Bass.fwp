FAIRWAVE PATCH 1
NAME  = ROOVER BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Roover Bass by Richard Devine: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, a table made along morph.
# Not carried over: 5 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Roover Upbeat, bpm Growth.
[OSC 1]
TABLE = MODWAVE/T/95/E0435DCE.WAV
READ = CLEAN
TUNE = -48
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/56/0AFF3C2E.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 80.500 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.375 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
LFO 2 > POS 2 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 68.5%

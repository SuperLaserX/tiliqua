FAIRWAVE PATCH 1
NAME  = GIFT ORGAN
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Gift Organ by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/4 HPF, Gift Organ, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9D/180E3805.WAV
READ = STEPS
TUNE = 0
FINE = 1
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/EE/E291C89A.WAV
READ = STEPS
TUNE = 24
POS = 49.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.276 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 30.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.5%

FAIRWAVE PATCH 1
NAME  = TECHNO SCIENCE
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Techno Science by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along position.
# Oscillator 2 is B's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Bass Squasher, Clavi Chorus, Drum Squasher, Mono 1/4 note dly, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/C1/66EFC9EE.WAV
READ = CLEAN
TUNE = -36
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/3E/7F4811B8.WAV
READ = CLEAN
TUNE = -36
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 494.667 MS
SUSTAIN = 0%
RELEASE = 40.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 5.827 S
SUSTAIN = 61%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.4%

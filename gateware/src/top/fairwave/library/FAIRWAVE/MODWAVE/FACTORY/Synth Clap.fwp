FAIRWAVE PATCH 1
NAME  = SYNTH CLAP
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Synth Clap by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, the sample Syn: Noise AL-1 1.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: 2 unison voices, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Synth Clap.
[OSC 1]
TABLE = MODWAVE/T/2D/23E7597A.WAV
READ = CLEAN
TUNE = 24
POS = 18.8%

[OSC 2]
TABLE = MODWAVE/T/0B/DB724D05.WAV
READ = SAMPLE
TUNE = -18
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 61.7%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 201.333 MS
SUSTAIN = 0%
RELEASE = 109.333 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 82.667 MS
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 100
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > X DEPTH = 100%
ENV 2 > POS 1 = 62.5%
CV 1 > POS 1 = 31.5%
ENV 2 > LEVEL 1 = 31%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

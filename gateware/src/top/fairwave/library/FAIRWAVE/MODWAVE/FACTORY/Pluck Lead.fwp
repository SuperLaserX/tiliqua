FAIRWAVE PATCH 1
NAME  = PLUCK LEAD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pluck Lead by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is the other half of its 2 unison voices.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Pluck Lead, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/02/B807E073.WAV
READ = CLEAN
TUNE = 14
FINE = -9
POS = 28.2%

[OSC 2]
TABLE = MODWAVE/T/02/B807E073.WAV
READ = CLEAN
TUNE = 14
FINE = 9
POS = 28.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 733.333 MS
SUSTAIN = 0%
RELEASE = 585.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 754.667 MS
SUSTAIN = 19%
RELEASE = 977.333 MS
A CURVE = 30
D CURVE = 100
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -47%
CV 1 > POS 2 = -47%
ENV 2 > POS 1 = 43.5%
ENV 2 > POS 2 = 43.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

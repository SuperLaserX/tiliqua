FAIRWAVE PATCH 1
NAME  = REPLICANT
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Replicant by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: Ethereal Grit, Replicant, Soft Orchestral, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/1F/04F1F4B0.WAV
READ = CLEAN
TUNE = 0
POS = 21.2%

[OSC 2]
TABLE = MODWAVE/T/C3/D4640CA9.WAV
READ = CLEAN
TUNE = 0
FINE = 4
POS = 21.2%

[ENV 1]
GATE = GATE 1
ATTACK = 181.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 924.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 89.333 MS
DECAY = 738.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 0
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57.5%
ENV 2 > POS 2 = 57.5%
CV 1 > POS 1 = -35.5%
CV 1 > POS 2 = -35.5%
CV 2 > POS 1 = 29%
CV 2 > POS 2 = 29%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 33.3%

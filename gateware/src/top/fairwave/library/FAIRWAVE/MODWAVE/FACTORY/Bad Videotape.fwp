FAIRWAVE PATCH 1
NAME  = BAD VIDEOTAPE
ABOUT = PIANO/KEYS FROM MODWAVE. GATE 1, C

# From the modwave's Bad Videotape by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Piano: Acoustic Damper.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, the noise generator, the sub oscillator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Bad Beta Grit, Bad Beta Wobble, Modern Compressor, Sine2Pad I, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FE/5A5D2B46.WAV
READ = SAMPLE
TUNE = -5
FINE = 18
POS = 0.0%
EDGE = WRAP
LOOP = 0.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/E3/3D49A6C7.WAV
READ = CLEAN
TUNE = 31
POS = 18.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.215 S
A CURVE = 0
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 44.2%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 341.333 MS
SUSTAIN = 0%
RELEASE = 3.521 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 62.5%
ENV 2 > X DEPTH = 57.5%
CV 1 > POS 2 = 31.5%
LFO 1 > PITCH 1 = 1%
LFO 1 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

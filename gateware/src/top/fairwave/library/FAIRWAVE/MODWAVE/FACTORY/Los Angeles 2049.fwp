FAIRWAVE PATCH 1
NAME  = LOS ANGELES 2049
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Los Angeles 2049 by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Texture Elly 1.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: layer B oscillator 2, modulation processors, performance modulators, the noise generator, the sub oscillator.
# Its effects, which FairWave hasn't got: AutoWobble Bass, LA 2049 Gentle Pad, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/89/3D15B81E.WAV
READ = SAMPLE
TUNE = -43
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 19.2%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/C3/C17930ED.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 13.8%

[ENV 1]
GATE = GATE 1
ATTACK = 3.140 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.107 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 2 = 72.5%
CV 1 > POS 2 = -23%
ENV 2 > POS 2 = 3.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.7%

FAIRWAVE PATCH 1
NAME  = NEBULA
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Nebula by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along morph.
# Oscillator 2 is B's 2, its wavetable.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Nebulocity, Use Your Words.
[OSC 1]
TABLE = MODWAVE/T/A8/02D0E061.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/FC/98D92131.WAV
READ = CLEAN
TUNE = -12
FINE = 2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 71.2%

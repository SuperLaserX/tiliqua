FAIRWAVE PATCH 1
NAME  = READY SET ACTION
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Ready Set Action  by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, the sample Syn: Airmetal.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: Action Hit & Hats, Action Scene Blips, Lost Satellite.
[OSC 1]
TABLE = MODWAVE/T/94/D47DAD43.WAV
READ = CLEAN
TUNE = 24
FINE = 2
POS = 48.2%

[OSC 2]
TABLE = MODWAVE/T/9B/EFBED8E1.WAV
READ = SAMPLE
TUNE = -6
FINE = 25
POS = 0.0%
EDGE = WRAP
LOOP = 19.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 81.333 MS
SUSTAIN = 3%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 0.0%

[LFO 1]
RATE = 10.059 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 2.5%
LFO 1 > PITCH 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 86.1%

FAIRWAVE PATCH 1
NAME  = GRAND PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Grand Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along position.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: 16ths - 3,4,6, Electric Pad.
[OSC 1]
TABLE = MODWAVE/T/06/2E551BA2.WAV
READ = CLEAN
TUNE = 7
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/9F/A277CF6E.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 802.667 MS
DECAY = 80.500 S
SUSTAIN = 59%
RELEASE = 121.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 90.000 S
SUSTAIN = 22%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 84.2%

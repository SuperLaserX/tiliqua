FAIRWAVE PATCH 1
NAME  = CHEEZE WALLACE
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Cheeze Wallace by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, layer A oscillator 1, layer B oscillator 1, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Cheeze Wallace, Tape Chug Even, Tape Chug Flipped.
[OSC 1]
TABLE = MODWAVE/T/7B/1E001C53.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/64/944FD591.WAV
READ = CLEAN
TUNE = 7
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 713.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 881.333 MS
SUSTAIN = 0%
RELEASE = 90.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.0%

FAIRWAVE PATCH 1
NAME  = GLITTER TALKS
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Glitter Talks by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 4 unison voices, controllers, random and Kaoss Physics, layer B oscillator 2, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Glitter Talk Drone, Slow LFO Drone, Stereo Chorus, bpm Pattern 1.
[OSC 1]
TABLE = MODWAVE/T/E6/C3B87C8A.WAV
READ = CLEAN
TUNE = 0
FINE = -13
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/05/B67F5F1E.WAV
READ = CLEAN
TUNE = -12
POS = 22.3%

[ENV 1]
GATE = GATE 1
ATTACK = 702.667 MS
DECAY = 90.000 S
SUSTAIN = 0%
RELEASE = 3.824 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 72.572 S
SUSTAIN = 0%
RELEASE = 3.783 S
A CURVE = 30
D CURVE = 0
R CURVE = 0

[LFO 2]
RATE = 6.370 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 75%
ENV 2 > POS 2 = 55.5%
CV 1 > POS 2 = -37%
CV 1 > POS 1 = 21%
ENV 2 > PITCH 1 = 3%
ENV 2 > PITCH 2 = 3%
LFO 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 61.1%

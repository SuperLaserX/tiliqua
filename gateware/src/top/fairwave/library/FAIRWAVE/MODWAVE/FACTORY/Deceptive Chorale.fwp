FAIRWAVE PATCH 1
NAME  = DECEPTIVE CHORAL
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's Deceptive Chorale by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along position.
# Oscillator 2 is B's 1, the sample Vox_WS:Choir.
# Not carried over: 3 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 1, layer B oscillator 2, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Crunchchoir, Deceptichoir, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/9C/1BF55885.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/85/FCCCDF87.WAV
READ = SAMPLE
TUNE = -19
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 2.3%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 50%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.4%

FAIRWAVE PATCH 1
NAME  = LOWRES BITBASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's LowRes BitBass by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, modulation processors, performance modulators.
# Its effects, which FairWave hasn't got: Junk Jam Low, LowRes Bitz.
[OSC 1]
TABLE = MODWAVE/T/B0/8585547C.WAV
READ = CLEAN
TUNE = -24
FINE = 1
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/A3/7A494B10.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 80.500 S
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
PHASE = 180
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 38.5%
LFO 1 > POS 2 = 38.5%
CV 1 > POS 1 = -19.5%
CV 1 > POS 2 = -19.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.6%

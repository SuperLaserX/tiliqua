FAIRWAVE PATCH 1
NAME  = TAPEOP LEAD (MOD
ABOUT = LEAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's TapeOp Lead (ModWhl) by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Inharmonic Twang, Tape Op ModWheel, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/CD/0FAD3EED.WAV
READ = CLEAN
TUNE = -12
FINE = 9
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/98/853C7C57.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 430.667 MS
SUSTAIN = 86%
RELEASE = 12.000 MS
A CURVE = 0
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 32.000 HZ
SHAPE = SQUARE
PHASE = 180
SYNC = GATE 1

[LFO 3]
RATE = 5.388 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 34%
LFO 1 > POS 2 = 34%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
LFO 3 > PITCH 1 = 1.5%
LFO 3 > PITCH 2 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 23.3%

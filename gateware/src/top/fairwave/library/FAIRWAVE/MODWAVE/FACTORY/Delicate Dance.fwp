FAIRWAVE PATCH 1
NAME  = DELICATE DANCE
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Delicate Dance by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Cym_WS: HiHat C.
# Oscillator 2 is B's 2, the sample Atk: Granular TambPlunge.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Inharmonic Twang, Slow Phaser, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/CB/D1040D12.WAV
READ = SAMPLE
TUNE = -25
FINE = -20
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/27/F370A69F.WAV
READ = SAMPLE
TUNE = -7
FINE = -23
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 645.333 MS
DECAY = 77.363 S
SUSTAIN = 82%
RELEASE = 1.335 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.995 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > PITCH 1 = 1.5%
LFO 1 > PITCH 2 = 1.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.4%

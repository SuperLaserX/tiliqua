FAIRWAVE PATCH 1
NAME  = DISTRO SPLIT "ME
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Distro Split "Metal" by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, the sample Drm: Kick Dance 11.
# On a modwave oscillator 1 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, layer A oscillator 1, layer B oscillator 1, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Choppa for Metal, Distro Metal, Odd Piano, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/AC/C4831913.WAV
READ = SAMPLE
TUNE = -13
FINE = 21
POS = 0.0%
EDGE = CLAMP
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/00/58E86289.WAV
READ = CLEAN
TUNE = -12
POS = 33.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 5.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.832 S
SUSTAIN = 0%
RELEASE = 48.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -56%
ENV 2 > POS 2 = 32.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.2%

FAIRWAVE PATCH 1
NAME  = DROID TALKER
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Droid Talker by YO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, a table made along position.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, performance modulators.
# Its effects, which FairWave hasn't got: Digi Motion S&H.
[OSC 1]
TABLE = MODWAVE/T/3D/9DAC09E4.WAV
READ = CLEAN
TUNE = 0
FINE = -4
POS = 33.9%

[OSC 2]
TABLE = MODWAVE/T/20/DEB599DF.WAV
READ = CLEAN
TUNE = 0
FINE = 1
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.147 S
DECAY = 4.467 S
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.586 HZ
SHAPE = SAW DN
SYNC = GATE 1

[LFO 3]
RATE = 3.766 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
ENV 2 > POS 1 = 75%
LFO 1 > POS 1 = -51%
LFO 3 > PITCH 1 = -0.5%
LFO 3 > PITCH 2 = -0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 10.8%

FAIRWAVE PATCH 1
NAME  = ORGAN, "AS IS" C
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Organ, "As Is" Condition by Rodier & Dan Phillips: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is A's 2, the sample Wave: Saw Chroma.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation, the sub oscillator.
# Its effects, which FairWave hasn't got: Organ As-Is, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/B2/4256BCD8.WAV
READ = CLEAN
TUNE = 0
FINE = 2
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/DA/37FB4377.WAV
READ = SAMPLE
TUNE = 0
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.227 S
SUSTAIN = 0%
RELEASE = 337.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 83.9%

[LFO 1]
RATE = 1.500 HZ
SHAPE = SQUARE
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 100%
LFO 1 > X DEPTH = 100%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 25.3%

FAIRWAVE PATCH 1
NAME  = WORLDSCAPE PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Worldscape Pad by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 5 unison voices, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator.
# Its effects, which FairWave hasn't got: Fast Chorus, Worldscape Pad.
[OSC 1]
TABLE = MODWAVE/T/B8/32CE4D0A.WAV
READ = CLEAN
TUNE = -12
POS = 26.1%

[OSC 2]
TABLE = MODWAVE/T/D7/78AE5A30.WAV
READ = CLEAN
TUNE = -24
POS = 21.9%

[ENV 1]
GATE = GATE 1
ATTACK = 2.464 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 3.669 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 3.483 S
DECAY = 449.333 MS
SUSTAIN = 100%
RELEASE = 3.263 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.247 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 56%
ENV 2 > POS 1 = 48%
CV 1 > POS 1 = -43.5%
CV 1 > POS 2 = -36.5%
LFO 1 > POS 1 = 9%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.0%

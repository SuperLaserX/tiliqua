FAIRWAVE PATCH 1
NAME  = ORGAN BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Organ Bass by Dan Phillips: backup1.mwbackup.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 16ths - 2,4,5.
[OSC 1]
TABLE = MODWAVE/T/81/3C954971.WAV
READ = CLEAN
TUNE = -36
FINE = -3
POS = 25.2%

[OSC 2]
TABLE = MODWAVE/T/81/F6957A28.WAV
READ = CLEAN
TUNE = -24
FINE = 4
POS = 25.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 64.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 232.000 MS
SUSTAIN = 37%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 49.5%
ENV 2 > POS 2 = 49.5%
CV 1 > POS 1 = -42%
CV 1 > POS 2 = -42%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.4%

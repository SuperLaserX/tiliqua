FAIRWAVE PATCH 1
NAME  = GLOW GESTURES (H
ABOUT = GTR/PLUCKED FROM MODWAVE. GATE 1, 

# From the modwave's Glow Gestures (Hold) by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, its wavetable.
# Oscillator 2 is B's 2, a table made along morph.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: 1/8 dotted LPF, Glow Drone, Inharmonic Twang, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/A1/D6D62F56.WAV
READ = CLEAN
TUNE = -24
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/38/B9273672.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 1.919 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.995 HZ
SHAPE = SQUARE
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > POS 2 = 50%
LFO 1 > PITCH 1 = 10%
LFO 1 > PITCH 2 = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.6%

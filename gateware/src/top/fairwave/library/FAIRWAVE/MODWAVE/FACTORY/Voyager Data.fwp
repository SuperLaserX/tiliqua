FAIRWAVE PATCH 1
NAME  = VOYAGER DATA
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Voyager Data by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, its wavetable.
# Oscillator 2 is B's 2, the sample Syn: Air Vox.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Odd Piano, Stereo Chorus, Voyager Pad B.
[OSC 1]
TABLE = MODWAVE/T/80/FC901920.WAV
READ = CLEAN
TUNE = 12
POS = 39.1%

[OSC 2]
TABLE = MODWAVE/T/17/C2201E48.WAV
READ = SAMPLE
TUNE = -2
FINE = 34
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 12.953 S
SUSTAIN = 0%
RELEASE = 3.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 1.540 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.1%

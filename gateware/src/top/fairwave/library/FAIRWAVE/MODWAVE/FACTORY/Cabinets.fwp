FAIRWAVE PATCH 1
NAME  = CABINETS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Cabinets by Rodier: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along morph.
# Oscillator 2 is B's 1, a table made along cutoff.
# Not carried over: 3 unison voices, layer A oscillator 2, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Cabinets Machine, Kaoss Y Wah, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/62/D2051653.WAV
READ = CLEAN
TUNE = -24
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/DC/5553CEB6.WAV
READ = CLEAN
TUNE = -12
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 781.333 MS
DECAY = 284.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.808 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.083 HZ
SHAPE = SINE
SYNC = GATE 1

[LFO 3]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 69%
LFO 1 > POS 1 = 50%
LFO 2 > LEVEL 1 = 30%
CV 1 > POS 2 = -26%
LFO 3 > POS 2 = -8%
LFO 2 > PITCH 2 = 3%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.3%

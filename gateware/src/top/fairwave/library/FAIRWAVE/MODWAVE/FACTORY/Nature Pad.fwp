FAIRWAVE PATCH 1
NAME  = NATURE PAD
ABOUT = PAD FROM MODWAVE. GATE 1, CV 1

# From the modwave's Nature Pad by Richard Devine: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, the sample Syn: Lore.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, controllers, random and Kaoss Physics, layer A oscillator 1, layer A oscillator 2, performance modulators, the mod wheel's scaling of a modulation, the noise generator, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Slow Phaser, bpm Long 2.
[OSC 1]
TABLE = MODWAVE/T/88/499D263B.WAV
READ = SAMPLE
TUNE = -26
FINE = -6
POS = 0.0%
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/8A/FF28507E.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[ENV 1]
GATE = GATE 1
ATTACK = 646.667 MS
DECAY = 1.927 S
SUSTAIN = 54%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 1]
RATE = 0.995 HZ
SHAPE = RANDOM
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = RANDOM
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 2 = -81%
LFO 2 > POS 2 = 21%
LFO 1 > PITCH 1 = 10%
LFO 1 > PITCH 2 = 10%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 41.1%

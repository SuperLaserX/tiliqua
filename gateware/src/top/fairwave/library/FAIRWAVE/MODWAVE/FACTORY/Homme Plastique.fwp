FAIRWAVE PATCH 1
NAME  = HOMME PLASTIQUE
ABOUT = PERCUSSION FROM MODWAVE. GATE 1, C

# From the modwave's Homme Plastique by Airwave: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Syn: Noise AL-1 6.
# On a modwave oscillator 2 plays at one pitch on every key. It does at 0 V here, and CV 1 tunes it.
# Not carried over: layer A oscillator 1, performance modulators, the noise generator.
# Its effects, which FairWave hasn't got: 138 Baby Kick Hat, BPass Feedback BPM, Lost Satellite, Synth Techno Hat, Synth Techno Kick.
[OSC 1]
TABLE = MODWAVE/T/9B/9481E3D2.WAV
READ = CLEAN
TUNE = 48
POS = 15.8%

[OSC 2]
TABLE = MODWAVE/T/14/FCFDD6A6.WAV
READ = SAMPLE
TUNE = -30
FINE = 29
POS = 0.0%
EDGE = WRAP
LOOP = 6.2%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 0.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 49.3%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 68.5%
CV 1 > POS 1 = 26.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

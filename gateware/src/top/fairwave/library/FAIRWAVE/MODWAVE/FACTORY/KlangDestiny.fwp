FAIRWAVE PATCH 1
NAME  = KLANGDESTINY
ABOUT = VOCAL/AIRY FROM MODWAVE. GATE 1, C

# From the modwave's KlangDestiny by Peter Schwartz: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Oscillator 2 is B's 2, the sample Syn: Texture Elly 2.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics, layer A oscillator 1, layer B oscillator 1, modulation processors, performance modulators, the mod wheel's scaling of a modulation, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/BA/7AA1C576.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 24.2%

[OSC 2]
TABLE = MODWAVE/T/81/C2689697.WAV
READ = SAMPLE
TUNE = -31
FINE = -19
POS = 0.0%
EDGE = WRAP
LOOP = 25.1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 3.544 S
DECAY = 46.213 S
SUSTAIN = 0%
RELEASE = 27.244 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ENV 2]
GATE = GATE 1
ATTACK = 1.540 S
DECAY = 29.551 S
SUSTAIN = 0%
RELEASE = 10.712 S
A CURVE = 30
D CURVE = 30
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 51.5%
CV 1 > POS 1 = -40.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 32.6%

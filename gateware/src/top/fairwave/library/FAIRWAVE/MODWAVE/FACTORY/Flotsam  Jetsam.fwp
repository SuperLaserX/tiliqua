FAIRWAVE PATCH 1
NAME  = FLOTSAM & JETSAM
ABOUT = SEQ FROM MODWAVE. GATE 1, CV 1

# From the modwave's Flotsam & Jetsam by Francis Preve: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, layer B oscillator 1, layer B oscillator 2, performance modulators.
# Its effects, which FairWave hasn't got: Electrik Kooltest, Flotsam, Ring Note Follower, Sine2Pad I.
[OSC 1]
TABLE = MODWAVE/T/60/3C311E37.WAV
READ = CLEAN
TUNE = -10
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/D8/0D69F42D.WAV
READ = CLEAN
TUNE = -16
FINE = -13
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 8.4%

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW DN
PHASE = 180
SYNC = GATE 1

[LFO 2]
RATE = 2.667 HZ
SHAPE = SAW DN
PHASE = 357
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 2 > LEVEL 1 = 100%
LFO 1 > LEVEL 2 = 100%
LFO 1 > X DEPTH = 11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = STRINGS IN MEMOR
ABOUT = STRINGS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Strings in Memory by TO: backup1.mwbackup.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Lunatron Whistle, Polysix Ensemble, Strings In Memory.
[OSC 1]
TABLE = MODWAVE/T/B6/9C7C31D0.WAV
READ = CLEAN
TUNE = -12
POS = 25.5%

[OSC 2]
TABLE = MODWAVE/T/BE/5636A328.WAV
READ = CLEAN
TUNE = 0
POS = 25.5%

[ENV 1]
GATE = GATE 1
ATTACK = 1.616 S
DECAY = 976.000 MS
SUSTAIN = 71%
RELEASE = 2.700 S
A CURVE = 100
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > POS 1 = 49%
ENV 1 > POS 2 = 49%
CV 1 > POS 1 = -42.5%
CV 1 > POS 2 = -42.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.4%

FAIRWAVE PATCH 1
NAME  = ARP FREE RUNNING
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Free running Bass by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/AD/F697399C.WAV
READ = CLEAN
TUNE = -24
POS = 18.8%

[OSC 2]
TABLE = MODWAVE/T/38/60F815AC.WAV
READ = CLEAN
TUNE = -24
POS = 18.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 153.333 MS
SUSTAIN = 99%
RELEASE = 480.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 520.000 MS
SUSTAIN = 21%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.070 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62.5%
ENV 2 > POS 2 = 62.5%
CV 1 > POS 1 = -31%
CV 1 > POS 2 = -31%
LFO 1 > POS 1 = 20.5%
LFO 1 > POS 2 = 20.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = ARP PS MUTE TRUM
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP PS Mute Trumpet by Ian dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage.
[OSC 1]
TABLE = MODWAVE/T/E4/C8B37894.WAV
READ = CLEAN
TUNE = -12
POS = 16.9%

[OSC 2]
TABLE = MODWAVE/T/E4/C8B37894.WAV
TUNE = -12
POS = 16.9%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 81.333 MS
DECAY = 98.667 MS
SUSTAIN = 73%
RELEASE = 725.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 42.667 MS
DECAY = 15.447 S
SUSTAIN = 61%
RELEASE = 148.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 66%
CV 1 > POS 1 = -28%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

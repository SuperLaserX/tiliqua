FAIRWAVE PATCH 1
NAME  = SOLINA ESMB BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Solina Esmb Bass by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/D4/E192C0FE.WAV
READ = CLEAN
TUNE = -24
POS = 44.0%

[OSC 2]
TABLE = MODWAVE/T/DA/4D8A8617.WAV
READ = CLEAN
TUNE = -12
POS = 53.0%

[ENV 1]
GATE = GATE 1
ATTACK = 266.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 946.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 38.1%

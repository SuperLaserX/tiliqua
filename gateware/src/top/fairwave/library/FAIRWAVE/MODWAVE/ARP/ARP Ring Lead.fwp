FAIRWAVE PATCH 1
NAME  = ARP RING LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Ring Lead by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/9A/9C62CCC2.WAV
READ = CLEAN
TUNE = 0
POS = 15.4%

[OSC 2]
TABLE = MODWAVE/T/65/36F8BAE8.WAV
READ = CLEAN
TUNE = 0
POS = 15.4%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 400.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 53.2%

[ENV 2]
GATE = GATE 1
ATTACK = 50.667 MS
DECAY = 1.176 S
SUSTAIN = 56%
RELEASE = 270.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = ARP STEEL GUITAR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Steel Guitar by Ian dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Vintage.
[OSC 1]
TABLE = MODWAVE/T/BD/A06AC793.WAV
READ = CLEAN
TUNE = -12
POS = 16.9%

[OSC 2]
TABLE = MODWAVE/T/48/6885445A.WAV
READ = CLEAN
TUNE = -12
POS = 16.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 32%
RELEASE = 941.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 15.447 S
SUSTAIN = 61%
RELEASE = 249.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66%
ENV 2 > POS 2 = 66%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 80.9%

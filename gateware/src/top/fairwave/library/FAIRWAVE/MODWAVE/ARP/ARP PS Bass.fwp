FAIRWAVE PATCH 1
NAME  = ARP PS BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP PS Bass by Ian dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage, Vintage Tine EP Chorus.
[OSC 1]
TABLE = MODWAVE/T/EA/89661ACC.WAV
READ = CLEAN
TUNE = -24
POS = 16.3%

[OSC 2]
TABLE = MODWAVE/T/F5/7990A8B5.WAV
READ = CLEAN
TUNE = -12
POS = 16.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 48%
RELEASE = 42.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.200 S
SUSTAIN = 29%
RELEASE = 148.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 7.3%

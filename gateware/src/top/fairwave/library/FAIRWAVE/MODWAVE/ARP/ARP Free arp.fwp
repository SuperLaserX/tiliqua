FAIRWAVE PATCH 1
NAME  = ARP FREE ARP
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Free arp by Ian dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/E9/4568033E.WAV
READ = CLEAN
TUNE = 0
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/1B/73F167B0.WAV
READ = CLEAN
TUNE = 0
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 16.000 MS
DECAY = 1.363 S
SUSTAIN = 0%
RELEASE = 96.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.042 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 1 = 81.5%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

FAIRWAVE PATCH 1
NAME  = ARP A2600 ENSEMB
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP A2600 Ensemble by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: String Ensemble Sln.
# Oscillator 2 is A's 2, the sample Syn: Ensemble A2600.
# Its effects, which FairWave hasn't got: Modern Compressor, Suspenstrings, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/2E/7C00BC42.WAV
READ = SAMPLE
TUNE = -13
FINE = 22
POS = 0.0%
EDGE = WRAP
LOOP = 1.6%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/EE/FBA3516B.WAV
READ = SAMPLE
TUNE = -7
FINE = 45
POS = 0.0%
EDGE = WRAP
LOOP = 1%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 82.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 1.645 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[CROSS MOD]
MODE = AM
FROM = OSC 1
DEPTH = 0.0%

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = ARP RING MOD LEA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Ring Mod Lead by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 90, bpm Mband Bounce.
[OSC 1]
TABLE = MODWAVE/T/1E/59870C9B.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 12.7%

[OSC 2]
TABLE = MODWAVE/T/44/3FDEE26A.WAV
READ = CLEAN
TUNE = 0
POS = 12.7%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 325.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 43.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 39.397 S
SUSTAIN = 42%
RELEASE = 213.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 100.0%

FAIRWAVE PATCH 1
NAME  = ARP PHASED CHORD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Phased Chords by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/C2/9324CA2B.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 15.0%

[OSC 2]
TABLE = MODWAVE/T/34/EB3F1443.WAV
READ = CLEAN
TUNE = -12
FINE = 3
POS = 15.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.131 S
SUSTAIN = 0%
RELEASE = 78.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.715 S
SUSTAIN = 42%
RELEASE = 213.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70%
ENV 2 > POS 2 = 70%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = ARP 2600 RES ON
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP 2600 Res on Res by ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Reso A2600.
# Oscillator 2 is A's 2, the sample Syn: Reso A2600.
# Its effects, which FairWave hasn't got: Deep Slow Chor mono, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F9/CD96C16E.WAV
READ = SAMPLE
TUNE = -12
FINE = 1
POS = 0.0%
EDGE = WRAP
LOOP = 87.5%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/85/098C72FD.WAV
READ = SAMPLE
TUNE = -11
FINE = -5
POS = 0.0%
EDGE = WRAP
LOOP = 86.5%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 45.543 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 36.4%

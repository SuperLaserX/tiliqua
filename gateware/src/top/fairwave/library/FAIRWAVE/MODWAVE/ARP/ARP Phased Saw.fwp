FAIRWAVE PATCH 1
NAME  = ARP PHASED SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Phased Saw by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Orange Phase V2 100, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/10/06DC9278.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/B0/746C0CCB.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 0.0%

[ENV 1]
GATE = GATE 1
ATTACK = 197.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 917.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 1.000 S
DECAY = 1.000 S
SUSTAIN = 0%
RELEASE = 1.000 S
A CURVE = 0
D CURVE = 0
R CURVE = 0

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

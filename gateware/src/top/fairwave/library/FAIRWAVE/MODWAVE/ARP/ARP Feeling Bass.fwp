FAIRWAVE PATCH 1
NAME  = ARP FEELING BASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Feeling Bass by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Modern Compressor, Vintage Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F9/1856FBC7.WAV
READ = CLEAN
TUNE = -24
POS = 16.0%

[OSC 2]
TABLE = MODWAVE/T/14/7198FD4F.WAV
READ = CLEAN
TUNE = -24
POS = 16.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 153.333 MS
SUSTAIN = 99%
RELEASE = 480.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 489.333 MS
SUSTAIN = 21%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
ENV 2 > POS 2 = 68%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
LFO 1 > PITCH 2 = -0.5%
LFO 1 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 57.0%

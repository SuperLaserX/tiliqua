FAIRWAVE PATCH 1
NAME  = ARP WIND FLUTE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Wind Flute by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the noise generator.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/86/A4B1B5F8.WAV
READ = CLEAN
TUNE = -12
POS = 16.7%

[OSC 2]
TABLE = MODWAVE/T/2F/EEEEC0D3.WAV
READ = CLEAN
TUNE = 12
FINE = -6
POS = 16.7%

[ENV 1]
GATE = GATE 1
ATTACK = 197.333 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 917.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 66.5%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.7%

FAIRWAVE PATCH 1
NAME  = ARP 2600 RES STR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP 2600 Res Strings by ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, the sample Syn: Detuned A2600 II.
# Oscillator 2 is A's 2, the sample Syn: Detuned A2600 II.
# Its effects, which FairWave hasn't got: Fast Vintage Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/C7/77CDEFFC.WAV
READ = SAMPLE
TUNE = -6
FINE = -30
POS = 0.0%
EDGE = WRAP
LOOP = 53.1%
GRAIN = SYNC 3

[OSC 2]
TABLE = MODWAVE/T/2E/A70C38E6.WAV
READ = SAMPLE
TUNE = -18
FINE = -38
POS = 0.0%
EDGE = WRAP
LOOP = 1.8%
GRAIN = SYNC 3

[ENV 1]
GATE = GATE 1
ATTACK = 1.253 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 45.543 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

FAIRWAVE PATCH 1
NAME  = ARP DIST RING LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Dist Ring Lead by Ian dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Lead Rock Guitar, Orange Phase V2 100, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/73/1172E296.WAV
READ = CLEAN
TUNE = -12
POS = 16.9%

[OSC 2]
TABLE = MODWAVE/T/CA/BA30DDDB.WAV
READ = CLEAN
TUNE = 12
FINE = -13
POS = 16.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 40.4%

[ENV 2]
GATE = GATE 1
ATTACK = 73.333 MS
DECAY = 4.352 S
SUSTAIN = 25%
RELEASE = 846.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66.5%
ENV 2 > POS 2 = 66.5%
CV 1 > POS 1 = -28%
CV 1 > POS 2 = -28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

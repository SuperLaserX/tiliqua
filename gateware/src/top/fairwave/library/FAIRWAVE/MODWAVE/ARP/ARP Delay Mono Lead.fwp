FAIRWAVE PATCH 1
NAME  = ARP DELAY MONO L
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's ARP Delay Mono Lead by Ian Dixon: ARP.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/4 HPF, JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/2C/2CD35FC1.WAV
READ = CLEAN
TUNE = -12
FINE = -8
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/2C/2CD35FC1.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

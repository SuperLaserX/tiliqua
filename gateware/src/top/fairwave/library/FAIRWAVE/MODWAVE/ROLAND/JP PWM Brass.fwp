FAIRWAVE PATCH 1
NAME  = JP PWM BRASS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP PWM Brass by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/BB/55AAC751.WAV
READ = CLEAN
TUNE = 0
POS = 18.9%

[OSC 2]
TABLE = MODWAVE/T/94/B4A6CAE8.WAV
READ = CLEAN
TUNE = -12
POS = 18.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 88%
RELEASE = 1.313 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 61.333 MS
DECAY = 8.431 S
SUSTAIN = 0%
RELEASE = 1.216 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 62%
ENV 2 > POS 2 = 62%
CV 1 > POS 1 = -31.5%
CV 1 > POS 2 = -31.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 51.1%

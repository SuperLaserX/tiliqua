FAIRWAVE PATCH 1
NAME  = JUNO PIANO
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Piano by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/96/3C561944.WAV
READ = CLEAN
TUNE = -12
POS = 12.1%

[OSC 2]
TABLE = MODWAVE/T/96/3C561944.WAV
TUNE = -12
POS = 12.1%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 746.667 MS
SUSTAIN = 15%
RELEASE = 860.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.131 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > POS 1 = 86.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = JP AGED
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Aged by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/A9/4C912F30.WAV
READ = CLEAN
TUNE = 0
POS = 32.3%

[OSC 2]
TABLE = MODWAVE/T/87/9A997B2C.WAV
READ = CLEAN
TUNE = 12
FINE = 6
POS = 32.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 36.507 S
SUSTAIN = 2%
RELEASE = 1.661 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 21.333 MS
SUSTAIN = 0%
RELEASE = 616.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -54%
CV 1 > POS 2 = -54%
ENV 2 > POS 1 = 35.5%
ENV 2 > POS 2 = 35.5%
ENV 2 > PITCH 1 = -0.5%
ENV 2 > PITCH 2 = -0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 49.8%

FAIRWAVE PATCH 1
NAME  = JP SYNC LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Sync Lead by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/EC/CC2F4EB7.WAV
READ = CLEAN
TUNE = -12
POS = 24.2%

[OSC 2]
TABLE = MODWAVE/T/EC/CC2F4EB7.WAV
TUNE = -12
POS = 24.2%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 0%
RELEASE = 52.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
ENV 2 > POS 1 = 51.5%
CV 1 > POS 1 = -40.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

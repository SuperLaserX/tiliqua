FAIRWAVE PATCH 1
NAME  = JX3P VIBRPHONE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX3P Vibrphone by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/BC/6D0A05BE.WAV
READ = CLEAN
TUNE = 0
POS = 33.3%

[OSC 2]
TABLE = MODWAVE/T/49/ABDFEAA9.WAV
READ = CLEAN
TUNE = 19
POS = 33.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 78.969 S
SUSTAIN = 23%
RELEASE = 916.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 24.000 MS
DECAY = 773.333 MS
SUSTAIN = 0%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.001 HZ
SHAPE = TRI

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -55.5%
CV 1 > POS 2 = -55.5%
ENV 2 > POS 1 = 33.5%
ENV 2 > POS 2 = 33.5%
LFO 1 > POS 1 = 8%
LFO 1 > POS 2 = 8%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

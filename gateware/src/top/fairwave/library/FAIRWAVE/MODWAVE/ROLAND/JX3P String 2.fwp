FAIRWAVE PATCH 1
NAME  = JX3P STRING 2
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX3P String 2 by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Chorus-Flange Morph, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/52/E9575357.WAV
READ = CLEAN
TUNE = 0
POS = 41.4%

[OSC 2]
TABLE = MODWAVE/T/D2/5CCAF1E4.WAV
READ = CLEAN
TUNE = 0
FINE = -15
POS = 41.4%

[ENV 1]
GATE = GATE 1
ATTACK = 112.000 MS
DECAY = 460.000 MS
SUSTAIN = 72%
RELEASE = 268.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 556.000 MS
DECAY = 90.000 S
SUSTAIN = 89%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -69%
CV 1 > POS 2 = -69%
ENV 2 > POS 1 = 17%
ENV 2 > POS 2 = 17%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

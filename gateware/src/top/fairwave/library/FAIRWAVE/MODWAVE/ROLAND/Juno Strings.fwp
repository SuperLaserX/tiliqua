FAIRWAVE PATCH 1
NAME  = JUNO STRINGS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Strings by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/BB/46DC1EFF.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/BB/46DC1EFF.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 980.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 2.133 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = JUNO CLASSIC PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Classic Pad by ID-Juno: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/59/F98D2F5B.WAV
READ = CLEAN
TUNE = -24
POS = 20.4%

[OSC 2]
TABLE = MODWAVE/T/5F/6E24B0DE.WAV
READ = CLEAN
TUNE = -12
POS = 20.4%

[ENV 1]
GATE = GATE 1
ATTACK = 461.333 MS
DECAY = 3.621 S
SUSTAIN = 95%
RELEASE = 51.683 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 304.000 MS
DECAY = 3.944 S
SUSTAIN = 67%
RELEASE = 4.900 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 59%
ENV 2 > POS 2 = 59%
CV 1 > POS 1 = -34%
CV 1 > POS 2 = -34%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 18.3%

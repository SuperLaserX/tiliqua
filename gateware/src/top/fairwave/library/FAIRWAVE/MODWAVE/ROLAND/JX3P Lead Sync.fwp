FAIRWAVE PATCH 1
NAME  = JX3P LEAD SYNC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX3P Lead Sync by Ian dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/D1/3F9AE949.WAV
READ = CLEAN
TUNE = -12
POS = 20.9%

[OSC 2]
TABLE = MODWAVE/T/3C/4BFF7F21.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 20.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58%
ENV 2 > POS 2 = 58%
CV 1 > POS 1 = -35%
CV 1 > POS 2 = -35%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = JP STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Strings by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/83/81BC74E4.WAV
READ = CLEAN
TUNE = -12
POS = 35.0%

[OSC 2]
TABLE = MODWAVE/T/83/81BC74E4.WAV
READ = CLEAN
TUNE = -12
POS = 35.0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.168 S
DECAY = 16.575 S
SUSTAIN = 65%
RELEASE = 1.645 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 581.333 MS
DECAY = 2.071 S
SUSTAIN = 0%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.082 HZ
SHAPE = SINE

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -58.5%
CV 1 > POS 2 = -58.5%
ENV 2 > POS 1 = 30%
ENV 2 > POS 2 = 30%
LFO 1 > PITCH 1 = 0.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 45.1%

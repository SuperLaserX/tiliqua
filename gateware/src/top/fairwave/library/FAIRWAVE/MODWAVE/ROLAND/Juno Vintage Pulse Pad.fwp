FAIRWAVE PATCH 1
NAME  = JUNO VINTAGE PUL
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Vintage Pulse Pad by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/18/8A782A92.WAV
READ = CLEAN
TUNE = -12
POS = 100.0%

[OSC 2]
TABLE = MODWAVE/T/96/3C561944.WAV
READ = CLEAN
TUNE = -12
POS = 12.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 97%
RELEASE = 2.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[LFO 1]
RATE = 0.131 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > POS 2 = 86.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 55.1%

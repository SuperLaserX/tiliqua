FAIRWAVE PATCH 1
NAME  = JP UNISON LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Unison Lead by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 6 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/9A/2E8BA0D6.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 30.6%

[OSC 2]
TABLE = MODWAVE/T/A6/2E0FF242.WAV
READ = CLEAN
TUNE = -12
FINE = 1
POS = 30.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 32.000 MS
DECAY = 246.667 MS
SUSTAIN = 46%
RELEASE = 3.067 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51%
CV 1 > POS 2 = -51%
ENV 2 > POS 1 = 39%
ENV 2 > POS 2 = 39%
ENV 2 > PITCH 1 = 1%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

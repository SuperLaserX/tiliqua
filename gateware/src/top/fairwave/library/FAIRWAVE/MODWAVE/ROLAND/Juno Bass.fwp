FAIRWAVE PATCH 1
NAME  = JUNO BASS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Bass by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 2, a table made along cutoff.
# Not carried over: the sub oscillator.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/18/44FA28DE.WAV
READ = CLEAN
TUNE = -24
POS = 29.3%

[OSC 2]
TABLE = MODWAVE/T/18/44FA28DE.WAV
TUNE = -24
POS = 29.3%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 62%
RELEASE = 84.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 3.600 S
SUSTAIN = 4%
RELEASE = 513.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -49%
ENV 2 > POS 1 = 41.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

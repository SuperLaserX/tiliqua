FAIRWAVE PATCH 1
NAME  = JP RING MOD BELL
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Ring Mod Bell by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/65/E446CE48.WAV
READ = CLEAN
TUNE = 0
POS = 16.1%

[OSC 2]
TABLE = MODWAVE/T/8D/A7ECC336.WAV
READ = CLEAN
TUNE = 0
FINE = 30
POS = 16.1%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 653.333 MS
SUSTAIN = 36%
RELEASE = 81.333 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = RING
FROM = OSC 1
DEPTH = 93.6%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 73.333 S
SUSTAIN = 8%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68%
ENV 2 > POS 2 = 68%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = JP OLD POLY CHOR
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Old Poly Chords by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: an LFO past the three here.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/4E/D63C8550.WAV
READ = CLEAN
TUNE = -24
FINE = 4
POS = 21.8%

[OSC 2]
TABLE = MODWAVE/T/67/07D531F4.WAV
READ = CLEAN
TUNE = -12
POS = 21.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 73.333 MS
SUSTAIN = 100%
RELEASE = 2.685 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 390.667 MS
DECAY = 63.823 S
SUSTAIN = 68%
RELEASE = 12.883 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 56.5%
ENV 2 > POS 2 = 56.5%
CV 1 > POS 1 = -36.5%
CV 1 > POS 2 = -36.5%
LFO 2 > POS 1 = 2%
LFO 2 > POS 2 = 2%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

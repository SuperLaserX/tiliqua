FAIRWAVE PATCH 1
NAME  = JUNO EP
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno EP by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: EP Chorus, Modern Compressor, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/7B/6CEC9904.WAV
READ = CLEAN
TUNE = -12
POS = 37.8%

[OSC 2]
TABLE = MODWAVE/T/7B/6CEC9904.WAV
TUNE = -12
POS = 37.8%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 746.667 MS
SUSTAIN = 9%
RELEASE = 860.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 37.333 S
SUSTAIN = 8%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 4.008 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
LFO 1 > LEVEL 1 = 100%
CV 1 > POS 1 = -63%
ENV 2 > POS 1 = 24.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

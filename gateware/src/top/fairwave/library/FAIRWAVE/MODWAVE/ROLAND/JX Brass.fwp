FAIRWAVE PATCH 1
NAME  = JX BRASS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX Brass by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/F1/C65436F6.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[OSC 2]
TABLE = MODWAVE/T/F1/C65436F6.WAV
READ = CLEAN
TUNE = -12
POS = 14.9%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 1.640 S
SUSTAIN = 91%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70.5%
ENV 2 > POS 2 = 70.5%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
ENV 2 > PITCH 1 = 1%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = JX PWM STABS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX PWM Stabs by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/9F/29114AAC.WAV
READ = CLEAN
TUNE = -12
POS = 17.6%

[OSC 2]
TABLE = MODWAVE/T/4A/45B52868.WAV
READ = CLEAN
TUNE = 0
POS = 17.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.559 S
SUSTAIN = 0%
RELEASE = 962.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 157.333 MS
SUSTAIN = 18%
RELEASE = 933.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29.5%
CV 1 > POS 2 = -29.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.5%

FAIRWAVE PATCH 1
NAME  = JP BRASS
ABOUT = SYNTH FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Brass by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/E8/A7CE1354.WAV
READ = CLEAN
TUNE = -12
POS = 19.6%

[OSC 2]
TABLE = MODWAVE/T/B5/C562C484.WAV
READ = CLEAN
TUNE = -12
POS = 19.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 120.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 26.667 MS
DECAY = 90.000 S
SUSTAIN = 93%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 61%
ENV 2 > POS 2 = 61%
CV 1 > POS 1 = -32.5%
CV 1 > POS 2 = -32.5%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.6%

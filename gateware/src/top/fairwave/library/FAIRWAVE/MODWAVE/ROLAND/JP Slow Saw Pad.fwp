FAIRWAVE PATCH 1
NAME  = JP SLOW SAW PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Slow Saw Pad by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 4 unison voices.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/9E/850A3A72.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/F8/D3EB2BF2.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 34.109 S
DECAY = 96.000 MS
SUSTAIN = 86%
RELEASE = 2.200 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 78.667 MS
SUSTAIN = 72%
RELEASE = 28.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = JUNO CLASSIC LEA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Juno Classic Lead by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/01/453A8B01.WAV
READ = CLEAN
TUNE = 0
POS = 18.6%

[OSC 2]
TABLE = MODWAVE/T/85/FD6EFE27.WAV
READ = CLEAN
TUNE = 0
POS = 18.6%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 0.000 MS
SUSTAIN = 100%
RELEASE = 593.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 125.333 MS
SUSTAIN = 41%
RELEASE = 82.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 3.401 HZ
SHAPE = TRI

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 63%
ENV 2 > POS 2 = 63%
CV 1 > POS 1 = -31%
CV 1 > POS 2 = -31%
LFO 2 > PITCH 1 = 1%
LFO 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 40.1%

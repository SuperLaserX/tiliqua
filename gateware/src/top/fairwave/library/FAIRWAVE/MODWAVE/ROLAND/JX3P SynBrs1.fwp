FAIRWAVE PATCH 1
NAME  = JX3P SYNBRS1
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX3P SynBrs1 by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/FF/4B62785B.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 25.0%

[OSC 2]
TABLE = MODWAVE/T/2B/D0B517F9.WAV
READ = CLEAN
TUNE = -12
FINE = -4
POS = 25.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 40.000 MS
DECAY = 0.000 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 50%
ENV 2 > POS 2 = 50%
CV 1 > POS 1 = -41.5%
CV 1 > POS 2 = -41.5%
ENV 2 > PITCH 2 = 2.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

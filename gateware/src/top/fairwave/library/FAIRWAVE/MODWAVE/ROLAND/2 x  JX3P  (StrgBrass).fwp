FAIRWAVE PATCH 1
NAME  = 2 X  JX3P  (STRG
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's 2 x  JX3P  (Strg&Brass) by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Nice Stereo DDL, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/0D/5317808C.WAV
READ = CLEAN
TUNE = -12
POS = 35.9%

[OSC 2]
TABLE = MODWAVE/T/3C/FB26F39C.WAV
READ = CLEAN
TUNE = -12
FINE = 13
POS = 35.9%

[ENV 1]
GATE = GATE 1
ATTACK = 280.000 MS
DECAY = 460.000 MS
SUSTAIN = 72%
RELEASE = 2.467 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 466.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -60%
CV 1 > POS 2 = -60%
ENV 2 > POS 1 = 28%
ENV 2 > POS 2 = 28%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

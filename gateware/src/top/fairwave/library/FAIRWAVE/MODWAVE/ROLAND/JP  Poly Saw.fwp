FAIRWAVE PATCH 1
NAME  = JP  POLY SAW
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP  Poly Saw by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 4.
[OSC 1]
TABLE = MODWAVE/T/3F/285A41BB.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 21.4%

[OSC 2]
TABLE = MODWAVE/T/78/B1F4FB74.WAV
READ = CLEAN
TUNE = -12
FINE = 4
POS = 21.4%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 49.333 MS
SUSTAIN = 100%
RELEASE = 2.016 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 1.115 S
SUSTAIN = 93%
RELEASE = 20.963 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 57.5%
ENV 2 > POS 2 = 57.5%
CV 1 > POS 1 = -35.5%
CV 1 > POS 2 = -35.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 64.3%

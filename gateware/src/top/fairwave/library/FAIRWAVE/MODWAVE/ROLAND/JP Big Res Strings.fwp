FAIRWAVE PATCH 1
NAME  = JP BIG RES STRIN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JP Big Res Strings by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: JC Amp Chorus, Modern Compressor, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/70/536A65FD.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[OSC 2]
TABLE = MODWAVE/T/E0/110F2C2A.WAV
READ = CLEAN
TUNE = -12
FINE = 18
POS = 15.3%

[ENV 1]
GATE = GATE 1
ATTACK = 7.040 S
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 4.925 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 277.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 63.304 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 0.221 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69.5%
ENV 2 > POS 2 = 69.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
LFO 1 > POS 1 = 3%
LFO 1 > POS 2 = 3%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

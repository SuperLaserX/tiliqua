FAIRWAVE PATCH 1
NAME  = JX SLOW FILTER
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's JX Slow Filter by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/6B/2CBD83FC.WAV
READ = CLEAN
TUNE = -12
POS = 21.0%

[OSC 2]
TABLE = MODWAVE/T/6B/2CBD83FC.WAV
READ = CLEAN
TUNE = -12
POS = 21.0%

[ENV 1]
GATE = GATE 1
ATTACK = 193.333 MS
DECAY = 46.667 MS
SUSTAIN = 96%
RELEASE = 913.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 2.800 S
DECAY = 6.667 S
SUSTAIN = 16%
RELEASE = 500.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 58%
ENV 2 > POS 2 = 58%
CV 1 > POS 1 = -35%
CV 1 > POS 2 = -35%
ENV 2 > PITCH 1 = 1%
ENV 2 > PITCH 2 = 1%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

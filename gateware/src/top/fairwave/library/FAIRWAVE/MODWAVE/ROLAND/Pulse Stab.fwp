FAIRWAVE PATCH 1
NAME  = PULSE STAB
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Pulse Stab by Ian Dixon: Roland.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
[OSC 1]
TABLE = MODWAVE/T/D3/4633502B.WAV
READ = CLEAN
TUNE = -12
POS = 30.8%

[OSC 2]
TABLE = MODWAVE/T/17/76DD05CC.WAV
READ = CLEAN
TUNE = -12
POS = 30.8%

[ENV 1]
GATE = GATE 1
ATTACK = 41.333 MS
DECAY = 821.333 MS
SUSTAIN = 67%
RELEASE = 857.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 77.333 MS
DECAY = 90.000 S
SUSTAIN = 50%
RELEASE = 520.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 1 > POS 1 = -51.5%
CV 1 > POS 2 = -51.5%
ENV 2 > POS 1 = 38.5%
ENV 2 > POS 2 = 38.5%
LFO 2 > POS 1 = 9%
LFO 2 > POS 2 = 9%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

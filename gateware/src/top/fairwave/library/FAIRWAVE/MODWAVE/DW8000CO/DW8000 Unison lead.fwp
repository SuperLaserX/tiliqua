FAIRWAVE PATCH 1
NAME  = DW8000 UNISON LE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Unison lead by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 8 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: 1/4 LPF, Modern Compressor, Stereo Chorus.
[OSC 1]
TABLE = MODWAVE/T/8C/C59C0D05.WAV
READ = CLEAN
TUNE = 0
POS = 22.2%

[OSC 2]
TABLE = MODWAVE/T/4C/2E71B60D.WAV
READ = CLEAN
TUNE = 0
POS = 22.2%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 55.5%
ENV 2 > POS 2 = 55.5%
CV 1 > POS 1 = -37%
CV 1 > POS 2 = -37%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = DW8000 / DW6000
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 / DW6000 Sweep by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Slow & Warm, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/22/60206CCF.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/D3/1EFC293D.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 50.0%

[ENV 2]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 90.000 S
SUSTAIN = 50%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 0
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 74.5%
ENV 2 > POS 2 = 74.5%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

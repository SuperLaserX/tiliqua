FAIRWAVE PATCH 1
NAME  = DW8000  SOFT BRA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000  Soft Brass by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/65/BAFCC1F9.WAV
READ = CLEAN
TUNE = -12
POS = 16.3%

[OSC 2]
TABLE = MODWAVE/T/65/BAFCC1F9.WAV
READ = CLEAN
TUNE = -12
POS = 16.3%

[ENV 1]
GATE = GATE 1
ATTACK = 28.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 453.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 89.333 MS
DECAY = 22.667 S
SUSTAIN = 0%
RELEASE = 4.867 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 67.5%
ENV 2 > POS 2 = 67.5%
CV 1 > POS 1 = -27%
CV 1 > POS 2 = -27%
LFO 1 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

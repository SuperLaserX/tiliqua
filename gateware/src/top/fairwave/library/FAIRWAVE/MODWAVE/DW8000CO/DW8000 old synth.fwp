FAIRWAVE PATCH 1
NAME  = DW8000 OLD SYNTH
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 old synth by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2, what changes its envelope and LFO speeds.
# Its effects, which FairWave hasn't got: Smooth Tremolo, Stereo Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/EF/EFE40FD4.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/25/2F7BAE51.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 449.333 MS
SUSTAIN = 100%
RELEASE = 184.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 0.056 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 75%
ENV 2 > POS 2 = 75%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 1 > POS 1 = 3%
LFO 1 > POS 2 = 3%
LFO 2 > PITCH 1 = -0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.4%

FAIRWAVE PATCH 1
NAME  = DW8000 STRINGS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Strings by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/BD/45A66BDF.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 17.6%

[OSC 2]
TABLE = MODWAVE/T/0B/A824B843.WAV
READ = CLEAN
TUNE = -12
POS = 17.6%

[ENV 1]
GATE = GATE 1
ATTACK = 1.600 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 12.000 MS
DECAY = 31.333 S
SUSTAIN = 65%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 65%
ENV 2 > POS 2 = 65%
CV 1 > POS 1 = -29.5%
CV 1 > POS 2 = -29.5%
ENV 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.5%

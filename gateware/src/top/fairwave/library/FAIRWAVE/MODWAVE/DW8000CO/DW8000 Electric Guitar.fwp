FAIRWAVE PATCH 1
NAME  = DW8000 ELECTRIC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Electric Guitar by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: Vintage Flanger, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/9F/8DD8ABF4.WAV
READ = CLEAN
TUNE = -12
POS = 26.3%

[OSC 2]
TABLE = MODWAVE/T/F4/48D9736A.WAV
READ = CLEAN
TUNE = -12
POS = 26.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.352 S
SUSTAIN = 52%
RELEASE = 2.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 56.000 MS
SUSTAIN = 0%
RELEASE = 34.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 47.5%
ENV 2 > POS 2 = 47.5%
CV 1 > POS 1 = -44%
CV 1 > POS 2 = -44%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.1%

FAIRWAVE PATCH 1
NAME  = DW8000 SEQ GUITA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Seq Guitar by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 8-Bit 12kHz, Vintage Flanger, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/80/F1162616.WAV
READ = CLEAN
TUNE = -12
POS = 15.0%

[OSC 2]
TABLE = MODWAVE/T/83/2E6050BD.WAV
READ = CLEAN
TUNE = -12
POS = 15.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.352 S
SUSTAIN = 42%
RELEASE = 2.173 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 753.333 MS
SUSTAIN = 0%
RELEASE = 41.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 70%
ENV 2 > POS 2 = 70%
CV 1 > POS 1 = -25%
CV 1 > POS 2 = -25%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.2%

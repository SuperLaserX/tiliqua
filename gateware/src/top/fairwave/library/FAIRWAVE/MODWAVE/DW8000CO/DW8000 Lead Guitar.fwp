FAIRWAVE PATCH 1
NAME  = DW8000 LEAD GUIT
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Lead Guitar by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Oscillator 2 is A's 2, its wavetable.
# Not carried over: the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Damaged Glass, US HiGain T75, Vintage Flanger.
[OSC 1]
TABLE = MODWAVE/T/F7/A6545B9A.WAV
READ = CLEAN
TUNE = -12
POS = 33.0%

[OSC 2]
TABLE = MODWAVE/T/28/1C8F65B5.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 100.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 46%
RELEASE = 24.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

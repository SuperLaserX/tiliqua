FAIRWAVE PATCH 1
NAME  = DW8000 SOFT  BEL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's DW8000 soft  Bell by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/27/7495BD27.WAV
READ = CLEAN
TUNE = 0
POS = 7.0%

[OSC 2]
TABLE = MODWAVE/T/A1/D27169B0.WAV
READ = CLEAN
TUNE = -12
POS = 7.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 45.675 S
SUSTAIN = 10%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 440.000 MS
DECAY = 79.120 S
SUSTAIN = 67%
RELEASE = 3.933 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 86%
ENV 2 > POS 2 = 86%
CV 1 > POS 1 = -11.5%
CV 1 > POS 2 = -11.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 76.7%

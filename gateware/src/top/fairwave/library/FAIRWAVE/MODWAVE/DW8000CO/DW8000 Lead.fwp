FAIRWAVE PATCH 1
NAME  = DW8000 LEAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Lead by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Modern Compressor, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/26/717448F1.WAV
READ = CLEAN
TUNE = -12
FINE = 5
POS = 17.0%

[OSC 2]
TABLE = MODWAVE/T/40/89A9B9C9.WAV
READ = CLEAN
TUNE = -12
POS = 17.0%

[ENV 1]
GATE = GATE 1
ATTACK = 30.667 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 1.567 S
SUSTAIN = 51%
RELEASE = 26.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 66%
ENV 2 > POS 2 = 66%
CV 1 > POS 1 = -28.5%
CV 1 > POS 2 = -28.5%
LFO 1 > POS 1 = 8%
LFO 1 > POS 2 = 8%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 44.6%

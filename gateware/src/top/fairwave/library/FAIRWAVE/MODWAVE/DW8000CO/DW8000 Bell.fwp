FAIRWAVE PATCH 1
NAME  = DW8000 BELL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's DW8000 Bell by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, Super Chorus, bpm Tape 3-Head.
[OSC 1]
TABLE = MODWAVE/T/5F/2F50ED68.WAV
READ = CLEAN
TUNE = 0
POS = 8.3%

[OSC 2]
TABLE = MODWAVE/T/E3/896D3346.WAV
READ = CLEAN
TUNE = -12
POS = 8.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 66.452 S
SUSTAIN = 88%
RELEASE = 4.413 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 4.763 S
SUSTAIN = 44%
RELEASE = 3.248 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 83.5%
ENV 2 > POS 2 = 83.5%
CV 1 > POS 1 = -14%
CV 1 > POS 2 = -14%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 54.3%

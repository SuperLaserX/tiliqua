FAIRWAVE PATCH 1
NAME  = DW8000  FM SEQ
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000  FM Seq by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: Modern Compressor, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/9A/B65F486E.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 12.6%

[OSC 2]
TABLE = MODWAVE/T/C5/FAE407EB.WAV
READ = CLEAN
TUNE = -12
POS = 12.6%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 47.3%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 280.000 MS
SUSTAIN = 53%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[LFO 2]
RATE = 2.000 HZ
SHAPE = TRI
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 75%
ENV 2 > POS 2 = 75%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
LFO 1 > LEVEL 1 = 11.5%
LFO 1 > LEVEL 2 = 11.5%
ENV 2 > PITCH 1 = 0.5%
LFO 2 > PITCH 1 = -0.5%
LFO 2 > PITCH 2 = 0.5%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.1%

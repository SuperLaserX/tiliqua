FAIRWAVE PATCH 1
NAME  = DW8000 ORGAN
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Organ by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is B's 1, a table made along cutoff.
# Oscillator 2 is B's 2, a table made along cutoff.
# Not carried over: 2 unison voices.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Stereo EP Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/FD/5E18C2CE.WAV
READ = CLEAN
TUNE = -12
POS = 12.5%

[OSC 2]
TABLE = MODWAVE/T/4B/8293F890.WAV
READ = CLEAN
TUNE = -12
POS = 12.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 30.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 0.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 75%
ENV 2 > POS 2 = 75%
CV 1 > POS 1 = -21%
CV 1 > POS 2 = -21%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.7%

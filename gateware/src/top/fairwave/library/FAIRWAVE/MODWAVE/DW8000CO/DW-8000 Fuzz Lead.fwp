FAIRWAVE PATCH 1
NAME  = DW-8000 FUZZ LEA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW-8000 Fuzz Lead by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices, controllers, random and Kaoss Physics, the mod wheel's scaling of a modulation.
# Its effects, which FairWave hasn't got: Hard Dive Lead, Modern Compressor, Mono 1/4 note dly, Stereo EP Chorus.
[OSC 1]
TABLE = MODWAVE/T/0E/74A3E2FB.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[OSC 2]
TABLE = MODWAVE/T/CF/CDCEB3B8.WAV
READ = CLEAN
TUNE = -12
POS = 15.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 413.333 MS
SUSTAIN = 61%
RELEASE = 772.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 21.333 MS
DECAY = 653.333 MS
SUSTAIN = 100%
RELEASE = 1.536 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69.5%
ENV 2 > POS 2 = 69.5%
CV 1 > POS 1 = -25.5%
CV 1 > POS 2 = -25.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 60.3%

FAIRWAVE PATCH 1
NAME  = DW8000 FILTER PA
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Filter pad by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Not carried over: performance modulators.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/3F/078F442A.WAV
READ = CLEAN
TUNE = -12
POS = 0.0%

[OSC 2]
TABLE = MODWAVE/T/3F/078F442A.WAV
TUNE = -12
POS = 0.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 73.333 MS
DECAY = 26.667 MS
SUSTAIN = 97%
RELEASE = 573.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

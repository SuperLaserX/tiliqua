FAIRWAVE PATCH 1
NAME  = DW8000  ELECTRIC
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000  Electric Piano by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, its wavetable.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Vintage.
[OSC 1]
TABLE = MODWAVE/T/AD/EE4912D2.WAV
READ = CLEAN
TUNE = -12
POS = 93.2%

[OSC 2]
TABLE = MODWAVE/T/AD/EE4912D2.WAV
TUNE = -12
POS = 93.2%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 1.333 MS
DECAY = 4.733 S
SUSTAIN = 0%
RELEASE = 560.000 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 2 > PITCH 1 = 0.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

FAIRWAVE PATCH 1
NAME  = DW8000 SINE PAD
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Sine Pad by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 5 unison voices, controllers, random and Kaoss Physics.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/A3/9EEDAD06.WAV
READ = CLEAN
TUNE = -12
FINE = -1
POS = 15.7%

[OSC 2]
TABLE = MODWAVE/T/C3/B92986FC.WAV
READ = CLEAN
TUNE = -12
POS = 15.7%

[ENV 1]
GATE = GATE 1
ATTACK = 1.600 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 14.667 MS
DECAY = 31.333 S
SUSTAIN = 65%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
ENV 2 > PITCH 1 = 0.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

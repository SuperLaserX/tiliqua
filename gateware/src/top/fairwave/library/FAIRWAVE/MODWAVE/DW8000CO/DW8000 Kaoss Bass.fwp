FAIRWAVE PATCH 1
NAME  = DW8000 KAOSS BAS
ABOUT = BASS FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Kaoss Bass by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C3 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: controllers, random and Kaoss Physics, performance modulators, the sub oscillator.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, bpm Pattern 3.
[OSC 1]
TABLE = MODWAVE/T/BC/432A5B15.WAV
READ = CLEAN
TUNE = -24
POS = 12.0%

[OSC 2]
TABLE = MODWAVE/T/BC/432A5B15.WAV
READ = CLEAN
TUNE = -24
POS = 12.0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 722.667 MS
SUSTAIN = 0%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 76%
ENV 2 > POS 2 = 76%
CV 1 > POS 1 = -20%
CV 1 > POS 2 = -20%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

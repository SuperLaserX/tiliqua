FAIRWAVE PATCH 1
NAME  = DW8000 WHIISTLE
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Whiistle by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/16 - 1/8 HPF, Modern Compressor, Polysix Ensemble.
[OSC 1]
TABLE = MODWAVE/T/39/BCB497C4.WAV
READ = CLEAN
TUNE = 0
POS = 15.8%

[OSC 2]
TABLE = MODWAVE/T/3F/DB1778DD.WAV
READ = CLEAN
TUNE = 0
FINE = -1
POS = 15.8%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 26.667 MS
SUSTAIN = 100%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 36.000 MS
DECAY = 1.933 S
SUSTAIN = 52%
RELEASE = 69.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 68.5%
ENV 2 > POS 2 = 68.5%
CV 1 > POS 1 = -26.5%
CV 1 > POS 2 = -26.5%
ENV 2 > PITCH 1 = 3.5%
ENV 2 > PITCH 2 = 3.5%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.3%

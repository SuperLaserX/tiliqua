FAIRWAVE PATCH 1
NAME  = DW8000 PIANO AND
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's DW8000 Piano and Pad by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/01/E7200E8C.WAV
READ = CLEAN
TUNE = -12
POS = 15.5%

[OSC 2]
TABLE = MODWAVE/T/4D/7712ABF0.WAV
READ = CLEAN
TUNE = -12
FINE = -2
POS = 15.5%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 90.000 S
SUSTAIN = 97%
RELEASE = 986.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 12.651 S
SUSTAIN = 14%
RELEASE = 24.000 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 69%
ENV 2 > POS 2 = 69%
CV 1 > POS 1 = -26%
CV 1 > POS 2 = -26%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

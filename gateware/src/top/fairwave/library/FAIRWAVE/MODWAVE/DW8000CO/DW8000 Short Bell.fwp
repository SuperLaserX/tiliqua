FAIRWAVE PATCH 1
NAME  = DW8000 SHORT BEL
ABOUT = BELL/MALLET FROM MODWAVE. GATE 1, 

# From the modwave's DW8000 Short Bell by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 3 unison voices.
# Its effects, which FairWave hasn't got: 1/8 - 1/8 dot LPF, Modern Compressor, Stereo Chorus, Super Chorus.
[OSC 1]
TABLE = MODWAVE/T/DB/1C71569E.WAV
READ = CLEAN
TUNE = 0
POS = 8.3%

[OSC 2]
TABLE = MODWAVE/T/5D/E84D0A3F.WAV
READ = CLEAN
TUNE = -12
POS = 8.3%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 746.667 MS
SUSTAIN = 0%
RELEASE = 866.667 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[CROSS MOD]
MODE = FM
FROM = OSC 1
DEPTH = 0.0%

[ENV 2]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 626.667 MS
SUSTAIN = 44%
RELEASE = 3.248 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 2 > POS 1 = 83.5%
ENV 2 > POS 2 = 83.5%
CV 1 > POS 1 = -14%
CV 1 > POS 2 = -14%
CV 2 > POS 1 = 25%
CV 2 > POS 2 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50.0%

FAIRWAVE PATCH 1
NAME  = DW8000 SIDE CHAI
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Dw8000 Side chain Pad by Ian Dixon: IDDW8000Colllection.mwbundle.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Oscillator 2 is A's 2, a table made along cutoff.
# Not carried over: 2 unison voices, an LFO past the three here, layer B oscillator 1, layer B oscillator 2.
# Its effects, which FairWave hasn't got: Modern Compressor, Stereo Chorus, Super Chorus, bpm Tape 1-Head.
[OSC 1]
TABLE = MODWAVE/T/F0/B2EB7229.WAV
READ = CLEAN
TUNE = -12
POS = 22.8%

[OSC 2]
TABLE = MODWAVE/T/EB/93B9928C.WAV
READ = CLEAN
TUNE = -12
POS = 22.8%

[ENV 1]
GATE = GATE 1
ATTACK = 4.315 S
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 3.267 S
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 69.333 MS
DECAY = 90.000 S
SUSTAIN = 100%
RELEASE = 18.667 S
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 2.000 HZ
SHAPE = SAW UP
SYNC = GATE 1

[LFO 2]
RATE = 0.250 HZ
SHAPE = SINE
PHASE = 9
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
LFO 1 > LEVEL 1 = 72%
LFO 1 > LEVEL 2 = 72%
ENV 2 > POS 1 = 54.5%
ENV 2 > POS 2 = 54.5%
CV 1 > POS 1 = -38%
CV 1 > POS 2 = -38%
LFO 2 > POS 1 = 5.5%
LFO 2 > POS 2 = 5.5%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 48.6%

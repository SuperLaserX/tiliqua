FAIRWAVE PATCH 1
NAME  = WORDERFULL CHRIS
ABOUT = USER FROM MODWAVE. GATE 1, CV 1

# From the modwave's Worderfull Christmas  by Ian Dixon: Worderfull Christmas.mwperf.
# 0 V plays what its C4 key plays.
# Oscillator 1 is A's 1, a table made along cutoff.
# Its effects, which FairWave hasn't got: 1/4 LPF, Modern Compressor.
[OSC 1]
TABLE = MODWAVE/T/6C/6610261A.WAV
READ = CLEAN
TUNE = -12
POS = 50.0%

[OSC 2]
TABLE = MODWAVE/T/6C/6610261A.WAV
TUNE = -12
POS = 50.0%
LEVEL = 0%

[ENV 1]
GATE = GATE 1
ATTACK = 0.000 MS
DECAY = 2.876 S
SUSTAIN = 6%
RELEASE = 77.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60
VCA = BOTH

[ENV 2]
GATE = GATE 1
ATTACK = 9.333 MS
DECAY = 144.000 MS
SUSTAIN = 9%
RELEASE = 53.333 MS
A CURVE = 30
D CURVE = 60
R CURVE = 60

[LFO 1]
RATE = 3.157 HZ
SHAPE = SAW DN
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > POS 1 = -38%
LFO 1 > POS 1 = 27.5%
ENV 2 > POS 1 = 20%
CV 2 > POS 1 = 25%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 0.0%

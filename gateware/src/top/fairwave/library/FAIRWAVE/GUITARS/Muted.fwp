FAIRWAVE PATCH 1
NAME  = MUTED
ABOUT = PALM MUTED: RIFFS

# D110-EG Mute, played by READ = SAMPLE, restarting on each gate. 0 V is C3.
# CV 2 moves where it starts.
[OSC 1]
TABLE = SAMPLES/EGMUTE.WAV
READ = SAMPLE
TUNE = -18
FINE = 21
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[OSC 2]
TABLE = SAMPLES/EGMUTE.WAV
READ = SAMPLE
TUNE = -18
FINE = 24
POS = 0%
EDGE = CLAMP
GRAIN = SYNC 1

[ENV 1]
ATTACK = 0
DECAY = 1 S
SUSTAIN = 100%
RELEASE = 60 MS
D CURVE = 40
VCA = BOTH

[LFO 1]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
CV 2 > POS 1 = 12%
CV 2 > POS 2 = 12%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 50%

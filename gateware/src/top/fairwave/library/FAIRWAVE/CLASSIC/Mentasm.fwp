FAIRWAVE PATCH 1
NAME  = MENTASM
ABOUT = THE HOOVER, ONE OCTAVE LOWER

# Further down, faster, and darker, with the swoop shorter for riffs: where a Mentasm riff lives. 0 V is C2.
[OSC 1]
TABLE = SAMPLES/HOOVDRK.WAV
TUNE = -42
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = SAMPLES/HOOVBRI.WAV
TUNE = -42
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
ATTACK = 70 MS
DECAY = 100 MS
SUSTAIN = 100%
RELEASE = 110 MS
A CURVE = 25
R CURVE = 15
VCA = BOTH

[LFO 1]
RATE = 1.9 HZ
SHAPE = SINE

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > PITCH 1 = 20%
ENV 1 > PITCH 2 = 20%
ENV 1 > BALANCE = 50%
LFO 1 > BALANCE = 16%
CV 2 > BALANCE = 40%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 10%

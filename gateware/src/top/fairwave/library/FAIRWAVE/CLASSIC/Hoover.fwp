FAIRWAVE PATCH 1
NAME  = HOOVER
ABOUT = RAVE HOOVER, LIVE FILTER. GATE 1

# The same oscillator and chorus as What The, but two recordings of it, one with the filter open and one with it shut,
# and the level moved between them: a filter that follows this patch's own envelope and LFO, at any pitch, with
# nothing baked in. It restarts on each gate so the two stay together. CV 2 opens it. 0 V is C3.
[OSC 1]
TABLE = SAMPLES/HOOVDRK.WAV
TUNE = -42
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[OSC 2]
TABLE = SAMPLES/HOOVBRI.WAV
TUNE = -42
FINE = 47
POS = 0%
READ = SAMPLE
EDGE = WRAP
LOOP = 0%
GRAIN = SYNC 3

[ENV 1]
ATTACK = 170 MS
DECAY = 100 MS
SUSTAIN = 100%
RELEASE = 200 MS
A CURVE = 20
R CURVE = 15
VCA = BOTH

[LFO 1]
RATE = 1.4 HZ
SHAPE = SINE

[LFO 3]
RATE = 0.01 HZ
SHAPE = SAW UP
SYNC = GATE 1

[ROUTING]
CV 1 > PITCH 1 = 100%
CV 1 > PITCH 2 = 100%
ENV 1 > PITCH 1 = 40%
ENV 1 > PITCH 2 = 40%
ENV 1 > BALANCE = 75%
LFO 1 > BALANCE = 18%
CV 2 > BALANCE = 30%

[MIXER]
OUT 0 = MIX
OUT 1 = MIX
BALANCE = 10%
